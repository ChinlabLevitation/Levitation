Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["run along x (C2v)",
  FontWeight->"Bold"],
 ":   ",
 "after 1 s: no spin, orientation = hanging state, velocity = steady \
prediction",
 "\n",
 StyleBox["|\[Omega]| = 2.05e-14 rad/s, horizontal speed 2.48e-15 mm/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"b265466b-0c2f-4e11-8bd0-42e896d883ec"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["run in the x-z plane (Cs)",
  FontWeight->"Bold"],
 ":   ",
 "after 1 s: no spin, orientation = hanging state, velocity = steady \
prediction",
 "\n",
 StyleBox["|\[Omega]| = 1.75e-12 rad/s, horizontal speed 1.406 mm/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"6a389993-8fcb-44ee-93e5-e782f47a0a11"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["run generic (C1, chiral)",
  FontWeight->"Bold"],
 ":   ",
 "after 1 s: no spin, orientation = hanging state, velocity = steady \
prediction",
 "\n",
 StyleBox["|\[Omega]| = 8.92e-13 rad/s, horizontal speed 1.113 mm/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"be75c53f-dc08-4364-b46b-41e90c533b3e"],

Cell[TextData[{
 "The pendulum frequency is set by the stiffness ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "g", "|", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"], "|"}], TraditionalForm]],ExpressionUUID->
  "50264ae6-7b2a-4711-a0ba-3dfe1c56628b"],
 " and the moment of inertia, as for the graded sphere. The ringdown takes a \
few tens of milliseconds. Afterwards the chiral particle moves exactly like \
an achiral one. Its orientation is locked, it has no spin, and its horizontal \
velocity is constant."
}], "Text",ExpressionUUID->"15d8a27a-c09d-430e-a604-f0f8ed0cf31e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mesh", "=", 
      RowBox[{"bodyMesh", "[", "Rnum", "]"}]}], ",", 
     RowBox[{"states", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"runs", "[", "\"\<generic (C1, chiral)\>\"", "]"}], 
          "[", "\"\<state\>\"", "]"}], "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0.", ",", "1.", ",", "0.005"}], "}"}]}], "]"}]}], 
     ",", 
     RowBox[{"rng", "=", 
      RowBox[{
       RowBox[{"10", "^", "6"}], 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"runs", "[", "\"\<generic (C1, chiral)\>\"", "]"}], 
          "[", "\"\<state\>\"", "]"}], "[", "1.", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "=", 
          RowBox[{"states", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", "x"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{"10", "^", "6"}], 
          RowBox[{"st", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}], ";", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"drawBody", "[", 
             RowBox[{"mesh", ",", "x", ",", 
              RowBox[{"quatR", "[", 
               RowBox[{"st", "[", 
                RowBox[{"[", 
                 RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ",", "60"}], 
             "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", ">", "1"}], ",", 
              RowBox[{"{", 
               RowBox[{"Gray", ",", "Thick", ",", 
                RowBox[{"Line", "[", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"states", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", "k"}], ",", 
                    RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], "]"}]}], 
               "}"}], ",", "Nothing"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Min", "[", 
                  RowBox[{"#", ",", "0"}], "]"}], "-", "120"}], "&"}], "/@", 
               "rng"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"#", ",", "0"}], "]"}], "+", "120"}], "&"}], "/@", 
               "rng"}]}], "}"}], "]"}]}], ",", 
          RowBox[{"BoxRatios", "->", "Automatic"}], ",", 
          RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<chiral (C1) offset,  t = \>\"", ",", 
              RowBox[{"5", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}]}], ",", "\"\< ms\>\""}], "}"}],
             "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "520"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "\"\<frame (5 ms steps)\>\""}], "}"}], ",",
        "1", ",", "201", ",", "1", ",", 
       RowBox[{"ControlType", "->", "Animator"}], ",", 
       RowBox[{"AnimationRunning", "->", "False"}]}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]}], "]"}]], "Input",Exp\
ressionUUID->"2a31ebb7-838f-4f98-9c8c-23b802eca9d0"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`k$$ = 1, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
