Cell[CellGroupData[{

Cell["5. Why a mass offset cannot make the particle spin", "Section",ExpressionUUID->"a5f0c434-bb53-4982-8810-2d38739fea4e"],

Cell[TextData[{
 "A steady spin ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Omega]",
     FontWeight->"Bold"], " ", "=", " ", "\[CapitalOmega]", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "a30ad02f-bc87-4f15-90bf-a09548192562"],
 " about the vertical needs a real eigenpair ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "\[Lambda]", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "f928f015-4bf4-4d0e-a5cc-b20adf427470"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", " ", "\[NotEqual]", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"d8e63dbd-73a1-42a2-afa7-21e23619860c"],
 " (then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", "\[Lambda]", " ", "G"}], 
   TraditionalForm]],ExpressionUUID->"e7599a04-ae1a-4a7f-a664-b5181401116e"],
 "). Insert ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "06e7874f-af34-4d57-95b8-48b4c5343e41"],
 " and take the dot product with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "8a05c3ae-f3dc-44a9-b442-986c9bb434ee"],
 ":"
}], "Text",ExpressionUUID->"0ba3cb44-0228-47a4-aff2-9acdaeb750f7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Lambda]", "\[ThinSpace]", 
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "\[Transpose]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["f",
          FontWeight->"Bold"], 
         StyleBox["th",
          FontSlant->"Plain"]], 
        StyleBox["u",
         FontWeight->"Bold"]}], ")"}]}], "\[CenterDot]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "c"], "\[Times]", 
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], 
       StyleBox["u",
        FontWeight->"Bold"]}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"0", " ", "\:2003"}], "\[DoubleRightArrow]", 
      RowBox[{"\:2003", " ", "\[Lambda]"}]}], " ", "=", " ", "0"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"235dea62-ce72-489b-97da-fa408dc3ccd8"],

Cell[TextData[{
 "The conclusion holds whenever the symmetric part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "3172534e-175b-43b3-aaeb-99b091dc5528"],
 " is positive-definite, which is always true for a near-sphere (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", 
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox["c", "0"], 
    StyleBox["I",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "b7ca4552-bed1-4be9-8e91-176c19b587ee"],
 "). The only real eigenvalue is therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"2f0f54ec-f578-4fce-82ee-9debf4917f52"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "\[DoubleVerticalBar]", " ", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"]}], TraditionalForm]],ExpressionUUID->
  "5e82fdf3-8c49-495b-806c-96a8585aab46"],
 ": the hanging orientation. The other two eigenvalues form a complex pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", " ", "\[PlusMinus]", " ", "i", 
    SubscriptBox["\[Gamma]", "0"], "|", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"], "|", "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "96686592-1616-4bb2-9752-b3f09a4fd26a"],
 ", a pendulum oscillation. Physically, every gas force acts through H. At \
levitation the total gas force balances gravity and is vertical, and a \
vertical force through H has no moment about the vertical axis through the \
CoM. So there is never a spin-driving torque, whichever way the offset points."
}], "Text",ExpressionUUID->"f5a65823-50b1-44cd-bf6f-1c7a3f8acd0e"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"KeyValueMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ev", "=", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Inverse", "[", 
             RowBox[{
              RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], 
              "[", "\"\<T_drag\>\"", "]"}], "]"}], ".", 
            RowBox[{
             RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_th\>\"", 
             "]"}]}], "]"}]}], ",", 
         RowBox[{"mu", "=", 
          RowBox[{
           RowBox[{"#2", "[", "\"\<gamma0\>\"", "]"}], 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"#2", "[", "\"\<com\>\"", "]"}], "]"}], "/", 
            RowBox[{"#2", "[", "\"\<c0\>\"", "]"}]}]}]}]}], "}"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"\"\<spectrum \>\"", "<>", "#1"}], 
         ",", "\"\<eigenvalues of T_drag^-1 T_th are 0 and a complex pair ~ \
+-i gamma0 |r_c|/c0\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"ev", ",", 
             RowBox[{"e_", "/;", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"Im", "[", "e", "]"}], "]"}], "<", 
               RowBox[{
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}], 
                RowBox[{"Abs", "[", "mu", "]"}]}]}]}]}], "]"}], "==", "1"}], "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Abs", "[", "ev", "]"}], "]"}], "<", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", "9"}]}], "mu"}]}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{"Im", "[", "ev", "]"}], "]"}], "]"}], "/", "mu"}], "-",
              "1"}], "]"}], "<", "0.1"}], "&&", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], 
                  "[", "\"\<f_th\>\"", "]"}], ".", 
                 RowBox[{
                  RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], 
                  "[", "\"\<T_drag\>\"", "]"}]}], "+", 
                RowBox[{"Transpose", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], 
                   "[", "\"\<f_th\>\"", "]"}], ".", 
                  RowBox[{
                   RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}], 
                   "[", "\"\<T_drag\>\"", "]"}]}], "]"}]}], ")"}], "/", "2"}],
              "]"}], "]"}], ">", "0"}]}], ",", 
         RowBox[{"\"\<eigenvalues/(gamma0 |r_c|/c0) = \>\"", "<>", 
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"Chop", "[", 
                  RowBox[{
                   RowBox[{"#", "/", "mu"}], ",", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "10"}]}]}], "]"}], ",", "4"}], "]"}], "]"}], 
              "&"}], "/@", "ev"}], ",", "\"\<,  \>\""}], "]"}]}]}], "]"}]}], 
      "]"}], "&"}], ",", "pts"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"f7c9741d-aa87-4808-8539-eb0d2a1e132d"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["spectrum along x (C2v)",
  FontWeight->"Bold"],
 ":   ",
