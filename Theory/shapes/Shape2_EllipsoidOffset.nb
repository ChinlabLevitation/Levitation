Cell[CellGroupData[{

Cell["8. Orbital radius and period", "Section",ExpressionUUID->"2ac8ff02-5ab8-47c6-a93e-57ed7a8371ca"],

Cell[TextData[{
 StyleBox["Not applicable, for every offset direction.",
  FontWeight->"Bold"],
 " The steady states have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"10a62579-d7a4-46a6-8677-d72bbd7346af"],
 " exactly, so the orbital radius is infinite and there is no orbital period. \
The table below lists what the particle does instead."
}], "Text",ExpressionUUID->"c4cdeea4-3636-4af5-84c8-e5830502217e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "#1", ",", "\"\<0\>\"", ",", "\"\<infinite\>\"", ",", "\"\<none\>\"",
           ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "9"}]}]}], ",", "\"\<hover\>\"", ",", 
            RowBox[{"\"\<straight glide at \>\"", "<>", 
             RowBox[{"num", "[", 
              RowBox[{"1000", 
               RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}]}], "]"}], 
             "<>", "\"\< mm/s\>\""}]}], "]"}]}], "}"}], "&"}], ",", "hang"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<offset\>\"", ",", "\"\<spin Omega (rad/s)\>\"", 
       ",", "\"\<orbital radius\>\"", ",", "\"\<period\>\"", 
       ",", "\"\<motion\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]], "Input",ExpressionUUID->\
"a393feeb-1224-4c87-8cd7-a6bb8ea05372"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"offset\"\>", "\<\"spin Omega (rad/s)\"\>", "\<\"orbital \
radius\"\>", "\<\"period\"\>", "\<\"motion\"\>"},
    {"\<\"along x (C2v)\"\>", "\<\"0\"\>", "\<\"infinite\"\>", \
"\<\"none\"\>", "\<\"hover\"\>"},
    {"\<\"in the x-z plane (Cs)\"\>", "\<\"0\"\>", "\<\"infinite\"\>", \
"\<\"none\"\>", "\<\"straight glide at 1.406 mm/s\"\>"},
    {"\<\"generic (C1, chiral)\"\>", "\<\"0\"\>", "\<\"infinite\"\>", \
"\<\"none\"\>", "\<\"straight glide at 1.113 mm/s\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"b06a5ff7-91f9-47a3-b43b-7b16dba56c2b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Answer: can an offset direction give chirality?", "Section",ExpressionUUID->"214fc461-e44b-4dd8-8feb-6aecb6de42bd"],

Cell[TextData[{
 StyleBox["Geometrically, yes.",
  FontWeight->"Bold"],
 " On a triaxial ellipsoid, any offset that lies neither on a principal axis \
nor in a principal plane leaves no symmetry element. The particle (surface \
plus mass) is then chiral, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "bd8fd713-d45d-49e5-8e19-b284422d62a9"],
 "."
}], "Item",ExpressionUUID->"c6d56f1e-5620-4de5-8903-adc8351c62b5"],

Cell[TextData[{
 StyleBox["Dynamically, no.",
  FontWeight->"Bold"],
 " The gas sees only the surface, which is centrosymmetric, so the gas wrench \
about H has no polar\[Dash]axial coupling. About the CoM the thermophoretic \
torque is the moment of a force through H, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "7f42403f-e51d-4dd8-95b2-8f751d55be65"],
 ". Such a torque can only align the particle, never spin it: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "f126ef39-a156-4998-a2ad-fa04ae2f5b72"],
 " has eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "0", ",", " ", "\[PlusMinus]", " ", "i", "\[Mu]", "}"}], 
   TraditionalForm]],ExpressionUUID->"125862ad-26ed-44a4-b420-092464351dd2"],
 " for every offset."
}], "Item",ExpressionUUID->"393afaf5-d97f-42d7-b3cc-980df62afa07"],

Cell[TextData[{
 StyleBox["What is needed instead.",
  FontWeight->"Bold"],
 " The chirality has to be in the ",
 StyleBox["surface",
  FontSlant->"Italic"],
 ", so that the gas forces themselves form a chiral pattern with a moment \
about the vertical. Shape 3 builds such a surface from spherical harmonics."
}], "Item",ExpressionUUID->"68cc9b8d-d934-4bd7-a0ae-5aba5ebcf8ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Summary", "Section",ExpressionUUID->"4996f065-9ed8-48bb-89fe-23b0b40e0855"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
