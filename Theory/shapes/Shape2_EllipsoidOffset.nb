Cell[CellGroupData[{

Cell["7. Simulated trajectories", "Section",ExpressionUUID->"5d59ae38-8f48-4701-967a-a0bba7f84f67"],

Cell["\<\
Each particle starts at rest, with its vertical tilted 30\[Degree] away from \
the hanging orientation, at the hanging state's levitation gradient. The full \
nonlinear equations show a damped pendulum swing, with no net spin, followed \
by steady straight-line motion. That motion is a hover for the axial offset \
and a glide for the other two.\
\>", "Text",ExpressionUUID->"0c395730-1194-405e-a62e-37b6807e9f56"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"runs", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "=", 
            RowBox[{"#2", "[", "\"\<u\>\"", "]"}]}], ",", "q0", ",", 
           "tiltAxis"}], "}"}], ",", 
         RowBox[{
          RowBox[{"tiltAxis", "=", 
           RowBox[{"Normalize", "[", 
            RowBox[{"Cross", "[", 
             RowBox[{"u", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"u", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "0.9"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}], 
            "]"}]}], ";", 
          RowBox[{"q0", "=", 
           RowBox[{"qFromTo", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RotationMatrix", "[", 
               RowBox[{
                RowBox[{"30", "Degree"}], ",", "tiltAxis"}], "]"}], ".", 
              "u"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"#1", "->", 
           RowBox[{"simulate", "[", 
            RowBox[{
             RowBox[{"pts", "[", "#1", "]"}], ",", 
             RowBox[{"#2", "[", "\"\<G\>\"", "]"}], ",", "q0", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1."}], 
            "]"}]}]}]}], "]"}], "&"}], ",", "hang"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uLab", "[", "st_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"quatR", "[", 
      RowBox[{"st", "[", 
       RowBox[{"[", 
        RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], "]"}], ".", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ts", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.", ",", "1.", ",", "1000"}], "]"}]}], ",", 
     RowBox[{"cols", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.9", ",", "0.5", ",", "0.1"}], "]"}], ",", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.2", ",", "0.65", ",", "0.3"}], "]"}]}], "}"}]}]}], "}"}], 
   ",", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"key", ",", "hs"}], "}"}], ",", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"1000", "ts"}], ",", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"VectorAngle", "[", 
                    RowBox[{
                    RowBox[{"uLab", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"runs", "[", "key", "]"}], "[", "\"\<state\>\"", 
                    "]"}], "[", "t", "]"}], "]"}], ",", 
                    RowBox[{"hs", "[", "\"\<u\>\"", "]"}]}], "]"}], "/", 
                    "Degree"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", "ts"}], "}"}]}], "]"}]}], "}"}], 
                "]"}]}], "]"}], ",", "hang"}], "]"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "150"}], "}"}], ",", "All"}], "}"}]}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<t (ms)\>\"", 
              ",", "\"\<angle from hanging orientation (deg)\>\""}], "}"}]}], 
           ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"Placed", "[", 
             RowBox[{
              RowBox[{"Keys", "[", "hang", "]"}], ",", "Below"}], "]"}]}], ",", 
           RowBox[{"PlotStyle", "->", "cols"}], ",", 
           RowBox[{"ImageSize", "->", "340"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<pendulum ringdown\>\""}]}], "]"}], 
         ",", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"key", ",", "hs"}], "}"}], ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"runs", "[", "key", "]"}], "[", "\"\<state\>\"", 
                    "]"}], "[", "t", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", "ts"}], "}"}]}], "]"}]}], "]"}], ",", 
             "hang"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
           RowBox[{"Frame", "->", "True"}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\""}], "}"}]}], ",", 
           
           RowBox[{"PlotStyle", "->", "cols"}], ",", 
           RowBox[{"ImageSize", "->", "340"}], ",", 
           RowBox[{"PlotLabel", "->", "\"\<top view of the CoM, 1 s\>\""}], ",", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Sequence", "@@", 
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"st", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"runs", "[", "#1", "]"}], "[", "\"\<state\>\"", 
                 "]"}], "[", "1.", "]"}]}], ",", "vpred"}], "}"}], ",", 
            RowBox[{
             RowBox[{"vpred", "=", 
              RowBox[{
               RowBox[{"quatR", "[", 
                RowBox[{"st", "[", 
                 RowBox[{"[", 
                  RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ".", 
               RowBox[{"#2", "[", "\"\<v_body\>\"", "]"}]}]}], ";", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{"\"\<run \>\"", "<>", "#1"}], 
               ",", "\"\<after 1 s: no spin, orientation = hanging state, \
velocity = steady prediction\>\"", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{"st", "[", 
                   RowBox[{"[", 
                    RowBox[{"11", ";;", "13"}], "]"}], "]"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "6"}]}]}], "&&", 
                RowBox[{
                 RowBox[{"VectorAngle", "[", 
                  RowBox[{
                   RowBox[{"uLab", "[", "st", "]"}], ",", 
                   RowBox[{"#2", "[", "\"\<u\>\"", "]"}]}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "5"}]}]}], "&&", 
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"st", "[", 
                    RowBox[{"[", 
                    RowBox[{"4", ";;", "6"}], "]"}], "]"}], "-", "vpred"}], 
                  "]"}], "<", 
                 RowBox[{
                  RowBox[{"10", "^", 
                   RowBox[{"-", "6"}]}], 
                  RowBox[{"Max", "[", 
                   RowBox[{
                    RowBox[{"Norm", "[", "vpred", "]"}], ",", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}]}]}]}], ",", 
               RowBox[{"\"\<|omega| = \>\"", "<>", 
                RowBox[{"sci", "[", 
                 RowBox[{"Norm", "[", 
                  RowBox[{"st", "[", 
                   RowBox[{"[", 
                    RowBox[{"11", ";;", "13"}], "]"}], "]"}], "]"}], "]"}], 
                "<>", "\"\< rad/s, horizontal speed \>\"", "<>", 
                RowBox[{"num", "[", 
                 RowBox[{"1000", 
                  RowBox[{"Norm", "[", 
                   RowBox[{"st", "[", 
                    RowBox[{"[", 
                    RowBox[{"4", ";;", "5"}], "]"}], "]"}], "]"}]}], "]"}], 
                "<>", "\"\< mm/s\>\""}]}], "]"}]}]}], "]"}], "&"}], ",", 
         "hang"}], "]"}]}]}], "}"}], "]"}]}], "]"}]}], "Input",ExpressionUUID->\
"25160542-5cc5-4f62-ae55-6424d168c129"],

