Cell[CellGroupData[{

Cell["4. The four tensors", "Section",ExpressionUUID->"dc3733ab-f993-4c9e-a3b0-a20cd507bb90"],

Cell[TextData[{
 "The gas sees only the surface. Every stress therefore acts exactly as in \
Shape 1, about H, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"], "H"], " ", "=", " ", 
    SuperscriptBox[
     StyleBox["B",
      FontWeight->"Bold"], "H"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"9a3f199f-0e6c-4103-b85f-1c0e57712e35"],
 ". Moving the reference point from H to the CoM changes the lever arm, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], " ", "=", " ", "-", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"]}], TraditionalForm]],ExpressionUUID->
  "23a96011-e720-4e66-a7a7-fd91789c552e"],
 ", and the velocity of H, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "H"], " ", "=", " ", 
    StyleBox["v",
     FontWeight->"Bold"], " ", "+", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "\[Times]", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"]}], TraditionalForm]],ExpressionUUID->
  "c5ad5007-a65f-4f8a-a5de-b46bb3fe88eb"],
 ". The result is exact:"
}], "Text",ExpressionUUID->"9ced207a-d51b-428f-b30b-7034cc10c9af"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubsuperscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"], "H"], " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubsuperscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "H"], " ", ",", " ", "\:2003\:2003", " ", 
   StyleBox["B",
    FontWeight->"Bold"], " ", "=", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]"], " ", ",", " ", 
   "\:2003\:2003", " ", 
   SuperscriptBox[
    StyleBox["B",
     FontWeight->"Bold"], "\[Transpose]"], " ", "=", " ", "-", 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"aa894055-def3-473f-9a32-189129f33855"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "-", 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "\[ThickSpace]", "\[TildeTilde]", 
   "\[ThickSpace]", " ", "-", 
   SubscriptBox["\[Gamma]", "0"], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]"], " ", ",", " ", 
   "\:2003\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubsuperscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "H"], " ", "+", " ", 
   SubsuperscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]", "\[Transpose]"], 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "c"], "]"}], "\[Times]"]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"75d36ff2-dde9-40d2-818f-91f6f1ee55f5"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"], "H"], TraditionalForm]],ExpressionUUID->
  "8908afc6-4b74-4bf4-8afe-7a8ce2163163"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "H"], TraditionalForm]],ExpressionUUID->
  "4016cc34-81a1-42f2-bcfa-c794ad7c1654"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "H"], TraditionalForm]],ExpressionUUID->
  "ad2d8854-edff-4577-90ba-a820ede457d5"],
 " are the diagonal first-order forms of Shape 1. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "de519119-94ca-435c-ab77-3a086607f5e2"],
 " they are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "\[ThinSpace]", 
    StyleBox["diag",
     FontSlant->"Plain"], "[", "1", " ", "+", " ", 
    FractionBox[
     RowBox[{"2", "\[CurlyEpsilon]"}], "5"], "(", "2", "E", " ", "-", " ", 
    SubscriptBox["e", "i"], ")", "]"}], TraditionalForm]],ExpressionUUID->
  "d048bb57-733d-4aa9-87f1-5393f14adca4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "0"], "\[ThinSpace]", 
    StyleBox["diag",
     FontSlant->"Plain"], "[", "1", " ", "+", " ", 
    FractionBox[
     RowBox[{"2", "\[CurlyEpsilon]"}], "5"], "(", "3", "E", " ", "-", " ", 
    "4", 
    SubscriptBox["e", "i"], " ", "+", " ", "8", "(", "3", 
    SubscriptBox["e", "i"], " ", "-", " ", "E", ")", "/", "(", "8", " ", "+", 
    " ", "\[Pi]", ")", ")", "]"}], TraditionalForm]],ExpressionUUID->
  "d40ad841-e2f2-46da-9058-02cf130dc58c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "0"], "\[ThinSpace]", 
    StyleBox["diag",
     FontSlant->"Plain"], "[", "1", " ", "+", " ", 
    FractionBox[
     RowBox[{"4", "\[CurlyEpsilon]"}], "5"], "(", "2", "E", " ", "-", " ", 
    SubscriptBox["e", "i"], ")", "]"}], TraditionalForm]],ExpressionUUID->
  "f241ce9f-96b8-49fd-a38d-ed259044c1ae"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", " ", "=", " ", "\[Sum]", " ", 
    SubscriptBox["e", "i"]}], TraditionalForm]],ExpressionUUID->
  "3e0d835d-e475-4ad8-b0b4-cbae4b16852d"],
 ". The thermophoretic torque is ",
 StyleBox["antisymmetric",
  FontWeight->"Bold"],
 " to leading order: it is the moment about the CoM of a force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], " ", "G", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "b87c44c8-05bd-4d68-82a8-c364b4945072"],
 " applied at H. The check below compares the full numerical quadrature about \
the CoM with these shift formulas."
}], "Text",ExpressionUUID->"ef7a9769-6336-4120-bac9-68e027d93471"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"shiftRule", "[", 
    RowBox[{"p0_", ",", "rc_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b", "=", 
        RowBox[{"p0", "[", "\"\<blocks\>\"", "]"}]}], ",", 
       RowBox[{"X", "=", 
        RowBox[{"hat", "[", "rc", "]"}]}]}], "}"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<f_th\>\"", "->", 
        RowBox[{"b", "[", "\"\<f_th\>\"", "]"}]}], ",", 
       RowBox[{"\"\<f_drag\>\"", "->", 
        RowBox[{"b", "[", "\"\<f_drag\>\"", "]"}]}], ",", 
       RowBox[{"\"\<B\>\"", "->", 
        RowBox[{
         RowBox[{"b", "[", "\"\<f_drag\>\"", "]"}], ".", "X"}]}], ",", 
       RowBox[{"\"\<Bt\>\"", "->", 
        RowBox[{"-", 
         RowBox[{"X", ".", 
          RowBox[{"b", "[", "\"\<f_drag\>\"", "]"}]}]}]}], ",", 
       RowBox[{"\"\<T_th\>\"", "->", 
        RowBox[{"-", 
         RowBox[{"X", ".", 
          RowBox[{"b", "[", "\"\<f_th\>\"", "]"}]}]}]}], ",", 
       RowBox[{"\"\<T_drag\>\"", "->", 
        RowBox[{
         RowBox[{"b", "[", "\"\<T_drag\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"Transpose", "[", "X", "]"}], ".", 
          RowBox[{"b", "[", "\"\<f_drag\>\"", "]"}], ".", "X"}]}]}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"KeyValueMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sr", "=", 
          RowBox[{"shiftRule", "[", 
           RowBox[{"pt0", ",", 
            RowBox[{"#2", "[", "\"\<com\>\"", "]"}]}], "]"}]}], ",", 
         RowBox[{"b", "=", 
          RowBox[{"#2", "[", "\"\<blocks\>\"", "]"}]}]}], "}"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"\"\<shift \>\"", "<>", "#1"}], 
         ",", "\"\<quadrature tensors about the CoM equal the shift of the \
Shape 1 tensors\>\"", ",", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<f_th\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<f_th\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"pt0", "[", "\"\<gamma0\>\"", "]"}]}], ",", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<f_drag\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<f_drag\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"pt0", "[", "\"\<xi0\>\"", "]"}]}], ",", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<B\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<B\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pt0", "[", "\"\<xi0\>\"", "]"}], "ell"}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<Bt\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<Bt\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pt0", "[", "\"\<xi0\>\"", "]"}], "ell"}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<T_th\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<T_th\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pt0", "[", "\"\<gamma0\>\"", "]"}], "ell"}], ")"}]}], 
            ",", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"b", "[", "\"\<T_drag\>\"", "]"}], "-", 
               RowBox[{"sr", "[", "\"\<T_drag\>\"", "]"}]}], "]"}], "/", 
             RowBox[{"pt0", "[", "\"\<c0\>\"", "]"}]}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}]}], "]"}]}], "]"}], "&"}], ",", "pts"}], 
   "]"}], "]"}]}], "Input",ExpressionUUID->"2c14021e-e54a-448e-bf01-\
871ba9ef755a"],

