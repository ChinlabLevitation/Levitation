Cell[CellGroupData[{

Cell["3. Diagram", "Section",ExpressionUUID->"7cbe4ffd-4fb5-4933-81ba-e8a3e7fe723b"],

Cell[TextData[{
 "Each panel shows the body coloured by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "-", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "5332f63f-f93e-4c80-abce-60be5df28116"],
 " (red is long), the geometric centre H (black) and the CoM (magenta). The \
magenta arrow is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "c"], TraditionalForm]],ExpressionUUID->
  "1b9698a5-676e-4dc3-9311-9ca9cad6c1bd"],
 " drawn 5 times longer than scale. In the chiral case the arrow leans out of \
every principal plane."
}], "Text",ExpressionUUID->"7dc79187-cced-4822-8c14-b6e4651ebbc2"],

