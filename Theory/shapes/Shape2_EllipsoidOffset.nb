Notebook[{

Cell[CellGroupData[{
Cell["Shape 2: an ellipsoid with an offset centre of mass", "Title",ExpressionUUID->"1778923a-c492-4699-89f0-973b757439fd"],

Cell["\<\
Does moving the CoM off the centre of force, in any direction, give the \
chirality needed for orbits?\
\>", "Subtitle",ExpressionUUID->"9da410d4-dbe7-4b19-948b-e0150921fca5"],

Cell[TextData[{
 "The body is the near-spherical ellipsoid of Shape 1, now with a small \
linear density gradient that moves the centre of mass (CoM) off the geometric \
centre H. Since the ellipsoid is centrosymmetric, H is also its centre of \
force. As before, the gradient is uniform, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "356d9f40-a6cc-4bb7-bd30-16a3c807b1f6"],
 ", with no trap. The response ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    StyleBox["F",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Tau]",
     FontWeight->"Bold"], ")", " ", "=", " ", "-", "\[ScriptCapitalR]", "\[CenterDot]",
     "(", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", ",", " ", 
    StyleBox["v",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "5fede387-38d3-4b59-8e65-a7c71fb5b8a0"],
 " is taken about the CoM."
}], "Text",ExpressionUUID->"4bb6de6f-c9c1-4582-bb5b-5478a711f686"],

Cell[TextData[{
 StyleBox["Results in brief.",
  FontWeight->"Bold"],
 " (1) An offset along a principal axis gives symmetry ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    RowBox[{"2", "v"}]], TraditionalForm]],ExpressionUUID->
  "01b1f988-e288-4778-8436-6f5cebc5cd87"],
 ", and an offset in a principal plane gives ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "s"], TraditionalForm]],ExpressionUUID->
  "05ccefaf-f2d5-43ec-a4ef-5cf60999b687"],
 ". On a triaxial ellipsoid an offset in a generic direction leaves no \
symmetry at all (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "d5843b19-87fd-45a6-8240-76d529e62b64"],
 "), so the particle ",
 StyleBox["is chiral",
  FontWeight->"Bold"],
 ". (2) All four tensors follow exactly from those of Shape 1 by a rigid \
shift. In particular ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "d602c917-34fe-4a06-b14d-0ca1355748f2"],
 ". (3) This chirality is invisible to the gas. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "9186efe1-31d2-4bff-96af-a8006d52e1b3"],
 " never has a real non-zero eigenvalue, whatever the offset direction. The \
reason: at levitation the net gas force is vertical and acts through H, so it \
has no moment about the vertical. (4) The particle hangs with its CoM below \
H, as a damped pendulum, and then ",
 StyleBox["glides in a straight line",
  FontWeight->"Bold"],
 " (offset in a mirror plane or generic) or hovers (offset along an axis). \
(5) There is ",
 StyleBox["no orbit",
  FontWeight->"Bold"],
 " for any offset: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"348f3c16-84d6-4c4b-be01-7fba1e2a83e8"],
 " and there is no period."
}], "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.35, 0.55, 0.85],
 Background->RGBColor[
  0.96, 0.97, 1.],ExpressionUUID->"2e0dbc83-9da9-4233-bb9f-91841501a063"],

Cell[CellGroupData[{

Cell["1. Setup", "Section",ExpressionUUID->"cc60cafe-aaae-474a-a6da-bc75ae8eea0a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shapesDir", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "$Failed"}], "]"}]}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"StringQ", "[", "shapesDir", "]"}]}], ",", 
    RowBox[{"shapesDir", "=", 
     RowBox[{"Environment", "[", "\"\<SHAPES_DIR\>\"", "]"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"shapesDir", ",", "\"\<ShapeLevitation.wl\>\""}], "}"}], "]"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$verifications", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"record", "[", 
    RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"$verifications", ",", 
       RowBox[{"{", 
        RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "}"}]}], 
      "]"}], ";", 
     RowBox[{"VR", "[", 
      RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "]"}]}], 
    ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VR", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"VR", "[", 
      RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], 
     ",", "fmt_"}], "]"}], ":=", 
   RowBox[{"ToBoxes", "[", 
    RowBox[{
     RowBox[{"Panel", "[", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"status", ",", "Bold", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"status", "==", "\"\<VERIFIED\>\""}], ",", 
                RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "]"}]}], 
             "]"}], ",", "\"\<   \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"ref", ",", "Bold"}], "]"}], ",", "\"\<:  \>\"", ",", 
            "claim"}], "}"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"detail", "===", "\"\<\>\""}], ",", "Nothing", ",", 
           "detail"}], "]"}]}], "}"}], "]"}], "]"}], ",", "fmt"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"check", "[", 
    RowBox[{"ref_String", ",", "claim_String", ",", "test_", ",", 
     RowBox[{"detail_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"record", "[", 
    RowBox[{"ref", ",", "claim", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "test", "]"}], ",", "\"\<VERIFIED\>\"", 
       ",", "\"\<DISCREPANCY\>\""}], "]"}], ",", "detail"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "expr_", "]"}], ":=", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"Simplify", "[", "expr", "]"}], "}"}], "]"}], ",", 
     "PossibleZeroQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sci", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"Log10", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], "/", 
            RowBox[{"10", "^", "e"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}], "<>", "\"\<e\>\"",
         "<>", 
        RowBox[{"ToString", "[", "e", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"num", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"d_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "!=", "0"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], ">=", 
         RowBox[{"10", "^", "5"}]}]}], ")"}]}], ",", 
     RowBox[{"sci", "[", "x", "]"}], ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", "d"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vec", "[", 
    RowBox[{"v_", ",", 
     RowBox[{"d_", ":", "3"}]}], "]"}], ":=", 
   RowBox[{"\"\<(\>\"", "<>", 
    RowBox[{"StringRiffle", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"num", "[", 
         RowBox[{"#", ",", "d"}], "]"}], "&"}], "/@", "v"}], 
      ",", "\"\<, \>\""}], "]"}], "<>", "\"\<)\>\""}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", "[", "m_", "]"}], ":=", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"MatrixForm", "[", "m", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gas", "=", 
   RowBox[{"gasModel", "[", "]"}]}], ";", 
  RowBox[{"ell", "=", "20*^-6"}], ";", 
  RowBox[{"rhoP", "=", "1000."}], ";"}]}], "Input",ExpressionUUID->"0dfd8609-\
40e4-4b9a-a776-d1a032710fe4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. The shape and the mass distribution", "Section",ExpressionUUID->"f1ccef6e-6c25-4afc-bc62-95278b48453f"],

Cell[TextData[{
 "The surface is the ellipsoid of Shape 1, with semi-axes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], " ", "=", " ", "1", " ", "+", " ", 
    "\[CurlyEpsilon]", " ", 
    SubscriptBox["e", "i"]}], TraditionalForm]],ExpressionUUID->
  "ba794490-7089-43f0-b464-9de7a93d69db"],
 " (units of ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "91fb8c0c-2206-4752-b459-932e31d5cc3a"],
 "), defaults ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"08cd2da0-580f-4a6f-8570-12cf61563a8f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "e", " ", "=", " ", "(", "1", ",", " ", "0", ",", " ", "-", "1", ")"}], 
   TraditionalForm]],ExpressionUUID->"5046bbcd-03d0-4195-b16c-4bf8bc7ba883"],
 ". The density is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "p"], "(", "1", " ", "+", " ", "\[Kappa]", "\[ThinSpace]", 
    OverscriptBox["d", "^"], "\[CenterDot]", 
    StyleBox["r",
     FontWeight->"Bold"], "/", "l", ")"}], TraditionalForm]],ExpressionUUID->
  "219abf23-ec3f-48a1-a2a3-e0b04db780bf"],
 ", with unit direction ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["d", "^"], TraditionalForm]],ExpressionUUID->
  "0e56b6a5-2a41-4408-9056-d8b3184ab326"],
 " and strength ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]],ExpressionUUID->
  "c120e79c-d6c6-4c3a-9fab-80c5d869c606"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ContourIntegral]", " ", 
    SubscriptBox["r", "i"], 
    SubscriptBox["r", "j"], "\[ThinSpace]", "d", "V", " ", "=", " ", 
    FractionBox["V", "5"], 
    SubsuperscriptBox["a", "i", "2"], 
    SuperscriptBox["l", "2"], 
    SubscriptBox["\[Delta]", 
     RowBox[{"i", "j"}]]}], TraditionalForm]],ExpressionUUID->
  "e9e36e87-5b51-40aa-ac73-a619036088c0"],
 " for an ellipsoid, the CoM sits at"
}], "Text",ExpressionUUID->"eebee237-5a55-4ec3-bacf-e1d881ee9209"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "c"], " ", "=", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Kappa]", "l"}], "5"], "\[ThinSpace]", 
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], "(", 
     RowBox[{
      SubsuperscriptBox["a", "1", "2"], ",", " ", 
      SubsuperscriptBox["a", "2", "2"], ",", " ", 
      SubsuperscriptBox["a", "3", "2"]}], ")"}], "\[ThinSpace]", 
    OverscriptBox["d", "^"], " ", "\:2003\:2003", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       StyleBox[
        RowBox[{
         RowBox[{"exact", ";"}], " "}],
        FontSlant->"Plain"], " ", "|", 
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold"], "c"], "|", " ", 
       RowBox[{"\[TildeTilde]", " ", 
        RowBox[{"0.1", "l"}]}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"2", "\[ThinSpace]", "\[Mu]", 
        StyleBox["m",
         FontSlant->"Plain"], "\[ThickSpace]", 
        StyleBox["for",
         FontSlant->"Plain"], "\[ThickSpace]", "\[Kappa]"}], " ", "=", " ", 
       "0.5"}]}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"c624fce2-0831-412b-8280-c7f22dc7c080"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a1", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e1"}]}]}], ";", 
  RowBox[{"a2", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e2"}]}]}], ";", 
  RowBox[{"a3", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rellipsoid", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", 
       RowBox[{"a1", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"y", "^", "2"}], "/", 
       RowBox[{"a2", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"z", "^", "2"}], "/", 
       RowBox[{"a3", "^", "2"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"density", "[", 
    RowBox[{"r_", ",", "dhat_", ",", "kappa_"}], "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"kappa", 
     RowBox[{"dhat", ".", "r"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"defaults", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"eps", "->", 
      RowBox[{"1", "/", "10"}]}], ",", 
     RowBox[{"e1", "->", "1"}], ",", 
     RowBox[{"e2", "->", "0"}], ",", 
     RowBox[{"e3", "->", 
      RowBox[{"-", "1"}]}]}], "}"}]}], ";", 
  RowBox[{"kappa0", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rnum", "[", "nn_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Rellipsoid", "[", "nn", "]"}], "/.", "defaults"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"offsets", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<along x (C2v)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"\"\<in the x-z plane (Cs)\>\"", "->", 
      RowBox[{"Normalize", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
     RowBox[{"\"\<generic (C1, chiral)\>\"", "->", 
      RowBox[{"Normalize", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<R(n) = \>\"", ",", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"Rellipsoid", "[", "n", "]"}], "]"}], 
    ",", "\"\<,   rho/rho_p = \>\"", ",", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"density", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"X", ",", "Y", ",", "Z"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"d1", ",", "d2", ",", "d3"}], "}"}], ",", "kappa"}], "]"}], 
     "]"}], ",", "\"\<,   defaults \>\"", ",", "defaults", 
    ",", "\"\<, kappa = \>\"", ",", "kappa0"}], "}"}], "]"}]}], "Input",Expres\
sionUUID->"2d0a68c4-3292-41f0-badc-1c5b297e0b82"],

Cell[BoxData[
 TemplateBox[{"\"R(n) = \"", 
   TagBox[
    FormBox[
     FractionBox["1", 
      SqrtBox[
       RowBox[{
         FractionBox[
          SuperscriptBox["x", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e1", " ", "eps"}], "+", "1"}], ")"}], "2"]], "+", 
         FractionBox[
          SuperscriptBox["y", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e2", " ", "eps"}], "+", "1"}], ")"}], "2"]], "+", 
         FractionBox[
          SuperscriptBox["z", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e3", " ", "eps"}], "+", "1"}], ")"}], "2"]]}]]], 
     TraditionalForm], TraditionalForm, Editable -> True], 
   "\",   rho/rho_p = \"", 
   TagBox[
    FormBox[
     RowBox[{
       RowBox[{"kappa", " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"d1", " ", "X"}], "+", 
             RowBox[{"d2", " ", "Y"}], "+", 
             RowBox[{"d3", " ", "Z"}]}], ")"}]}], "+", "1"}], 
     TraditionalForm], TraditionalForm, Editable -> True], 
   "\",   defaults \"", 
   RowBox[{"{", 
     RowBox[{
       RowBox[{"eps", "\[Rule]", 
         FractionBox["1", "10"]}], ",", 
       RowBox[{"e1", "\[Rule]", "1"}], ",", 
       RowBox[{"e2", "\[Rule]", "0"}], ",", 
       RowBox[{"e3", "\[Rule]", 
         RowBox[{"-", "1"}]}]}], "}"}], "\", kappa = \"", "0.5`"},
  "RowDefault"]], "Output",ExpressionUUID->"55af8b9d-5f5d-4d72-a644-\
0f47e007b7c7"]
}, Open  ]],

Cell["\<\
Three offset directions represent the three symmetry classes that an offset \
can produce on a triaxial ellipsoid:\
\>", "Text",ExpressionUUID->"14023bf8-5ce9-4a27-9e3e-8a5c5d3dbe14"],

Cell[TextData[Cell[BoxData[GridBox[{
   {
    RowBox[{
     RowBox[{"offset", " ", "direction", " "}], 
     FormBox[
      OverscriptBox["d", "^"],
      TraditionalForm]}], 
    RowBox[{
     RowBox[{"symmetry", " ", "of", " ", "body"}], " ", "+", " ", "mass"}], 
    RowBox[{"surviving", " ", "elements"}], 
    RowBox[{"chiral", "?"}]},
   {
    RowBox[{
     RowBox[{
      RowBox[{"along", " ", "a", " ", "principal", " ", "axis"}], ",", " ", 
      RowBox[{"e", ".", "g", ".", " "}]}], 
     FormBox[
      OverscriptBox["x", "^"],
      TraditionalForm]}], 
    FormBox[
     SubscriptBox["C", 
      RowBox[{"2", "v"}]],
     TraditionalForm], 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "two"}], "-", 
      RowBox[{"fold", " ", "axis", " ", "along", " "}]}], 
     FormBox[
      OverscriptBox["d", "^"],
      TraditionalForm], 
     RowBox[{" ", 
      RowBox[{
      "and", " ", "two", " ", "mirror", " ", "planes", " ", "containing", " ",
        "it"}]}]}], "no"},
   {
    RowBox[{
     RowBox[{
      RowBox[{"in", " ", "a", " ", "principal", " ", "plane"}], ",", " ", 
      RowBox[{"e", ".", "g", ".", " "}]}], 
     FormBox[
      RowBox[{"(", 
       OverscriptBox["x", "^"], " ", "+", " ", 
       OverscriptBox["z", "^"], ")", "/", 
       SqrtBox["2"]}],
      TraditionalForm]}], 
    FormBox[
     SubscriptBox["C", "s"],
     TraditionalForm], 
    RowBox[{
     RowBox[{"the", " ", "mirror", " ", "plane", " ", "containing", " "}], 
     FormBox[
      OverscriptBox["d", "^"],
      TraditionalForm]}], "no"},
   {
    RowBox[{
     RowBox[{"generic", ",", " ", 
      RowBox[{"e", ".", "g", ".", " "}]}], 
     FormBox[
      RowBox[{"(", "1", ",", " ", "2", ",", " ", "3", ")", "/", 
       SqrtBox["14"]}],
      TraditionalForm]}], 
    FormBox[
     SubscriptBox["C", "1"],
     TraditionalForm], "none", 
    RowBox[{"**", "yes", "**"}]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxBackground->{"Rows" -> {
      RGBColor[0.9, 0.93, 0.97], None}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}]],
 FontFamily->
  "Source Sans Pro",ExpressionUUID->"4b89f4cf-4a17-4ec2-a21c-04bd9532f306"]], \
"Text",ExpressionUUID->"bbc1b2e7-c756-4eb8-9031-a0f5f9da418a"],

Cell[TextData[{
 "(For a spheroid, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], " ", "=", " ", 
    SubscriptBox["a", "2"]}], TraditionalForm]],ExpressionUUID->
  "0ad54fd0-f619-4f13-8d80-ada043e72759"],
 ", even a generic offset leaves the mirror plane that contains the symmetry \
axis and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["d", "^"], TraditionalForm]],ExpressionUUID->
  "41e9a34c-53d6-49e5-a9a7-440226984555"],
 ". So only a triaxial ellipsoid can be made chiral this way.) Next, build \
the three particles by numerical quadrature, and check the CoM formula and \
convexity."
}], "Text",ExpressionUUID->"de0e0f82-0be8-4c09-8e5a-6c05c477515d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pts", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "->", 
        RowBox[{"makeParticle", "[", 
         RowBox[{"Rnum", ",", "ell", ",", "rhoP", ",", "gas", ",", 
          RowBox[{"Function", "[", 
           RowBox[{"r", ",", 
            RowBox[{"density", "[", 
             RowBox[{"r", ",", "#2", ",", "kappa0"}], "]"}]}], "]"}]}], 
         "]"}]}], "&"}], ",", "offsets"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pt0", "=", 
   RowBox[{"makeParticle", "[", 
    RowBox[{"Rnum", ",", "ell", ",", "rhoP", ",", "gas"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rcExact", "[", "dhat_", "]"}], ":=", 
   RowBox[{"kappa0", 
    RowBox[{"ell", "/", "5"}], 
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}], "^", "2"}], "/.", 
        "defaults"}], "]"}], "]"}], ".", "dhat"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"check", "[", 
      RowBox[{"\"\<convex\>\"", ",", "\"\<the surface (Shape 1) is convex\>\"",
        ",", 
       RowBox[{
        RowBox[{"convexityMargin", "[", "Rnum", "]"}], ">", "0"}]}], "]"}], 
     "}"}], ",", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"\"\<CoM \>\"", "<>", "#1"}], 
         ",", "\"\<CoM = (kappa l/5) diag(a_i^2).d\>\"", ",", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"#2", "[", "\"\<com\>\"", "]"}], "-", 
            RowBox[{"rcExact", "[", 
             RowBox[{"offsets", "[", "#1", "]"}], "]"}]}], "]"}], "<", 
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}], "ell"}]}], ",", 
         RowBox[{"\"\<r_c/l = \>\"", "<>", 
          RowBox[{"vec", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "[", "\"\<com\>\"", "]"}], "/", "ell"}], ",", 
            "4"}], "]"}]}]}], "]"}], "&"}], ",", "pts"}], "]"}]}], "]"}], 
  "]"}]}], "Input",ExpressionUUID->"8dce52f0-40ce-4ab5-8a13-cc958e4ea637"],

