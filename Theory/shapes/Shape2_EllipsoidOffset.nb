Cell[CellGroupData[{

Cell["6. Steady states: hang, then glide or hover", "Section",ExpressionUUID->"4e339e89-1f1c-4cbb-87cb-779abc074482"],

Cell[TextData[{
 "With no spin available, the steady states are non-rotating. The solver ",
 StyleBox["steadyMotions",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " imposes exact body-frame balance of force and torque, including the drag \
torque of the glide velocity about the CoM (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["B",
      FontWeight->"Bold"], "\[Transpose]"], 
    StyleBox["v",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "5627b561-7a62-4c59-83eb-e044aa92809e"],
 "), together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], "\[CenterDot]", 
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"56518afd-4fc1-4a00-88fe-fce8a591edad"],
 ". It then linearises the full rigid-body equations about each solution. For \
each offset it finds two states: CoM below H (stable) and CoM above H \
(unstable)."
}], "Text",ExpressionUUID->"2e38266a-d9d5-40ca-a3b8-6c9de109a869"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"steady", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "->", 
        RowBox[{"steadyMotions", "[", "#2", "]"}]}], "&"}], ",", "pts"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hang", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "->", 
        RowBox[{"First", "@", 
         RowBox[{"Select", "[", 
          RowBox[{"#2", ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}]}], 
       "&"}], ",", "steady"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", 
          RowBox[{"vec", "[", 
           RowBox[{"Chop", "[", 
            RowBox[{
             RowBox[{"#2", "[", "\"\<u\>\"", "]"}], ",", 
             RowBox[{"10", "^", 
              RowBox[{"-", "9"}]}]}], "]"}], "]"}], ",", 
          RowBox[{"num", "[", 
           RowBox[{"#2", "[", "\"\<Omega\>\"", "]"}], "]"}], ",", 
          RowBox[{"num", "[", 
           RowBox[{"1000", 
            RowBox[{"Chop", "[", 
             RowBox[{
              RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}], ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "9"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}], ">", 
             RowBox[{"10", "^", 
              RowBox[{"-", "9"}]}]}], ",", 
            RowBox[{"vec", "[", 
             RowBox[{"Normalize", "[", 
              RowBox[{
               RowBox[{"#2", "[", "\"\<v_body\>\"", "]"}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"#2", "[", "\"\<v_body\>\"", "]"}], ".", 
                  RowBox[{"#2", "[", "\"\<u\>\"", "]"}]}], ")"}], 
                RowBox[{"#2", "[", "\"\<u\>\"", "]"}]}]}], "]"}], "]"}], 
            ",", "\"\<-\>\""}], "]"}], ",", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Im", "[", 
               RowBox[{"#2", "[", "\"\<rates\>\"", "]"}], "]"}], "]"}], "]"}],
             "/", 
            RowBox[{"(", 
             RowBox[{"2", "Pi"}], ")"}]}], "]"}]}], "}"}], "&"}], ",", 
       "hang"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<offset\>\"", ",", "\"\<u = lab Z in body axes\>\"", 
       ",", "\"\<Omega (rad/s)\>\"", ",", "\"\<glide (mm/s)\>\"", 
       ",", "\"\<glide direction (body)\>\"", 
       ",", "\"\<pendulum f (Hz)\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "Input",ExpressionUUID->\
"314aee08-3d8d-4f88-b6b9-629c44d16078"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"offset\"\>", "\<\"u = lab Z in body axes\"\>", "\<\"Omega (rad/s)\"\
\>", "\<\"glide (mm/s)\"\>", "\<\"glide direction (body)\"\>", "\<\"pendulum \
f (Hz)\"\>"},
    {"\<\"along x (C2v)\"\>", "\<\"(-1., 0., 0.)\"\>", "\<\"0.\"\>", \
"\<\"0.\"\>", "\<\"-\"\>", "\<\"60.34\"\>"},
    {"\<\"in the x-z plane (Cs)\"\>", "\<\"(-0.831, 0., -0.556)\"\>", "\<\"0.\
\"\>", "\<\"1.406\"\>", "\<\"(0.556, -4.11e-17, -0.831)\"\>", "\<\"53.83\"\>"},
    {"\<\"generic (C1, chiral)\"\>", "\<\"(-0.359, -0.593, -0.721)\"\>", \
"\<\"0.\"\>", "\<\"1.113\"\>", "\<\"(0.691, 0.351, -0.632)\"\>", "\<\"51.91\"\
\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"5d2ebd0a-7685-4efe-be42-f7531b6d9c49"]
}, Open  ]],

Cell[TextData[{
 "The hanging vertical is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "-", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "^"], "c"]}], TraditionalForm]],ExpressionUUID->
  "e1eb24c5-739f-4834-ab2b-71a47c3f4adc"],
 ", with the CoM straight below H. The reason: in steady state the total gas \
force equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "g", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "6c8bb149-b781-4959-bc5c-c32a1cb27d46"],
 " and acts through H, so its moment about the CoM vanishes only if H lies on \
the vertical through the CoM. (The zero eigenvector of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "a5a7d2f0-133c-4ab3-90e9-db40e5d5b650"],
 " alone, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "\[DoubleVerticalBar]", " ", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"]}], TraditionalForm]],ExpressionUUID->
  "0926d12d-2084-4c7e-bd55-365b6ccdc7ba"],
 ", differs slightly. The drag torque of the glide, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["B",
      FontWeight->"Bold"], "\[Transpose]"], 
    StyleBox["v",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "b2ab4b6f-877d-4cb1-b3e6-9f8ea74d530d"],
 ", makes up the difference.) For the axial offset ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a52e10fb-5721-40a5-ab30-aacf649e6daf"],
 " is a principal axis and the particle hovers. For the in-plane and generic \
offsets it glides, at the speed Shape 1 predicts for that orientation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], " ", "\[TildeTilde]", " ", "(", "M", 
    "g", "/", 
    SubscriptBox["\[Xi]", "0"], ")", 
    SubscriptBox[
     RowBox[{"[", "(", 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold"], 
       StyleBox["th",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[Gamma]", "0"], " ", "-", " ", 
      StyleBox["I",
       FontWeight->"Bold"], ")", 
      StyleBox["u",
       FontWeight->"Bold"], "]"}], "\[UpTee]"]}], TraditionalForm]],
  ExpressionUUID->"db19ecf3-7ec6-4c95-bc2d-4fb060c81ab4"],
 ". In the mirror-symmetric (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "s"], TraditionalForm]],ExpressionUUID->
  "f3e44f76-48c2-4f18-a6f5-1d096859ca73"],
 ") case the glide stays in the mirror plane. In the chiral (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "4737249d-4db7-4c1f-be2b-c9b87067e8f2"],
 ") case it points in a generic direction. It is still a straight line."
}], "Text",ExpressionUUID->"cc12cdbf-843f-481c-9302-6ce1953df451"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"u", "=", 
            RowBox[{"#2", "[", "\"\<u\>\"", "]"}]}], ",", 
           RowBox[{"rc", "=", 
            RowBox[{
             RowBox[{"pts", "[", "#1", "]"}], "[", "\"\<com\>\"", "]"}]}], ",", 
           RowBox[{"p", "=", 
            RowBox[{"pts", "[", "#1", "]"}]}], ",", "lo"}], "}"}], ",", 
         RowBox[{
          RowBox[{"lo", "=", 
           RowBox[{
            RowBox[{"p", "[", "\"\<M\>\"", "]"}], 
            RowBox[{"$gEarth", "/", 
             RowBox[{"p", "[", "\"\<xi0\>\"", "]"}]}], 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"w", "=", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], 
                    "[", "\"\<f_th\>\"", "]"}], "/", 
                    RowBox[{"p", "[", "\"\<gamma0\>\"", "]"}]}], "-", 
                   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ")"}], ".", 
                 "u"}]}], "}"}], ",", 
              RowBox[{"Norm", "[", 
               RowBox[{"w", "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"w", ".", "u"}], ")"}], "u"}]}], "]"}]}], "]"}]}]}],
           ";", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"\"\<hang \>\"", "<>", "#1"}], 
            ",", "\"\<stable state: Omega = 0, CoM exactly below H, glide \
speed matches the first-order formula\>\"", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#2", "[", "\"\<Omega\>\"", "]"}], "==", "0"}], "&&", 
             RowBox[{
              RowBox[{"u", ".", "rc"}], "<", "0"}], "&&", 
             RowBox[{
              RowBox[{"VectorAngle", "[", 
               RowBox[{"u", ",", 
                RowBox[{"-", "rc"}]}], "]"}], "<", 
              RowBox[{"10", "^", 
               RowBox[{"-", "6"}]}]}], "&&", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}], "-", "lo"}], "]"}],
               "<", 
              RowBox[{
               RowBox[{"0.1", "lo"}], "+", 
               RowBox[{"10", "^", 
                RowBox[{"-", "9"}]}]}]}]}], ",", 
            RowBox[{"\"\<angle between u and -r_c: \>\"", "<>", 
             RowBox[{"num", "[", 
              RowBox[{
               RowBox[{"VectorAngle", "[", 
                RowBox[{"u", ",", 
                 RowBox[{"-", "rc"}]}], "]"}], "/", "Degree"}], "]"}], 
             "<>", "\"\< deg; glide \>\"", "<>", 
             RowBox[{"num", "[", 
              RowBox[{"1000", 
               RowBox[{"#2", "[", "\"\<vperp\>\"", "]"}]}], "]"}], 
             "<>", "\"\< mm/s, formula \>\"", "<>", 
             RowBox[{"num", "[", 
              RowBox[{"1000", "lo"}], "]"}], "<>", "\"\< mm/s\>\""}]}], 
           "]"}]}]}], "]"}], "&"}], ",", "hang"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{"\"\<mirror\>\"", 
        ",", "\"\<Cs offset: the glide lies in the mirror plane (y-component \
zero)\>\"", ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hang", "[", "\"\<in the x-z plane (Cs)\>\"", "]"}], 
            "[", "\"\<v_body\>\"", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}]}]}], "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<unstable\>\"", 
        ",", "\"\<each offset also has an inverted state (CoM above H), which \
is unstable\>\"", ",", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Values", "[", "steady", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Count", "[", 
             RowBox[{"#", ",", 
              RowBox[{"s_", "/;", 
               RowBox[{"!", 
                RowBox[{"s", "[", "\"\<stable\>\"", "]"}]}]}]}], "]"}], ">=", 
            "1"}], "&"}]}], "]"}]}], "]"}]}], "}"}]}], "]"}], "]"}]], "Input",\
ExpressionUUID->"488d69ec-fe2a-4975-8dee-3bf05dcd0964"],

