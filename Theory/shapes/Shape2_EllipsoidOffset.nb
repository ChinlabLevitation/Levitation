 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "335d9878-81a3-4440-a4d2-105a6119fc97"],
 "^-1 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "27b01a28-ef3e-4df0-9f0d-70f9e6b94da3"],
 " are 0 and a complex pair ~ +-i \[Gamma]0 |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    StyleBox["c",
