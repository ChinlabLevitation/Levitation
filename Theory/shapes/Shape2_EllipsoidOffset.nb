        RowBox[{
         RowBox[{"$verifications", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", "\"\<VERIFIED\>\""}],
         "]"}], ",", "\"\< verified)\>\""}], "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"$verifications", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<item\>\"", ",", "\"\<statement\>\"", 
           ",", "\"\<result\>\""}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"c677c43b-544d-440a-9214-0144d757f0bf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"checks: \"", "19", "\"  (\"", "19", "\" verified)\""},
      "RowDefault"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"item\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"statement\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"result\"\>",
          StripOnInput->False,
          FontWeight->Bold]},
        {"\<\"convex\"\>", "\<\"the surface (Shape 1) is convex\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"CoM along x (C2v)\"\>", "\<\"CoM = (kappa l/5) \
diag(a_i^2).d\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"CoM in the x-z plane (Cs)\"\>", "\<\"CoM = (kappa l/5) \
diag(a_i^2).d\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"CoM generic (C1, chiral)\"\>", "\<\"CoM = (kappa l/5) \
diag(a_i^2).d\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"shift along x (C2v)\"\>", "\<\"quadrature tensors about the CoM \
equal the shift of the Shape 1 tensors\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"shift in the x-z plane (Cs)\"\>", "\<\"quadrature tensors about \
the CoM equal the shift of the Shape 1 tensors\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"shift generic (C1, chiral)\"\>", "\<\"quadrature tensors about \
the CoM equal the shift of the Shape 1 tensors\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"symbolic\"\>", "\<\"T_th = -[r_c]x f_th through O(eps^2), with \
r_c = (eps/5)(k_i (1 + 2 eps e_i))\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"spectrum along x (C2v)\"\>", "\<\"eigenvalues of T_drag^-1 T_th \
are 0 and a complex pair ~ +-i gamma0 |r_c|/c0\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"spectrum in the x-z plane (Cs)\"\>", "\<\"eigenvalues of \
T_drag^-1 T_th are 0 and a complex pair ~ +-i gamma0 |r_c|/c0\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"spectrum generic (C1, chiral)\"\>", "\<\"eigenvalues of \
T_drag^-1 T_th are 0 and a complex pair ~ +-i gamma0 |r_c|/c0\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"hang along x (C2v)\"\>", "\<\"stable state: Omega = 0, CoM \
exactly below H, glide speed matches the first-order formula\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"hang in the x-z plane (Cs)\"\>", "\<\"stable state: Omega = 0, \
CoM exactly below H, glide speed matches the first-order formula\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"hang generic (C1, chiral)\"\>", "\<\"stable state: Omega = 0, \
CoM exactly below H, glide speed matches the first-order formula\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"mirror\"\>", "\<\"Cs offset: the glide lies in the mirror plane \
(y-component zero)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"unstable\"\>", "\<\"each offset also has an inverted state (CoM \
above H), which is unstable\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"run along x (C2v)\"\>", "\<\"after 1 s: no spin, orientation = \
hanging state, velocity = steady prediction\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"run in the x-z plane (Cs)\"\>", "\<\"after 1 s: no spin, \
orientation = hanging state, velocity = steady prediction\"\>", "\<\"VERIFIED\
\"\>"},
        {"\<\"run generic (C1, chiral)\"\>", "\<\"after 1 s: no spin, \
orientation = hanging state, velocity = steady prediction\"\>", "\<\"VERIFIED\
\"\>"}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
           GrayLevel[0.85]}},
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"ec6f895d-0f85-42a9-981c-9ae815eb7bc8"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Shape.",
  FontWeight->"Bold"],
 " ",
 StyleBox["Rellipsoid",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " of Shape 1 with density ",
 StyleBox["1 + kappa dhat.r",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 ". Defaults: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"d1031f11-8ca2-4a52-90ab-ef1e0b865a0a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "e", " ", "=", " ", "(", "1", ",", " ", "0", ",", " ", "-", "1", ")"}], 
   TraditionalForm]],ExpressionUUID->"4aa71e86-d407-4f96-99f9-a1b7ae4b66fb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", "=", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"546fcc3b-9200-4fb4-b598-cae9f3327487"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"], "|", " ", "\[TildeTilde]", " ", "2", "\[ThinSpace]",
     "\[Mu]"}], TraditionalForm]],ExpressionUUID->
  "d6b58967-31d1-44f9-ae37-7fa09a0a7689"],
 "m)."
}], "Item",ExpressionUUID->"614cd267-3fff-4ec9-a79b-89b618d8cedc"],

Cell[TextData[{
 StyleBox["Tensors.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7e9f197d-778a-49c6-8a21-61b6dbbf1c6d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "734cb166-937e-469d-8c4a-4aa4121bb3e2"],
 " are as in Shape 1. The others are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "92080b6b-4ac5-44cd-9cf5-e007501855b7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"]}], TraditionalForm]],
  ExpressionUUID->"b082dc4e-fd22-4444-a2a5-9831e968dee9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], "H"], " ", "+", " ", 
    SubsuperscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]", "\[Transpose]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"]}], TraditionalForm]],
  ExpressionUUID->"3d0d0d73-35dc-44db-bdbc-432023fdb983"],
 ", all exact."
}], "Item",ExpressionUUID->"4e1e8b8b-0379-4108-89c0-dc41a62ede0d"],

Cell[TextData[{
 StyleBox["Motion.",
  FontWeight->"Bold"],
 " The particle swings as a damped pendulum into the CoM-below-H orientation. \
It then hovers (axial offset) or glides in a straight line (in-plane or \
generic offset)."
}], "Item",ExpressionUUID->"6538f7d1-760c-4205-8003-058024a4d476"],

Cell[TextData[{
 StyleBox["Orbit.",
  FontWeight->"Bold"],
 " None for any offset: a chiral mass distribution is not enough, and the \
chirality must be in the surface."
}], "Item",ExpressionUUID->"f2dfb0cf-f98d-48ba-b4c4-69dca143211b"]
}, Open  ]]
