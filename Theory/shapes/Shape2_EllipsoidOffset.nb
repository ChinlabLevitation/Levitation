 "    ",
 StyleBox["shift in the x-z plane (Cs)",
  FontWeight->"Bold"],
 ":   ",
 "quadrature tensors about the CoM equal the shift of the Shape 1 tensors"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"5b3ddc7c-9959-4ca7-9d93-ce857d032076"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["shift generic (C1, chiral)",
  FontWeight->"Bold"],
 ":   ",
 "quadrature tensors about the CoM equal the shift of the Shape 1 tensors"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"a5e1a62a-90db-4200-b6fc-4814c4c9e981"],

Cell[TextData[{
 "The same result follows symbolically. The next cell runs the perturbation \
engine with the density written as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "+", " ", "\[CurlyEpsilon]", "(", 
    SubscriptBox["k", "1"], "x", " ", "+", " ", 
    SubscriptBox["k", "2"], "y", " ", "+", " ", 
    SubscriptBox["k", "3"], "z", ")"}], TraditionalForm]],ExpressionUUID->
  "45e1555d-fb99-4645-8206-6681b752dfc5"],
 ", so that the shape and the offset are both of order ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "a8b94fae-bae2-4f7c-a9d1-03293b29cf49"],
 ". It confirms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "65512db0-bdf6-43d0-a8f1-5d3e38950d11"],
 " through second order, including the shape \[Times] offset cross terms."
}], "Text",ExpressionUUID->"8d77eebb-7bc9-421f-adc6-dac817a9c6ab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"shS", "=", 
   RowBox[{"symbolicShape", "[", 
    RowBox[{
     RowBox[{"1", "+", 
      RowBox[{"eps", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"e1", 
          RowBox[{"x", "^", "2"}]}], "+", 
         RowBox[{"e2", 
          RowBox[{"y", "^", "2"}]}], "+", 
         RowBox[{"e3", 
          RowBox[{"z", "^", "2"}]}]}], ")"}]}]}], ",", "n", ",", "eps", ",", 
     "2", ",", 
     RowBox[{"1", "+", 
      RowBox[{"eps", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k1", "x"}], "+", 
         RowBox[{"k2", "y"}], "+", 
         RowBox[{"k3", "z"}]}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", "=", 
      RowBox[{"shS", "[", "\"\<blocks\>\"", "]"}]}], ",", 
     RowBox[{"rc", "=", 
      RowBox[{"shS", "[", "\"\<com\>\"", "]"}]}], ",", "trunc2"}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"trunc2", "[", "m_", "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{"eps", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "&"}],
        ",", "m", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<r_c/l = \>\"", ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"Simplify", "[", "rc", "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<(T_th)_12/(gamma0 l) = \>\"", ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"b", "[", "\"\<T_th\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], "}"}], 
        "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<symbolic\>\"", 
         ",", "\"\<T_th = -[r_c]x f_th through O(eps^2), with r_c = \
(eps/5)(k_i (1 + 2 eps e_i))\>\"", ",", 
         RowBox[{
          RowBox[{"zeroQ", "[", 
           RowBox[{"trunc2", "[", 
            RowBox[{
             RowBox[{"b", "[", "\"\<T_th\>\"", "]"}], "+", 
             RowBox[{
              RowBox[{"hat", "[", "rc", "]"}], ".", 
              RowBox[{"b", "[", "\"\<f_th\>\"", "]"}]}]}], "]"}], "]"}], "&&", 
          RowBox[{"zeroQ", "[", 
           RowBox[{"rc", "-", 
            RowBox[{
             RowBox[{"eps", "/", "5"}], 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"k1", ",", "k2", ",", "k3"}], "}"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}], 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"2", "eps", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"e1", ",", "e2", ",", "e3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], "}"}], "]"}]}]}], "]"}]}], "Input",ExpressionUUID->"6c5b2eed-\
53db-455a-af47-cc800881db02"],

Cell[BoxData[
 TemplateBox[{"\"r_c/l = \"", 
   TagBox[
    FormBox[
     RowBox[{"{", 
       RowBox[{
         RowBox[{
           FractionBox["1", "5"], " ", "eps", " ", "k1", " ", 
