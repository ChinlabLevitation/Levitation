          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", "\"\<VERIFIED\>\""}],
         "]"}], ",", "\"\< verified)\>\""}], "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"$verifications", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<item\>\"", ",", "\"\<statement\>\"", 
           ",", "\"\<result\>\""}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
