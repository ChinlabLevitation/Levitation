                "], 
                Span[1, $CellContext`k$$], 
                Span[1, 3]]]}, Nothing]}, 
          PlotRange -> {{-1700, 150}, {-150, 150}, {-150, 150}}, 
          BoxRatios -> {5, 1, 1}, Lighting -> "Neutral", Axes -> True, 
          AxesLabel -> {"X (um)", "Y", "Z"}, PlotLabel -> 
          Row[{"t = ", 10 ($CellContext`k$$ - 1), " ms"}], ImageSize -> 600]],
       "Specifications" :> {{{$CellContext`k$$, 1, "frame (10 ms steps)"}, 1, 
         101, 1, ControlType -> Animator, AnimationRunning -> False}}, 
      "Options" :> {}, "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({
      Attributes[$CellContext`st$] = {Temporary}, 
       Attributes[$CellContext`x$] = {Temporary}, ShapeLevitation`drawBody[
         Pattern[ShapeLevitation`Private`mesh, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`x, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`R, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`scale, 
          Blank[]]] := GraphicsComplex[
         Map[
         ShapeLevitation`Private`x + 
          ShapeLevitation`Private`scale Dot[ShapeLevitation`Private`R, #]& , 
          ShapeLevitation`Private`mesh["pts"]], {
          EdgeForm[], 
          Polygon[
           ShapeLevitation`Private`mesh["polys"]]}, VertexColors -> 
         ShapeLevitation`Private`mesh["cols"]], 
       TagSet[ShapeLevitation`drawBody, 
        MessageName[ShapeLevitation`drawBody, "usage"], 
        "drawBody[mesh, x, R, scale] places the mesh at x with orientation R, \
lengths multiplied by scale."], ShapeLevitation`quatR[{
          Pattern[ShapeLevitation`Private`q0, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q1, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q2, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q3, 
           Blank[]]}] := (ShapeLevitation`Private`q0^2 - 
          Dot[{ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}]) IdentityMatrix[3] + 
        2 Outer[Times, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}] + 
        2 ShapeLevitation`Private`q0 
         ShapeLevitation`hat[{
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}], 
       TagSet[ShapeLevitation`quatR, 
        MessageName[ShapeLevitation`quatR, "usage"], 
        "quatR[q] is the rotation matrix of the unit quaternion q (body -> \
lab)."], ShapeLevitation`hat[{
          Pattern[ShapeLevitation`Private`a1, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`a2, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`a3, 
           Blank[]]}] := {{
         0, -ShapeLevitation`Private`a3, ShapeLevitation`Private`a2}, {
         ShapeLevitation`Private`a3, 0, -ShapeLevitation`Private`a1}, {-
          ShapeLevitation`Private`a2, ShapeLevitation`Private`a1, 0}}, 
       TagSet[ShapeLevitation`hat, 
        MessageName[ShapeLevitation`hat, "usage"], 
        "hat[a] is the skew matrix [a]x."]}; Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",ExpressionUUID->"b182a3ef-\
58ae-4deb-9546-3c219366d5c4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Orbital radius and period", "Section",ExpressionUUID->"3b78119c-74ae-4113-b4e9-d5917af5ff53"],

Cell[TextData[{
 StyleBox["Not applicable.",
  FontWeight->"Bold"],
 " The ellipsoid has no thermophoretic torque, so it has no steady spin (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"5b5db91c-8524-4ed9-ab48-197760fa276a"],
 "). Its levitated motion is a straight-line glide (or a hover when a \
principal axis is vertical). The orbital radius is infinite and there is no \
orbital period. The glide direction is fixed by whatever orientation the \
particle happens to have."
}], "Text",ExpressionUUID->"a31ff485-0ae8-4e35-b1a0-1b0ada05e2c9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Summary", "Section",ExpressionUUID->"d3301b5c-88c1-4b56-a58e-393e6821cb81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
