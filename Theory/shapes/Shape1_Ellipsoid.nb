  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "3b41a7b8-06b4-4416-9572-f6b1483311a9"],
 " = \[Gamma]0 diag[1 + (2 \[CurlyEpsilon]/5)((3 - a) E - (4 - 3 a) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["i",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "07dbe8da-d84b-46c1-a4e1-ab66c0ac4a5c"],
 ")]"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"4ceaf142-c5ff-487d-bc3d-1b3e842c1a4f"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["f_drag",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "56243ca9-8e2f-4198-ae4c-ddb95ec0b673"],
 " = \[Xi]0 diag[1 + (2 \[CurlyEpsilon]/5)(3E - 4 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["i",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "861924e7-fd62-484f-a3fe-e2d9c9ee8ec4"],
 " + 8a(3 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["i",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "295663e5-c4ab-4c36-b5d6-05fa57beb0fb"],
 " - E)/(8 + \[Pi] a))]"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"87089d5e-a4c6-4d88-afde-2d4785f8d121"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
