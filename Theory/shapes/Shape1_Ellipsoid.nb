Notebook[{

Cell[CellGroupData[{
Cell["Shape 1: a near-spherical ellipsoid", "Title",ExpressionUUID->"c0096525-9f68-4d3e-b05d-7ca713343bcb"],

Cell["\<\
Response tensors, steady states and trajectories of a triaxial ellipsoid \
close to a sphere, in a uniform temperature gradient without a trap\
\>", "Subtitle",ExpressionUUID->"09eb0552-144f-48f2-a648-bb2db684c92d"],

Cell[TextData[{
 "This is the first notebook in a series asking which simple particle shape \
has the chirality needed for circular orbits. The physics follows the \
corrected notes (v22). The gas\[Dash]surface stress of Eq. (50) is integrated \
over the particle surface. This gives the complete linear response about the \
centre of mass (CoM), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    StyleBox["F",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Tau]",
     FontWeight->"Bold"], ")", " ", "=", " ", "-", "\[ScriptCapitalR]", "\[CenterDot]",
     "(", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", ",", " ", 
    StyleBox["v",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "eb56704a-f642-476e-a06f-3d5c6557158c"],
 ", with blocks ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "48962fdb-6929-4f55-9b10-1c675c5646f8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "848f4dd9-4396-464d-80ff-f1a60d6257b0"],
 ", ",
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "0a539b53-10a4-4078-90bd-6191b1e1d718"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f59b2c24-ea48-4cbf-94b6-e83abc2c7e8f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["B",
     FontWeight->"Bold"], "\[Transpose]"], TraditionalForm]],ExpressionUUID->
  "e0085abd-62a5-4d05-a576-94734bc7e9b3"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4c9b2807-4ff5-4533-8a20-ed45cf67ef77"],
 ". The temperature field is a uniform gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "a23c70c5-85f2-4834-9ac8-3ae50fc85412"],
 " (hot below), with no trap. The shared machinery lives in ",
 StyleBox["ShapeLevitation.wl",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " next to this notebook."
}], "Text",ExpressionUUID->"80eb5dea-87dc-4f2a-a160-8033f7684987"],

Cell[TextData[{
 StyleBox["Results in brief.",
  FontWeight->"Bold"],
 " (1) The ellipsoid is centrosymmetric, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"464aa155-00bd-4a12-868f-1e6d695478e8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["B",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"932a5d2a-dd0d-4742-b34a-fe72b4ea8c8a"],
 " exactly, to all orders in the deformation. (2) To first order in ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "77c27b9a-b854-4885-9fd5-940306a12238"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ab529d9b-bd14-430c-99ca-c7a704ad8901"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4998751d-fe7f-472c-901a-c78cf0473054"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "3a88b607-14df-486a-9741-1c30f89766c4"],
 " are diagonal in the principal axes, with the closed forms of Section 4. \
(3) Nothing ever torques the particle, so every orientation is an equilibrium \
(neutral). (4) At levitation a tilted ellipsoid ",
 StyleBox["glides in a straight line",
  FontWeight->"Bold"],
 " at speed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", 
    FractionBox["1", "5"], "(", "4", " ", "-", " ", "3", "a", ")", 
    "\[CurlyEpsilon]", "|", 
    SubscriptBox["e", "1"], " ", "-", " ", 
    SubscriptBox["e", "3"], "|", 
    StyleBox["sin",
     FontSlant->"Plain"], "2", "\[Theta]", "\[ThinSpace]", "M", "g", "/", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "b329d07f-800b-41cc-a7d8-3d95cd9b450f"],
 ", up to 1.5 mm/s for the defaults. (5) There is no spin and ",
 StyleBox["no orbit",
  FontWeight->"Bold"],
 ": the orbital radius is infinite and there is no period."
}], "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.35, 0.55, 0.85],
 Background->RGBColor[
  0.96, 0.97, 1.],ExpressionUUID->"928407da-9276-4091-aa77-1dda290948e4"],

Cell[CellGroupData[{

Cell["1. Setup", "Section",ExpressionUUID->"d040cb7e-af79-427e-9861-c5dd7ec80e00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shapesDir", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "$Failed"}], "]"}]}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"StringQ", "[", "shapesDir", "]"}]}], ",", 
    RowBox[{"shapesDir", "=", 
     RowBox[{"Environment", "[", "\"\<SHAPES_DIR\>\"", "]"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"shapesDir", ",", "\"\<ShapeLevitation.wl\>\""}], "}"}], "]"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$verifications", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"record", "[", 
    RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"$verifications", ",", 
       RowBox[{"{", 
        RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "}"}]}], 
      "]"}], ";", 
     RowBox[{"VR", "[", 
      RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "]"}]}], 
    ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VR", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"VR", "[", 
      RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], 
     ",", "fmt_"}], "]"}], ":=", 
   RowBox[{"ToBoxes", "[", 
    RowBox[{
     RowBox[{"Panel", "[", 
      RowBox[{"Column", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"status", ",", "Bold", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"status", "==", "\"\<VERIFIED\>\""}], ",", 
                RowBox[{"Darker", "[", "Green", "]"}], ",", "Red"}], "]"}]}], 
             "]"}], ",", "\"\<   \>\"", ",", 
            RowBox[{"Style", "[", 
             RowBox[{"ref", ",", "Bold"}], "]"}], ",", "\"\<:  \>\"", ",", 
            "claim"}], "}"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"detail", "===", "\"\<\>\""}], ",", "Nothing", ",", 
           "detail"}], "]"}]}], "}"}], "]"}], "]"}], ",", "fmt"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"check", "[", 
    RowBox[{"ref_String", ",", "claim_String", ",", "test_", ",", 
     RowBox[{"detail_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"record", "[", 
    RowBox[{"ref", ",", "claim", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "test", "]"}], ",", "\"\<VERIFIED\>\"", 
       ",", "\"\<DISCREPANCY\>\""}], "]"}], ",", "detail"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "expr_", "]"}], ":=", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"Simplify", "[", "expr", "]"}], "}"}], "]"}], ",", 
     "PossibleZeroQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sci", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"Log10", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], "/", 
            RowBox[{"10", "^", "e"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}], "<>", "\"\<e\>\"",
         "<>", 
        RowBox[{"ToString", "[", "e", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"num", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"d_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "!=", "0"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", "x", "]"}], ">=", 
         RowBox[{"10", "^", "5"}]}]}], ")"}]}], ",", 
     RowBox[{"sci", "[", "x", "]"}], ",", 
     RowBox[{"ToString", "[", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"N", "[", "x", "]"}], ",", "d"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tf", "[", "m_", "]"}], ":=", 
   RowBox[{"TraditionalForm", "[", 
    RowBox[{"MatrixForm", "[", "m", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dispT", "[", "m_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DiagonalMatrixQ", "[", "m", "]"}], "&&", 
      RowBox[{"!", 
       RowBox[{"zeroQ", "[", "m", "]"}]}]}], ",", 
     RowBox[{"Column", "[", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<(\>\"", ",", "i", ",", "\"\<,\>\"", ",", "i", 
             ",", "\"\<)   \>\"", ",", 
             RowBox[{"TraditionalForm", "[", 
              RowBox[{"m", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "i"}], "]"}], "]"}], "]"}]}], "}"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3"}], "}"}]}], "]"}], 
        ",", "\"\<(off-diagonal entries = 0)\>\""}], "]"}], "]"}], ",", 
     RowBox[{"tf", "[", "m", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gas", "=", 
   RowBox[{"gasModel", "[", "]"}]}], ";", 
  RowBox[{"ell", "=", "20*^-6"}], ";", 
  RowBox[{"rhoP", "=", "1000."}], ";"}]}], "Input",ExpressionUUID->"401077a8-\
a4bc-4f21-aaf4-dbee61dd69a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. The shape", "Section",ExpressionUUID->"9abdb826-5e6a-47a5-81fe-78cb97750d2d"],

Cell[TextData[{
 "Lengths are in units of the mean radius ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "1f06f85a-666b-47bd-b778-2b8c93654633"],
 ". The body is the ellipsoid with semi-axes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], " ", "=", " ", "1", " ", "+", " ", 
    "\[CurlyEpsilon]", " ", 
    SubscriptBox["e", "i"]}], TraditionalForm]],ExpressionUUID->
  "d699a0f3-b8fd-46e0-84c1-0b1fcc1674ee"],
 " along the body axes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ",", " ", "y", ",", " ", "z"}], TraditionalForm]],
  ExpressionUUID->"fe75be86-7f7c-4322-993f-799c2d331cd7"],
 ". Its surface is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold"], " ", "=", " ", "l", " ", "R", "(", 
    OverscriptBox["n", "^"], ")", 
    OverscriptBox["n", "^"]}], TraditionalForm]],ExpressionUUID->
  "bbe40186-eb31-4a06-b60c-7d04f260acf5"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "^"], " ", "=", " ", "(", "x", ",", " ", "y", ",", " ",
     "z", ")"}], TraditionalForm]],ExpressionUUID->
  "f1df0a80-5e66-42dc-89eb-8d1f3d3f0185"],
 " is the unit direction. The Mathematica definition used throughout is:"
}], "Text",ExpressionUUID->"1d500180-891e-4c86-a05f-44cd7cd4ca48"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a1", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e1"}]}]}], ";", 
  RowBox[{"a2", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e2"}]}]}], ";", 
  RowBox[{"a3", "=", 
   RowBox[{"1", "+", 
    RowBox[{"eps", "e3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rellipsoid", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", 
       RowBox[{"a1", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"y", "^", "2"}], "/", 
       RowBox[{"a2", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"z", "^", "2"}], "/", 
       RowBox[{"a3", "^", "2"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"defaults", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"eps", "->", 
      RowBox[{"1", "/", "10"}]}], ",", 
     RowBox[{"e1", "->", "1"}], ",", 
     RowBox[{"e2", "->", "0"}], ",", 
     RowBox[{"e3", "->", 
      RowBox[{"-", "1"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Rnum", "[", "nn_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"Rellipsoid", "[", "nn", "]"}], "/.", "defaults"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<R(n) = \>\"", ",", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"Rellipsoid", "[", "n", "]"}], "]"}], 
    ",", "\"\<      defaults: \>\"", ",", "defaults", 
    ",", "\"\<   (semi-axes 1.1, 1.0, 0.9)\>\""}], "}"}], "]"}]}], "Input",Exp\
ressionUUID->"31615cac-99c1-4a56-a6f3-ce9671edffd3"],

Cell[BoxData[
 TemplateBox[{"\"R(n) = \"", 
   TagBox[
    FormBox[
     FractionBox["1", 
      SqrtBox[
       RowBox[{
         FractionBox[
          SuperscriptBox["x", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e1", " ", "eps"}], "+", "1"}], ")"}], "2"]], "+", 
         FractionBox[
          SuperscriptBox["y", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e2", " ", "eps"}], "+", "1"}], ")"}], "2"]], "+", 
         FractionBox[
          SuperscriptBox["z", "2"], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"e3", " ", "eps"}], "+", "1"}], ")"}], "2"]]}]]], 
     TraditionalForm], TraditionalForm, Editable -> True], 
   "\"      defaults: \"", 
   RowBox[{"{", 
     RowBox[{
       RowBox[{"eps", "\[Rule]", 
         FractionBox["1", "10"]}], ",", 
       RowBox[{"e1", "\[Rule]", "1"}], ",", 
       RowBox[{"e2", "\[Rule]", "0"}], ",", 
       RowBox[{"e3", "\[Rule]", 
         RowBox[{"-", "1"}]}]}], "}"}], "\"   (semi-axes 1.1, 1.0, 0.9)\""},
  "RowDefault"]], "Output",ExpressionUUID->"b21fd2e8-c59a-4fd9-83f7-\
7e4677a9afe4"]
}, Open  ]],

Cell[TextData[{
 "The defaults give a triaxial body, 10% longer along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "a907d331-b56c-4da4-aea7-0f62a5adf165"],
 " and 10% shorter along ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "f68936af-3a0c-4f27-8f6c-a9d676cdc6e2"],
 ". The symbolic engine needs a radius that equals 1 identically at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"783024ef-edb7-445f-972c-3d9ab8355d76"],
 ". On the unit sphere, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], " ", "+", " ", 
    SuperscriptBox["y", "2"], " ", "+", " ", 
    SuperscriptBox["z", "2"], " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"3e5fcca4-739c-4530-8cd5-8f9b196b6ff1"],
 ", the same surface is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    SuperscriptBox[
     RowBox[{"[", "1", " ", "+", " ", 
      SubscriptBox["\[Sum]", "i"], "(", 
      SubsuperscriptBox["a", "i", 
       RowBox[{"-", "2"}]], " ", "-", " ", "1", ")", 
      SubsuperscriptBox["n", "i", "2"], "]"}], 
     RowBox[{"-", "1", "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "36611eb1-de4b-432a-9a68-df7b0aec265a"],
 ". The first check confirms the two forms agree. The free-molecule stress \
model assumes a convex body (no element shadows another), which the second \
check confirms. The last check tests the numerical quadrature against the \
exact mass and inertia of an ellipsoid."
}], "Text",ExpressionUUID->"f4e74ac3-b294-4e41-90ee-a21617b47ca8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rsph", "=", 
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a1", "^", 
          RowBox[{"-", "2"}]}], "-", "1"}], ")"}], 
       RowBox[{"x", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a2", "^", 
          RowBox[{"-", "2"}]}], "-", "1"}], ")"}], 
       RowBox[{"y", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a3", "^", 
          RowBox[{"-", "2"}]}], "-", "1"}], ")"}], 
       RowBox[{"z", "^", "2"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pt", "=", 
   RowBox[{"makeParticle", "[", 
    RowBox[{"Rnum", ",", "ell", ",", "rhoP", ",", "gas"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Mex", ",", "Iex", ",", 
     RowBox[{"A", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}], "/.", "defaults"}], 
       "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"Mex", "=", 
     RowBox[{"4", 
      RowBox[{"Pi", "/", "3"}], "rhoP", 
      RowBox[{"ell", "^", "3"}], 
      RowBox[{"Times", "@@", "A"}]}]}], ";", 
    RowBox[{"Iex", "=", 
     RowBox[{"Mex", 
      RowBox[{
       RowBox[{"ell", "^", "2"}], "/", "5"}], 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "^", "2"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}]}], 
    ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{"\"\<surface\>\"", 
         ",", "\"\<the regular form equals the ellipsoid on the unit sphere\>\
\"", ",", 
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Rsph", "-", 
             RowBox[{"Rellipsoid", "[", "n", "]"}]}], ")"}], "/.", 
           RowBox[{"z", "->", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"x", "^", "2"}], "-", 
              RowBox[{"y", "^", "2"}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<convex\>\"", 
         ",", "\"\<the default body is convex (smallest principal curvature > \
0)\>\"", ",", 
         RowBox[{
          RowBox[{"convexityMargin", "[", "Rnum", "]"}], ">", "0"}], ",", 
         RowBox[{"\"\<smallest principal curvature = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"convexityMargin", "[", "Rnum", "]"}], "]"}], 
          "<>", "\"\< / ell\>\""}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<quadrature\>\"", 
         ",", "\"\<numerical mass, CoM and inertia match the exact \
ellipsoid\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"pt", "[", "\"\<M\>\"", "]"}], "/", "Mex"}], "-", "1"}],
             "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}]}], "&&", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"pt", "[", "\"\<com\>\"", "]"}], "]"}], "<", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", "12"}]}], "ell"}]}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"pt", "[", "\"\<I\>\"", "]"}], "-", "Iex"}], "]"}], "/", 
            RowBox[{"Norm", "[", "Iex", "]"}]}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}]}]}], ",", 
         RowBox[{"\"\<M = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"pt", "[", "\"\<M\>\"", "]"}], "]"}], 
          "<>", "\"\< kg,  I/(M ell^2) = \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Diagonal", "[", 
               RowBox[{"pt", "[", "\"\<I\>\"", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"pt", "[", "\"\<M\>\"", "]"}], 
                RowBox[{"ell", "^", "2"}]}], ")"}]}], ",", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "4"}]}]}], "]"}], "]"}]}]}], "]"}]}], "}"}], 
     "]"}]}]}], "]"}]}], "Input",ExpressionUUID->"eca67d83-bdbf-49d7-9e0f-\
959c0f239905"],

