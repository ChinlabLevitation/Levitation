                 FractionBox["4", "5"], " ", "eps", " ", 
                 RowBox[{"(", 
                   RowBox[{"e1", "+", 
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{"e2", "+", "e3"}], ")"}]}]}], ")"}]}], "+", "1"}],
              TraditionalForm], TraditionalForm, Editable -> True]},
          "RowDefault"]},
        {
         TemplateBox[{"\"(\"", "2", "\",\"", "2", "\")   \"", 
