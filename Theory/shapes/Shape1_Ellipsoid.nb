Cell[CellGroupData[{

Cell["5. Steady states: neutral orientation and gliding", "Section",ExpressionUUID->"feab9bbb-ba1a-40dc-94a2-5c1f99c846eb"],

Cell[TextData[{
 StyleBox["Rotation.",
  FontWeight->"Bold"],
 " A steady spin ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Omega]",
     FontWeight->"Bold"], " ", "=", " ", "\[CapitalOmega]", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "999e2ebe-89e0-4e7d-9136-2c4949f87836"],
 " about the vertical needs a real, non-zero eigenvalue of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "81b5c13d-abbe-4843-a924-6fde769d41bd"],
 " (notes Sec. 2.2). Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"1a788b02-b79c-416f-92e9-0a6276e0423e"],
 ", so the only rotational motion is the decay of any initial spin, and ",
 StyleBox["every orientation is an equilibrium",
  FontWeight->"Bold"],
 ". Nothing selects an orientation."
}], "Text",ExpressionUUID->"8a1af3c6-12c2-430a-a318-7da9bdf3f183"],

Cell[TextData[{
 StyleBox["Translation.",
  FontWeight->"Bold"],
 " Let ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8f1eb7e9-86c8-4fa5-af28-9e9d363cd7e9"],
 " be the lab vertical expressed in the body frame. At rest the body-frame \
force balance is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "G", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "-", " ", "M", "g", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "c0f60dc7-1410-4570-b286-9f9fed69d18c"],
 ". Levitation fixes ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "c1f0be11-3e9a-4ac7-92a7-c68efa090e02"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], "\[CenterDot]", 
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"5bbd46c3-788c-4239-b91a-da357700cf68"],
 ", and the horizontal velocity that remains is a glide. To first order in ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "c2fb0879-bab7-4d29-b8ff-d17c33d396b8"],
 " only the anisotropy of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "bb5ec397-50c3-4b36-8237-a98b93bd0cec"],
 " enters (notes Eq. 43); the drag anisotropy is multiplied by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "G", " ", "-", " ", "M", "g", " ", "=", 
    " ", "O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],ExpressionUUID->
  "0a2fea3d-1ba9-4ff8-b173-ddcb38be96f3"],
 ":"
}], "Text",ExpressionUUID->"2a221394-07cc-4e17-b972-7656b1181334"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"M", "g"}], 
       SubscriptBox["\[Xi]", "0"]], "\[ThinSpace]", 
      SubscriptBox[
       RowBox[{"[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox[
             StyleBox["f",
              FontWeight->"Bold"], 
             StyleBox["th",
              FontSlant->"Plain"]], "/", 
            SubscriptBox["\[Gamma]", "0"]}], " ", "-", " ", 
           StyleBox["I",
            FontWeight->"Bold"]}], ")"}], "\[ThinSpace]", 
         StyleBox["u",
          FontWeight->"Bold"]}], "]"}], "\[UpTee]"]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", "(", "4", " ", "-", " ", "3", "a", ")"}], "5"]}], "\[ThinSpace]",
       "\[CurlyEpsilon]", "\[ThinSpace]", 
      FractionBox[
       RowBox[{"M", "g"}], 
       SubscriptBox["\[Xi]", "0"]], "\[ThinSpace]", 
      SubscriptBox[
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          StyleBox["diag",
           FontSlant->"Plain"], "(", 
          SubscriptBox["e", "i"], ")"}], "\[ThinSpace]", 
         StyleBox["u",
          FontWeight->"Bold"]}], "]"}], "\[UpTee]"]}]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", "|", 
     SubscriptBox[
      StyleBox["v",
       FontWeight->"Bold"], "\[UpTee]"], "|"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"4", " ", "-", " ", "3", "a"}], "5"], "\[ThinSpace]", 
      "\[CurlyEpsilon]"}], "\[ThinSpace]", "|", 
     RowBox[{
      SubscriptBox["e", "1"], " ", "-", " ", 
      SubscriptBox["e", "3"]}], "|", "\[ThinSpace]", "|", 
     RowBox[{
      StyleBox["sin",
       FontSlant->"Plain"], "2", "\[Theta]"}], "|", "\[ThinSpace]", 
     FractionBox[
      RowBox[{"M", "g"}], 
      SubscriptBox["\[Xi]", "0"]]}]}]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"6745e4ba-481c-4408-80a7-8133de85859f"],

Cell[TextData[{
 "The second form is for a tilt ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "ff59e247-9368-4c6d-bd16-2f15f5df5e17"],
 " of the vertical within the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "49815da5-3045-474a-9caa-14f65d9c8e61"],
 "\[Dash]",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "0f9e5d59-6455-4472-a3b9-2abb96237de2"],
 " plane, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "(", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]", ",", " ", "0", ",", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "49bdcb26-b711-4c1f-b3dd-10e51720f401"],
 ". The glide is fastest at 45\[Degree] between the longest and shortest axes \
and vanishes when a principal axis is vertical. The exact glide is computed \
below from the quadrature tensors for every orientation (",
 StyleBox["hoverDrift",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 "), and compared with the formula."
}], "Text",ExpressionUUID->"8fb26060-3605-4d41-b2fb-db60a2cec2b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"glideLO", "[", "th_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", "-", 
       RowBox[{"3", 
        RowBox[{"gas", "[", "\"\<a\>\"", "]"}]}]}], ")"}], "/", "5"}], 
    RowBox[{"(", 
     RowBox[{"1", "/", "10"}], ")"}], 
    RowBox[{"Abs", "[", 
     RowBox[{"1", "-", 
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}]}], "]"}], 
    RowBox[{"Abs", "[", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", "th"}], "]"}], "]"}], 
    RowBox[{"pt", "[", "\"\<M\>\"", "]"}], 
    RowBox[{"$gEarth", "/", 
     RowBox[{"pt", "[", "\"\<xi0\>\"", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"glideExact", "[", "th_", "]"}], ":=", 
   RowBox[{
    RowBox[{"hoverDrift", "[", 
     RowBox[{"pt", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", "th", "]"}], ",", "0", ",", 
        RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], "]"}], 
    "[", "\"\<speed\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1000", 
         RowBox[{"glideExact", "[", 
          RowBox[{"th", "Degree"}], "]"}]}], ",", 
        RowBox[{"1000", 
         RowBox[{"glideLO", "[", 
          RowBox[{"th", "Degree"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"th", ",", "0", ",", "180"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Dashed"}], "}"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<tilt of the vertical from the body z axis, in the x-z \
plane (deg)\>\"", ",", "\"\<glide speed (mm/s)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<exact quadrature tensors\>\"", 
         ",", "\"\<first-order formula\>\""}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "480"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<glide speed at levitation\>\""}]}], 
     "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<glide\>\"", 
      ",", "\"\<at 45 deg the glide speed matches the first-order formula to \
O(eps)\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"glideExact", "[", 
           RowBox[{"45", "Degree"}], "]"}], "/", 
          RowBox[{"glideLO", "[", 
           RowBox[{"45", "Degree"}], "]"}]}], "-", "1"}], "]"}], "<", 
       "0.15"}], ",", 
      RowBox[{"\"\<exact \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"1000", 
         RowBox[{"glideExact", "[", 
          RowBox[{"45", "Degree"}], "]"}]}], "]"}], 
       "<>", "\"\< mm/s, first order \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"1000", 
         RowBox[{"glideLO", "[", 
          RowBox[{"45", "Degree"}], "]"}]}], "]"}], "<>", "\"\< mm/s\>\""}]}],
      "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<no torque\>\"", 
      ",", "\"\<a gliding ellipsoid feels no torque at any orientation\>\"", ",", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"hoverDrift", "[", 
             RowBox[{"pt", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sin", "[", "t", "]"}], 
                 RowBox[{"Cos", "[", "p", "]"}]}], ",", 
                RowBox[{
                 RowBox[{"Sin", "[", "t", "]"}], 
                 RowBox[{"Sin", "[", "p", "]"}]}], ",", 
                RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], "]"}], 
            "[", "\"\<torque\>\"", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0.1", ",", "3", ",", "0.4"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"p", ",", "0", ",", "6", ",", "0.7"}], "}"}]}], "]"}], 
        "]"}], "<", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "12"}]}], 
        RowBox[{"pt", "[", "\"\<gamma0\>\"", "]"}], "ell", 
        RowBox[{"pt", "[", "\"\<G0\>\"", "]"}]}]}]}], "]"}]}], "}"}], 
