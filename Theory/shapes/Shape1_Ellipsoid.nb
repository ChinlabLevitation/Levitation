Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["straight line",
  FontWeight->"Bold"],
 ":   ",
 "run 1: orientation constant and the CoM glides in a straight line at the \
predicted velocity",
 "\n",
 StyleBox["glide speed 1.54 mm/s (predicted 1.54 mm/s), vertical velocity \
-1.20e-16 m/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"b03b7e63-d1da-4e11-a0e6-5768920add8d"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["neutral",
  FontWeight->"Bold"],
 ":   ",
 "run 2: the spin decays and leaves the body in a new orientation that it \
keeps; the glide direction turns with it",
 "\n",
 StyleBox["glide direction turned by 99.82 deg; tilt changed by 7.58 deg (",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "21cbc955-578b-4fa4-999b-b822ef16c9a9"],
 StyleBox[" is anisotropic); speed 1.491 mm/s; final |\[Omega]| = 1.12e-13 \
rad/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"05e02259-bec2-40a1-a01e-64dc651cbd31"],

Cell[TextData[{
 "Run 1 stays at constant height. In run 2 the spin also nudges the tilt \
slightly (the rotational drag is anisotropic), so the levitation gradient no \
longer matches exactly and the particle drifts slowly in height; a trap would \
hold it. The animation shows run 1: the body keeps its orientation and slides \
sideways (toward ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "X"}], TraditionalForm]],ExpressionUUID->
  "9b241138-d9bd-43b7-92c9-69e071a0b067"],
 "). The body is drawn 3 times larger than the displacement scale, and the \
grey line is the CoM path."
}], "Text",ExpressionUUID->"68970ec2-2a01-4247-93b1-0a347117f76d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mesh", "=", 
      RowBox[{"bodyMesh", "[", "Rnum", "]"}]}], ",", 
     RowBox[{"states", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"run1", "[", "\"\<state\>\"", "]"}], "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0.", ",", "1.", ",", "0.01"}], "}"}]}], "]"}]}]}],
     "}"}], ",", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "=", 
          RowBox[{"states", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", "x"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{"10", "^", "6"}], 
          RowBox[{"st", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}], ";", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"drawBody", "[", 
             RowBox[{"mesh", ",", "x", ",", 
              RowBox[{"quatR", "[", 
               RowBox[{"st", "[", 
                RowBox[{"[", 
                 RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ",", "60"}], 
             "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", ">", "1"}], ",", 
              RowBox[{"{", 
               RowBox[{"Gray", ",", "Thick", ",", 
                RowBox[{"Line", "[", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"states", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", "k"}], ",", 
                    RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], "]"}]}], 
               "}"}], ",", "Nothing"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1700"}], ",", "150"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "150"}], ",", "150"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "150"}], ",", "150"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"BoxRatios", "->", 
           RowBox[{"{", 
            RowBox[{"5", ",", "1", ",", "1"}], "}"}]}], ",", 
          RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<t = \>\"", ",", 
              RowBox[{"10", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}]}], ",", "\"\< ms\>\""}], "}"}],
             "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "\"\<frame (10 ms steps)\>\""}], "}"}], ",",
        "1", ",", "101", ",", "1", ",", 
       RowBox[{"ControlType", "->", "Animator"}], ",", 
       RowBox[{"AnimationRunning", "->", "False"}]}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]}], "]"}]], "Input",Exp\
ressionUUID->"dd72ad9d-e675-4217-8f16-04c793ee285c"],

