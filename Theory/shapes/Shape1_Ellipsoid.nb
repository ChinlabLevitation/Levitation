      RowBox[{"PlotLabel", "->", "\"\<top view (down z)\>\""}]}], "]"}]}], 
   "}"}], "]"}]], "Input",ExpressionUUID->"dcec5d70-c53c-4272-b92c-\
4da3abbf9a39"],

