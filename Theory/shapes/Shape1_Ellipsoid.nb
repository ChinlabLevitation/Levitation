Cell[CellGroupData[{

Cell["4. The four tensors", "Section",ExpressionUUID->"1448a756-be07-4eb1-be59-43957c6d64c4"],

Cell[TextData[{
 "The symbolic engine expands the surface normal, the area element and every \
stress kernel in ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "f76c01ac-cf4f-44f3-a5e7-1f8f84acfded"],
 ". It then integrates the resulting polynomials in ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],ExpressionUUID->
  "8636067b-2e49-4197-9744-0e5031d7f467"],
 " exactly with the sphere moments ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ContourIntegral]", " ", 
    SuperscriptBox["x", "a"], 
    SuperscriptBox["y", "b"], 
    SuperscriptBox["z", "c"], "\[ThinSpace]", "d", "\[CapitalOmega]"}], 
   TraditionalForm]],ExpressionUUID->"33944f9e-e10f-4d0a-98af-59a880937afb"],
 ". Results are in natural units: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "611812aa-a3fe-4dd7-bd38-e5d3d0feec26"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "0"], TraditionalForm]],ExpressionUUID->
  "a8f40738-80d9-4b14-828e-0ed23f73a952"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "bf8ae712-b3e9-41d8-b9bc-5a1d2dde9827"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "0"], TraditionalForm]],ExpressionUUID->
  "8570281b-1fff-42b9-9ef0-b8f224827714"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ba1c858d-14c9-4ccb-b86a-67c66815e268"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "l"}], TraditionalForm]],ExpressionUUID->
  "c2e038f8-ac73-43f8-b0db-aed5a66a30a6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "5ccee0bb-c35a-4fff-808f-f3b8e9ba14f1"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "0"], TraditionalForm]],ExpressionUUID->
  "833c9c5a-2788-4b37-a5a4-5de2a357db01"],
 ", and ",
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ecd92855-abab-46d9-9504-cbea08680c83"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "0"], "l"}], TraditionalForm]],ExpressionUUID->
  "e35a08d0-2fa1-47e7-a769-7154a14219b0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "0"], TraditionalForm]],ExpressionUUID->
  "878eaf8e-aca4-4c9f-81a6-8ba1aca435c6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", "0"], TraditionalForm]],ExpressionUUID->
  "caf50f9b-d438-4539-86d2-e2d0c72e1693"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "0"], TraditionalForm]],ExpressionUUID->
  "a38d2bc4-b871-4f83-b57c-89319851e303"],
 " are the sphere values of the notes. The accommodation coefficient ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "ee299986-e4cd-42ed-80a1-a9947786bb99"],
 " is kept general."
}], "Text",ExpressionUUID->"4236e127-039d-48f1-b8b9-c6494265539a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"shE", "=", 
   RowBox[{"symbolicShape", "[", 
    RowBox[{"Rsph", ",", "n", ",", "eps", ",", "1", ",", "1", ",", 
     RowBox[{"\"\<Accommodation\>\"", "->", "a"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bl", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"FullSimplify", ",", 
     RowBox[{"shE", "[", "\"\<blocks\>\"", "]"}], ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<f_th / gamma0 :\>\"", ",", 
       RowBox[{"dispT", "[", 
        RowBox[{"bl", "[", "\"\<f_th\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<f_drag / xi0 :\>\"", ",", 
       RowBox[{"dispT", "[", 
        RowBox[{"bl", "[", "\"\<f_drag\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<T_th / (gamma0 l) :\>\"", ",", 
       RowBox[{"dispT", "[", 
        RowBox[{"bl", "[", "\"\<T_th\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<T_drag / c0 :\>\"", ",", 
       RowBox[{"dispT", "[", 
        RowBox[{"bl", "[", "\"\<T_drag\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<B / (xi0 l) :\>\"", ",", 
       RowBox[{"dispT", "[", 
        RowBox[{"bl", "[", "\"\<B\>\"", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Alignment", "->", 
    RowBox[{"{", 
     RowBox[{"Left", ",", "Center"}], "}"}]}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1.5"}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input",ExpressionUUID->\
"b1774654-f71c-4619-a8ff-5d6061fa4844"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"f_th / gamma0 :\"\>", 
     TagBox[GridBox[{
        {
         TemplateBox[{"\"(\"", "1", "\",\"", "1", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{
               FractionBox["1", "5"], " ", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "a"}], "-", "1"}], ")"}], " ", "e1", 
                    " ", "eps"}], "-", 
                   RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{"a", "-", "3"}], ")"}], " ", "eps", " ", 
                    RowBox[{"(", 
                    RowBox[{"e2", "+", "e3"}], ")"}]}], "+", "5"}], ")"}]}], 
             TraditionalForm], TraditionalForm, Editable -> True]},
          "RowDefault"]},
        {
         TemplateBox[{"\"(\"", "2", "\",\"", "2", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{"1", "-", 
               RowBox[{
                 FractionBox["2", "5"], " ", "eps", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "-", "3"}], ")"}], " ", "e1"}], "-", 
                    RowBox[{"2", " ", "a", " ", "e2"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "-", "3"}], ")"}], " ", "e3"}], "+", "e2"}], 
                   ")"}]}]}], TraditionalForm], TraditionalForm, Editable -> 
            True]},
          "RowDefault"]},
        {
         TemplateBox[{"\"(\"", "3", "\",\"", "3", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{"1", "-", 
               RowBox[{
                 FractionBox["2", "5"], " ", "eps", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "-", "3"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"e1", "+", "e2"}], ")"}]}], "-", 
                    RowBox[{"2", " ", "a", " ", "e3"}], "+", "e3"}], 
                   ")"}]}]}], TraditionalForm], TraditionalForm, Editable -> 
            True]},
          "RowDefault"]},
        {"\<\"(off-diagonal entries = 0)\"\>"}
       },
       DefaultBaseStyle->"Column",
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Column"]},
    {"\<\"f_drag / xi0 :\"\>", 
     TagBox[GridBox[{
        {
         TemplateBox[{"\"(\"", "1", "\",\"", "1", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{
               FractionBox["1", "5"], " ", 
               RowBox[{"(", 
                 RowBox[{
                   FractionBox[
                    RowBox[{"16", " ", "a", " ", "eps", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "e1"}], "-", "e2", "-", "e3"}], ")"}]}], 
                    RowBox[{
                    RowBox[{"\[Pi]", " ", "a"}], "+", "8"}]], "-", 
                   RowBox[{
                    RowBox[{"2"}], " ", "e1", " ", "eps"}], "+", 
                   RowBox[{"6", " ", "e2", " ", "eps"}], "+", 
                   RowBox[{"6", " ", "e3", " ", "eps"}], "+", "5"}], ")"}]}], 
             TraditionalForm], TraditionalForm, Editable -> True]},
          "RowDefault"]},
        {
         TemplateBox[{"\"(\"", "2", "\",\"", "2", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{
               RowBox[{
                 FractionBox["2", "5"], " ", "eps", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", 
                    FractionBox[
                    RowBox[{"8", " ", "a", " ", 
                    RowBox[{"(", 
                    RowBox[{"e1", "-", 
                    RowBox[{"2", " ", "e2"}], "+", "e3"}], ")"}]}], 
                    RowBox[{
                    RowBox[{"\[Pi]", " ", "a"}], "+", "8"}]]}], "+", 
                    RowBox[{"3", " ", "e1"}], "-", "e2", "+", 
                    RowBox[{"3", " ", "e3"}]}], ")"}]}], "+", "1"}], 
             TraditionalForm], TraditionalForm, Editable -> True]},
          "RowDefault"]},
        {
         TemplateBox[{"\"(\"", "3", "\",\"", "3", "\")   \"", 
           TagBox[
            FormBox[
             RowBox[{
               RowBox[{
                 FractionBox["2", "5"], " ", "eps", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", 
                    FractionBox[
                    RowBox[{"8", " ", "a", " ", 
                    RowBox[{"(", 
                    RowBox[{"e1", "+", "e2", "-", 
                    RowBox[{"2", " ", "e3"}]}], ")"}]}], 
                    RowBox[{
                    RowBox[{"\[Pi]", " ", "a"}], "+", "8"}]]}], "+", 
                    RowBox[{"3", " ", "e1"}], "+", 
                    RowBox[{"3", " ", "e2"}], "-", "e3"}], ")"}]}], "+", 
               "1"}], TraditionalForm], TraditionalForm, Editable -> True]},
          "RowDefault"]},
        {"\<\"(off-diagonal entries = 0)\"\>"}
       },
       DefaultBaseStyle->"Column",
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Column"]},
    {"\<\"T_th / (gamma0 l) :\"\>", 
