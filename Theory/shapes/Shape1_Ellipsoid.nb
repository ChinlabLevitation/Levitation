Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", " ", "\[Congruent]", " ", 
    SubscriptBox["e", "1"], " ", "+", " ", 
    SubscriptBox["e", "2"], " ", "+", " ", 
    SubscriptBox["e", "3"]}], TraditionalForm]],ExpressionUUID->
  "d962eedc-6b9b-4c66-82c9-3ff40f7d1bb5"],
 " and ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "60b36d37-fa97-43cb-acf0-6162c987f891"],
 " labelling the principal axis, the four tensors to first order in ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "310bfb10-9004-49d3-b084-2c0355e6b0a0"],
 " are:"
}], "Text",ExpressionUUID->"7fee367d-03cb-41b9-88e8-2ca38b3885a8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "\[ThinSpace]", 
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], "[", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[CurlyEpsilon]"}], "5"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "-", " ", "a"}], ")"}], "E"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"4", " ", "-", " ", 
            RowBox[{"3", "a"}]}], ")"}], 
          SubscriptBox["e", "i"]}]}], ")"}]}]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"3b2b76c4-68fc-4dc9-91a2-23b360d50eb1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   RowBox[{
    SubscriptBox["\[Xi]", "0"], "\[ThinSpace]", 
    RowBox[{
     StyleBox["diag",
      FontSlant->"Plain"], "[", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[CurlyEpsilon]"}], "5"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "E"}], " ", "-", " ", 
         RowBox[{"4", 
          SubscriptBox["e", "i"]}], " ", "+", " ", 
         FractionBox[
          RowBox[{"8", "a", "(", "3", 
           SubscriptBox["e", "i"], " ", "-", " ", "E", ")"}], 
          RowBox[{"8", " ", "+", " ", "\[Pi]", " ", "a"}]]}], ")"}]}]}], 
     "]"}]}]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"b7c4c6e5-4a4a-493d-b1e2-160459005d07"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "0", " ", "\:2003\:2003", 
   StyleBox[
    RowBox[{"(", "exactly", ",", " ", "to", " ", "all", " ", "orders", ")"}],
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"205783e4-a3b7-46f3-9df0-ebbfd8d5a218"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["c", "0"], "\[ThinSpace]", 
     RowBox[{
      StyleBox["diag",
       FontSlant->"Plain"], "[", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"4", "\[CurlyEpsilon]"}], "5"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "E"}], " ", "-", " ", 
          SubscriptBox["e", "i"]}], ")"}]}]}], "]"}]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     StyleBox["B",
      FontWeight->"Bold"]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      StyleBox["B",
       FontWeight->"Bold"], "\[Transpose]"], " ", "=", " ", "0"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"ac6b363b-20db-4a5b-ae6e-2326fd4cd12f"],

Cell[TextData[{
 "The isotropic parts are just the size change: an ellipsoid with all ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["e", "i"], " ", "=", " ", "e"}], TraditionalForm]],
  ExpressionUUID->"99d0b212-4a13-4e2e-8048-dbd6a3d05908"],
 " is a sphere of radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "+", " ", "\[CurlyEpsilon]", " ", "e"}], 
   TraditionalForm]],ExpressionUUID->"7118e346-af8d-413a-8f72-5f3c1fba6cb8"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], ",", " ", 
    SubscriptBox["\[Xi]", "0"], " ", "\[Proportional]", " ", 
    SuperscriptBox["l", "2"]}], TraditionalForm]],ExpressionUUID->
  "619cf638-16c9-418c-b81f-809184c117d4"],
 " gain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CurlyEpsilon]", " ", "e"}], TraditionalForm]],
  ExpressionUUID->"27ec6178-8ba2-4dfe-8ac8-55d575599e4e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "0"], " ", "\[Proportional]", " ", 
    SuperscriptBox["l", "4"]}], TraditionalForm]],ExpressionUUID->
  "4c6bc6ce-f07f-451a-9ea5-44cc30914166"],
 " gains ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[CurlyEpsilon]", " ", "e"}], TraditionalForm]],
  ExpressionUUID->"7eec0afa-0e7f-4239-baec-ced8d0028791"],
 ". The anisotropic parts are what matter for the motion. For full \
accommodation (",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "05d3a032-b5b0-4eb2-b597-480e554a53d1"],
 "), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "0294c757-4fc0-41e9-b4f2-c7266e694688"],
 " is ",
 StyleBox["smaller",
  FontSlant->"Italic"],
 " along a long axis, by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["2", "5"], "\[CurlyEpsilon]", " ", 
    SubscriptBox["e", "i"], 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "40f882c0-6299-49ba-b1f1-2689fdd379e0"],
 ". The thermophoretic anisotropy is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", " ", "-", " ", "3", "a"}], TraditionalForm]],ExpressionUUID->
  "fdda1839-f7b8-4acd-9c44-b97b1a730bf3"],
 ", which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", 
    SqrtBox["\[Pi]"], "/", 
    SqrtBox["h"]}], TraditionalForm]],ExpressionUUID->
  "ae82fe90-26ba-4e58-a00e-f025476b1ee2"],
 " times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "n"], " ", "-", " ", 
    SubscriptBox["C", "t"]}], TraditionalForm]],ExpressionUUID->
  "da4c30bc-22ad-4904-b9b5-98e6b0c68eed"],
 " (the normal minus the tangential heat-flux coefficient of Eq. 50). ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "87e1112f-3c4d-4878-a10d-7dc9086e43d2"],
 " does not depend on ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "2e16760f-a3c6-46b6-9dea-6adc1797c87f"],
 "."
}], "Text",ExpressionUUID->"f6776ed4-fa9f-4d75-9b4a-bde3e703d1b6"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<f_th\>\"", 
      ",", "\"\<f_th = gamma0 diag[1 + (2 eps/5)((3 - a) E - (4 - 3 a) \
e_i)]\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"bl", "[", "\"\<f_th\>\"", "]"}], "-", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"2", 
             RowBox[{"eps", "/", "5"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"3", "-", "a"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"e1", "+", "e2", "+", "e3"}], ")"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"4", "-", 
                  RowBox[{"3", "a"}]}], ")"}], 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"e1", ",", "e2", ",", "e3"}], "}"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}]}], "]"}]}], "]"}], 
    ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<f_drag\>\"", 
      ",", "\"\<f_drag = xi0 diag[1 + (2 eps/5)(3E - 4 e_i + 8a(3 e_i - E)/(8 \
+ pi a))]\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"bl", "[", "\"\<f_drag\>\"", "]"}], "-", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"2", 
             RowBox[{"eps", "/", "5"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"3", 
                RowBox[{"(", 
                 RowBox[{"e1", "+", "e2", "+", "e3"}], ")"}]}], "-", 
               RowBox[{"4", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"e1", ",", "e2", ",", "e3"}], "}"}], "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "+", 
               RowBox[{"8", "a", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"3", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"e1", ",", "e2", ",", "e3"}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "-", 
                   RowBox[{"(", 
                    RowBox[{"e1", "+", "e2", "+", "e3"}], ")"}]}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"8", "+", 
                   RowBox[{"Pi", "a"}]}], ")"}]}]}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}]}], "]"}]}], "]"}], 
    ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<T_drag\>\"", 
      ",", "\"\<T_drag = c0 diag[1 + (4 eps/5)(2E - e_i)], independent of a\>\
\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"bl", "[", "\"\<T_drag\>\"", "]"}], "-", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"4", 
             RowBox[{"eps", "/", "5"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", 
                RowBox[{"(", 
                 RowBox[{"e1", "+", "e2", "+", "e3"}], ")"}]}], "-", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"e1", ",", "e2", ",", "e3"}], "}"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}]}], "]"}], "]"}]}], "]"}]}], "]"}], 
    ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<T_th, B\>\"", 
      ",", "\"\<T_th = B = B^T = 0 at this order\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"bl", "[", "\"\<T_th\>\"", "]"}], ",", 
         RowBox[{"bl", "[", "\"\<B\>\"", "]"}], ",", 
         RowBox[{"bl", "[", "\"\<Bt\>\"", "]"}]}], "}"}], "]"}]}], "]"}]}], 
   "}"}], "]"}]], "Input",ExpressionUUID->"152fc39e-d4c9-44fe-87f5-\
dfc75637b2d5"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["f_th",
  FontWeight->"Bold"],
 ":   ",
