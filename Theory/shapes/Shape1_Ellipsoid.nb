Cell[TextData[{
 StyleBox["Why ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e89fc526-2981-48fb-aec3-73c71f445ee1"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "08e13873-603c-4568-b885-855fe6fdfacc"],
 StyleBox[" vanish exactly.",
  FontWeight->"Bold"],
 " Under inversion through the centre (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold"], " ", "\[RightArrow]", " ", "-", 
    StyleBox["r",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "e51525c4-c9c9-441e-ac3e-297185955648"],
 "), forces and velocities (polar vectors) change sign but torques and \
angular velocities (axial vectors) do not. A body that is its own inversion \
image can therefore have no polar-to-axial coupling: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ead9d50c-09e1-47bf-833c-15302efbd93b"],
 " (torque per gradient) and ",
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e94b49a8-8a06-404a-87e8-aa5fbe51b654"],
 " (force per angular velocity) must vanish identically. The next check \
confirms this with the full numerical quadrature of the exact ellipsoid at \
finite ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "0eabfcfa-b6ec-4129-9204-740b063f8288"],
 ". It also compares the quadrature with the first-order formulas at small ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "f14930ec-3825-466a-b179-645f76f21b0e"],
 ", where the error should shrink like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "5015867f-59f1-4532-939c-178aa1e8cf26"],
 "."
}], "Text",ExpressionUUID->"6c6000cb-868d-44a0-92ce-3c779870f825"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bn", "=", 
      RowBox[{"pt", "[", "\"\<blocks\>\"", "]"}]}], ",", "sym1", ",", "err"}],
     "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"sym1", "[", "e_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"makeParticle", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"nn", ",", 
              RowBox[{
               RowBox[{"Rellipsoid", "[", "nn", "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"eps", "->", "e"}], ",", 
                 RowBox[{"e1", "->", "1"}], ",", 
                 RowBox[{"e2", "->", "0"}], ",", 
                 RowBox[{"e3", "->", 
                  RowBox[{"-", "1"}]}]}], "}"}]}]}], "]"}], ",", "ell", ",", 
            "rhoP", ",", "gas"}], "]"}]}], ",", "s"}], "}"}], ",", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"shE", "[", "\"\<blocks\>\"", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "->", "1"}], ",", 
            RowBox[{"eps", "->", "e"}], ",", 
            RowBox[{"e1", "->", "1"}], ",", 
            RowBox[{"e2", "->", "0"}], ",", 
            RowBox[{"e3", "->", 
             RowBox[{"-", "1"}]}]}], "}"}]}]}], ";", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<f_th\>\"", 
              "]"}], "/", 
             RowBox[{"p", "[", "\"\<gamma0\>\"", "]"}]}], "-", 
            RowBox[{"s", "[", "\"\<f_th\>\"", "]"}]}], "]"}], ",", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<f_drag\>\"",
               "]"}], "/", 
             RowBox[{"p", "[", "\"\<xi0\>\"", "]"}]}], "-", 
            RowBox[{"s", "[", "\"\<f_drag\>\"", "]"}]}], "]"}], ",", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_drag\>\"",
               "]"}], "/", 
             RowBox[{"p", "[", "\"\<c0\>\"", "]"}]}], "-", 
            RowBox[{"s", "[", "\"\<T_drag\>\"", "]"}]}], "]"}]}], "]"}]}]}], 
      "]"}]}], ";", 
    RowBox[{"err", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sym1", "[", "0.01", "]"}], ",", 
       RowBox[{"sym1", "[", "0.02", "]"}]}], "}"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{"\"\<centrosymmetry\>\"", 
         ",", "\"\<exact ellipsoid (eps = 0.1): T_th and B vanish to \
quadrature precision\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"bn", "[", "\"\<T_th\>\"", "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"pt", "[", "\"\<gamma0\>\"", "]"}], "ell"}], ")"}]}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"bn", "[", "\"\<B\>\"", "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"pt", "[", "\"\<xi0\>\"", "]"}], "ell"}], ")"}]}], "<", 
           
           RowBox[{"10", "^", 
            RowBox[{"-", "12"}]}]}]}], ",", 
         RowBox[{"\"\<|T_th|/(gamma0 l) = \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"bn", "[", "\"\<T_th\>\"", "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"pt", "[", "\"\<gamma0\>\"", "]"}], "ell"}], ")"}]}], 
           "]"}], "<>", "\"\<,  |B|/(xi0 l) = \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"bn", "[", "\"\<B\>\"", "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"pt", "[", "\"\<xi0\>\"", "]"}], "ell"}], ")"}]}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<first order\>\"", 
         ",", "\"\<quadrature minus first-order formulas scales as eps^2\>\"",
          ",", 
         RowBox[{"3.5", "<", 
          RowBox[{
           RowBox[{"err", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "/", 
           RowBox[{"err", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "<", "4.5"}], ",", 
         RowBox[{"\"\<max error \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"err", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], 
          "<>", "\"\< at eps = 0.01 and \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"err", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], 
          "<>", "\"\< at eps = 0.02\>\""}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"370719f9-841c-444e-9241-ca0697b5fe74"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["centrosymmetry",
  FontWeight->"Bold"],
 ":   ",
 "exact ellipsoid (\[CurlyEpsilon] = 0.1): ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "a5f404c8-4f6e-4b27-848e-3b27b6221b79"],
 " and B vanish to quadrature precision",
 "\n",
 StyleBox["|",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d324fe35-d69f-40c9-8f78-1ba121df76a3"],
 StyleBox["|/(\[Gamma]0 l) = 5.11e-17,  |B|/(\[Xi]0 l) = 1.61e-16",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"9bde2ff4-ca44-4671-a1e7-716f070edd91"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["first order",
  FontWeight->"Bold"],
 ":   ",
 "quadrature minus first-order formulas scales as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "5c0b434e-46f4-4713-b429-c28a98adfa42"],
 "\n",
 StyleBox["max error 4.34e-4 at \[CurlyEpsilon] = 0.01 and 1.74e-3 at \
\[CurlyEpsilon] = 0.02",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
