Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["glide",
  FontWeight->"Bold"],
 ":   ",
 "at 45 deg the glide speed matches the first-order formula to O(\
\[CurlyEpsilon])",
 "\n",
 StyleBox["exact 1.54 mm/s, first order 1.539 mm/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"fe4ceb31-ddce-4e09-856e-5c99ff5feb44"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["no torque",
  FontWeight->"Bold"],
 ":   ",
 "a gliding ellipsoid feels no torque at any orientation"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"212ebe4c-753a-4b9a-9c40-a56aa586c994"],

Cell[TextData[{
 "Over all orientations the glide speed forms a map on the sphere of \
directions ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "05f7e157-bbb0-4531-ae21-471ced15bb59"],
 ". It vanishes at the six principal directions and peaks midway between the \
longest and shortest axes."
}], "Text",ExpressionUUID->"bcdc0d12-f973-403e-8a4e-028e7efe3e3a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListDensityPlot", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "t", ",", 
         RowBox[{"1000", 
          RowBox[{
           RowBox[{"hoverDrift", "[", 
            RowBox[{"pt", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Sin", "[", 
                 RowBox[{"t", "Degree"}], "]"}], 
                RowBox[{"Cos", "[", 
                 RowBox[{"p", "Degree"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"Sin", "[", 
                 RowBox[{"t", "Degree"}], "]"}], 
                RowBox[{"Sin", "[", 
                 RowBox[{"p", "Degree"}], "]"}]}], ",", 
               RowBox[{"Cos", "[", 
                RowBox[{"t", "Degree"}], "]"}]}], "}"}]}], "]"}], 
           "[", "\"\<speed\>\"", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "180", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p", ",", "0", ",", "360", ",", "6"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<azimuth of u (deg)\>\"", 
      ",", "\"\<polar angle of u from z (deg)\>\""}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "480"}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<glide speed (mm/s) versus the vertical direction u in body \
axes\>\""}], ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",ExpressionUUID->"8cce30de-\
badc-4b14-bd3a-43326f092faa"],

