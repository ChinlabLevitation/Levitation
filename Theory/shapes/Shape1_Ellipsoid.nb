Cell[CellGroupData[{

Cell["6. Simulated trajectories", "Section",ExpressionUUID->"de75d0a8-e6ba-4ea3-b824-60a083d9ebcb"],

Cell[TextData[{
 "The simulator integrates the full nonlinear rigid-body equations with the \
complete ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "\[Times]", "9"}], TraditionalForm]],ExpressionUUID->
  "5bc6825a-9b02-4d24-939e-f7e5f35d6bee"],
 " response, gravity at the CoM, and the uniform gradient (no trap). The \
first run starts at rest with the vertical at 45\[Degree] in the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "36635601-5339-4407-826a-2ae6ba3f99dd"],
 "\[Dash]",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "a65940e6-87a1-4992-b63d-086209d08652"],
 " plane, at that orientation's levitation gradient. The second run starts at \
the same orientation with a 400 rad/s spin about the vertical. The spin \
decays within a few milliseconds. It leaves the particle turned about the \
vertical by about 100\[Degree], and also re-tilted a little, because the \
anisotropic rotational drag couples the spin into the tilt. The particle then \
keeps this orientation, and the glide direction turns with it: the \
orientation is neutral."
}], "Text",ExpressionUUID->"533197b0-4996-4e47-9062-fd1646710f18"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"u45", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"45", "Degree"}], "]"}], ",", "0", ",", 
     RowBox[{"Cos", "[", 
      RowBox[{"45", "Degree"}], "]"}]}], "}"}]}], ";", 
  RowBox[{"hd45", "=", 
   RowBox[{"hoverDrift", "[", 
    RowBox[{"pt", ",", "u45"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"run1", "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"pt", ",", 
     RowBox[{"hd45", "[", "\"\<G\>\"", "]"}], ",", 
     RowBox[{"qFromTo", "[", 
      RowBox[{"u45", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1."}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"run2", "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"pt", ",", 
     RowBox[{"hd45", "[", "\"\<G\>\"", "]"}], ",", 
     RowBox[{"qFromTo", "[", 
      RowBox[{"u45", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"400", "u45"}], ",", "1."}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uLab", "[", "st_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"quatR", "[", 
      RowBox[{"st", "[", 
       RowBox[{"[", 
        RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], "]"}], ".", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ts", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.", ",", "1.", ",", "400"}], "]"}]}], ",", "s1", ",", "s2"}],
     "}"}], ",", 
   RowBox[{
    RowBox[{"s1", "=", 
     RowBox[{
      RowBox[{"run1", "[", "\"\<state\>\"", "]"}], "/@", "ts"}]}], ";", 
    RowBox[{"s2", "=", 
     RowBox[{
      RowBox[{"run2", "[", "\"\<state\>\"", "]"}], "/@", "ts"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "6"}], 
               RowBox[{"s1", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"10", "^", "6"}], 
               RowBox[{"s2", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"Placed", "[", 
              RowBox[{
               RowBox[{"{", 
                
                RowBox[{"\"\<from rest\>\"", 
                 ",", "\"\<with initial spin about Z\>\""}], "}"}], ",", 
               "Below"}], "]"}]}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<top view, 1 s\>\""}], ",", 
            RowBox[{"ImageSize", "->", "330"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"Axes", "->", "False"}]}], "]"}], ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1000", "ts"}], ",", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"s1", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], "}"}], "]"}],
               ",", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1000", "ts"}], ",", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"s2", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "3"}], "]"}], "]"}]}]}], "}"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<t (ms)\>\"", ",", "\"\<Z (um)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<height\>\""}], ",", 
            RowBox[{"ImageSize", "->", "330"}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "}"}], "]"}], ",", 
       
       RowBox[{"check", "[", 
        RowBox[{"\"\<straight line\>\"", 
         ",", "\"\<run 1: orientation constant and the CoM glides in a \
straight line at the predicted velocity\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"uLab", "[", 
              RowBox[{"s1", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", "u45"}], "]"}], 
           "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], "&&", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"s1", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", 
                RowBox[{"4", ";;", "6"}]}], "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"quatR", "[", 
               RowBox[{"s1", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"7", ";;", "10"}]}], "]"}], "]"}], "]"}], ".", 
              RowBox[{"hd45", "[", "\"\<v_body\>\"", "]"}]}]}], "]"}], "<", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}], 
            RowBox[{"Norm", "[", 
             RowBox[{"hd45", "[", "\"\<v_body\>\"", "]"}], "]"}]}]}]}], ",", 
         RowBox[{"\"\<glide speed \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"1000", 
            RowBox[{"Norm", "[", 
             RowBox[{"s1", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", 
                RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], "]"}]}], "]"}], 
          "<>", "\"\< mm/s (predicted \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"1000", 
            RowBox[{"hd45", "[", "\"\<speed\>\"", "]"}]}], "]"}], 
          "<>", "\"\< mm/s), vertical velocity \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"s1", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "6"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< m/s\>\""}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<neutral\>\"", 
         ",", "\"\<run 2: the spin decays and leaves the body in a new \
orientation that it keeps; the glide direction turns with it\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"s2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"11", ";;", "13"}]}], "]"}], "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], "&&", 
          RowBox[{
           RowBox[{
            RowBox[{"VectorAngle", "[", 
             RowBox[{
              RowBox[{"s1", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], ",", 
              RowBox[{"s2", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"4", ";;", "5"}]}], "]"}], "]"}]}], "]"}], "/", 
            "Degree"}], ">", "20"}], "&&", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"uLab", "[", 
              RowBox[{"s2", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", 
             RowBox[{"uLab", "[", 
              RowBox[{
               RowBox[{"run2", "[", "\"\<state\>\"", "]"}], "[", "0.5", "]"}],
               "]"}]}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}]}]}], ",", 
         RowBox[{"\"\<glide direction turned by \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"VectorAngle", "[", 
             RowBox[{
              RowBox[{"s1", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], ",", 
              RowBox[{"s2", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"4", ";;", "5"}]}], "]"}], "]"}]}], "]"}], "/", 
            "Degree"}], "]"}], "<>", "\"\< deg; tilt changed by \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"VectorAngle", "[", 
             RowBox[{
              RowBox[{"uLab", "[", 
               RowBox[{"s2", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ",", "u45"}], "]"}],
             "/", "Degree"}], "]"}], 
          "<>", "\"\< deg (T_drag is anisotropic); speed \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"1000", 
            RowBox[{"Norm", "[", 
             RowBox[{"s2", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", 
                RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], "]"}]}], "]"}], 
          "<>", "\"\< mm/s; final |omega| = \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"Norm", "[", 
            RowBox[{"s2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"11", ";;", "13"}]}], "]"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< rad/s\>\""}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"4cc36399-545e-4ed2-9433-7f2afb845b35"],

