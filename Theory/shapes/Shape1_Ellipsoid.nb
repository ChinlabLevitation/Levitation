Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"checks: \"", "13", "\"  (\"", "13", "\" verified)\""},
      "RowDefault"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"item\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"statement\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"result\"\>",
          StripOnInput->False,
          FontWeight->Bold]},
        {"\<\"surface\"\>", "\<\"the regular form equals the ellipsoid on the \
unit sphere\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"convex\"\>", "\<\"the default body is convex (smallest \
principal curvature > 0)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"quadrature\"\>", "\<\"numerical mass, CoM and inertia match the \
exact ellipsoid\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"f_th\"\>", "\<\"f_th = gamma0 diag[1 + (2 eps/5)((3 - a) E - (4 \
- 3 a) e_i)]\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"f_drag\"\>", "\<\"f_drag = xi0 diag[1 + (2 eps/5)(3E - 4 e_i + \
8a(3 e_i - E)/(8 + pi a))]\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"T_drag\"\>", "\<\"T_drag = c0 diag[1 + (4 eps/5)(2E - e_i)], \
independent of a\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"T_th, B\"\>", "\<\"T_th = B = B^T = 0 at this order\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"centrosymmetry\"\>", "\<\"exact ellipsoid (eps = 0.1): T_th and \
B vanish to quadrature precision\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"first order\"\>", "\<\"quadrature minus first-order formulas \
scales as eps^2\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"glide\"\>", "\<\"at 45 deg the glide speed matches the \
first-order formula to O(eps)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"no torque\"\>", "\<\"a gliding ellipsoid feels no torque at any \
orientation\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"straight line\"\>", "\<\"run 1: orientation constant and the \
CoM glides in a straight line at the predicted velocity\"\>", "\<\"VERIFIED\"\
\>"},
        {"\<\"neutral\"\>", "\<\"run 2: the spin decays and leaves the body \
in a new orientation that it keeps; the glide direction turns with it\"\>", "\
\<\"VERIFIED\"\>"}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
           GrayLevel[0.85]}},
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"4c257cd3-1e40-4ba3-bf74-712be3fc4dae"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Shape.",
  FontWeight->"Bold"],
 " ",
 StyleBox["Rellipsoid[{x_, y_, z_}] := 1/Sqrt[x^2/a1^2 + y^2/a2^2 + z^2/a3^2]",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], " ", "=", " ", "1", " ", "+", " ", 
    "\[CurlyEpsilon]", " ", 
    SubscriptBox["e", "i"]}], TraditionalForm]],ExpressionUUID->
  "ff367a3a-b892-45a8-9e11-c6544135f26a"],
 "; defaults ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"5fd9e16f-d373-4dfd-a15e-551a60297ea4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "e", " ", "=", " ", "(", "1", ",", " ", "0", ",", " ", "-", "1", ")"}], 
   TraditionalForm]],ExpressionUUID->"aa590dc4-9315-4eff-a9f4-4e17e49ad216"],
 "."
}], "Item",ExpressionUUID->"f2cd1d77-5bf3-47d9-9d1f-547b5d4f47b0"],

Cell[TextData[{
 StyleBox["Tensors.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "dfa656c5-58f4-4e08-9d30-b542f2d7b0b3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f33e9475-4912-4a58-b03e-18dbae31dd4b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "02081542-b277-43cd-ae1b-398aed24c457"],
 " are diagonal in the principal axes, with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"eb27d14c-2af7-44a0-bc1f-ad59aef00447"],
 " forms of Section 4. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", 
    StyleBox["B",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"8a815f58-def1-48c0-b23c-bb17e6f8fd51"],
 " exactly, because the body is centrosymmetric."
}], "Item",ExpressionUUID->"6410a152-73ae-49e1-95fe-1584ae0d2784"],

Cell[TextData[{
 StyleBox["Motion.",
  FontWeight->"Bold"],
 " There is no torque, so the orientation is neutral and any spin decays. At \
levitation a tilted ellipsoid glides in a straight line at up to 1.5 mm/s for \
the defaults, fastest when the vertical lies midway between the longest and \
shortest axes."
}], "Item",ExpressionUUID->"8e3b0443-4df7-4337-894e-c011aba9649e"],

Cell[TextData[{
 StyleBox["Orbit.",
  FontWeight->"Bold"],
 " None: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"fb822d98-dd2f-4573-b79f-2e2795d9a9bb"],
 ", no period. An ellipsoid is achiral, and more strongly it is \
centrosymmetric, so it cannot turn a vertical gradient into a torque. Shape 2 \
adds a CoM offset, and Shape 3 adds odd harmonics."
}], "Item",ExpressionUUID->"ba0d935e-77a2-497a-a98f-d6cb2409c213"]
}, Open  ]]
}, Open  ]]
},
