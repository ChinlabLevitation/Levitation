Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["quadrature",
  FontWeight->"Bold"],
 ":   ",
 "numerical mass, CoM and inertia match the exact ellipsoid",
 "\n",
 StyleBox["M = 3.32e-11 kg,  I/(M el",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "2"], TraditionalForm]],ExpressionUUID->
  "1b73809e-2070-4d22-828c-9813ff35df31"],
 StyleBox[") = {0.362, 0.404, 0.442}",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"c9d49a6b-1a49-4e0c-ba46-eb7215016c09"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Diagram", "Section",ExpressionUUID->"5c523e9c-754a-4ce5-a9b4-e1017b27f1e4"],

Cell[TextData[{
 "The diagram shows the default body, coloured by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "-", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "8f946c29-db8b-431a-9918-cccdd85e5305"],
 " (red is long, blue is short), with its body axes. The black dot is the \
geometric centre, which here is also the CoM and the centre of force. The \
symmetry group is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"2", "h"}]], TraditionalForm]],ExpressionUUID->
  "4a41a5de-f3e0-4d66-8ff5-dea93ff11100"],
 ": three mirror planes, three two-fold axes, and inversion through the \
centre."
}], "Text",ExpressionUUID->"e6a4f688-7bab-41d2-946c-315e87304d5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
