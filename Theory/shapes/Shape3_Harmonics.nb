Cell[CellGroupData[{

Cell["7.4 Orbital radius and period", "Subsection",ExpressionUUID->"1633b795-0b51-40db-9045-36a92d5b7ce9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"Step", "-", 
        RowBox[{"6", " ", "particle", " "}]}],
       FontSlant->"Plain"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], ",", 
        "\[ThickSpace]", 
        RowBox[{"\[Chi]", " ", "=", " ", 
         RowBox[{"20", "\[Degree]"}]}], ",", "\[ThickSpace]", 
        RowBox[{"b", " ", "=", " ", "3"}], ",", "\[ThickSpace]", 
        RowBox[{"l", " ", "=", " ", 
         RowBox[{"20", "\[ThinSpace]", "\[Mu]", 
          StyleBox["m",
           FontSlant->"Plain"]}]}], ",", "\[ThickSpace]", 
        RowBox[{
         SubscriptBox["\[Rho]", "p"], " ", "=", " ", 
         RowBox[{"1", "\[ThinSpace]", 
          StyleBox[
           RowBox[{"g", "/", 
            SuperscriptBox["cm", "3"]}],
           FontSlant->"Plain"]}]}], ",", "\[ThickSpace]", 
        RowBox[{"5", "\[ThickSpace]", 
         StyleBox["Torr",
          FontSlant->"Plain"]}], ",", "\[ThickSpace]", 
        RowBox[{"300", "\[ThickSpace]", 
         StyleBox["K",
          FontSlant->"Plain"]}]}], ")"}]}], ":", 
     RowBox[{"\:2003", " ", 
      SubscriptBox["R", 
       StyleBox["orbit",
        FontSlant->"Plain"]]}]}], " ", "=", " ", 
    RowBox[{"24.5", "\[ThinSpace]", "\[Mu]", 
     StyleBox["m",
      FontSlant->"Plain"]}]}], " ", ",", 
   RowBox[{
    RowBox[{"\:2003", " ", 
     SubscriptBox["T", 
      StyleBox["orbit",
       FontSlant->"Plain"]]}], " ", "=", " ", 
    RowBox[{"0.436", "\[ThickSpace]", 
     RowBox[{
      StyleBox["s",
       FontSlant->"Plain"], "\[ThickSpace]", "(", 
      RowBox[{"\[CapitalOmega]", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", "14.4"}], "\[ThickSpace]", 
        StyleBox[
         RowBox[{
         "rad", "/", "s", ",", "\[ThickSpace]", "clockwise", "\[ThickSpace]", 
          "from", "\[ThickSpace]", "above"}],
         FontSlant->"Plain"]}]}], ")"}]}]}], " ", ",", 
   RowBox[{
    RowBox[{"\:2003", " ", "|", 
     RowBox[{"\[Del]", " ", "T"}], "|"}], " ", "=", " ", 
    RowBox[{"67.3", "\[ThickSpace]", 
     StyleBox[
      RowBox[{"K", "/", "cm"}],
      FontSlant->"Plain"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"c1f86c2a-0c28-41c8-a456-c9f58bebfc23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<\>\"", ",", "\"\<orbital radius (um)\>\"", 
       ",", "\"\<period (s)\>\"", ",", "\"\<Omega (rad/s)\>\""}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"\"\<leading-order formula\>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"loOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<period\>\"", "]"}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<Omega\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<exact steady state\>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"stOrb", "[", "\"\<period\>\"", "]"}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"stOrb", "[", "\"\<Omega\>\"", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<simulation (15-20 s)\>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"orbMeas", "[", "\"\<R\>\"", "]"}]}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"orbMeas", "[", "\"\<period\>\"", "]"}], "]"}], ",", 
       RowBox[{"num", "[", 
        RowBox[{"orbMeas", "[", "\"\<Omega\>\"", "]"}], "]"}]}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Center"}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]], "Input",Expression\
UUID->"d50ab409-9257-4b92-8fba-cb08e2aeeb7c"],

