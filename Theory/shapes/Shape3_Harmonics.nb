Cell[TextData[{
 StyleBox["Spin rates and the stability rule.",
  FontWeight->"Bold"],
 " To leading order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], " ", "\[TildeTilde]", " ", 
    SubscriptBox["c", "0"], 
    StyleBox["I",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "fe20d372-776f-4144-b6d0-18b4b6f69e57"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "\[TildeTilde]", " ", "M", "g", "/", 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "5837871a-5916-49c5-9f77-c99c9dea2a5b"],
 ". The steady spins are then about the real eigenvectors ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "46123f83-9124-4eb5-ac44-7174f67bf0bd"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], "~"], " ", "\[Congruent]", " ", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], "/", "(", 
    SubscriptBox["\[Gamma]", "0"], "l", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"bf5db1e5-6093-4e76-b75a-c59e7d36c14c"],
 ", with rate"
}], "Text",ExpressionUUID->"072fd415-2005-4e98-992c-cea0aeebe731"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[CapitalOmega]", " ", "=", " ", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], 
   OverscriptBox["\[Lambda]", "~"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"M", "g", "l"}], 
    SubscriptBox["c", "0"]], " ", "=", " ", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], 
   OverscriptBox["\[Lambda]", "~"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{
     SubscriptBox["\[Rho]", "p"], "g"}], 
    RowBox[{"a", "\[Alpha]"}]], " ", "\:2003\:2003", " ", "(", 
   SubscriptBox["\[Rho]", "p"], "g", "/", "a", "\[Alpha]", " ", "\[TildeTilde]",
    " ", "5.4", "\[Times]", 
   SuperscriptBox["10", "3"], "\[ThickSpace]", 
   StyleBox[
    SuperscriptBox["s", 
     RowBox[{"-", "1"}]],
    FontSlant->"Plain"], "\[ThickSpace]", 
   StyleBox[
    RowBox[{"at", " ", "5", " ", "Torr"}],
    FontSlant->"Plain"], ")"}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"3a25ce8a-08e9-48f3-9fb5-1c946e72383e"],

Cell[TextData[{
 "Which spin is stable follows from criterion (41b) of the notes. For a \
traceless spectrum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "1"], " ", "<", " ", 
    SubscriptBox["\[Lambda]", "2"], " ", "<", " ", 
    SubscriptBox["\[Lambda]", "3"]}], TraditionalForm]],ExpressionUUID->
  "b75e0ae7-e3c1-469a-ad3d-cb6869a4c41a"],
 " it reduces to a compact rule. The stable axis is the ",
 StyleBox["extreme",
  FontSlant->"Italic"],
 " eigenvector whose eigenvalue has the same sign as the middle one, provided \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["\[Lambda]", "2"], "|"}], TraditionalForm]],ExpressionUUID->
  "3267cd6d-e380-4891-9bd3-02f91f989b24"],
 " exceeds ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SqrtBox["3"], " ", "-", " ", "1", ")", "/", "2", " ", "\[TildeTilde]", 
    " ", "0.366"}], TraditionalForm]],ExpressionUUID->
  "83c5c266-77ba-44da-adf7-7e23fa91a678"],
 " of it. So ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "bb87d6e1-cafe-40d1-bdb5-b35e988e50ae"],
 " is stable when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.366", " ", "<", " ", 
    SubscriptBox["\[Lambda]", "2"], "/", 
    SubscriptBox["\[Lambda]", "3"], " ", "<", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"0a597c87-74e2-4e4b-a491-de38f93784d0"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "8719c9bc-f6c6-4b38-a755-e480d03e9a27"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.366", " ", "<", " ", 
    SubscriptBox["\[Lambda]", "2"], "/", 
    SubscriptBox["\[Lambda]", "1"], " ", "<", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"c48802fc-d796-4797-8eed-a4e81722ef76"],
 ". Otherwise no spin is stable. For example, a uniaxial ",
 Cell[BoxData[
  FormBox[
   StyleBox["Q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cd16411d-059c-4d19-8264-966f9b1d46f5"],
 " gives the spectrum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "-", "\[Mu]", ",", " ", "0", ",", " ", "\[Mu]", ")"}], 
   TraditionalForm]],ExpressionUUID->"ed1ec648-d9cb-45b6-b46b-44ff859d9be9"],
 ", which never spins stably."
}], "Text",ExpressionUUID->"f463c802-4f0f-4395-bbf3-9685a1033944"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"crit", "[", "l_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{"Sort", "[", "l", "]"}]}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "=", "i"}], ",", "j", ",", "m"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"j", ",", "m"}], "}"}], "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
             RowBox[{"{", "k", "}"}]}], "]"}]}], ";", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"s", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "-", 
               RowBox[{"s", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"s", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "-", 
               RowBox[{"s", "[", 
                RowBox[{"[", "m", "]"}], "]"}]}], ")"}]}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"s", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"s", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"s", "[", 
                 RowBox[{"[", "m", "]"}], "]"}]}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"s", "[", 
               RowBox[{"[", "m", "]"}], "]"}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"s", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"s", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ">", 
            "0"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rule", "[", "l_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{"Sort", "[", "l", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"s", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ">", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "3", "]"}], "-", "1"}], ")"}], "/", "2"}]}], 
        "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"s", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "<", "1"}]}], ",", "False", ",", 
       
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"s", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ">", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", "3", "]"}], "-", "1"}], ")"}], "/", "2"}]}], 
        "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"s", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "<", "1"}]}]}], "}"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"check", "[", 
  RowBox[{"\"\<stability rule\>\"", 
   ",", "\"\<for 20000 random traceless spectra, criterion (41b) equals the \
ratio rule\>\"", ",", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"l", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "2"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"l", ",", 
            RowBox[{"-", 
             RowBox[{"Total", "[", "l", "]"}]}]}], "]"}], ";", 
          RowBox[{
           RowBox[{"crit", "[", "l", "]"}], "==", 
           RowBox[{"rule", "[", "l", "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", "20000", "}"}]}], "]"}], ",", "TrueQ"}], "]"}]}], 
  "]"}]}], "Input",ExpressionUUID->"87448a1a-cd8e-4e0a-af7c-5b83f040a028"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["stability rule",
  FontWeight->"Bold"],
 ":   ",
 "for 20000 random traceless spectra, criterion (41b) equals the ratio rule"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"43b538f3-dfb5-43fd-a855-def2fb6b170f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
6. Step 5: the twisted ellipsoid, which spins but cannot orbit\
\>", "Section",ExpressionUUID->"345a2b7e-3217-48db-adc0-0de63bfad8ac"],

Cell[TextData[{
 "Take a triaxial ellipsoid aligned with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "a7b9ac03-908a-472a-b6e2-1795b298f603"],
 " harmonic:"
}], "Text",ExpressionUUID->"f3594c03-b225-465f-8731-317cba33da96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q0", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "5"}], ",", 
      RowBox[{
       RowBox[{"-", "4"}], "/", "5"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"b0", "=", "3"}], ";", 
  RowBox[{"eps0", "=", 
   RowBox[{"1", "/", "10"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sD2", "=", 
   RowBox[{
    RowBox[{"Y2", "[", "Q0", "]"}], "+", 
    RowBox[{"b0", "x", "y", "z"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"RD2", "=", 
   RowBox[{"toR", "[", 
    RowBox[{"sD2", ",", "eps0"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<s = \>\"", ",", 
    RowBox[{"TraditionalForm", "[", "sD2", "]"}], ",", "\"\<      eps = \>\"",
     ",", "eps0", ",", "\"\<,   convexity margin = \>\"", ",", 
    RowBox[{"num", "[", 
     RowBox[{"convexityMargin", "[", "RD2", "]"}], "]"}], 
    ",", "\"\< / l\>\""}], "}"}], "]"}]}], "Input",ExpressionUUID->"62f35fd6-\
2942-4a2b-b488-61d737938fa4"],

Cell[BoxData[
 TemplateBox[{"\"s = \"", 
   TagBox[
    FormBox[
     RowBox[{
       SuperscriptBox["x", "2"], "+", 
       RowBox[{"3", " ", "x", " ", "y", " ", "z"}], "-", 
       FractionBox[
        SuperscriptBox["y", "2"], "5"], "-", 
       FractionBox[
        RowBox[{"4", " ", 
          SuperscriptBox["z", "2"]}], "5"]}], TraditionalForm], 
    TraditionalForm, Editable -> True], "\"      eps = \"", 
   FractionBox["1", "10"], "\",   convexity margin = \"", "\"0.4093\"", 
   "\" / l\""},
  "RowDefault"]], "Output",ExpressionUUID->"2e55564c-5a50-4c91-80b5-\
63b751714559"]
}, Open  ]],

Cell[TextData[{
 "The semi-axes are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "+", " ", "\[CurlyEpsilon]", "(", "1", ",", " ", "-", 
    FractionBox["1", "5"], ",", " ", "-", 
    FractionBox["4", "5"], ")"}], TraditionalForm]],ExpressionUUID->
  "afc9ccca-db3d-459c-a890-b036516bc779"],
 ", and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "c4d56a0d-00f8-4895-a91b-440e9f2c7d81"],
 " bumps carry the chirality. The symmetry group is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "2"], TraditionalForm]],ExpressionUUID->
  "94ba493a-e6bd-4e27-b52c-0ae11f26c41a"],
 ": three two-fold axes and no mirror plane. The diagram's two views show the \
ellipsoid and, from above, the four-lobed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "e1be9220-fa62-46c5-8815-462fadf4673d"],
 " pattern."
}], "Text",ExpressionUUID->"5ee5efa2-3c78-4454-8d30-2743c49abaca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"shapeDiagram", "[", 
     RowBox[{"RD2", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<twisted ellipsoid (D2)\>\""}], ",", 
      RowBox[{"ImageSize", "->", "280"}]}], "]"}], ",", 
    RowBox[{"shapeDiagram", "[", 
     RowBox[{"RD2", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"ViewPoint", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "5"}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<top view\>\""}], ",", 
      RowBox[{"ImageSize", "->", "280"}]}], "]"}]}], "}"}], "]"}]], "Input",Ex\
pressionUUID->"c2b16851-9a47-4c64-91b4-dfbbd922ca14"],

