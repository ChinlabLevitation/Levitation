Cell[TextData[{
 "Beyond second order the exact quadrature gives the answer. For a generic \
(chiral) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "c3efa3b2-25ca-44f7-8ea9-494bb68bc59f"],
 " combination, the torque's antisymmetric part grows as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "3"], TraditionalForm]],ExpressionUUID->
  "65e42d5d-f152-4c22-af44-13cf95ec91f1"],
 ". That part is only a pendulum-like offset between the CoM and the centre \
of force, and cannot drive a spin. The symmetric part grows as ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "5"], TraditionalForm]],ExpressionUUID->
  "2a61088b-3fc2-4291-a9a9-e0073aca5f0c"],
 ", which is negligible in practice."
}], "Text",ExpressionUUID->"aa71a6e8-e085-400a-9f4c-870cfa15aabe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s3gen", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0.7", ",", "0.4", ",", 
      RowBox[{"-", "0.3"}], ",", "0.25", ",", "0.15", ",", 
      RowBox[{"-", "0.2"}]}], "}"}], ".", "Y3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l3scan", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"makeParticle", "[", 
           RowBox[{
            RowBox[{"toR", "[", 
             RowBox[{"s3gen", ",", "e"}], "]"}], ",", "ell", ",", "rhoP", ",",
             "gas"}], "]"}]}], ",", "T"}], "}"}], ",", 
       RowBox[{
        RowBox[{"T", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_th\>\"", 
           "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"p", "[", "\"\<gamma0\>\"", "]"}], "ell"}], ")"}]}]}], ";", 
        RowBox[{"{", 
         RowBox[{"e", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"T", "+", 
              RowBox[{"Transpose", "[", "T", "]"}]}], ")"}], "/", "2"}], 
           "]"}], ",", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"T", "-", 
              RowBox[{"Transpose", "[", "T", "]"}]}], ")"}], "/", "2"}], 
           "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", 
       RowBox[{"{", 
        RowBox[{"0.02", ",", "0.04", ",", "0.08"}], "}"}]}], "}"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
            RowBox[{"sci", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "l3scan"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<eps\>\"", ",", "\"\<|sym T_th|/(gamma0 l)\>\"", 
          ",", "\"\<|antisym T_th|/(gamma0 l)\>\""}], "}"}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<l = 3 scaling\>\"", 
      ",", "\"\<generic l = 3 alone: antisymmetric torque ~ eps^3, symmetric \
torque ~ eps^5\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"2", ",", 
            RowBox[{
             RowBox[{"l3scan", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "3"}], "]"}], "]"}], "/", 
             RowBox[{"l3scan", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "3"}], "]"}], "]"}]}]}], "]"}], "-", "3"}], 
         "]"}], "<", "0.3"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"2", ",", 
            RowBox[{
             RowBox[{"l3scan", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}], "/", 
             RowBox[{"l3scan", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "]"}], "-", "5"}], 
         "]"}], "<", "0.3"}]}], ",", 
      RowBox[{"\"\<local exponents: antisymmetric \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           RowBox[{
            RowBox[{"l3scan", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "3"}], "]"}], "]"}], "/", 
            RowBox[{"l3scan", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "3"}], "]"}], "]"}]}]}], "]"}], ",", "3"}], 
        "]"}], "<>", "\"\<, symmetric \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
           RowBox[{
            RowBox[{"l3scan", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "2"}], "]"}], "]"}], "/", 
            RowBox[{"l3scan", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "]"}], ",", "3"}], 
        "]"}]}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"1b7a20dd-\
4c02-42bc-bbbd-35a702d84dba"],

