Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["D2 spin",
  FontWeight->"Bold"],
 ":   ",
 "the stable steady state spins about the z axis (the C2 axis whose \
eigenvalue shares the middle eigenvalue's sign)",
 "\n",
 StyleBox["\[CapitalOmega] = -14.1 rad/s (leading order -16.7 rad/s)",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"2526f7ab-f722-4284-8138-0d3b42e5ec8f"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["D2 no orbit",
  FontWeight->"Bold"],
 ":   ",
 "spinning about a two-fold axis forces v || u: orbital radius exactly 0"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"1be4e526-e339-447f-802e-b8775eecda35"],

Cell[TextData[{
 StyleBox["Why ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["D", "2"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "ad7c462a-3eb1-4157-a031-cc915b857e06"],
 StyleBox[" cannot orbit.",
  FontWeight->"Bold"],
 " The stable spin axis is a two-fold axis of the body. A half-turn about it \
maps the particle onto itself, so the body-frame velocity must be invariant \
under that half-turn. That forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "\[DoubleVerticalBar]", " ", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "1193f1f5-f713-4915-83a3-004638a75e27"],
 ", and at levitation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"6b3b1d8b-37b5-4c1a-a942-ec8c8da3fb16"],
 ". The particle spins in place. The simulation starts at rest with the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "4599c1fe-1929-42a5-a6a1-fdd218499058"],
 " axis tilted 20\[Degree] from the vertical."
}], "Text",ExpressionUUID->"9dd9c8ba-9dac-4374-879d-fd4dcc6e5b10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"runD2", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"st", "=", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{"smD2", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"simulate", "[", 
      RowBox[{"ptD2", ",", 
       RowBox[{"st", "[", "\"\<G\>\"", "]"}], ",", 
       RowBox[{"qFromTo", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RotationMatrix", "[", 
           RowBox[{
            RowBox[{"20", "Degree"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "0"}], "}"}], "/", 
             RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ".", 
          RowBox[{"st", "[", "\"\<u\>\"", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "12."}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ts", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.", ",", "12.", ",", "1200"}], "]"}]}], ",", "sts", ",", 
     RowBox[{"st", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"smD2", ",", 
        RowBox[{
         RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}]}], "}"}],
    ",", 
   RowBox[{
    RowBox[{"sts", "=", 
     RowBox[{
      RowBox[{"runD2", "[", "\"\<state\>\"", "]"}], "/@", "ts"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLogPlot", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"ts", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"VectorAngle", "[", 
                   RowBox[{
                    RowBox[{"uLab", "[", "#", "]"}], ",", 
                    RowBox[{"st", "[", "\"\<u\>\"", "]"}]}], "]"}], "/", 
                  "Degree"}], "&"}], "/@", "sts"}]}], "}"}], "]"}], ",", 
            RowBox[{"Joined", "->", "True"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              
              RowBox[{"\"\<t (s)\>\"", 
               ",", "\"\<tilt of spin axis from vertical (deg)\>\""}], 
              "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "300"}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<alignment\>\""}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"ts", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"quatR", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ".", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"11", ";;", "13"}], "]"}], "]"}]}], ")"}], "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "&"}], "/@", "sts"}]}], 
              "}"}], "]"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<t (s)\>\"", ",", "\"\<Omega_Z (rad/s)\>\""}], 
              "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "300"}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<spin about the vertical\>\""}], ",", 
            RowBox[{"GridLines", "->", 
             RowBox[{"{", 
              RowBox[{"None", ",", 
               RowBox[{"{", 
                RowBox[{"st", "[", "\"\<Omega\>\"", "]"}], "}"}]}], "}"}]}]}],
            "]"}], ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"10", "^", "6"}], 
             RowBox[{"sts", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\""}], "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "260"}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<top view\>\""}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "}"}], "]"}], ",", 
       
       RowBox[{"check", "[", 
        RowBox[{"\"\<D2 simulation\>\"", 
         ",", "\"\<from a 20 deg tilt the particle aligns, spins up to Omega \
and stops moving sideways\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"VectorAngle", "[", 
            RowBox[{
             RowBox[{"uLab", "[", 
              RowBox[{"Last", "[", "sts", "]"}], "]"}], ",", 
             RowBox[{"st", "[", "\"\<u\>\"", "]"}]}], "]"}], "<", 
           RowBox[{"1", "Degree"}]}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"quatR", "[", 
                  RowBox[{"sts", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"7", ";;", "10"}]}], "]"}], "]"}], "]"}], ".", 
                 RowBox[{"sts", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{"11", ";;", "13"}]}], "]"}], "]"}]}], ")"}], "[", 
               
               RowBox[{"[", "3", "]"}], "]"}], "/", 
              RowBox[{"st", "[", "\"\<Omega\>\"", "]"}]}], "-", "1"}], "]"}], 
           "<", "0.01"}], "&&", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"sts", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], "]"}], "<", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", "2"}]}], 
            RowBox[{"Norm", "[", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"4", ";;", "5"}], "]"}], "]"}], "]"}], "&"}], "/@",
                "sts"}], "]"}], "]"}]}]}]}], ",", 
         RowBox[{"\"\<final tilt \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"VectorAngle", "[", 
             RowBox[{
              RowBox[{"uLab", "[", 
               RowBox[{"Last", "[", "sts", "]"}], "]"}], ",", 
              RowBox[{"st", "[", "\"\<u\>\"", "]"}]}], "]"}], "/", "Degree"}],
            "]"}], "<>", "\"\< deg, final Omega_Z = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"quatR", "[", 
               RowBox[{"sts", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", 
                  RowBox[{"7", ";;", "10"}]}], "]"}], "]"}], "]"}], ".", 
              RowBox[{"sts", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", 
                 RowBox[{"11", ";;", "13"}]}], "]"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}], 
          "<>", "\"\< rad/s, net horizontal displacement \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"10", "^", "6"}], 
            RowBox[{"Norm", "[", 
             RowBox[{"sts", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", 
                RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], "]"}]}], "]"}], 
          "<>", "\"\< um\>\""}]}], "]"}]}], "}"}], "]"}]}]}], "]"}]}], "Input",\
ExpressionUUID->"65ca157f-ff8e-459e-b0f0-dd7fbbec2287"],

