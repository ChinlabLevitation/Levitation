  0.92, 0.97, 0.92],ExpressionUUID->"611dde7a-14a8-4a3b-be0c-88a17c3c36b1"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["leading order",
  FontWeight->"Bold"],
 ":   ",
 "the leading-order formulas agree with the exact steady state to O(\
\[CurlyEpsilon]) (within 25%)",
 "\n",
 StyleBox["R: 22.48 vs 24.53 um; \[CapitalOmega]: -16.98 vs -14.43 rad/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"913ffcb9-9927-4063-8d12-54551acdf5a0"],

Cell[TextData[{
 StyleBox["Convergence.",
  FontWeight->"Bold"],
 " As ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "\[RightArrow]", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"f40f5728-434a-4f1a-bfb8-035e437e0a7d"],
 " the exact solution must approach the leading-order one. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "\[CurlyEpsilon]"}], TraditionalForm]],ExpressionUUID->
  "73c7d5e7-8e70-4674-bda5-962208f5ce96"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "/", 
    SuperscriptBox["\[CurlyEpsilon]", "2"]}], TraditionalForm]],
  ExpressionUUID->"ee4eb131-24a2-4653-ba01-cda64b5bfb89"],
 " should become constant, with relative errors shrinking like ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "7af2fe27-a61c-4355-a832-f5f3a62e490a"],
 ":"
}], "Text",ExpressionUUID->"3d57171b-20a0-4fab-847b-00e34f6267fd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"convTab", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"makeParticle", "[", 
           RowBox[{
            RowBox[{"toR", "[", 
             RowBox[{"sOrb", ",", "e"}], "]"}], ",", "ell", ",", "rhoP", ",", 
            "gas"}], "]"}]}], ",", "sm", ",", "st", ",", "lo"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sm", "=", 
         RowBox[{"steadyMotions", "[", "p", "]"}]}], ";", 
        RowBox[{"lo", "=", 
         RowBox[{"First", "@", 
          RowBox[{"MaximalBy", "[", 
           RowBox[{
            RowBox[{"loOrbit", "[", 
             RowBox[{
              RowBox[{"Qc", "[", "chi0", "]"}], ",", "b0", ",", "e"}], "]"}], 
            ",", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "[", "\"\<u\>\"", "]"}], ".", 
               RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}], "]"}], "&"}]}], 
           "]"}]}]}], ";", 
        RowBox[{"st", "=", 
         RowBox[{"First", "@", 
          RowBox[{"MaximalBy", "[", 
           RowBox[{"sm", ",", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "[", "\"\<u\>\"", "]"}], ".", 
               RowBox[{"lo", "[", "\"\<u\>\"", "]"}]}], "]"}], "&"}]}], 
           "]"}]}]}], ";", 
        RowBox[{"{", 
         RowBox[{"e", ",", 
          RowBox[{
           RowBox[{"10", "^", "6"}], 
           RowBox[{"st", "[", "\"\<R\>\"", "]"}], "e"}], ",", 
          RowBox[{
           RowBox[{"st", "[", "\"\<Omega\>\"", "]"}], "/", 
           RowBox[{"e", "^", "2"}]}], ",", 
          RowBox[{
           RowBox[{"10", "^", "6"}], 
           RowBox[{"lo", "[", "\"\<R\>\"", "]"}], "e"}], ",", 
          RowBox[{
           RowBox[{"lo", "[", "\"\<Omega\>\"", "]"}], "/", 
           RowBox[{"e", "^", "2"}]}], ",", 
          RowBox[{"st", "[", "\"\<stable\>\"", "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", 
       RowBox[{"{", 
        RowBox[{"0.1", ",", "0.05", ",", "0.025", ",", "0.0125"}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "4", "]"}], "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "5", "]"}], "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "/", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "4", "]"}], "]"}]}], "-", "1"}], "]"}], ",", 
              "2"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "/", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "5", "]"}], "]"}]}], "-", "1"}], "]"}], ",", 
              "2"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "6", "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "convTab"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<eps\>\"", ",", "\"\<R eps (um), exact\>\"", 
          ",", "\"\<Omega/eps^2, exact\>\"", ",", "\"\<R eps, leading\>\"", 
          ",", "\"\<Omega/eps^2, leading\>\"", ",", "\"\<rel. err R\>\"", 
          ",", "\"\<rel. err Omega\>\"", ",", "\"\<stable\>\""}], "}"}]}], 
       "]"}], ",", 
      RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<convergence\>\"", 
      ",", "\"\<relative errors of R and Omega fall roughly in proportion to \
eps\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"er", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "/", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "4", "]"}], "]"}]}], "-", "1"}], "]"}], "&"}], "/@",
             "convTab"}]}], ",", 
          RowBox[{"eo", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "/", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "5", "]"}], "]"}]}], "-", "1"}], "]"}], "&"}], "/@",
             "convTab"}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"er", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "<", 
          RowBox[{
           RowBox[{"er", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}], "&&", 
         RowBox[{
          RowBox[{"eo", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "<", 
          RowBox[{
           RowBox[{"eo", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}]}]}], "]"}]}], 
     "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"33a65c39-9439-4f54-\
859f-78251ec7f0e2"],

