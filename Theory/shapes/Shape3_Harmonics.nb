                ShapeLevitation`Private`gv, ShapeLevitation`Private`P, K}, 
              ShapeLevitation`Private`r = 
               ShapeLevitation`Private`Rfun[ShapeLevitation`Private`n] 
                ShapeLevitation`Private`n; 
              ShapeLevitation`Private`gv = 
               Apply[ShapeLevitation`Private`g, ShapeLevitation`Private`r]; 
              ShapeLevitation`Private`P = 
               IdentityMatrix[3] - 
                Outer[Times, ShapeLevitation`Private`gv, 
                  ShapeLevitation`Private`gv]/Dot[
                ShapeLevitation`Private`gv, ShapeLevitation`Private`gv]; 
              K = Dot[ShapeLevitation`Private`P, 
                  Apply[ShapeLevitation`Private`h, ShapeLevitation`Private`r],
                   ShapeLevitation`Private`P]/Norm[
                ShapeLevitation`Private`gv]; Part[
                Sort[
                 Eigenvalues[(K + Transpose[K])/2]], 2]], {
             ShapeLevitation`Private`t, Pi/(2 ShapeLevitation`Private`npts), 
              Pi, Pi/ShapeLevitation`Private`npts}, {
             ShapeLevitation`Private`p, 0, 2 Pi, Pi/
              ShapeLevitation`Private`npts}]]; 
         Min[ShapeLevitation`Private`vals]], 
       TagSet[ShapeLevitation`convexityMargin, 
        MessageName[ShapeLevitation`convexityMargin, "usage"], 
        "convexityMargin[Rfun] is the smallest principal curvature (units \
1/ell) of the surface on a grid; positive means convex."]}; 
     Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",ExpressionUUID->"d7a37a08-\
6ebd-4a8d-9e4e-1a1c0d326db9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Summary", "Section",ExpressionUUID->"d27aeb0d-1809-4b57-b436-98e1dd0b152c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<checks: \>\"", ",", 
       RowBox[{"Length", "[", "$verifications", "]"}], ",", "\"\<  (\>\"", ",", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"$verifications", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", "\"\<VERIFIED\>\""}],
         "]"}], ",", "\"\< verified)\>\""}], "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"$verifications", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<item\>\"", ",", "\"\<statement\>\"", 
           ",", "\"\<result\>\""}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"2c8c6d60-b7ae-4243-bcd6-fbf16c4eed4f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"checks: \"", "22", "\"  (\"", "22", "\" verified)\""},
      "RowDefault"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"item\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"statement\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"result\"\>",
          StripOnInput->False,
          FontWeight->Bold]},
        {"\<\"harmonic\"\>", "\<\"the l = 3 basis polynomials are harmonic \
(zero Laplacian), so each is a pure l = 3 spherical harmonic\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"l = 1\"\>", "\<\"s = z: T_th = 0 about the CoM through \
O(eps^3); the CoM moves by eps\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"l = 2\"\>", "\<\"s = n.Q.n (general Q): T_th = B = 0 and CoM = \
0 through O(eps^2)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"l = 3, first order\"\>", "\<\"an l = 3 harmonic leaves every \
tensor and the CoM unchanged at O(eps)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"l = 3, second order\"\>", "\<\"T_th = 0 through O(eps^2) for a \
general l = 3 surface\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"l = 3 scaling\"\>", "\<\"generic l = 3 alone: antisymmetric \
torque ~ eps^3, symmetric torque ~ eps^5\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"T_th (2 x 3)\"\>", "\<\"symmetric part -(3(4 - 3a)b/35) \
diag(q_yy - q_zz, q_zz - q_xx, q_xx - q_yy); antisymmetric part (2(7 - \
4a)b/35)[w]x\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"CoM (2 x 3)\"\>", "\<\"r_c = (6b/35) eps^2 l (q_yz, q_zx, \
q_xy); at a = 1 the antisymmetric torque is gamma0 [r_c]x\"\>", "\<\"VERIFIED\
\"\>"},
        {"\<\"traceless\"\>", "\<\"T_th is traceless at O(eps^2) (no \
pseudoscalar part)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"first order\"\>", "\<\"f_th, f_drag, T_drag at O(eps) are the \
ellipsoid forms with Q; B = 0 at O(eps)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"stability rule\"\>", "\<\"for 20000 random traceless spectra, \
criterion (41b) equals the ratio rule\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"D2 spin\"\>", "\<\"the stable steady state spins about the z \
axis (the C2 axis whose eigenvalue shares the middle eigenvalue's sign)\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"D2 no orbit\"\>", "\<\"spinning about a two-fold axis forces v \
|| u: orbital radius exactly 0\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"D2 simulation\"\>", "\<\"from a 20 deg tilt the particle \
aligns, spins up to Omega and stops moving sideways\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"convex\"\>", "\<\"the orbiting shape is convex\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"T_th (tilted)\"\>", "\<\"quadrature T_th/eps^2 at eps = 0.01 \
matches the second-order formula\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"orbit exists\"\>", "\<\"exactly one stable steady state pair: \
spin near z with a finite orbit radius\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"leading order\"\>", "\<\"the leading-order formulas agree with \
the exact steady state to O(eps) (within 25%)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"convergence\"\>", "\<\"relative errors of R and Omega fall \
roughly in proportion to eps\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"simulated orbit\"\>", "\<\"the simulated CoM circles with the \
steady-state radius, period and sense\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"pressure\"\>", "\<\"from 2 to 10 Torr the period grows in \
proportion to the pressure, while the radius changes by only a few per cent\"\
\>", "\<\"VERIFIED\"\>"},
        {"\<\"mirror image\"\>", "\<\"the mirror-image particle orbits with \
the same radius and period in the opposite sense\"\>", "\<\"VERIFIED\"\>"}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
           GrayLevel[0.85]}},
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"05dd60c5-774e-4981-b830-4262f5d383f9"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Where chirality enters.",
  FontWeight->"Bold"],
 " For a uniform-density near-sphere the thermophoretic torque about the CoM \
is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"45de4c89-13ee-46fb-baec-26eed7cda9e4"],
 ". It comes only from products of harmonics of adjacent degree. The simplest \
is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "l", " ", "=", " ", "2", " ", "\[Times]", " ", "l", " ", "=", " ", "3"}], 
   TraditionalForm]],ExpressionUUID->"ec895eca-3cfe-464e-bf32-80e7a528be06"],
 ", and it is traceless at this order. Single harmonics give nothing (",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "53d58830-273e-44b4-8782-ab7a012b7baf"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "2"}], TraditionalForm]],ExpressionUUID->
  "b19df25f-7737-489e-9734-0c124f381996"],
 ") or almost nothing (",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "427aaa86-144a-4b94-b59b-363f67fb0e6f"],
 ": symmetric part ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "5"], ")"}], TraditionalForm]],
  ExpressionUUID->"b2b45320-df1d-4dba-8f01-baa0b4acb2d1"],
 ")."
}], "Item",ExpressionUUID->"38413f0c-0491-4975-944e-428cb2c46495"],

Cell[TextData[{
 StyleBox["Simplest spinning shape.",
  FontWeight->"Bold"],
 " ",
 StyleBox["R = 1 + eps (n.Q0.n + b x y z)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 ", an ellipsoid with an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "c7e20121-d7ac-4927-9608-8600af4270ac"],
 " twist (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "2"], TraditionalForm]],ExpressionUUID->
  "5f4ba59e-43b8-4de5-85d5-17f25ad09677"],
 "). It spins steadily about the principal axis selected by the ratio rule, \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], 
    OverscriptBox["\[Lambda]", "~"], 
    SubscriptBox["\[Rho]", "p"], "g", "/", "a", "\[Alpha]"}], 
   TraditionalForm]],ExpressionUUID->"ccb3380c-8b26-49b0-b6c8-67d5bc991f37"],
 ". For the defaults this is about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "14"}], TraditionalForm]],ExpressionUUID->
  "20f8e354-8b8e-4374-89e0-176ce0fb0bc6"],
 " rad/s. By symmetry it spins in place, with orbit radius 0."
}], "Item",ExpressionUUID->"d59fffe3-5f82-4753-ae2a-bedeeb53ed3c"],

Cell[TextData[{
 StyleBox["Simplest orbiting shape.",
  FontWeight->"Bold"],
 " Tilt the ellipsoid against the twist, ",
 StyleBox["R = 1 + eps (n.Q(chi).n + b x y z)",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "da65c335-a8f4-4d89-ad04-59f12f73f32b"],
 "). With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"d40613c8-474b-4ac9-8e8b-75a800010f3e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", " ", "=", " ", "20", "\[Degree]"}], TraditionalForm]],
  ExpressionUUID->"667feae7-66ac-4f4f-aa40-3a0114704176"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", "=", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "f16b96f1-c80f-4d57-9f09-ff38aa6e3a79"],
 ", the orbit has ",
 StyleBox["R = 24.5 \[Micro]m and T = 0.436 s",
  FontWeight->"Bold"],
 ", clockwise seen from above. The mirror image turns the other way. To \
leading order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    FractionBox["a", 
     RowBox[{"a", " ", "+", " ", "\[Beta]"}]], 
    FractionBox[
     RowBox[{"2", "(", "4", " ", "-", " ", "3", "a", ")"}], "5"], 
    FractionBox[
     RowBox[{"|", 
      SubscriptBox[
       RowBox[{"(", 
        StyleBox["Q",
         FontWeight->"Bold"], 
        StyleBox["u",
         FontWeight->"Bold"], ")"}], "\[UpTee]"], "|"}], 
     RowBox[{"\[CurlyEpsilon]", "|", 
      OverscriptBox["\[Lambda]", "~"], "|"}]], "l"}], TraditionalForm]],
  ExpressionUUID->"6e44fed1-96d4-4178-972e-a8e83bc80ba0"],
 ", independent of pressure, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", " ", "2", "\[Pi]", " ", "a", "\[Alpha]", "/", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], "|", 
    OverscriptBox["\[Lambda]", "~"], "|", 
    SubscriptBox["\[Rho]", "p"], "g", ")", " ", "\[Proportional]", " ", "P"}],
    TraditionalForm]],ExpressionUUID->
  "b0929e6c-2a04-4412-8f32-2c3a33f373d4"],
 "."
}], "Item",ExpressionUUID->"556df869-59e4-46a9-9ca5-1bfec18a6dc7"],

Cell[TextData[{
 StyleBox["Ingredients of an orbit.",
  FontWeight->"Bold"],
 " (i) Surface chirality, which gives a symmetric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "368f7796-caa6-4198-8922-73f01b565fbe"],
 " and a steady spin. (ii) A stable spin axis, by the ratio rule of Section \
5. (iii) A spin axis that is not a principal axis of the thermophoretic force \
tensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      StyleBox["Q",
       FontWeight->"Bold"], 
      StyleBox["u",
       FontWeight->"Bold"], ")"}], "\[UpTee]"], " ", "\[NotEqual]", " ", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "a80e0314-a377-4db1-8553-d172cbbcd0c7"],
 ", which gives a lateral velocity that turns with the body. A mass offset \
(Shape 2) supplies none of these."
}], "Item",ExpressionUUID->"5a7d1961-7360-467e-9707-1ad47e032d6a"]
}, Open  ]]
}, Open  ]]
},
