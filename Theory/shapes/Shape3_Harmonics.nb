          ViewPoint -> {1.3, -2.4, 1.6}, PlotLabel -> Row[{"t = ", 
             NumberForm[19 + 0.01 ($CellContext`k$$ - 1), {4, 2}], 
             " s   (red: predicted orbit)"}], ImageSize -> 460]], 
      "Specifications" :> {{{$CellContext`k$$, 1, "frame (10 ms)"}, 1, 101, 1,
          ControlType -> Animator, AnimationRunning -> False}}, 
      "Options" :> {}, "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({
      Attributes[$CellContext`st$] = {Temporary}, 
       Attributes[$CellContext`x$] = {Temporary}, 
       Attributes[$CellContext`R$] = {Temporary}, ShapeLevitation`quatR[{
          Pattern[ShapeLevitation`Private`q0, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q1, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q2, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`q3, 
           Blank[]]}] := (ShapeLevitation`Private`q0^2 - 
          Dot[{ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}]) IdentityMatrix[3] + 
        2 Outer[Times, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}, {
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}] + 
        2 ShapeLevitation`Private`q0 
         ShapeLevitation`hat[{
           ShapeLevitation`Private`q1, ShapeLevitation`Private`q2, 
            ShapeLevitation`Private`q3}], 
       TagSet[ShapeLevitation`quatR, 
        MessageName[ShapeLevitation`quatR, "usage"], 
        "quatR[q] is the rotation matrix of the unit quaternion q (body -> \
lab)."], ShapeLevitation`hat[{
          Pattern[ShapeLevitation`Private`a1, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`a2, 
           Blank[]], 
          Pattern[ShapeLevitation`Private`a3, 
           Blank[]]}] := {{
         0, -ShapeLevitation`Private`a3, ShapeLevitation`Private`a2}, {
         ShapeLevitation`Private`a3, 0, -ShapeLevitation`Private`a1}, {-
          ShapeLevitation`Private`a2, ShapeLevitation`Private`a1, 0}}, 
       TagSet[ShapeLevitation`hat, 
        MessageName[ShapeLevitation`hat, "usage"], 
        "hat[a] is the skew matrix [a]x."], ShapeLevitation`drawBody[
         Pattern[ShapeLevitation`Private`mesh, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`x, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`R, 
          Blank[]], 
         Pattern[ShapeLevitation`Private`scale, 
          Blank[]]] := GraphicsComplex[
         Map[
         ShapeLevitation`Private`x + 
          ShapeLevitation`Private`scale Dot[ShapeLevitation`Private`R, #]& , 
          ShapeLevitation`Private`mesh["pts"]], {
          EdgeForm[], 
          Polygon[
           ShapeLevitation`Private`mesh["polys"]]}, VertexColors -> 
         ShapeLevitation`Private`mesh["cols"]], 
       TagSet[ShapeLevitation`drawBody, 
        MessageName[ShapeLevitation`drawBody, "usage"], 
        "drawBody[mesh, x, R, scale] places the mesh at x with orientation R, \
lengths multiplied by scale."], $CellContext`stOrb = <|
        "u" -> {0.001884759080362338, 0.10938613653393389`, 
          0.993997545679761}, "Omega" -> -14.427158054622982`, "G" -> 
         22.420233152290216`, "gradT (K/cm)" -> 67.26069945687064, 
         "v_body" -> {0.000016746277270639308`, -0.0003513250808990624, 
          0.000038630407827227245`}, "vperp" -> 0.00035383902933404024`, "R" -> 
         0.000024525899556542075`, "period" -> 0.4355109497927921, "residual" -> 
         5.202423529740149*^-13, 
         "rates" -> {-0.328947803477147 - 16.147982208952993` 
           I, -0.328947803477147 + 
           16.147982208952993` I, -211.90779174861882` + 
           0. I, -229.26330696477564` + 0. I, -245.38303172970902` + 
           0. I, -253.57592565461096` - 19.05993017398168 
           I, -253.57592565461096` + 19.05993017398168 I, -266.7737325908978 + 
           0. I}, "stable" -> True, "growth" -> -0.328947803477147|>}; 
     Typeset`initDone$$ = True),
    SynchronousInitialization->True,
