Cell[TextData[{
 "Combine a general quadrupole ",
 Cell[BoxData[
  FormBox[
   StyleBox["Q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7fb74fa0-09b3-48ee-9de7-817bd3942c2d"],
 " with the simplest ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "1b513e4c-feb6-4e71-9212-b25a7e1d4b9e"],
 " harmonic, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "4389b815-a8a9-4307-af3f-ddb8f9cdaf08"],
 " (which on its own is the achiral tetrahedral shape), and keep the \
accommodation coefficient ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "6b76ef07-4d5f-4dff-86d6-93827f198b73"],
 " general:"
}], "Text",ExpressionUUID->"1f243ea8-1752-4451-a93f-724db0041f2d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sh4", "=", 
   RowBox[{"symbolicShape", "[", 
    RowBox[{
     RowBox[{"Rharm", "[", 
      RowBox[{
       RowBox[{"Y2", "[", "Qg", "]"}], "+", 
       RowBox[{"b", "x", "y", "z"}]}], "]"}], ",", "n", ",", "eps", ",", "2", 
     ",", "1", ",", 
     RowBox[{"\"\<Accommodation\>\"", "->", "a"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T4", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Coefficient", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sh4", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_th\>\"", 
       "]"}], ",", "eps", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<T_th/(gamma0 l eps^2) = \>\"", ",", 
       RowBox[{"tf", "[", "T4", "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<CoM/l = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"sh4", "[", "\"\<com\>\"", "]"}], "]"}]}], "}"}], "]"}]}], 
   "}"}], "]"}]}], "Input",ExpressionUUID->"c778b603-ce53-460e-8cd7-\
2fcd66f44e40"],

