Cell[CellGroupData[{

Cell["7.3 Simulated trajectory", "Subsection",ExpressionUUID->"8493b0c1-6b70-4c9c-827e-9534cfd83e5f"],

Cell[TextData[{
 "The particle starts at rest with its spin axis tilted 15\[Degree] from the \
vertical, at the steady state's levitation gradient, and the full nonlinear \
equations run for 20 s. The spin builds up within milliseconds. The axis then \
precesses and slowly aligns (a rate of about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.33", "\[ThickSpace]", 
    StyleBox[
     SuperscriptBox["s", 
      RowBox[{"-", "1"}]],
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "06beb27d-e18e-48c2-acc3-bb0c329539ec"],
 "), and the CoM spirals onto the predicted circle."
}], "Text",ExpressionUUID->"e7e80a8e-ceea-4f3f-abe0-6a5f4edd6966"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"runOrb", "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"ptOrb", ",", 
     RowBox[{"stOrb", "[", "\"\<G\>\"", "]"}], ",", 
     RowBox[{"qFromTo", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationMatrix", "[", 
         RowBox[{
          RowBox[{"15", "Degree"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "0"}], "}"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}]}], "]"}], ".", 
        RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "20."}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"orbMeas", "=", 
   RowBox[{"orbitFromRun", "[", 
    RowBox[{"runOrb", ",", "15.", ",", "20."}], "]"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ts", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.", ",", "20.", ",", "4000"}], "]"}]}], ",", "sts", ",", 
     RowBox[{"ctr", "=", 
      RowBox[{"orbMeas", "[", "\"\<centre\>\"", "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{"sts", "=", 
     RowBox[{
      RowBox[{"runOrb", "[", "\"\<state\>\"", "]"}], "/@", "ts"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"10", "^", "6"}], 
             RowBox[{"sts", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\""}], "}"}]}], ",", 
            RowBox[{
            "PlotLabel", "->", "\"\<top view of the CoM, 0-20 s\>\""}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Dashed", ",", 
               RowBox[{"Circle", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"10", "^", "6"}], "ctr"}], ",", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}]}], "]"}]}], 
              "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "330"}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
          RowBox[{"Column", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ListLinePlot", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"ts", ",", 
                  RowBox[{
                   RowBox[{"10", "^", "6"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", "2"}], "]"}], "]"}], "-", "ctr"}], 
                    "]"}], "&"}], "/@", "sts"}], ")"}]}]}], "}"}], "]"}], ",", 
               RowBox[{"Frame", "->", "True"}], ",", 
               RowBox[{"FrameLabel", "->", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<t (s)\>\"", 
                  ",", "\"\<distance from orbit centre (um)\>\""}], "}"}]}], ",", 
               RowBox[{"ImageSize", "->", "300"}], ",", 
               RowBox[{"GridLines", "->", 
                RowBox[{"{", 
                 RowBox[{"None", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"10", "^", "6"}], 
                    RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "}"}]}], 
                 "}"}]}], ",", 
               RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
             RowBox[{"ListLinePlot", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"ts", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"VectorAngle", "[", 
                    RowBox[{
                    RowBox[{"uLab", "[", "#", "]"}], ",", 
                    RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}], "]"}], "/", 
                    "Degree"}], "&"}], "/@", "sts"}]}], "}"}], "]"}], ",", 
               RowBox[{"Frame", "->", "True"}], ",", 
               RowBox[{"FrameLabel", "->", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<t (s)\>\"", 
                  ",", "\"\<spin-axis tilt from steady (deg)\>\""}], "}"}]}], 
               ",", 
               RowBox[{"ImageSize", "->", "300"}], ",", 
               RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "}"}], "]"}]}], 
         "}"}], "]"}], ",", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"10", "^", "6"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"runOrb", "[", "\"\<state\>\"", "]"}], "[", "#", "]"}],
               "[", 
              RowBox[{"[", 
               RowBox[{"1", ";;", "2"}], "]"}], "]"}], "&"}], "/@", 
            RowBox[{"Subdivide", "[", 
             RowBox[{"17.", ",", "20.", ",", "1500"}], "]"}]}], ")"}]}], ",", 
         
         RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<final orbit, 17-20 s (red dashed: steady-state \
prediction)\>\""}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed", ",", 
            RowBox[{"Circle", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "6"}], "ctr"}], ",", 
              RowBox[{
               RowBox[{"10", "^", "6"}], 
               RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}]}], "]"}], ",", 
            RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{
              RowBox[{"10", "^", "6"}], "ctr"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "330"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "6"}], "ctr"}], "-", 
              RowBox[{"1.3", 
               RowBox[{"10", "^", "6"}], 
               RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"10", "^", "6"}], "ctr"}], "+", 
              RowBox[{"1.3", 
               RowBox[{"10", "^", "6"}], 
               RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}]}]}], "}"}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<simulated orbit\>\"", 
         ",", "\"\<the simulated CoM circles with the steady-state radius, \
period and sense\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"orbMeas", "[", "\"\<R\>\"", "]"}], "/", 
              RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "-", "1"}], "]"}], "<",
            "0.03"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"orbMeas", "[", "\"\<period\>\"", "]"}], "/", 
              RowBox[{"stOrb", "[", "\"\<period\>\"", "]"}]}], "-", "1"}], 
            "]"}], "<", "0.01"}], "&&", 
          RowBox[{
           RowBox[{"Sign", "[", 
            RowBox[{"orbMeas", "[", "\"\<Omega\>\"", "]"}], "]"}], "==", 
           RowBox[{"Sign", "[", 
            RowBox[{"stOrb", "[", "\"\<Omega\>\"", "]"}], "]"}]}]}], ",", 
         RowBox[{"\"\<measured over 15-20 s: R = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{
            RowBox[{"10", "^", "6"}], 
            RowBox[{"orbMeas", "[", "\"\<R\>\"", "]"}]}], "]"}], 
          "<>", "\"\< um, period \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"orbMeas", "[", "\"\<period\>\"", "]"}], "]"}], 
          "<>", "\"\< s, \>\"", "<>", 
          RowBox[{"orbMeas", "[", "\"\<sense\>\"", "]"}], 
          "<>", "\"\<; vertical drift \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"orbMeas", "[", "\"\<vertical drift (m/s)\>\"", "]"}], 
           "]"}], "<>", "\"\< m/s\>\""}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"39030656-8ada-4cf7-8d4d-141832846c23"],

Cell[BoxData[
 TemplateBox[{
