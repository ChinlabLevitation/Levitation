Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["orbit exists",
  FontWeight->"Bold"],
 ":   ",
 "exactly one stable steady state pair: spin near z with a finite orbit \
radius",
 "\n",
 StyleBox["u = (0.00188, 0.109, 0.994), R = 24.53 um, period 0.4355 s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
