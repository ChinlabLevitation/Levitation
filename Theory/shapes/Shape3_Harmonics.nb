          PlotRange -> {{
            Part[{-406.0378822501233, -57.6142192567706}, 1] - 60, 
             Part[{-406.0378822501233, -57.6142192567706}, 1] + 60}, {
            Part[{-406.0378822501233, -57.6142192567706}, 2] - 60, 
             Part[{-406.0378822501233, -57.6142192567706}, 2] + 
             60}, {-381.8385181992785 - 45, -381.8385181992785 + 45}}, 
          BoxRatios -> Automatic, Lighting -> "Neutral", Axes -> True, 
