Cell[TextData[{
 "The exact tensors differ from the leading-order ones by relative ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"f24b8da0-84a0-4a01-a4bc-7d408b77ab76"],
 ", mostly through the size change of the body. The check below repeats the \
comparison at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.01"}], TraditionalForm]],
  ExpressionUUID->"ebb7ad16-1bd8-411c-8799-7f36b173551c"],
 ", where the chiral torque divided by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "a1c3de83-0ce0-4603-be1a-d2ddfcbfb5db"],
 " must match the formula to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"25996888-91da-4e5f-bb85-b483c0ca6f7a"],
 "."
}], "Text",ExpressionUUID->"badd4c61-d92b-4f9e-8fac-2c6387319d0f"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{"makeParticle", "[", 
       RowBox[{
        RowBox[{"toR", "[", 
         RowBox[{"sOrb", ",", "0.01"}], "]"}], ",", "ell", ",", "rhoP", ",", 
        "gas"}], "]"}]}], ",", "Tn"}], "}"}], ",", 
   RowBox[{
    RowBox[{"Tn", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_th\>\"", "]"}], 
      "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", "[", "\"\<gamma0\>\"", "]"}], "ell", 
        RowBox[{"0.01", "^", "2"}]}], ")"}]}]}], ";", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<T_th (tilted)\>\"", 
      ",", "\"\<quadrature T_th/eps^2 at eps = 0.01 matches the second-order \
formula\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"Tn", "-", 
          RowBox[{"T2", "[", 
           RowBox[{"Qn", ",", "b0"}], "]"}]}], "]"}], "/", 
        RowBox[{"Norm", "[", 
         RowBox[{"T2", "[", 
          RowBox[{"Qn", ",", "b0"}], "]"}], "]"}]}], "<", "0.03"}], ",", 
      RowBox[{"\"\<relative difference \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"Tn", "-", 
            RowBox[{"T2", "[", 
             RowBox[{"Qn", ",", "b0"}], "]"}]}], "]"}], "/", 
          RowBox[{"Norm", "[", 
           RowBox[{"T2", "[", 
            RowBox[{"Qn", ",", "b0"}], "]"}], "]"}]}], ",", "3"}], "]"}]}]}], 
     "]"}]}]}], "]"}]], "Input",ExpressionUUID->"e71df9ae-cd3e-4918-a10e-\
ba3cc81704f1"],

