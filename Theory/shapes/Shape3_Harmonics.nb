Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["simulated orbit",
  FontWeight->"Bold"],
 ":   ",
 "the simulated CoM circles with the steady-state radius, period and sense",
 "\n",
 StyleBox["measured over 15-20 s: R = 24.5 um, period 0.4355 s, clockwise \
seen from above; vertical drift -1.00e-8 m/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"04e0ad98-24cc-43c2-8f34-a784b7d949ce"],

Cell["\<\
The animation shows the last second at true scale: the body (radius 20 \
\[Micro]m), its spin axis (blue), and the CoM path. The particle is about as \
large as its orbit, so the motion looks like a wobbling spin whose centre \
traces a circle.\
\>", "Text",ExpressionUUID->"3872fa32-4d57-4353-98a5-7a8178ebb01c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mesh", "=", 
      RowBox[{"bodyMesh", "[", 
       RowBox[{"Rorb", ",", "24"}], "]"}]}], ",", 
     RowBox[{"states", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"runOrb", "[", "\"\<state\>\"", "]"}], "[", "t", "]"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"t", ",", "19.", ",", "20.", ",", "0.01"}], "}"}]}], "]"}]}],
      ",", 
     RowBox[{"ctr", "=", 
      RowBox[{
       RowBox[{"10", "^", "6"}], 
       RowBox[{"orbMeas", "[", "\"\<centre\>\"", "]"}]}]}], ",", 
     RowBox[{"rr", "=", 
      RowBox[{
       RowBox[{"10", "^", "6"}], 
       RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}]}], ",", 
     RowBox[{"zc", "=", 
      RowBox[{
       RowBox[{"10", "^", "6"}], 
       RowBox[{
        RowBox[{
         RowBox[{"runOrb", "[", "\"\<state\>\"", "]"}], "[", "19.5", "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}], ",", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"st", "=", 
          RowBox[{"states", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", "x", ",", "R"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{"10", "^", "6"}], 
          RowBox[{"st", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}], ";", 
        RowBox[{"R", "=", 
         RowBox[{"quatR", "[", 
          RowBox[{"st", "[", 
           RowBox[{"[", 
            RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"drawBody", "[", 
             RowBox[{"mesh", ",", "x", ",", "R", ",", "20"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"Blue", ",", "Thick", ",", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{"x", "+", 
                  RowBox[{"35", 
                   RowBox[{"R", ".", 
                    RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}]}]}]}], "}"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Red", ",", "Thick", ",", 
              RowBox[{"Line", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"ctr", "+", 
                    RowBox[{"rr", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", "p", "]"}], ",", 
                    RowBox[{"Sin", "[", "p", "]"}]}], "}"}]}]}], ",", "zc"}], 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"p", ",", "0", ",", 
                   RowBox[{"2", "Pi"}], ",", 
                   RowBox[{"Pi", "/", "40"}]}], "}"}]}], "]"}], "]"}]}], 
             "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", ">", "1"}], ",", 
              RowBox[{"{", 
               RowBox[{"Black", ",", "Thick", ",", 
                RowBox[{"Line", "[", 
                 RowBox[{
                  RowBox[{"10", "^", "6"}], 
                  RowBox[{"states", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", ";;", "k"}], ",", 
                    RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], "]"}]}], 
               "}"}], ",", "Nothing"}], "]"}]}], "}"}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"ctr", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", "60"}], ",", 
               RowBox[{
                RowBox[{"ctr", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "+", "60"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"ctr", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", "60"}], ",", 
               RowBox[{
                RowBox[{"ctr", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "+", "60"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"zc", "-", "45"}], ",", 
               RowBox[{"zc", "+", "45"}]}], "}"}]}], "}"}]}], ",", 
          RowBox[{"BoxRatios", "->", "Automatic"}], ",", 
          RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
          RowBox[{"Axes", "->", "True"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<X (um)\>\"", ",", "\"\<Y (um)\>\"", 
             ",", "\"\<Z\>\""}], "}"}]}], ",", 
          RowBox[{"ViewPoint", "->", 
           RowBox[{"{", 
            RowBox[{"1.3", ",", 
             RowBox[{"-", "2.4"}], ",", "1.6"}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<t = \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"19", "+", 
                 RowBox[{"0.01", 
                  RowBox[{"(", 
                   RowBox[{"k", "-", "1"}], ")"}]}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"4", ",", "2"}], "}"}]}], "]"}], 
              ",", "\"\< s   (red: predicted orbit)\>\""}], "}"}], "]"}]}], ",", 
          RowBox[{"ImageSize", "->", "460"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "\"\<frame (10 ms)\>\""}], "}"}], ",", 
       "1", ",", "101", ",", "1", ",", 
       RowBox[{"ControlType", "->", "Animator"}], ",", 
       RowBox[{"AnimationRunning", "->", "False"}]}], "}"}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "]"}]}], "]"}]], "Input",Exp\
ressionUUID->"e655f120-95f4-485d-8f56-a174c9645c84"],

