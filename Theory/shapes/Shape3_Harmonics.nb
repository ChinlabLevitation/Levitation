Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"pressure (Torr)\"\>", "\<\"R (um)\"\>", "\<\"period (s)\"\>"},
    {"2.`", "\<\"23.25\"\>", "\<\"0.1741\"\>"},
    {"5.`", "\<\"24.53\"\>", "\<\"0.4355\"\>"},
    {"10.`", "\<\"24.56\"\>", "\<\"0.871\"\>"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"4b9b1fc0-9b82-4893-bbfb-27fc37e7dd9c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["pressure",
  FontWeight->"Bold"],
 ":   ",
 "from 2 to 10 Torr the period grows in proportion to the pressure, while the \
radius changes by only a few per cent",
 "\n",
 StyleBox["R changes by 5.3% (inertial corrections M \[CapitalOmega]/\[Xi]0 \
and I \[CapitalOmega]/c0, which grow as 1/P); period ratio 5. for a pressure \
ratio of 5",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"cedd96fe-3db5-445b-8526-25d5558fcbaa"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["mirror image",
  FontWeight->"Bold"],
 ":   ",
 "the mirror-image particle orbits with the same radius and period in the \
opposite sense",
 "\n",
 StyleBox["\[CapitalOmega] = 14.43 rad/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"2a1493b9-65e0-46bd-a2b3-7be6175917f3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Interactive explorer", "Section",ExpressionUUID->"d24ca02b-9248-4326-a1ab-94b89358fdbb"],

Cell[TextData[{
 "Tick ",
 StyleBox["compute",
  FontWeight->"Bold"],
 ", then choose the deformation ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "1ea543dd-0569-4217-9a57-fd16070e5fd3"],
 ", the tilt ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]],ExpressionUUID->
  "f626f463-e813-4708-bf4a-75d3216a4ec4"],
 ", the twist ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "f0049508-5112-435d-9eec-76573521ffb1"],
 ", and the particle and gas parameters. The explorer recomputes the tensors \
by quadrature (on a coarser 32 \[Times] 64 grid), finds every steady state, \
and runs the full equations from rest with the vertical tilted 10\[Degree] \
off the stable axis (or off ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "1cbc55f2-e6dc-4435-ba51-d430b27929c3"],
 " if none is stable). Each update takes a second or two."
}], "Text",ExpressionUUID->"43d6a886-7e3a-4cc1-993b-7a8ded6d5800"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", "go"}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Set the parameters, then tick \\\"compute\\\" (each update \
takes a second or two).\>\"", ",", "13", ",", "Italic"}], "]"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"gasModel", "[", 
           RowBox[{"<|", 
            RowBox[{"\"\<PTorr\>\"", "->", "pT"}], "|>"}], "]"}]}], ",", "p", 
         ",", "sm", ",", "st", ",", "run", ",", "ts", ",", "sts", ",", "u0"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"makeParticle", "[", 
          RowBox[{
           RowBox[{"toR", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{"Y2", "[", 
                RowBox[{"Qc", "[", 
                 RowBox[{"chi", "Degree"}], "]"}], "]"}], "+", 
               RowBox[{"bb", "x", "y", "z"}]}], "]"}], ",", "e"}], "]"}], ",", 
           RowBox[{"rad", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}], ",", 
           RowBox[{"rhoc", "1000."}], ",", "g", ",", 
           RowBox[{"1", "&"}], ",", "32", ",", "64"}], "]"}]}], ";", 
        RowBox[{"sm", "=", 
         RowBox[{"steadyMotions", "[", "p", "]"}]}], ";", 
        RowBox[{"st", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{"sm", ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], ";", 
        
        RowBox[{"u0", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MissingQ", "[", "st", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1."}], "}"}], ",", 
           RowBox[{"st", "[", "\"\<u\>\"", "]"}]}], "]"}]}], ";", 
        RowBox[{"run", "=", 
         RowBox[{"simulate", "[", 
          RowBox[{"p", ",", 
           RowBox[{"If", "[", 
            RowBox[{
