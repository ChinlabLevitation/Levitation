 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["convex",
  FontWeight->"Bold"],
 ":   ",
 "the orbiting shape is convex",
 "\n",
