Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["D2 simulation",
  FontWeight->"Bold"],
 ":   ",
 "from a 20 deg tilt the particle aligns, spins up to \[CapitalOmega] and \
stops moving sideways",
 "\n",
 StyleBox["final tilt 0.01756 deg, final ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "a2bc1dbd-5fca-4b8d-b9be-d56dc46ce2ae"],
 StyleBox[" = -14.1 rad/s, net horizontal displacement 844. um",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"2cad3c59-8677-4f08-8cab-ac2c4ebee16e"],

Cell[TextData[{
 "The alignment is slow, at a rate of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalOmega]", "2"], "I", "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "a18d57a8-c32d-40f0-90cc-dd99c70834f7"],
 ". While the axis precesses in, the tilted body glides, and the particle \
wanders several hundred micrometres sideways in a looping path. Once aligned \
it spins in place. The spin sense is fixed by the handedness of the body: \
flipping ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "83d3d58c-c3b3-48e7-8786-523daa245326"],
 " (the mirror-image particle) reverses ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],ExpressionUUID->
  "edde815c-0e16-4da7-b847-575f4caa853e"],
 "."
}], "Text",ExpressionUUID->"71969277-56d5-43b7-9dfd-4676d562ad73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
7. Step 6: tilt the ellipsoid against the twist, and it orbits\
\>", "Section",ExpressionUUID->"617e3d19-c07a-4057-a718-a0ea3ce15d24"],

Cell[TextData[{
 "Tilt the ellipsoid by an angle ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]],ExpressionUUID->
  "044141c4-0927-4dcc-8098-bd803a6e42ff"],
 " about the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "87dc7e75-ba4c-4e1c-ab9e-b7fae4e80102"],
 " axis while keeping the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "e5849889-bdde-4ec2-8728-53bc7f01ce4b"],
 " harmonic fixed. The ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "bd8335d2-3825-4b31-ba0c-be89d23dc2db"],
 " axis is the only two-fold axis left (symmetry ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "18b67ecc-2017-46ec-98b6-2e97a6cc862f"],
 "), and ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "263610b2-6e74-46a3-9752-329a055bdd47"],
 " is not the spin axis. The stable spin stays close to ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "8cc1184e-8528-402f-b60d-ba2bdb4281cc"],
 ", which is no longer a symmetry axis, so the body-frame velocity can have a \
horizontal part that rotates with the body: a circular orbit."
}], "Text",ExpressionUUID->"5557f84d-d2dc-4c72-9d76-2c32acc70064"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Qc", "[", "chi_", "]"}], ":=", 
   RowBox[{
    RowBox[{"RotationMatrix", "[", 
     RowBox[{"chi", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], ".", "Q0", ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"RotationMatrix", "[", 
      RowBox[{"chi", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chi0", "=", 
   RowBox[{"20", "Degree"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sOrb", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"Y2", "[", 
      RowBox[{"Qc", "[", "chi0", "]"}], "]"}], "+", 
     RowBox[{"b0", "x", "y", "z"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rorb", "=", 
   RowBox[{"toR", "[", 
    RowBox[{"sOrb", ",", "eps0"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<s = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"N", "[", 
         RowBox[{"sOrb", ",", "4"}], "]"}], "]"}], 
       ",", "\"\<      (chi = 20 deg, b = 3, eps = 0.1)\>\""}], "}"}], "]"}], 
    ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Q(chi) = \>\"", ",", 
       RowBox[{"tf", "[", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Qc", "[", "chi0", "]"}], ",", "4"}], "]"}], "]"}]}], "}"}],
      "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<convex\>\"", ",", "\"\<the orbiting shape is convex\>\"", ",", 
      RowBox[{
       RowBox[{"convexityMargin", "[", "Rorb", "]"}], ">", "0"}], ",", 
      RowBox[{"\"\<smallest principal curvature \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"convexityMargin", "[", "Rorb", "]"}], "]"}], 
       "<>", "\"\< / l\>\""}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUU\
ID->"daf1f2aa-58df-48d9-8a39-2e35f7044771"],

Cell[BoxData[
 TemplateBox[{"\"s = \"", 
   TagBox[
    FormBox[
     RowBox[{
       SuperscriptBox["x", "2"], "+", 
       RowBox[{"3.`4.", " ", "x", " ", "y", " ", "z"}], "-", 
       RowBox[{"0.2701866670643065892`4.", " ", 
         SuperscriptBox["y", "2"]}], "+", 
       RowBox[{"0.3856725658119235952`4.", " ", "y", " ", "z"}], "-", 
       RowBox[{"0.7298133329356934106`4.", " ", 
         SuperscriptBox["z", "2"]}]}], TraditionalForm], TraditionalForm, 
    Editable -> True], "\"      (chi = 20 deg, b = 3, eps = 0.1)\""},
  "RowDefault"]], "Output",ExpressionUUID->"8e42bf50-75ad-4726-8a2b-\
69e50cfd8042"],

Cell[BoxData[
 TemplateBox[{"\"Q(chi) = \"", 
   TagBox[
    FormBox[
     TagBox[
      RowBox[{"(", "\[NoBreak]", 
        GridBox[{{"1.`4.", "0", "0"}, {"0", 
           RowBox[{"-", "0.2701866670643065892`4."}], 
           "0.1928362829059617976`4."}, {"0", "0.1928362829059617976`4.", 
           RowBox[{"-", "0.7298133329356934106`4."}]}}, RowSpacings -> 1, 
         ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> 
         Center], "\[NoBreak]", ")"}], 
      Function[BoxForm`e$, 
       MatrixForm[BoxForm`e$]]], TraditionalForm], TraditionalForm, Editable -> 
    True]},
  "RowDefault"]], "Output",ExpressionUUID->"04eaf8de-dcbc-4083-8809-\
7ef739844e31"]
}, Open  ]],

