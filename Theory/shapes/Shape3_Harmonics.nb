Cell[CellGroupData[{

Cell["7.2 Predicted orbit: leading order and exact", "Subsection",ExpressionUUID->"54fe3e02-90d4-4cd9-9fde-8d9a1129a29b"],

Cell[TextData[{
 StyleBox["Leading order.",
  FontWeight->"Bold"],
 " Take the real eigenpair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    OverscriptBox["\[Lambda]", "~"], ",", " ", 
    StyleBox["u",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "5221cfcb-facd-4e16-bb47-1858d354c816"],
 " of ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], "~"], TraditionalForm]],ExpressionUUID->
  "07a13175-54a8-43a2-aa2d-69b6333327ee"],
 ". Levitation sets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", 
    SubscriptBox["\[Gamma]", "0"], " ", "\[TildeTilde]", " ", "M", "g"}], 
   TraditionalForm]],ExpressionUUID->"0f5fd9e8-3053-4a5d-b4c2-17ba87584309"],
 ". The spin is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "=", " ", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], 
    OverscriptBox["\[Lambda]", "~"], "M", "g", "l", "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "622149d6-a3be-4ada-b99f-034516395792"],
 ". The horizontal body-frame velocity (notes Eq. 43) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], " ", "=", " ", "(", "M", "g", "/", 
    SubscriptBox["\[Xi]", "0"], ")", 
    SubscriptBox[
     RowBox[{"[", "(", 
      SubscriptBox[
       StyleBox["f",
        FontWeight->"Bold"], 
       StyleBox["th",
        FontSlant->"Plain"]], "/", 
      SubscriptBox["\[Gamma]", "0"], " ", "-", " ", 
      StyleBox["I",
       FontWeight->"Bold"], ")", 
      StyleBox["u",
       FontWeight->"Bold"], "]"}], "\[UpTee]"], " ", "=", " ", "-", 
    FractionBox[
     RowBox[{"2", "(", "4", " ", "-", " ", "3", "a", ")"}], "5"], 
    "\[CurlyEpsilon]", "(", "M", "g", "/", 
    SubscriptBox["\[Xi]", "0"], ")", 
    SubscriptBox[
     RowBox[{"(", 
      StyleBox["Q",
       FontWeight->"Bold"], 
      StyleBox["u",
       FontWeight->"Bold"], ")"}], "\[UpTee]"]}], TraditionalForm]],
  ExpressionUUID->"6ac00ef2-5be4-4e50-bca7-9c0ff50b32ca"],
 ". It rotates with the body, so the CoM moves on a circle of radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "|", "/", "|", "\[CapitalOmega]", 
    "|"}], TraditionalForm]],ExpressionUUID->
  "4eef7597-b23a-4805-a35a-8d4f20559eee"],
 ":"
}], "Text",ExpressionUUID->"73c3ffb2-b478-42ad-82f8-e68c0b907467"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], " ", "=", " ", 
   FractionBox["a", 
    RowBox[{"a", " ", "+", " ", "\[Beta]"}]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"2", "(", "4", " ", "-", " ", "3", "a", ")"}], "5"], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"|", 
     SubscriptBox[
      RowBox[{"(", 
       StyleBox["Q",
        FontWeight->"Bold"], 
       StyleBox["u",
        FontWeight->"Bold"], ")"}], "\[UpTee]"], "|"}], 
    RowBox[{"\[CurlyEpsilon]", "\[ThinSpace]", "|", 
     OverscriptBox["\[Lambda]", "~"], "|"}]], "\[ThickSpace]", "l", " ", ",", 
   " ", "\:2003\:2003", " ", 
   SubscriptBox["T", 
    StyleBox["orbit",
     FontSlant->"Plain"]], " ", "=", " ", 
   FractionBox[
    RowBox[{"2", "\[Pi]"}], 
    RowBox[{"|", "\[CapitalOmega]", "|"}]], " ", "=", " ", 
   FractionBox[
    RowBox[{"2", "\[Pi]"}], 
    RowBox[{
     SuperscriptBox["\[CurlyEpsilon]", "2"], "|", 
     OverscriptBox["\[Lambda]", "~"], "|"}]], "\[ThinSpace]", 
   FractionBox[
    RowBox[{"a", "\[Alpha]"}], 
    RowBox[{
     SubscriptBox["\[Rho]", "p"], "g"}]], " ", ",", " ", "\:2003\:2003", " ", 
   "\[Beta]", " ", "=", " ", "2", " ", "-", " ", "a", " ", "+", " ", 
   FractionBox[
    RowBox[{"\[Pi]", " ", "a"}], "4"]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"811e8c40-9f29-4df7-9781-c11a8ad4c238"],

Cell[TextData[{
 "At this order the radius is purely geometric: it is independent of the gas \
pressure, the particle density and the temperature. The period scales with \
pressure and inversely with density. An orbit needs ",
 StyleBox["both",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Lambda]", "~"], " ", "\[NotEqual]", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"495a48f7-8850-4131-8d01-04acdd863dbc"],
 " (surface chirality) ",
 StyleBox["and",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      StyleBox["Q",
       FontWeight->"Bold"], 
      StyleBox["u",
       FontWeight->"Bold"], ")"}], "\[UpTee]"], " ", "\[NotEqual]", " ", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "51aa2a87-a36c-46e1-b473-a4c21d0c3e2b"],
 " (the spin axis must not be a principal axis of the ellipsoid part). The \
twisted ellipsoid of Step 5 fails the second condition."
}], "Text",ExpressionUUID->"cb41e7f5-d6db-4c7e-bed5-1bd3b68e80f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"loOrbit", "[", 
    RowBox[{"Q_", ",", "bb_", ",", "e_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ev", ",", "vecs", ",", 
       RowBox[{"Mgl", "=", 
        RowBox[{"rhoP", 
         RowBox[{"$gEarth", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gas", "[", "\"\<a\>\"", "]"}], 
            RowBox[{"gas", "[", "\"\<alpha\>\"", "]"}]}], ")"}]}]}]}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ev", ",", "vecs"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"T2", "[", 
         RowBox[{
          RowBox[{"N", "[", "Q", "]"}], ",", "bb"}], "]"}], "]"}]}], ";", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"Im", "[", 
             RowBox[{"ev", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ">", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}], ",", "Nothing", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"u", "=", 
               RowBox[{"Normalize", "[", 
                RowBox[{"Re", "[", 
                 RowBox[{"vecs", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}]}], ",", 
              RowBox[{"lam", "=", 
               RowBox[{"Re", "[", 
                RowBox[{"ev", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ",", "qu"}], "}"}], 
            ",", 
            RowBox[{
             RowBox[{"qu", "=", 
              RowBox[{
               RowBox[{"N", "[", "Q", "]"}], ".", "u"}]}], ";", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<u\>\"", "->", "u"}], ",", 
               RowBox[{"\"\<lambda\>\"", "->", "lam"}], ",", 
               RowBox[{"\"\<Omega\>\"", "->", 
                RowBox[{
                 RowBox[{"e", "^", "2"}], "lam", "Mgl"}]}], ",", 
               RowBox[{"\"\<R\>\"", "->", 
                RowBox[{"ell", 
                 RowBox[{"4", "/", 
                  RowBox[{"(", 
                   RowBox[{"8", "+", "Pi"}], ")"}]}], 
                 RowBox[{"2", "/", "5"}], 
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{"qu", "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"qu", ".", "u"}], ")"}], "u"}]}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"e", 
                    RowBox[{"Abs", "[", "lam", "]"}]}], ")"}]}]}]}], ",", 
               RowBox[{"\"\<period\>\"", "->", 
                RowBox[{"2", 
                 RowBox[{"Pi", "/", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"e", "^", "2"}], "lam", "Mgl"}], "]"}]}]}]}]}], 
              "|>"}]}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smOrb", "=", 
   RowBox[{"steadyMotions", "[", "ptOrb", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stOrb", "=", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{"smOrb", ",", 
     RowBox[{
      RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"loOrb", "=", 
   RowBox[{"First", "@", 
    RowBox[{"MaximalBy", "[", 
     RowBox[{
      RowBox[{"loOrbit", "[", 
       RowBox[{
        RowBox[{"Qc", "[", "chi0", "]"}], ",", "b0", ",", "eps0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"#", "[", "\"\<u\>\"", "]"}], ".", 
         RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}], "]"}], "&"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{"\"\<exact steady states (full 6x9 response, eps = 0.1):\>\"", ",",
       "Bold"}], "]"}], ",", 
    RowBox[{"motionGrid", "[", "smOrb", "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<leading order for the same axis: \>\"", ",", "Bold"}], 
        "]"}], ",", "\"\<u = \>\"", ",", 
       RowBox[{"vec", "[", 
        RowBox[{
         RowBox[{"Sign", "[", 
          RowBox[{
           RowBox[{"loOrb", "[", "\"\<u\>\"", "]"}], ".", 
           RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}]}], "]"}], 
         RowBox[{"loOrb", "[", "\"\<u\>\"", "]"}]}], "]"}], 
       ",", "\"\<,  lambda = \>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<lambda\>\"", "]"}], "]"}], 
       ",", "\"\<,  Omega = \>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<Omega\>\"", "]"}], "]"}], 
       ",", "\"\< rad/s,  R = \>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"loOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], 
       ",", "\"\< um,  period = \>\"", ",", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<period\>\"", "]"}], "]"}], 
       ",", "\"\< s\>\""}], "}"}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<orbit exists\>\"", 
      ",", "\"\<exactly one stable steady state pair: spin near z with a \
finite orbit radius\>\"", ",", 
      RowBox[{
       RowBox[{"stOrb", "=!=", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "&&", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "7"}]}], "<", 
        RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}], ">", "0.95"}]}], ",", 
      RowBox[{"\"\<u = \>\"", "<>", 
       RowBox[{"vec", "[", 
        RowBox[{"stOrb", "[", "\"\<u\>\"", "]"}], "]"}], 
       "<>", "\"\<, R = \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], 
       "<>", "\"\< um, period \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"stOrb", "[", "\"\<period\>\"", "]"}], "]"}], 
       "<>", "\"\< s\>\""}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<leading order\>\"", 
      ",", "\"\<the leading-order formulas agree with the exact steady state \
to O(eps) (within 25%)\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"loOrb", "[", "\"\<R\>\"", "]"}], "/", 
           RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "-", "1"}], "]"}], "<",
         "0.25"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"loOrb", "[", "\"\<Omega\>\"", "]"}], "/", 
           RowBox[{"stOrb", "[", "\"\<Omega\>\"", "]"}]}], "-", "1"}], "]"}], 
        "<", "0.25"}]}], ",", 
      RowBox[{"\"\<R: \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"loOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], 
       "<>", "\"\< vs \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], 
         RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "]"}], 
       "<>", "\"\< um; Omega: \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"loOrb", "[", "\"\<Omega\>\"", "]"}], "]"}], 
       "<>", "\"\< vs \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"stOrb", "[", "\"\<Omega\>\"", "]"}], "]"}], 
       "<>", "\"\< rad/s\>\""}]}], "]"}]}], "}"}], "]"}]}], "Input",Expression\
UUID->"a72f8c0a-93c3-4356-886f-18619e4f44d1"],

Cell[BoxData[
 StyleBox["\<\"exact steady states (full 6x9 response, eps = 0.1):\"\>",
  StripOnInput->False,
  FontWeight->Bold]], "Output",ExpressionUUID->"fc7b30e1-f9fd-4d9c-9bdb-\
1c136d7823bf"],

