Cell[TextData[{
 StyleBox["Dependence on the tilt, the pressure and the handedness.",
  FontWeight->"Bold"],
 " The next cell varies ",
 Cell[BoxData[
  FormBox["\[Chi]", TraditionalForm]],ExpressionUUID->
  "a35ca43e-5861-4c6d-867f-ce28623f5cf5"],
 " at fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"25ae0a76-2301-426a-8328-3acbe162401d"],
 ". The radius grows roughly linearly with the tilt, since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      StyleBox["Q",
       FontWeight->"Bold"], 
      StyleBox["u",
       FontWeight->"Bold"], ")"}], "\[UpTee]"], " ", "\[Proportional]", " ", 
    StyleBox["sin",
     FontSlant->"Plain"], "2", "\[Chi]"}], TraditionalForm]],ExpressionUUID->
  "d1b0a8e7-5e6f-4940-8ec4-9a5416c0bbfa"],
 ", until the spin loses stability near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", " ", "\[TildeTilde]", " ", "30", "\[Degree]"}], 
   TraditionalForm]],ExpressionUUID->"f6f0e671-a5d8-45ae-b69b-54b8684966e9"],
 "\[Dash]",
 Cell[BoxData[
  FormBox[
   RowBox[{"45", "\[Degree]"}], TraditionalForm]],ExpressionUUID->
  "121fe407-f644-4157-a235-fd1dbf593ed8"],
 ". Varying the pressure changes the period in proportion. The radius changes \
by only a few per cent, through the inertial corrections ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "\[CapitalOmega]", "/", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "3d861315-ade1-4e71-8fe4-6de40fd52123"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "\[CapitalOmega]", "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "35223255-8a0d-43b6-baa9-e676563f4b22"],
 ", which grow at low pressure. The mirror-image particle (",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", "\[RightArrow]", " ", "-", "b"}], TraditionalForm]],
  ExpressionUUID->"e0047ce6-2a26-4dd5-abe7-b91da8ceda03"],
 " together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", " ", "\[RightArrow]", " ", "-", "\[Chi]"}], 
   TraditionalForm]],ExpressionUUID->"820097a5-6d91-471e-b7e2-64de4d1c29c1"],
 ") orbits with the same radius in the opposite sense."
}], "Text",ExpressionUUID->"f176f03b-e1ba-449c-bddf-4e6585e63984"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chiScan", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"makeParticle", "[", 
           RowBox[{
            RowBox[{"toR", "[", 
             RowBox[{
              RowBox[{"Expand", "[", 
               RowBox[{
                RowBox[{"Y2", "[", 
                 RowBox[{"Qc", "[", 
                  RowBox[{"c", "Degree"}], "]"}], "]"}], "+", 
                RowBox[{"b0", "x", "y", "z"}]}], "]"}], ",", "eps0"}], "]"}], 
            ",", "ell", ",", "rhoP", ",", "gas", ",", 
            RowBox[{"1", "&"}], ",", "32", ",", "64"}], "]"}]}], ",", "st"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"st", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"steadyMotions", "[", "p", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&&", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<u\>\"", "]"}], "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}], ">", "0.8"}]}], 
            "&"}]}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MissingQ", "[", "st", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"Missing", "[", "]"}], ",", 
            RowBox[{"Missing", "[", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{
             RowBox[{"10", "^", "6"}], 
             RowBox[{"st", "[", "\"\<R\>\"", "]"}]}], ",", 
            RowBox[{"st", "[", "\"\<period\>\"", "]"}]}], "}"}]}], "]"}]}]}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "0", ",", "40", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"presScan", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"gasModel", "[", 
           RowBox[{"<|", 
            RowBox[{"\"\<PTorr\>\"", "->", "P"}], "|>"}], "]"}]}], ",", "p", ",",
          "st"}], "}"}], ",", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"makeParticle", "[", 
          RowBox[{"Rorb", ",", "ell", ",", "rhoP", ",", "g", ",", 
           RowBox[{"1", "&"}], ",", "32", ",", "64"}], "]"}]}], ";", 
        RowBox[{"st", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"steadyMotions", "[", "p", "]"}], ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], ";", 
        
        RowBox[{"{", 
         RowBox[{"P", ",", 
          RowBox[{
           RowBox[{"10", "^", "6"}], 
           RowBox[{"st", "[", "\"\<R\>\"", "]"}]}], ",", 
          RowBox[{"st", "[", "\"\<period\>\"", "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"P", ",", 
       RowBox[{"{", 
        RowBox[{"2.", ",", "5.", ",", "10."}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mirror", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{"makeParticle", "[", 
        RowBox[{
         RowBox[{"toR", "[", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{
             RowBox[{"Y2", "[", 
              RowBox[{"Qc", "[", 
               RowBox[{"-", "chi0"}], "]"}], "]"}], "-", 
             RowBox[{"b0", "x", "y", "z"}]}], "]"}], ",", "eps0"}], "]"}], ",",
          "ell", ",", "rhoP", ",", "gas"}], "]"}]}], "}"}], ",", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"steadyMotions", "[", "p", "]"}], ",", 
       RowBox[{
        RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"DeleteMissing", "[", 
          RowBox[{
           RowBox[{"chiScan", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", "1", ",", 
           "1"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<tilt chi (deg)\>\"", 
            ",", "\"\<orbital radius (um)\>\""}], "}"}]}], ",", 
         RowBox[{"Mesh", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "300"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<stable orbits, eps = 0.1\>\""}]}], 
        "]"}], ",", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"DeleteMissing", "[", 
          RowBox[{
           RowBox[{"chiScan", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", "1", ",", 
           "1"}], "]"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<tilt chi (deg)\>\"", ",", "\"\<period (s)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"Mesh", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "300"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "All"}], "}"}]}]}], "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
            RowBox[{"num", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
         "presScan"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<pressure (Torr)\>\"", ",", "\"\<R (um)\>\"", 
          ",", "\"\<period (s)\>\""}], "}"}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<pressure\>\"", 
      ",", "\"\<from 2 to 10 Torr the period grows in proportion to the \
pressure, while the radius changes by only a few per cent\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"presScan", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], "/", 
           RowBox[{"presScan", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", "1"}], "]"}], "<", 
        "0.1"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"presScan", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "3"}], "]"}], "]"}], "/", 
             RowBox[{"presScan", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"10", "/", "2"}], ")"}]}], "-", "1"}], "]"}], "<", 
        "0.05"}]}], ",", 
      RowBox[{"\"\<R changes by \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"100", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"presScan", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], "/", 
             RowBox[{"presScan", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", "1"}], "]"}]}], ",",
          "2"}], "]"}], 
       "<>", "\"\<% (inertial corrections M Omega/xi0 and I Omega/c0, which \
grow as 1/P); period ratio \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"presScan", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "3"}], "]"}], "]"}], "/", 
          RowBox[{"presScan", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ",", "3"}], "]"}], 
       "<>", "\"\< for a pressure ratio of 5\>\""}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<mirror image\>\"", 
      ",", "\"\<the mirror-image particle orbits with the same radius and \
period in the opposite sense\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mirror", "[", "\"\<R\>\"", "]"}], "/", 
           RowBox[{"stOrb", "[", "\"\<R\>\"", "]"}]}], "-", "1"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mirror", "[", "\"\<Omega\>\"", "]"}], "/", 
           RowBox[{"stOrb", "[", "\"\<Omega\>\"", "]"}]}], "+", "1"}], "]"}], 
        "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], ",", 
      RowBox[{"\"\<Omega = \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"mirror", "[", "\"\<Omega\>\"", "]"}], "]"}], 
       "<>", "\"\< rad/s\>\""}]}], "]"}]}], "}"}], "]"}]}], "Input",Expression\
UUID->"27986125-0022-4c65-a7ea-ec2f279102fb"],

