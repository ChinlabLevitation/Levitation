 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["T_th (tilted)",
  FontWeight->"Bold"],
 ":   ",
 "quadrature ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "96b13d63-8342-47cc-8b45-57988296adaf"],
 "/",
