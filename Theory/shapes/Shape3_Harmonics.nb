Cell["\<\
Split into its symmetric and antisymmetric parts, the result is\
\>", "Text",ExpressionUUID->"4255a10b-f8ce-41e4-95a7-9ed5fc1346bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Gamma]", "0"], "l", 
     RowBox[{
      SuperscriptBox["\[CurlyEpsilon]", "2"], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"3", "(", "4", " ", "-", " ", "3", "a", ")", "b"}], "35"]}],
         "\[ThinSpace]", 
        RowBox[{
         StyleBox["diag",
          FontSlant->"Plain"], "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["q", 
            RowBox[{"y", "y"}]], " ", "-", " ", 
           SubscriptBox["q", 
            RowBox[{"z", "z"}]]}], ",", "\[ThinSpace]", " ", 
          RowBox[{
           SubscriptBox["q", 
            RowBox[{"z", "z"}]], " ", "-", " ", 
           SubscriptBox["q", 
            RowBox[{"x", "x"}]]}], ",", "\[ThinSpace]", " ", 
          RowBox[{
           SubscriptBox["q", 
            RowBox[{"x", "x"}]], " ", "-", " ", 
           SubscriptBox["q", 
            RowBox[{"y", "y"}]]}]}], ")"}]}], " ", "+", " ", 
       RowBox[{
        FractionBox[
         RowBox[{"2", "(", "7", " ", "-", " ", "4", "a", ")", "b"}], "35"], 
        SubscriptBox[
         RowBox[{"[", 
          StyleBox["w",
           FontWeight->"Bold"], "]"}], "\[Times]"]}]}], "]"}]}]}], " ", ",", 
   " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     StyleBox["w",
      FontWeight->"Bold"]}], " ", "=", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["q", 
       RowBox[{"y", "z"}]], ",", " ", 
      SubscriptBox["q", 
       RowBox[{"z", "x"}]], ",", " ", 
      SubscriptBox["q", 
       RowBox[{"x", "y"}]]}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"99062460-a7a8-487a-bfd2-dec19cf92ad5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "c"], " ", "=", " ", 
   FractionBox[
    RowBox[{"6", "b"}], "35"], "\[ThinSpace]", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], "l", "\[ThinSpace]", 
   StyleBox["w",
    FontWeight->"Bold"]}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"49609aa0-e0df-4bc1-8abd-6f2f78a2c96e"],

Cell[TextData[{
 "Two features stand out. The ",
 StyleBox["symmetric part",
  FontWeight->"Bold"],
 " is the spin-driving chirality. It is traceless, as the selection rules \
require, and depends only on the ",
 StyleBox["diagonal",
  FontSlant->"Italic"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["Q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "399d9f89-14c6-4dae-a413-ec126d2ce379"],
 " in the frame of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "y", "z"}], TraditionalForm]],ExpressionUUID->
  "0a3ce016-c5ed-410f-84e6-d4c484c37bb4"],
 " harmonic, through the cyclic differences ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", 
     RowBox[{"y", "y"}]], " ", "-", " ", 
    SubscriptBox["q", 
     RowBox[{"z", "z"}]]}], TraditionalForm]],ExpressionUUID->
  "90d3ca35-e6a4-412f-a5c3-8d1cb86f1028"],
 " and so on. The ",
 StyleBox["antisymmetric part",
  FontWeight->"Bold"],
 " comes from the off-diagonal elements of ",
 Cell[BoxData[
  FormBox[
   StyleBox["Q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5766cb44-22a0-4176-bdcd-5462d67eb8d1"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "73e5d7a2-07a2-4288-8d55-2a08f274a539"],
 " it is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "c"], "]"}], "\[Times]"]}], TraditionalForm]],
  ExpressionUUID->"f4c6830e-dd8e-40ec-875b-cfa6ceae0629"],
 ": the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "\[Times]", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "5df1f572-19a3-4256-a8b6-8849b96b4e3e"],
 " product also shifts the CoM, by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "c"], " ", "\[Proportional]", " ", 
    StyleBox["w",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "3200b3f4-07c1-411a-8d0c-8848823d4e89"],
 ". The factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", " ", "-", " ", "3", "a"}], TraditionalForm]],ExpressionUUID->
  "bbf00ced-7230-4620-9b29-b8aa131d4660"],
 " is again ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Proportional]", " ", 
    SubscriptBox["C", "n"], " ", "-", " ", 
    SubscriptBox["C", "t"]}], TraditionalForm]],ExpressionUUID->
  "e8b55314-db07-4eab-8a39-057cfac8fd50"],
 ". The other tensors keep their ellipsoid forms at first order, since the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"l", " ", "=", " ", "3"}], TraditionalForm]],ExpressionUUID->
  "919a414d-f63d-462e-869d-837a8b4dbed6"],
 " part enters only at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"a4f31890-0067-482c-8050-d96722e3c43a"],
 ":"
}], "Text",ExpressionUUID->"366f75b1-3d17-4431-9bc9-36b1d62f27bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Gamma]", "0"], "[", 
     RowBox[{
      StyleBox["I",
       FontWeight->"Bold"], " ", "-", " ", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "(", "4", " ", "-", " ", "3", "a", ")"}], "5"], 
       "\[CurlyEpsilon]", 
       StyleBox["Q",
        FontWeight->"Bold"]}]}], "]"}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold"], 
      StyleBox["drag",
       FontSlant->"Plain"]]}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Xi]", "0"], "[", 
     RowBox[{
      StyleBox["I",
       FontWeight->"Bold"], " ", "-", " ", 
      RowBox[{
       FractionBox["2", "5"], 
       RowBox[{"(", 
        RowBox[{"4", " ", "-", " ", 
         FractionBox[
          RowBox[{"24", "a"}], 
          RowBox[{"8", " ", "+", " ", "\[Pi]", " ", "a"}]]}], ")"}], 
       "\[CurlyEpsilon]", 
       StyleBox["Q",
        FontWeight->"Bold"]}]}], "]"}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     SubscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      StyleBox["drag",
       FontSlant->"Plain"]]}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["c", "0"], "[", 
     RowBox[{
      StyleBox["I",
       FontWeight->"Bold"], " ", "-", " ", 
      RowBox[{
       FractionBox["4", "5"], "\[CurlyEpsilon]", 
       StyleBox["Q",
        FontWeight->"Bold"]}]}], "]"}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     StyleBox["B",
      FontWeight->"Bold"]}], " ", "=", " ", 
    RowBox[{"O", "(", 
     SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellFrameColor->GrayLevel[0.4],
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"d3a0c4bc-ab72-4089-accf-74e391a948a5"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b1", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"#", ",", "eps", ",", "1"}], "]"}], "&"}], ",", 
       RowBox[{"sh4", "[", "\"\<blocks\>\"", "]"}], ",", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{"\"\<T_th (2 x 3)\>\"", 
        ",", "\"\<symmetric part -(3(4 - 3a)b/35) diag(q_yy - q_zz, q_zz - \
q_xx, q_xx - q_yy); antisymmetric part (2(7 - 4a)b/35)[w]x\>\"", ",", 
        RowBox[{"zeroQ", "[", 
         RowBox[{"T4", "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], 
             RowBox[{"(", 
              RowBox[{"4", "-", 
               RowBox[{"3", "a"}]}], ")"}], 
             RowBox[{"b", "/", "35"}], 
             RowBox[{"DiagonalMatrix", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"qyy", "-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "qxx"}], "-", "qyy"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "qxx"}], "-", "qyy"}], ")"}], "-", "qxx"}], ",", 
                RowBox[{"qxx", "-", "qyy"}]}], "}"}], "]"}]}], "+", 
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"7", "-", 
               RowBox[{"4", "a"}]}], ")"}], 
             RowBox[{"b", "/", "35"}], 
             RowBox[{"hat", "[", 
              RowBox[{"{", 
               RowBox[{"qyz", ",", "qxz", ",", "qxy"}], "}"}], "]"}]}]}], 
           ")"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<CoM (2 x 3)\>\"", 
        ",", "\"\<r_c = (6b/35) eps^2 l (q_yz, q_zx, q_xy); at a = 1 the \
antisymmetric torque is gamma0 [r_c]x\>\"", ",", 
        RowBox[{
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"sh4", "[", "\"\<com\>\"", "]"}], "-", 
           RowBox[{"6", 
            RowBox[{"b", "/", "35"}], 
            RowBox[{"eps", "^", "2"}], 
            RowBox[{"{", 
             RowBox[{"qyz", ",", "qxz", ",", "qxy"}], "}"}]}]}], "]"}], "&&", 
         
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"T4", "-", 
                RowBox[{"Transpose", "[", "T4", "]"}]}], ")"}], "/", "2"}], "/.", 
             RowBox[{"a", "->", "1"}]}], ")"}], "-", 
           RowBox[{"hat", "[", 
            RowBox[{"6", 
             RowBox[{"b", "/", "35"}], 
             RowBox[{"{", 
              RowBox[{"qyz", ",", "qxz", ",", "qxy"}], "}"}]}], "]"}]}], 
          "]"}]}]}], "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<traceless\>\"", 
        ",", "\"\<T_th is traceless at O(eps^2) (no pseudoscalar part)\>\"", ",", 
        RowBox[{"zeroQ", "[", 
         RowBox[{"Tr", "[", "T4", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<first order\>\"", 
        ",", "\"\<f_th, f_drag, T_drag at O(eps) are the ellipsoid forms with \
Q; B = 0 at O(eps)\>\"", ",", 
        RowBox[{
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"b1", "[", "\"\<f_th\>\"", "]"}], "+", 
           RowBox[{"2", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"4", "-", 
               RowBox[{"3", "a"}]}], ")"}], "/", "5"}], "Qg"}]}], "]"}], "&&", 
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"b1", "[", "\"\<f_drag\>\"", "]"}], "+", 
           RowBox[{
            RowBox[{"2", "/", "5"}], 
            RowBox[{"(", 
             RowBox[{"4", "-", 
              RowBox[{"24", 
               RowBox[{"a", "/", 
                RowBox[{"(", 
                 RowBox[{"8", "+", 
                  RowBox[{"Pi", "a"}]}], ")"}]}]}]}], ")"}], "Qg"}]}], "]"}], 
         "&&", 
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"b1", "[", "\"\<T_drag\>\"", "]"}], "+", 
           RowBox[{
            RowBox[{"4", "/", "5"}], "Qg"}]}], "]"}], "&&", 
         RowBox[{"zeroQ", "[", 
          RowBox[{"b1", "[", "\"\<B\>\"", "]"}], "]"}]}]}], "]"}]}], "}"}], 
    "]"}]}], "]"}]], "Input",ExpressionUUID->"ff4abc85-27cf-4248-a517-\
a9282f04fccb"],

