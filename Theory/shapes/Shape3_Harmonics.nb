Cell[TextData[{
 "At leading order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], "~"], " ", "=", " ", "-", 
    FractionBox[
     RowBox[{"3", "b"}], "35"], "\[ThinSpace]", 
    StyleBox["diag",
     FontSlant->"Plain"], "(", 
    FractionBox["3", "5"], ",", " ", "-", 
    FractionBox["9", "5"], ",", " ", 
    FractionBox["6", "5"], ")"}], TraditionalForm]],ExpressionUUID->
  "ccd9626c-57e7-4eaf-8889-da30b08fb412"],
 ", with eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "(", "-", "0.154", ",", " ", "0.463", ",", " ", "-", "0.309", ")"}], 
   TraditionalForm]],ExpressionUUID->"91987e57-73f5-42d3-bd81-82615d84116e"],
 " along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "x", ",", " ", "y", ",", " ", "z", ")"}], TraditionalForm]],
  ExpressionUUID->"51c514b4-68eb-47ab-9332-6c1b27418b7b"],
 ". The middle eigenvalue belongs to ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "14088e86-828d-4f85-a16c-7d4a3d85138e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "0.154"}], TraditionalForm]],ExpressionUUID->
  "363e7b6f-7cfb-48a4-9945-f3d3fd170190"],
 ") and has the sign of the extreme one on ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "c7ffdf80-4979-4a6e-8d5c-f0ee08af7a88"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "0.309"}], TraditionalForm]],ExpressionUUID->
  "75873076-60ef-4097-a84d-1b4571f22073"],
 "), with ratio 0.5, so ",
 Cell[BoxData[
  FormBox[
   StyleBox["z",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "798aa712-1dc4-4dec-8ccf-6e3383d78a6d"],
 StyleBox[" is the stable spin axis",
  FontWeight->"Bold"],
 ". Its spin rate is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", " ", "\[TildeTilde]", " ", "-", "0.309", "\[ThinSpace]", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], 
    SubscriptBox["\[Rho]", "p"], "g", "/", "a", "\[Alpha]", " ", "=", " ", "-",
     "16.7"}], TraditionalForm]],ExpressionUUID->
  "c61e36eb-e7d8-4f4a-beff-a6020af175b5"],
 " rad/s. Now compare with the exact tensors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "=", " ", "0.1"}], TraditionalForm]],
  ExpressionUUID->"a69c346d-e67a-4e93-aaf3-2ba937ce8b57"],
 ":"
}], "Text",ExpressionUUID->"7aafde94-eba8-4ebd-96da-12951d90691a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ptD2", "=", 
   RowBox[{"makeParticle", "[", 
    RowBox[{"RD2", ",", "ell", ",", "rhoP", ",", "gas"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smD2", "=", 
   RowBox[{"steadyMotions", "[", "ptD2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"motionGrid", "[", "sm_", "]"}], ":=", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"vec", "[", 
            RowBox[{"#", "[", "\"\<u\>\"", "]"}], "]"}], ",", 
           RowBox[{"num", "[", 
            RowBox[{"#", "[", "\"\<Omega\>\"", "]"}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<R\>\"", "]"}], "===", "Infinity"}], 
             ",", "\"\<inf\>\"", ",", 
             RowBox[{"num", "[", 
              RowBox[{
               RowBox[{"10", "^", "6"}], 
               RowBox[{"#", "[", "\"\<R\>\"", "]"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"num", "[", 
            RowBox[{"#", "[", "\"\<period\>\"", "]"}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<stable\>\"", "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<stable\>\"", ",", 
               RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], 
             ",", "\"\<unstable\>\""}], "]"}], ",", 
           RowBox[{"num", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<growth\>\"", "]"}], ",", "3"}], "]"}], ",", 
           RowBox[{"num", "[", 
            RowBox[{"#", "[", "\"\<gradT (K/cm)\>\"", "]"}], "]"}]}], "}"}], 
         "&"}], "/@", "sm"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<spin axis u (body)\>\"", ",", "\"\<Omega (rad/s)\>\"", 
         ",", "\"\<R (um)\>\"", ",", "\"\<period (s)\>\"", 
         ",", "\"\<stability\>\"", ",", "\"\<max Re(rate) (1/s)\>\"", 
         ",", "\"\<|grad T| (K/cm)\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"st", "=", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{"smD2", ",", 
        RowBox[{
         RowBox[{"#", "[", "\"\<stable\>\"", "]"}], "&"}]}], "]"}]}], ",", 
     RowBox[{"lo", "=", 
      RowBox[{
       RowBox[{"-", "3"}], 
       RowBox[{"b0", "/", "35"}], 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"3", "/", "5"}], ",", 
         RowBox[{
          RowBox[{"-", "9"}], "/", "5"}], ",", 
         RowBox[{"6", "/", "5"}]}], "}"}]}]}]}], "}"}], ",", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"motionGrid", "[", "smD2", "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<D2 spin\>\"", 
        ",", "\"\<the stable steady state spins about the z axis (the C2 axis \
whose eigenvalue shares the middle eigenvalue's sign)\>\"", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"st", "[", "\"\<u\>\"", "]"}], "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], "-", "1"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], "&&", 
         RowBox[{
          RowBox[{"st", "[", "\"\<Omega\>\"", "]"}], "<", "0"}]}], ",", 
        RowBox[{"\"\<Omega = \>\"", "<>", 
         RowBox[{"num", "[", 
          RowBox[{"st", "[", "\"\<Omega\>\"", "]"}], "]"}], 
         "<>", "\"\< rad/s (leading order \>\"", "<>", 
         RowBox[{"num", "[", 
          RowBox[{
           RowBox[{"eps0", "^", "2"}], 
           RowBox[{"lo", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "rhoP", 
           RowBox[{"$gEarth", "/", 
            RowBox[{"gas", "[", "\"\<alpha\>\"", "]"}]}]}], "]"}], 
         "<>", "\"\< rad/s)\>\""}]}], "]"}], ",", 
      RowBox[{"check", "[", 
       RowBox[{"\"\<D2 no orbit\>\"", 
        ",", "\"\<spinning about a two-fold axis forces v || u: orbital \
radius exactly 0\>\"", ",", 
        RowBox[{
         RowBox[{"st", "[", "\"\<R\>\"", "]"}], "<", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "12"}]}], "ell"}]}]}], "]"}]}], "}"}], "]"}]}], 
  "]"}]}], "Input",ExpressionUUID->"8d3e3e85-51f8-4e4e-985f-9908e7a5a68e"],

