Cell[CellGroupData[{

Cell["7.1 The four tensors", "Subsection",ExpressionUUID->"85410eea-ffc3-4f78-b187-426e651660d9"],

Cell[TextData[{
 "The formulas of Step 4 with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q",
     FontWeight->"Bold"], " ", "=", " ", 
    StyleBox["Q",
     FontWeight->"Bold"], "(", "\[Chi]", ")"}], TraditionalForm]],
  ExpressionUUID->"379d54e6-6bda-4545-a44d-5ea44d673f86"],
 " give the tensors to leading order (",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "4698b1fa-76c2-4cf0-83d9-d04f5fdf4721"],
 "). ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6dcbcb49-2f05-4800-8d9a-4cbfdcb1d293"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f8a7ccc4-b130-4357-813b-83df34973c04"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f195e91e-a09c-4420-8f7d-1f49f48b2b26"],
 " come from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Q",
     FontWeight->"Bold"], "(", "20", "\[Degree]", ")"}], TraditionalForm]],
  ExpressionUUID->"b7fa4943-38f4-4c23-b49f-60ec7d51a004"],
 " at first order. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "566bb93d-b7a0-4461-bba2-05b45e410991"],
 " is second order, with a symmetric (spin) part and an antisymmetric \
(CoM-offset) part:"
}], "Text",ExpressionUUID->"15051128-fc6a-482b-a156-560b14e5423d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T2", "[", 
    RowBox[{"Q_", ",", "bb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"9", 
        RowBox[{"bb", "/", "105"}]}], ")"}]}], 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "3"}], "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "3"}], "]"}], "]"}], "-", 
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
         RowBox[{"Q", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"6", 
       RowBox[{"bb", "/", "35"}]}], ")"}], 
     RowBox[{"hat", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Q", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "3"}], "]"}], "]"}], ",", 
        RowBox[{"Q", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", 
        RowBox[{"Q", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Qn", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Qc", "[", "chi0", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"loT", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<f_th/gamma0\>\"", "->", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "-", 
       RowBox[{
        RowBox[{"2", "/", "5"}], "eps0", "Qn"}]}]}], ",", 
     RowBox[{"\"\<f_drag/xi0\>\"", "->", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "-", 
       RowBox[{
        RowBox[{"2", "/", "5"}], 
        RowBox[{"(", 
         RowBox[{"4", "-", 
          RowBox[{"24", "/", 
           RowBox[{"(", 
            RowBox[{"8", "+", "Pi"}], ")"}]}]}], ")"}], "eps0", "Qn"}]}]}], ",", 
     RowBox[{"\"\<T_th/(gamma0 l)\>\"", "->", 
      RowBox[{
       RowBox[{"eps0", "^", "2"}], 
       RowBox[{"T2", "[", 
        RowBox[{"Qn", ",", "b0"}], "]"}]}]}], ",", 
     RowBox[{"\"\<T_drag/c0\>\"", "->", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "-", 
       RowBox[{
        RowBox[{"4", "/", "5"}], "eps0", "Qn"}]}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ptOrb", "=", 
   RowBox[{"makeParticle", "[", 
    RowBox[{"Rorb", ",", "ell", ",", "rhoP", ",", "gas"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exT", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<f_th/gamma0\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"ptOrb", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<f_th\>\"", 
        "]"}], "/", 
       RowBox[{"ptOrb", "[", "\"\<gamma0\>\"", "]"}]}]}], ",", 
     RowBox[{"\"\<f_drag/xi0\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"ptOrb", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<f_drag\>\"", 
        "]"}], "/", 
       RowBox[{"ptOrb", "[", "\"\<xi0\>\"", "]"}]}]}], ",", 
     RowBox[{"\"\<T_th/(gamma0 l)\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"ptOrb", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_th\>\"", 
        "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"ptOrb", "[", "\"\<gamma0\>\"", "]"}], "ell"}], ")"}]}]}], ",", 
     RowBox[{"\"\<T_drag/c0\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"ptOrb", "[", "\"\<blocks\>\"", "]"}], "[", "\"\<T_drag\>\"", 
        "]"}], "/", 
       RowBox[{"ptOrb", "[", "\"\<c0\>\"", "]"}]}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"tf", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"loT", "[", "k", "]"}], ",", 
            RowBox[{"10.", "^", 
             RowBox[{"-", "4"}]}]}], "]"}], "]"}], ",", 
         RowBox[{"tf", "[", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"exT", "[", "k", "]"}], ",", 
            RowBox[{"10.", "^", 
             RowBox[{"-", "4"}]}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Keys", "[", "loT", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<tensor\>\"", ",", "\"\<leading order (formulas)\>\"", 
       ",", "\"\<exact quadrature, eps = 0.1\>\""}], "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "Input",ExpressionUUID->\
"636ca604-7881-43d9-8a39-13dd1ad02ca9"],

