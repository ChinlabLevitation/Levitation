 " \[Rho] = 3.4e-11 kg"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"b13f90fe-d290-4055-bf71-8c5496c9cdb4"],

Cell[TextData[{
 StyleBox["Dominant response: thermophoretic force.",
  FontWeight->"Bold"],
 " Using the Waldmann free-molecule result (which is a good approximation \
even at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", " ", "\[TildeTilde]", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"f4f870f7-f27b-44d2-982e-6147be1b63ae"],
 "), the thermophoretic force is"
}], "Text",ExpressionUUID->"ba9d9e81-cbc4-4540-8248-5d8944217124"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["F", "T"], " ", "=", " ", "\[Eta]", 
   FractionBox["\[Kappa]", 
    OverscriptBox["v", "_"]], 
   SuperscriptBox["\[ScriptL]", "2"], "|", "\[Del]", " ", "T", "|", " ", "\[TildeTilde]",
    " ", "9.5", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], "\[ThinSpace]", 
   StyleBox["N",
    FontSlant->"Plain"], " ", ",", " ", "\:2003\:2003", " ", "\[Eta]", " ", "=",
    " ", 
   FractionBox[
    RowBox[{"16", 
     SqrtBox["\[Pi]"]}], "15"], " ", "\[TildeTilde]", " ", "1.89", " ", ","}],
   TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(58)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"2aa969b7-1e5d-4c39-8f9b-bccbb0c0eab9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", "=", " ", "0.026"}], TraditionalForm]],
  ExpressionUUID->"f05cb723-9cde-4191-8ddd-b4b11ca63d7d"],
 " W/(m K) is the thermal conductivity of air. Gravity gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "g", " ", "\[TildeTilde]", " ", "3.3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]],ExpressionUUID->
  "4b5bffe7-7480-4cda-82ba-7d63b02dd1d4"],
 " N, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "T"], "/", "M", "g", " ", "\[TildeTilde]", " ", "2.9"}],
    TraditionalForm]],ExpressionUUID->
  "a455ac8e-40a7-4a4f-aeac-6a5684c87be3"],
 ": the thermophoretic force is sufficient to levitate the particle, \
consistent with the experimental conditions."
}], "Text",ExpressionUUID->"6f217505-04b8-4d0d-adf6-c8a7aa38f665"],

Cell[TextData[{
 StyleBox["Thermophoretic torque.",
  FontWeight->"Bold"],
 " The thermophoretic torque arises because different surface elements of a \
non-spherical body experience different stresses. Its magnitude is set by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "T"], TraditionalForm]],ExpressionUUID->
  "ec4ce43b-bde7-4396-88a9-7b091ea1f514"],
 " acting over a moment arm of order ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]],ExpressionUUID->
  "b2aec100-b04e-4bd6-9183-83bbadda82cd"],
 ":"
}], "Text",ExpressionUUID->"1c2ac160-8f86-4887-bc64-0f917536bcf3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Tau]", "T"], " ", "\[Tilde]", " ", "\[CapitalLambda]", "|",
    "\[Del]", 
   StyleBox["ln",
    FontSlant->"Plain"], " ", "T", "|", " ", "\[Tilde]", " ", 
   "\[CapitalGamma]", "\[ScriptL]", "|", "\[Del]", 
   StyleBox["ln",
    FontSlant->"Plain"], " ", "T", "|", " ", "=", " ", 
   SubscriptBox["F", "T"], "\[ScriptL]", " ", "\[TildeTilde]", " ", "1.9", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "14"}]], "\[ThinSpace]", 
   StyleBox[
    RowBox[{"N", "\[ThinSpace]", "m"}],
    FontSlant->"Plain"], " ", ","}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(59)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"759e6c94-294f-453f-98be-110ecfe32e4a"],

Cell[TextData[{
 "where we used ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[CapitalLambda]", " ", "\[Tilde]", " ", "\[CapitalGamma]", 
    "\[ScriptL]"}], TraditionalForm]],ExpressionUUID->
  "a6c8eaa6-b08c-4736-90ef-070f5b625824"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", "|", " ", "=", " ", "|", "\[Del]", " ", 
    "T", "|", "/", "T", " ", "\[TildeTilde]", " ", "66.7", "\[ThinSpace]", 
    StyleBox[
     SuperscriptBox["m", 
      RowBox[{"-", "1"}]],
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "64afc193-cf1d-4162-b5be-851784e69fcb"],
 ". The thermophoretic torque is therefore ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]],ExpressionUUID->
  "13a38917-3859-4f43-ba72-e1500e206be2"],
 " times smaller than the thermophoretic force in the sense that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "T"], " ", "=", " ", 
    SubscriptBox["F", "T"], "\[CenterDot]", "\[ScriptL]"}], TraditionalForm]],
  ExpressionUUID->"f58cefad-247d-478d-8357-5506e58cabdc"],
 ", which is the natural geometric relationship between force and torque at \
the scale of the particle."
}], "Text",ExpressionUUID->"df8152aa-6515-4caf-abdd-795df28f9825"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"FT", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"eta", 
      RowBox[{"kappaq", "/", "vbar"}], 
      RowBox[{"ellq", "^", "2"}], "gradTq"}], ",", "\"\<Newtons\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Mg", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"Mp", "gq"}], ",", "\"\<Newtons\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gradLnTq", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"gradTq", "/", "Tq"}], ",", 
     RowBox[{"1", "/", "\"\<Meters\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tauT", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"FT", "ellq"}], ",", 
     RowBox[{"\"\<Newtons\>\"", "\"\<Meters\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kappaTr", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"15", "/", "4"}], 
      RowBox[{"kBq", "/", "mAir"}], "muq"}], ",", 
     RowBox[{"\"\<Watts\>\"", "/", 
      RowBox[{"(", 
       RowBox[{"\"\<Meters\>\"", "\"\<Kelvins\>\""}], ")"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<F_T\>\"", ",", "FT"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<M g\>\"", ",", "Mg"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<F_T/(M g)\>\"", ",", 
          RowBox[{"UnitSimplify", "[", 
           RowBox[{"FT", "/", "Mg"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<|grad ln T|\>\"", ",", "gradLnTq"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<tau_T = F_T l\>\"", ",", "tauT"}], "}"}]}], "}"}], ",", 
      
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (58)\>\"", 
      ",", "\"\<F_T = eta (kappa/vbar) l^2 |grad T| = 9.5e-10 N\>\"", ",", 
      RowBox[{"close", "[", 
       RowBox[{"FT", ",", "9.5*^-10", ",", "0.02"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6\>\"", 
      ",", "\"\<M g = 3.3e-10 N and F_T/(M g) = 2.9\>\"", ",", 
      RowBox[{
       RowBox[{"close", "[", 
        RowBox[{"Mg", ",", "3.3*^-10", ",", "0.02"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"UnitSimplify", "[", 
           RowBox[{"FT", "/", "Mg"}], "]"}], "-", "2.9"}], "]"}], "<", 
        "0.05"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (59)\>\"", 
      ",", "\"\<|grad ln T| = 66.7 1/m and tau_T = F_T l = 1.9e-14 N m\>\"", ",", 
      RowBox[{
       RowBox[{"close", "[", 
        RowBox[{"gradLnTq", ",", "66.7", ",", "0.005"}], "]"}], "&&", 
       RowBox[{"close", "[", 
        RowBox[{"tauT", ",", "1.9*^-14", ",", "0.02"}], "]"}]}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (58)\>\"", 
      ",", "\"\<Waldmann's formula uses the translational conductivity\>\"", ",", 
      RowBox[{"\"\<Waldmann's result is derived for the translational heat \
conductivity. For air, kappa_tr = (15/4)(k_B/m) mu = \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"QuantityMagnitude", "[", "kappaTr", "]"}], ",", "3"}], 
        "]"}], "<>", "\"\< W/(m K), about 25% below the total kappa = 0.026 \
W/(m K), which includes internal molecular degrees of freedom. The estimate \
of F_T should be read as an upper value.\>\""}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"324f8bf3-7052-41bb-adc5-ec3f3931efdf"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"F_T\"\>", 
     TemplateBox[{
      "9.475939222879263`*^-10", "\"N\"", "newtons", "\"Newtons\""},
      "Quantity"]},
    {"\<\"M g\"\>", 
     TemplateBox[{"3.28736255271636`*^-10", "\"N\"", "newtons", "\"Newtons\""},
      "Quantity"]},
    {"\<\"F_T/(M g)\"\>", "2.882535488837171`"},
    {"\<\"|grad ln T|\"\>", 
     TemplateBox[{"66.66666666666667`", 
       RowBox[{"\"per \"", "\[InvisibleSpace]", "\"meter\""}], 
       "reciprocal meters", 
       FractionBox["1", "\"Meters\""]},
      "Quantity"]},
    {"\<\"tau_T = F_T l\"\>", 
     TemplateBox[{"1.8951878445758524`*^-14", 
       RowBox[{"\"m\"", "\[ThinSpace]", "\"N\""}], "meter newtons", 
       RowBox[{"\"Meters\"", " ", "\"Newtons\""}]},
      "Quantity"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"e729b229-73ef-451b-b8c1-375b9978f872"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (58)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4d29d886-1893-4740-8a5d-221bfc00d48e"],
 " = \[Eta] (\[Kappa]/vbar) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "2"], TraditionalForm]],ExpressionUUID->
  "e2197186-4840-4e68-bf89-dbdc2766a752"],
 " |\[Del]T| = 9.5e-10 N"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"8c67d30f-aa3f-4d4c-8307-82b26c5f0e8b"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Sec. 6",
  FontWeight->"Bold"],
 ":   ",
 "M g = 3.3e-10 N and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f17715c6-3264-486c-89f9-3943c1f20d0f"],
 "/(M g) = 2.9"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"7d4b0614-cee3-4d41-b5d0-e81bcfc59df8"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (59)",
  FontWeight->"Bold"],
 ":   ",
 "|\[Del]ln T| = 66.7 1/m and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "185953ae-1367-42eb-8562-f6ba00649268"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "260952b4-dceb-4125-be81-e334700a9dcd"],
 " l = 1.9e-14 N m"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"8ef47615-4e91-42a7-844f-4cb40a4596c5"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eq. (58)",
  FontWeight->"Bold"],
 ":   ",
 "Waldmann's formula uses the translational conductivity",
 "\n",
 StyleBox["Waldmann's result is derived for the translational heat \
conductivity. For air, ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Kappa]", 
    StyleBox["tr",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "15805778-c810-4783-ada0-f5722bd0f4fb"],
 StyleBox[" = (15/4)(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "631e4f4c-afb2-4d97-b8a6-634081f0b4d8"],
 StyleBox["/m) \[Mu] = 0.0199 W/(m K), about 25% below the total \[Kappa] = \
0.026 W/(m K), which includes internal molecular degrees of freedom. The \
estimate of ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "acd6cb2f-ebf1-4825-9e8c-1f157ea15cf6"],
 StyleBox[" should be read as an upper value.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"03b4e7a7-7f61-4676-8bc4-fe29c693a05b"],

Cell[TextData[{
 StyleBox["Steady-state angular velocity.",
  FontWeight->"Bold"],
 " A freely suspended non-spherical particle subject to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "T"], TraditionalForm]],ExpressionUUID->
  "59fe1b74-43c7-4792-b595-1dd00b6a864b"],
 " will spin until the rotational drag torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", 
     StyleBox["drag",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubscriptBox["C", "r"], "\[Omega]"}], TraditionalForm]],ExpressionUUID->
  "398967a1-2651-4173-a52b-0baeb9cf6bce"],
 " balances it. Using the free-molecule rotational drag coefficient for a \
sphere, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "r"], " ", "=", " ", "(", "8", "\[Pi]", "/", "15", ")", 
    "(", "P", "/", 
    OverscriptBox["v", "_"], ")", 
    SuperscriptBox["\[ScriptL]", "4"], " ", "\[TildeTilde]", " ", "4.3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "19"}]]}], TraditionalForm]],ExpressionUUID->
  "12b68846-7880-4656-92b1-cf685754f391"],
 " N m s, the steady-state angular velocity is"
}], "Text",ExpressionUUID->"bcf7f810-905c-4e6d-8a4d-96ead7afadce"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", 
    StyleBox["ss",
     FontSlant->"Plain"]], " ", "=", " ", 
   FractionBox[
    SubscriptBox["\[Tau]", "T"], 
    SubscriptBox["C", "r"]], " ", "\[Tilde]", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["F", "T"], "\[ScriptL]"}], 
    SubscriptBox["C", "r"]], " ", "\[TildeTilde]", " ", "4.4", "\[Times]", 
   SuperscriptBox["10", "4"], "\[ThinSpace]", 
   StyleBox[
    RowBox[{"rad", "/", "s"}],
    FontSlant->"Plain"], " ", "\[TildeTilde]", " ", "2", "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "3"}]], 
   FractionBox[
    OverscriptBox["v", "_"], "\[ScriptL]"], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(60)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"0f3212d5-b453-4f2a-b4cd-8e9d2c756e95"],

Cell[TextData[{
 "The steady-state spin is much slower than the natural frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["v", "_"], "/", "\[ScriptL]", " ", "\[TildeTilde]", " ", 
    "2", "\[Times]", 
    SuperscriptBox["10", "7"]}], TraditionalForm]],ExpressionUUID->
  "a0c08dfc-8ce6-4372-83dd-8e41975831e8"],
 " rad/s set by the thermal speed and particle size, confirming the \
slow-rotation assumption underlying the linear response theory."
}], "Text",ExpressionUUID->"a373e5bc-edba-4858-932b-d5fd5e784b1a"],

Cell[TextData[{
 StyleBox["Verification of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["C", "r"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "5a9ba936-fa68-4684-954b-1c9a64c2f973"],
 StyleBox[" from the kinetic stresses of Section 3.",
  FontWeight->"Bold"],
 " A sphere rotating at ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Omega]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f5dc5ca6-943c-432e-9972-0b4fb9f82d76"],
 " has surface velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "\[Times]", 
    StyleBox["r",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "54eef5ea-788c-4f22-99e6-8f7292c51e72"],
 ". The tangential drag stress of the kinetic derivation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "(", "a", "/", "2", ")", "\[Alpha]", "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold"], "t"]}], TraditionalForm]],ExpressionUUID->
  "2ac12eee-234e-4743-966d-b61c8c590de5"],
 ", then gives a torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["C", "r"], 
    StyleBox["\[Omega]",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "36c31ae2-6874-45ba-a5ed-1268c0a482f1"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "r"], " ", "=", " ", 
    FractionBox[
     RowBox[{"4", "\[Pi]"}], "3"], "a", "\[ThinSpace]", "\[Alpha]", " ", 
    SuperscriptBox["R", "4"]}], TraditionalForm]],ExpressionUUID->
  "88e5ce7a-216a-48af-8f9d-ad562ead50f3"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "=", " ", "\[Rho]", 
    OverscriptBox["c", "_"], "/", "2"}], TraditionalForm]],ExpressionUUID->
  "920a97fc-98a9-4093-8d45-8ee210376bfd"],
 " this is the classical momentum-flux result ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "r"], " ", "=", " ", 
    FractionBox[
     RowBox[{"2", "\[Pi]"}], "3"], "a", "\[Rho]", 
    OverscriptBox["c", "_"], 
    SuperscriptBox["R", "4"]}], TraditionalForm]],ExpressionUUID->
  "bdb362e6-2abe-4ec6-a186-07738990ffee"],
 ". Expressed through ",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],ExpressionUUID->
  "09e6d5f6-8141-43f8-98d4-9aa79ed2f6fa"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["v", "_"], " ", "=", " ", 
    SqrtBox[
     RowBox[{"2", 
      SubscriptBox["k", "B"], "T", "/", "m"}]]}], TraditionalForm]],
  ExpressionUUID->"1deadbab-f5ad-4df3-b2d2-f35a2dc27978"],
 ", it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "r"], " ", "=", " ", 
    FractionBox[
     RowBox[{"8", 
      SqrtBox["\[Pi]"]}], "3"], "a", 
    FractionBox["P", 
     OverscriptBox["v", "_"]], 
    SuperscriptBox["R", "4"]}], TraditionalForm]],ExpressionUUID->
  "b477eee0-3f0c-422e-a167-00d01fee8bc8"],
 ". For diffuse reflection (",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "=", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "83943714-f834-4929-9ac1-b1f9e2438848"],
 ") this is 2.8 times the value used in the notes."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"0ec78fff-b955-4622-8630-4b559ed54ffa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"torqueSphere", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Cross", "[", 
        RowBox[{
         RowBox[{"Rs", 
          RowBox[{"nHat", "[", 
           RowBox[{"th", ",", "ph"}], "]"}]}], ",", 
         RowBox[{"stressKin", "[", 
          RowBox[{
           RowBox[{"nHat", "[", 
            RowBox[{"th", ",", "ph"}], "]"}], ",", 
           RowBox[{"Cross", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "wz"}], "}"}], ",", 
             RowBox[{"Rs", 
              RowBox[{"nHat", "[", 
               RowBox[{"th", ",", "ph"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}], 
       RowBox[{"Rs", "^", "2"}], 
       RowBox[{"Sin", "[", "th", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"th", ",", "0", ",", "Pi"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ph", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CrKin", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"torqueSphere", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], "/", "wz"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CrKinPV", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"CrKin", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nn", "->", 
          RowBox[{"Pp", "/", 
           RowBox[{"(", 
            RowBox[{"kB", "Tk"}], ")"}]}]}], ",", 
         RowBox[{"hh", "->", 
          RowBox[{"mm", "/", 
           RowBox[{"(", 
            RowBox[{"2", "kB", "Tk"}], ")"}]}]}]}], "}"}]}], "/.", 
      RowBox[{"mm", "->", 
       RowBox[{"2", "kB", 
        RowBox[{"Tk", "/", 
         RowBox[{"vbarS", "^", "2"}]}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pp", ">", "0"}], ",", 
       RowBox[{"vbarS", ">", "0"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CrPDF", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"8", 
      RowBox[{"Pi", "/", "15"}], 
      RowBox[{"Pq", "/", "vbar"}], 
      RowBox[{"ellq", "^", "4"}]}], ",", 
     RowBox[{"\"\<Newtons\>\"", "\"\<Meters\>\"", "\"\<Seconds\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CrKinQ", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"8", 
      RowBox[{
       RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "3"}], 
      RowBox[{"Pq", "/", "vbar"}], 
      RowBox[{"ellq", "^", "4"}]}], ",", 
     RowBox[{"\"\<Newtons\>\"", "\"\<Meters\>\"", "\"\<Seconds\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<kinetic rotational drag:  C_r = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", "CrKin", "]"}], ",", "\"\< = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"CrKinPV", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Pp", "->", "\"\<P\>\""}], ",", 
           RowBox[{"vbarS", "->", 
            RowBox[{"OverBar", "[", "\"\<v\>\"", "]"}]}]}], "}"}]}], "]"}]}], 
      "}"}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6\>\"", 
      ",", "\"\<C_r = (8 pi/15)(P/vbar) l^4 = 4.3e-19 N m s (arithmetic)\>\"",
       ",", 
      RowBox[{"close", "[", 
       RowBox[{"CrPDF", ",", "4.3*^-19", ",", "0.02"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (60)\>\"", 
      ",", "\"\<free-molecule rotational drag C_r = (8 pi/15)(P/vbar) l^4\>\"",
       ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"CrKinPV", "/.", 
          RowBox[{"aa", "->", "1"}]}], ")"}], "-", 
        RowBox[{"8", 
         RowBox[{"Pi", "/", "15"}], 
         RowBox[{"Pp", "/", "vbarS"}], 
         RowBox[{"Rs", "^", "4"}]}]}], "]"}], ",", 
      RowBox[{"\"\<Kinetic theory (diffuse reflection): C_r = (8 \
Sqrt[pi]/3)(P/vbar) l^4 = \>\"", "<>", 
       RowBox[{"sci", "[", 
        RowBox[{"QuantityMagnitude", "[", "CrKinQ", "]"}], "]"}], 
       "<>", "\"\< N m s, a factor \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"8", 
             RowBox[{
              RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "3"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"8", 
             RowBox[{"Pi", "/", "15"}]}], ")"}]}], "]"}], ",", "3"}], "]"}], 
       "<>", "\"\< larger.\>\""}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (60)\>\"", 
      ",", "\"\<omega_ss = F_T l/C_r = 4.4e4 rad/s = 2e-3 vbar/l (with the \
notes' C_r)\>\"", ",", 
      RowBox[{
       RowBox[{"close", "[", 
        RowBox[{
         RowBox[{"UnitConvert", "[", 
          RowBox[{
           RowBox[{"tauT", "/", "CrPDF"}], ",", 
           RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}], ",", "4.4*^4", ",",
          "0.03"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"UnitSimplify", "[", 
            RowBox[{
             RowBox[{"UnitConvert", "[", 
              RowBox[{
               RowBox[{"tauT", "/", "CrPDF"}], ",", 
               RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}], 
             RowBox[{"ellq", "/", "vbar"}]}], "]"}], "/", "2*^-3"}], "-", 
          "1"}], "]"}], "<", "0.1"}]}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (60)\>\"", 
      ",", "\"\<with the kinetic C_r the steady spin is 2.8 times slower\>\"",
       ",", 
      RowBox[{"\"\<omega_ss = \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"QuantityMagnitude", "[", 
          RowBox[{"UnitConvert", "[", 
           RowBox[{
            RowBox[{"tauT", "/", "CrKinQ"}], ",", 
            RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}], "]"}], ",", "3"}],
         "]"}], "<>", "\"\< rad/s. The slow-rotation conclusion is unchanged.\
\>\""}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"5757e889-0796-\
4018-b82d-310cbb72095a"],

Cell[BoxData[
 TemplateBox[{"\"kinetic rotational drag:  C_r = \"", 
   TagBox[
    FormBox[
     FractionBox[
      RowBox[{"4", " ", 
        SqrtBox["\[Pi]"], " ", "aa", " ", "mm", " ", "nn", " ", 
        SuperscriptBox["Rs", "4"]}], 
      RowBox[{"3", " ", 
        SqrtBox["hh"]}]], TraditionalForm], TraditionalForm, Editable -> 
    True], "\" = \"", 
   TagBox[
    FormBox[
     FractionBox[
      RowBox[{"8", " ", 
        SqrtBox["\[Pi]"], " ", "aa", " ", "\"P\"", " ", 
        SuperscriptBox["Rs", "4"]}], 
      RowBox[{"3", " ", 
        OverscriptBox["\"v\"", "_"]}]], TraditionalForm], TraditionalForm, 
    Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"016f6075-09b9-49b5-ab9f-\
0612fab5cb3a"]
}, Open  ]],

