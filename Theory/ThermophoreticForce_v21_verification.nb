       RowBox[{"\"\<grad \>\"", "->", "\"\<\[Del]\>\""}]}], "}"}], ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RegularExpression", "[", 
