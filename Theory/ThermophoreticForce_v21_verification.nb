Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (29)",
  FontWeight->"Bold"],
 ":   ",
 "uniaxial class '",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox[
     RowBox[{"inf", " ", "v"}],
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4334f381-b291-46f8-b133-680019626532"],
 "' has ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "37f83437-4b39-4fa2-8e5a-e6747cd13de9"],
 " = 0 (6 DOF total)",
 "\n",
 StyleBox["For ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox[
     RowBox[{"inf", " ", "v"}],
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "db356f7c-d762-4ea2-8147-8f085a0aa65d"],
 StyleBox[" (e.g. a cone, or any body of revolution that is not symmetric end \
to end) the pseudotensor ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "3f3d13b3-ff7e-438c-8849-11799af8d523"],
 StyleBox[" has one invariant: an antisymmetric part \[Lambda] [",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["3",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "36919c86-244b-45ff-8ed7-f5a61c94661c"],
 StyleBox["]x, giving the aligning torque \[Tau] ~ ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["3",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "eb8cd7ea-807d-45cc-97ff-7dffeb135bbb"],
 StyleBox[" x \[Del]ln T. ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7c05263c-7897-48b1-9e77-756a4f578ffa"],
 StyleBox[" = 0 holds for ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    StyleBox[
     RowBox[{"inf", " ", "h"}],
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "59ddd4e3-8e31-4901-a6cb-d8d75e4b829b"],
 StyleBox[", the actual symmetry of cylinders and spheroids. So (29) is \
correct for the bodies listed, but the group label should be ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    StyleBox[
     RowBox[{"inf", " ", "h"}],
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c3f59dae-49b8-4967-a689-dba04905ac94"],
 StyleBox[".",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
