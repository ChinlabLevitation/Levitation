Cell[TextData[{
 StyleBox["Table 2: Estimated magnitudes of the four thermophoretic and drag \
responses for a levitating particle of generic shape. Parameters:",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", " ", "=", " ", "20", "\[ThinSpace]", "\[Mu]"}], 
   TraditionalForm]],ExpressionUUID->"0a953479-23e2-44db-914a-f064ead330d4"],
 "m, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", " ", "=", " ", "1", "\[ThinSpace]", 
    StyleBox[
     RowBox[{"g", "/", 
      SuperscriptBox["cm", "3"]}],
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "f909c8b2-91c2-4f05-9fc7-21b66af0d526"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Del]", " ", "T", "|", " ", "=", " ", "200"}], 
   TraditionalForm]],ExpressionUUID->"045463ba-909b-4f5b-b0b6-153961411c92"],
 " K/cm, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " ", "=", " ", "5"}], TraditionalForm]],ExpressionUUID->
  "d1d3461c-1cc2-49f9-ae2b-ccdcad6511e4"],
 " Torr, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", " ", "300"}], TraditionalForm]],ExpressionUUID->
  "5f4e72a4-6107-4c13-8f1a-337068e434b9"],
 " K, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", " ", "\[TildeTilde]", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"ee5fd2e6-e242-4a88-b2f4-a81f9e745a42"],
 ". The torque column is normalised by ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]],ExpressionUUID->
  "42c4f211-505f-4f4e-9375-5c83467a7846"],
 " for direct comparison with forces. (\[Dagger]) Divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", " ", "=", " ", "20", "\[ThinSpace]", "\[Mu]"}], 
   TraditionalForm]],ExpressionUUID->"bea4dc05-0cac-4f7a-afbb-2d0936802b8b"],
 "m for comparison with forces.*"
}], "Text",ExpressionUUID->"7cd6f43a-f107-47e6-addb-735172bfe9d4"],

Cell["Several conclusions follow from this analysis.", "Text",ExpressionUUID->"2b8a91f2-46ca-4a7a-8b35-05f3689e8ca7"],

Cell[TextData[{
 StyleBox["Thermophoretic force and torque are the primary drivers.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "T"], TraditionalForm]],ExpressionUUID->
  "bb252bd3-d8e8-4499-80ff-30e1ed52b487"],
 " levitates the particle against gravity (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "T"], "/", "M", "g", " ", "\[TildeTilde]", " ", "2.9"}],
    TraditionalForm]],ExpressionUUID->
  "6f943f06-c315-4779-833f-28e083f305d1"],
 "), while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "T"], " ", "\[Tilde]", " ", 
    SubscriptBox["F", "T"], "\[CenterDot]", "\[ScriptL]"}], TraditionalForm]],
  ExpressionUUID->"ca4f2dae-72c6-4952-8670-15699526db2e"],
 " rotates any non-spherical particle toward a preferred orientation. Both \
are first-order effects."
}], "ItemNumbered",ExpressionUUID->"ba935dc4-39cd-4305-94e5-8f720e548b79"],

Cell[TextData[{
 StyleBox["The gyrophoretic force is not negligible.",
  FontWeight->"Bold"],
 " For a non-spherical particle spinning at steady state, the gyrophoretic \
force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "\[Omega]"], " ", "\[Tilde]", " ", "3", "K", "n", "\[CenterDot]",
     " ", 
    SubscriptBox["F", "T"]}], TraditionalForm]],ExpressionUUID->
  "aac9d5bc-577d-4be9-aea7-ff3223372fd4"],
 " is of the same order as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "T"], TraditionalForm]],ExpressionUUID->
  "e911befa-d311-4f01-8317-f4211f5b6a51"],
 " in the transition regime (",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", " ", "\[Tilde]", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"374edf58-74d6-43e2-9ee5-2ef6691f7b32"],
 "). This coupling between rotation and translation is a rarefaction effect: \
it vanishes in the continuum limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", "\[RightArrow]", "0"}], TraditionalForm]],ExpressionUUID->
  "280be42e-b21a-4f12-abde-f6363e7e075f"],
 ". For a spherical particle the gyrophoretic coupling vanishes and this term \
is absent."
}], "ItemNumbered",ExpressionUUID->"5eea1280-0a64-4bbe-b0ce-6fa4180ef3e7"],

Cell[TextData[{
 StyleBox["Three small dimensionless parameters govern the dynamics.",
  FontWeight->"Bold"],
 " The translational drift velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", " ", "\[Tilde]", " ", 
    SubscriptBox["F", "T"], "/", "\[CapitalXi]"}], TraditionalForm]],
  ExpressionUUID->"f52d6d3c-0b38-42a0-ab1a-270b3483d47f"],
 " satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", "/", 
    OverscriptBox["v", "_"], " ", "\[TildeTilde]", " ", "4", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "4"}]]}], TraditionalForm]],ExpressionUUID->
  "e6b51f2c-7247-403a-b528-98e1bd1b1147"],
 "; the steady spin satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     StyleBox["ss",
      FontSlant->"Plain"]], "\[ScriptL]", "/", 
    OverscriptBox["v", "_"], " ", "\[TildeTilde]", " ", "2", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]],ExpressionUUID->
  "f47ec642-59b4-4f9f-8621-c5f3b8cffb51"],
 "; and the particle is small compared to the gradient scale, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", "/", 
    SubscriptBox["L", "T"], " ", "\[TildeTilde]", " ", "1.3", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], TraditionalForm]],ExpressionUUID->
  "f6981928-8bd1-49c2-8856-461b9a73b710"],
 ". All three confirm the validity of the linear response approximation."
}], "ItemNumbered",ExpressionUUID->"64883767-3c72-4eb8-a4ee-c650b59eb6dc"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The transition regime requires special treatment.",
  FontWeight->"Bold"],
 " With ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", " ", "\[TildeTilde]", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"bad9b35e-5712-4a99-b3a8-c47dcf0b7d2d"],
 ", neither the continuum (",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", "\[RightArrow]", "0"}], TraditionalForm]],ExpressionUUID->
  "86a89b5a-5f4b-42d7-b8a1-3e8d1d4b281d"],
 ") nor the free-molecule (",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", "\[RightArrow]", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"22837f90-d37a-4682-be23-38e864ae58d4"],
 ") limit applies exactly. The full numerical solutions of the Boltzmann \
equation reviewed in Zheng (2002) are needed for quantitative predictions, \
particularly for the diagonal tensors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7df5bb33-d5a1-476e-b044-bb599c01b32a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "87ed37d3-4412-4854-b5b0-03360424dd10"],
 ". The off-diagonal tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6ef061d1-2597-4972-9cb9-1dc6e719def0"],
 " has not been computed for the transition regime."
}], "ItemNumbered",ExpressionUUID->"97334327-d880-4191-b04b-1620df898960"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Xi", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"4", 
      RowBox[{"Pi", "/", "3"}], 
      RowBox[{"ellq", "^", "2"}], 
      RowBox[{"(", 
       RowBox[{"Pq", 
        RowBox[{"mAir", "/", 
         RowBox[{"(", 
          RowBox[{"kBq", "Tq"}], ")"}]}]}], ")"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"8", "kBq", 
        RowBox[{"Tq", "/", 
         RowBox[{"(", 
          RowBox[{"Pi", "mAir"}], ")"}]}]}], "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Pi", "/", "8"}]}], ")"}]}], ",", 
     RowBox[{"\"\<Newtons\>\"", 
      RowBox[{"\"\<Seconds\>\"", "/", "\"\<Meters\>\""}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"vDrift", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"FT", "/", "Xi"}], ",", 
     RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"LT", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"Tq", "/", "gradTq"}], ",", "\"\<Meters\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Epstein drag Xi (diffuse)\>\"", ",", "Xi"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<v = F_T/Xi\>\"", ",", "vDrift"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<v/vbar\>\"", ",", 
          RowBox[{"UnitSimplify", "[", 
           RowBox[{"vDrift", "/", "vbar"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<omega_ss l/vbar (notes' C_r)\>\"", ",", 
          RowBox[{"UnitSimplify", "[", 
           RowBox[{
            RowBox[{"tauT", "/", "CrPDF"}], 
            RowBox[{"ellq", "/", "vbar"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<l/L_T\>\"", ",", 
          RowBox[{"UnitSimplify", "[", 
           RowBox[{"ellq", "/", "LT"}], "]"}]}], "}"}]}], "}"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Table 2\>\"", ",", "\"\<Mg/F_T = 0.35\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"UnitSimplify", "[", 
          RowBox[{"Mg", "/", "FT"}], "]"}], "-", "0.35"}], "]"}], "<", 
       "0.01"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6, conclusion 3\>\"", 
      ",", "\"\<v/vbar of about 4e-4 (order of magnitude, Epstein drag)\>\"", 
      ",", 
      RowBox[{"1*^-4", "<", 
       RowBox[{"UnitSimplify", "[", 
        RowBox[{"vDrift", "/", "vbar"}], "]"}], "<", "1*^-3"}], ",", 
      RowBox[{"\"\<Epstein drag gives v/vbar = \>\"", "<>", 
       RowBox[{"sci", "[", 
        RowBox[{"UnitSimplify", "[", 
         RowBox[{"vDrift", "/", "vbar"}], "]"}], "]"}], "<>", "\"\<.\>\""}]}],
      "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6, conclusion 3\>\"", 
      ",", "\"\<omega_ss l/vbar = 2e-3 and l/L_T = 1.3e-3\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"UnitSimplify", "[", 
            RowBox[{
             RowBox[{"tauT", "/", "CrPDF"}], 
             RowBox[{"ellq", "/", "vbar"}]}], "]"}], "/", "2*^-3"}], "-", 
          "1"}], "]"}], "<", "0.1"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"UnitSimplify", "[", 
            RowBox[{"ellq", "/", "LT"}], "]"}], "/", "1.3*^-3"}], "-", "1"}], 
         "]"}], "<", "0.05"}]}]}], "]"}]}], "}"}], "]"}]}], "Input",Expression\
UUID->"d7e43d8d-173e-4062-96f3-692678777d7b"],

