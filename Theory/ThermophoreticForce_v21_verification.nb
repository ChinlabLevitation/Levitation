Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eqs. (48)-(49)",
  FontWeight->"Bold"],
 ":   ",
 "the steady precession is a horizontal circle with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c1950f8c-a5bc-40cb-b265-3c8dc3f665fd"],
 " = 0"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"8e724718-776a-48f9-925f-707b75a7ca7d"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (49), corrected",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "33ea8ef3-1724-4478-842f-69d961aebefd"],
 " = c0 |",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", 
    StyleBox["perp",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "832925f3-9a60-42c0-817b-d0e7130f87e8"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6cc33b99-6602-4fa3-8eb9-6c8abd8d3afc"],
 " e3|/(\[Xi]0 |\[Lambda]3|) converges to the simulation as \[CurlyEpsilon] \
-> 0",
 "\n",
 StyleBox["relative errors for \[CurlyEpsilon] = 0.04, 0.02, 0.01: 1.26e-2, \
7.61e-3, 4.14e-3",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"874eea2d-0128-474a-a880-31045c55adc9"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (49)",
  FontWeight->"Bold"],
 ":   ",
 "exact quasi-steady radius matches the simulation, with the residual \
shrinking like ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "826ced0e-92a7-43b0-9bc7-d9ec380f126b"],
 "\n",
 StyleBox["relative errors for \[CurlyEpsilon] = 0.04, 0.02, 0.01: 1.09e-3, \
2.64e-4, 6.50e-5",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"9bdd259d-4405-40df-8a32-3b91e0a9fa9f"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (49)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4c70f899-c465-438c-875c-929c46242356"],
 " as printed (with dA containing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "68debf2f-3a26-4649-9424-11fa0daf65c7"],
 ") matches the simulated orbit",
 "\n",
 StyleBox["The printed radius misses by 47% at \[CurlyEpsilon] = 0.01, and \
the error does not shrink with \[CurlyEpsilon]; the corrected radius is \
within 0.41%.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"1a696ef1-daad-46e9-b00a-8ee487b6dca1"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Sec. 2.3, key feature 1",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "01d32986-051c-4027-b40e-0bf83556392f"],
 " is independent of \[CurlyEpsilon] (to leading order)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"006c0bbd-4124-43d3-a6a9-e06031d55dd0"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Sec. 2.3, key feature 3",
  FontWeight->"Bold"],
 ":   ",
 "the hover condition involves only ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "063205a9-34ad-46c6-9539-82cc45aa7d07"],
 "\n",
 StyleBox["With the corrected (47), ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b9c34ecb-887e-49f2-a102-77f105b38549"],
 StyleBox[" = 0 when ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "3c132538-a235-4bcf-872e-ecd1bac00de2"],
 StyleBox[" e3 is parallel to e3 (",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ed4f1356-c0d4-4cde-a1f0-0bcf29ac1a6b"],
 StyleBox[" and ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["dT", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6dbd471e-a057-4002-a3fe-c313e42bc5b8"],
 StyleBox[" share the eigenvector e3); the drag tensor plays no role at this \
order.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"716602ce-cb31-4678-831f-54f80c70cf5a"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eq. (42)",
  FontWeight->"Bold"],
 ":   ",
 "the 'steady' translational balance neglects the centripetal acceleration M \
\[CapitalOmega]3 x v",
 "\n",
 StyleBox["The exact circular solution has |",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    StyleBox["perp",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4f08e96a-174d-4714-80c9-be21488941cd"],
 StyleBox["| reduced by 1/Sqrt[1 + (M \[CapitalOmega]3/\[Xi]0)",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "2"], TraditionalForm]],ExpressionUUID->
  "b5590704-b706-44ea-8bfd-e4aab7700bf4"],
 StyleBox["]; this is O(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "7e3dfa20-f042-4bf4-b5f0-b6f6ce684fdd"],
 StyleBox[") here but matters for heavy particles or strong asymmetry.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"8e3566ab-53de-4d25-829e-52bbd5e5ddfe"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Thermophoretic force on a surface element", "Section",ExpressionUUID->"999b3b04-f55b-4d42-a52e-450dc2ebe84d"],

Cell[TextData[{
 "We consider a surface element with area ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "ef1c6167-6971-4d45-ae97-677fdc87c4da"],
 " placed in a thermal field with temperature gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "'", " ", ">", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "82917e43-9b74-430f-b269-95bd0880b668"],
 " in the ",
 StyleBox["negative",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "9bedb023-b0f5-4c34-b874-decd4dc043c4"],
 "-direction: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Del]", " ", "T", " ", "=", " ", "-", "T", "'", "(", "0", ",", " ", "0", 
    ",", " ", "1", ")", " ", "=", " ", "T", "'", "(", "0", ",", " ", "0", ",",
     " ", "-", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "5eccfc4f-4849-41aa-9d23-0637434d721f"],
 ", so the gas is hotter at large ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "25df4e3e-1ea9-45d3-b831-4ca826d29fa1"],
 " (cold below, hot above) and the thermophoretic force on a sphere is in the \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "z"}], TraditionalForm]],ExpressionUUID->
  "f429bffd-1151-4265-b406-ae0babf4d687"],
 " direction, opposing gravity. The surface normal in spherical coordinates \
is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["n", "^"], " ", "=", " ", "(", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "bc64b925-5a0d-4583-858a-e52892c73715"],
 " with tangents ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["t", "^"], "1"], " ", "=", " ", "(", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", "-", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "5aca79a1-61ca-484b-9ed0-a2b93ba55158"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["t", "^"], "2"], " ", "=", " ", "(", "-", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[CurlyPhi]", ",", " ", "0", ")"}], 
   TraditionalForm]],ExpressionUUID->"fee48f19-88a1-4492-b135-9a09b9f8da0f"],
 "."
}], "Text",ExpressionUUID->"a62e8ba2-dca7-4f24-b85a-80eb2e9888a5"],

Cell["\<\
Following Eqs. (20\[Dash]21) of Garcia-Ybarra & Rosner (1989), the force on \
the element is:\
\>", "Text",ExpressionUUID->"94d79a8a-38e5-4671-adf7-360f08783181"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", "A"], 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["F", 
        SubscriptBox["t", "1"]]},
      {
       SubscriptBox["F", 
        SubscriptBox["t", "2"]]},
      {
       SubscriptBox["F", "n"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "=", " ", "\[Alpha]", 
   RowBox[{"(", GridBox[{
      {"0"},
      {"0"},
      {
       RowBox[{"-", 
        FractionBox["1", "2"], 
        SqrtBox[
         RowBox[{"\[Pi]", "/", "h"}]]}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "-", " ", "\[Alpha]", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        FractionBox["a", "2"], 
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        SubscriptBox[
         OverscriptBox["t", "^"], "1"]}]},
      {
       RowBox[{"-", 
        FractionBox["a", "2"], 
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        SubscriptBox[
         OverscriptBox["t", "^"], "2"]}]},
      {
       RowBox[{
       "[", "2", " ", "-", " ", "a", "(", "1", " ", "-", " ", "\[Pi]", "/", 
        "4", ")", "]", 
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        OverscriptBox["n", "^"]}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "+", " ", "\[Alpha]", 
   FractionBox[
    RowBox[{"3", "\[Nu]"}], "4"], 
   FractionBox[
    RowBox[{"T", "'"}], "T"], 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        FractionBox["a", "2"], 
        StyleBox["sin",
         FontSlant->"Plain"], "\[Theta]"}]},
      {"0"},
      {
       RowBox[{"(", "2", " ", "-", " ", "a", ")", 
        StyleBox["cos",
         FontSlant->"Plain"], "\[Theta]"}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(50)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"b5536ed2-1f83-42f3-b1b5-c2de8a6c26b1"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "=", " ", "m", "N", "/", 
    SqrtBox[
     RowBox[{"\[Pi]", " ", "h"}]]}], TraditionalForm]],ExpressionUUID->
  "c2ba7fa0-0a42-441d-84fd-d9d985b5a5a3"],
 ". The three terms are hydrostatic pressure, viscous drag, and \
thermophoretic stress, respectively."
}], "Text",ExpressionUUID->"9b1e0227-35b3-41e7-95ac-cf158ffd4cd8"],

Cell[TextData[{
 StyleBox["Independent kinetic-theory derivation of (50).",
  FontWeight->"Bold"],
 " We derive the free-molecular stress on a flat element from first \
principles, without using Garcia-Ybarra & Rosner. The gas near the element is \
described by the Grad (13-moment) distribution carrying a heat flux ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "73808ebe-2488-40ab-b435-b43e2d831253"],
 ","
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"c6d37166-f376-4fdc-b0fc-ae2a068e25f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", " ", "=", " ", 
    RowBox[{"N", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["h", "\[Pi]"], ")"}], 
      RowBox[{"3", "/", "2"}]], 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{"-", "h", "|", 
        StyleBox["c",
         FontWeight->"Bold"], " ", "+", " ", 
        StyleBox["V",
         FontWeight->"Bold"], 
        SuperscriptBox["|", "2"]}]], "[", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{
        RowBox[{"A", "\[ThinSpace]", "(", 
         RowBox[{
          StyleBox["q",
           FontWeight->"Bold"], "\[CenterDot]", 
          StyleBox["c",
           FontWeight->"Bold"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"h", " ", 
           SuperscriptBox["c", "2"]}], " ", "-", " ", 
          FractionBox["5", "2"]}], ")"}]}]}], "]"}]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", "h"}], " ", "=", " ", 
    FractionBox["m", 
     RowBox[{"2", 
      SubscriptBox["k", "B"], "T"}]]}], " ", ","}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"73a9546d-3515-4e65-\
9230-d3cb3cba92aa"],

Cell[TextData[{
 "seen from an element moving with velocity ",
 Cell[BoxData[
  FormBox[
   StyleBox["V",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "2194c9bb-9a7b-4309-b61b-9cc75979952a"],
 " relative to the gas, where ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "f897f3f5-98e1-4d8c-b3f7-9d3c201ad24e"],
 " is fixed by requiring the heat-flux moment to equal ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1c7ca18f-fd47-4e7b-a25f-03fcf19219f1"],
 ". Molecules hitting the element (outward normal ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["n", "^"], TraditionalForm]],ExpressionUUID->
  "1aeca18e-0e11-4fdc-87dd-e7108ad85d3b"],
 ") are re-emitted specularly with probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", " ", "-", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "a554a7fd-1115-4e26-a6ae-c55dae205feb"],
 ", and diffusely with probability ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "bcab10f4-b360-4a00-ad86-06ed8da7a970"],
 " from a half-Maxwellian at the gas temperature with the same number flux. \
The force on the element is the momentum delivered by incoming molecules \
minus the momentum carried away by outgoing ones. Everything is kept to \
linear order in ",
 Cell[BoxData[
  FormBox[
   StyleBox["V",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "3a161fa4-38f4-4180-bf7c-5919416ceb4e"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "56032b22-c352-4d53-aac0-d25336bc3c38"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"1b6ca1a5-f89b-4720-a1bd-2ed2447ea234"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kinAssume", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hh", ">", "0"}], ",", 
     RowBox[{"nn", ">", "0"}], ",", 
     RowBox[{"mm", ">", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"hh", ">", "0"}], ",", 
     RowBox[{"nn", ">", "0"}], ",", 
     RowBox[{"mm", ">", "0"}], ",", 
     RowBox[{"kB", ">", "0"}], ",", 
     RowBox[{"Tk", ">", "0"}], ",", 
     RowBox[{"kap", ">", "0"}], ",", 
     RowBox[{"nuG", ">", "0"}], ",", 
     RowBox[{"q0", ">", "0"}], ",", 
     RowBox[{"Rs", ">", "0"}], ",", 
     RowBox[{"rC", ">", "0"}], ",", 
     RowBox[{"LC", ">", "0"}], ",", 
     RowBox[{"0", "<=", "aa", "<=", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cvec", "=", 
   RowBox[{"{", 
    RowBox[{"cx", ",", "cy", ",", "cz"}], "}"}]}], ";", 
  RowBox[{"Vv", "=", 
   RowBox[{"{", 
    RowBox[{"Vx", ",", "Vy", ",", "Vz"}], "}"}]}], ";", 
  RowBox[{"qv", "=", 
   RowBox[{"{", 
    RowBox[{"qx", ",", "qy", ",", "qz"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"velInt", "[", 
    RowBox[{"expr_", ",", "czRange_"}], "]"}], ":=", 
   RowBox[{"Integrate", "[", 
    RowBox[{"expr", ",", 
     RowBox[{"{", 
      RowBox[{"cx", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"cy", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"cz", ",", 
       RowBox[{"Sequence", "@@", "czRange"}]}], "}"}], ",", 
     RowBox[{"Assumptions", "->", "kinAssume"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fGrad", "=", 
   RowBox[{"nn", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"hh", "/", "Pi"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}]}], 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "hh"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"cvec", "+", "Vv"}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"cvec", "+", "Vv"}], ")"}]}]}], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Ag", 
       RowBox[{"(", 
        RowBox[{"qv", ".", "cvec"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"hh", 
          RowBox[{"cvec", ".", "cvec"}]}], "-", 
         RowBox[{"5", "/", "2"}]}], ")"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"heatMoment", "=", 
   RowBox[{"velInt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"mm", "/", "2"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"cvec", ".", "cvec"}], ")"}], "cz", 
      RowBox[{"(", 
       RowBox[{"fGrad", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Vx", "->", "0"}], ",", 
          RowBox[{"Vy", "->", "0"}], ",", 
          RowBox[{"Vz", "->", "0"}], ",", 
          RowBox[{"qx", "->", "0"}], ",", 
          RowBox[{"qy", "->", "0"}]}], "}"}]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"AgSol", "=", 
   RowBox[{"First", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"heatMoment", "==", "qz"}], ",", "Ag"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linearise", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"expr", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"Vv", ",", "qv"}], "]"}], "->", 
          RowBox[{"ee", 
           RowBox[{"Join", "[", 
            RowBox[{"Vv", ",", "qv"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ee", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "/.", 
    RowBox[{"ee", "->", "1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fLin", "=", 
   RowBox[{"linearise", "[", 
    RowBox[{"fGrad", "/.", "AgSol"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pin", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"velInt", "[", 
      RowBox[{
       RowBox[{"mm", 
        RowBox[{"cvec", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"-", "cz"}], ")"}], "fLin"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "Infinity"}], ",", "0"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gin", "=", 
   RowBox[{"velInt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "cz"}], ")"}], "fLin"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "Infinity"}], ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fspec", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"2", 
      RowBox[{"Pin", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fdiff", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pin", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"Pin", "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Pin", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "-", 
      RowBox[{"Gin", "mm", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"4", "hh"}], ")"}]}], "]"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fkin", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "aa"}], ")"}], "Fspec"}], "+", 
      RowBox[{"aa", "Fdiff"}]}], ",", "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alphaK", "=", 
   RowBox[{"mm", 
    RowBox[{"nn", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Pi", "hh"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Grad coefficient:  A = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Ag", "/.", "AgSol"}], "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<stress on the element (tangent x, y; normal z):  \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"Fkin", "/", "alphaK"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "Vx", ",", "Vy", ",", "Vz", ",", "qx", ",", "qy", ",", "qz"}], 
           "}"}], ",", "Simplify"}], "]"}], "]"}], 
       ",", "\"\<  \[Times] \[Alpha]\>\""}], "}"}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"5eced872-be68-489a-9bff-50431f9c0c93"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"Grad coefficient:  A = \"", 
       TagBox[
        FormBox[
         FractionBox[
          RowBox[{"8", " ", 
            SuperscriptBox["hh", "2"]}], 
          RowBox[{"5", " ", "mm", " ", "nn"}]], TraditionalForm], 
        TraditionalForm, Editable -> True]},
      "RowDefault"]},
    {
     TemplateBox[{"\"stress on the element (tangent x, y; normal z):  \"", 
       TagBox[
        FormBox[
         RowBox[{"{", 
           RowBox[{
             RowBox[{
               FractionBox[
                RowBox[{"aa", " ", "hh", " ", "qx"}], 
                RowBox[{"5", " ", "mm", " ", "nn"}]], "-", 
               FractionBox[
                RowBox[{"aa", " ", "Vx"}], "2"]}], ",", 
             RowBox[{
               FractionBox[
                RowBox[{"aa", " ", "hh", " ", "qy"}], 
                RowBox[{"5", " ", "mm", " ", "nn"}]], "-", 
               FractionBox[
                RowBox[{"aa", " ", "Vy"}], "2"]}], ",", 
             RowBox[{
               RowBox[{"-", 
                 RowBox[{
                   FractionBox[
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{"aa", "-", "2"}], ")"}], " ", "hh", " ", "qz"}], 
                    RowBox[{"5", " ", "mm", " ", "nn"}]]}]}], "+", 
               RowBox[{
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"\[Pi]", " ", "aa"}], "4"]}]}], "+", "aa", "-", 
                    "2"}], ")"}], " ", "Vz"}], "-", 
               FractionBox[
                SqrtBox["\[Pi]"], 
                RowBox[{"2", " ", 
                  SqrtBox["hh"]}]]}]}], "}"}], TraditionalForm], 
        TraditionalForm, Editable -> True], "\"  \[Times] \[Alpha]\""},
      "RowDefault"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"ddf2184b-4ce0-4c11-b038-46df9d430c72"]
}, Open  ]],

Cell[TextData[{
 "Now compare term by term with (50), taking ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "64bc6212-1c85-44f5-b2b5-e7a498a1cd7c"],
 " in (50) as the element's velocity, which the normal drag term requires. \
The thermophoretic term of (50) is written for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], " ", "=", " ", "\[Kappa]", " ", "T", "'", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "33481556-063b-468b-ab37-06b6973bcc3e"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], "\[CenterDot]", 
    SubscriptBox[
     OverscriptBox["t", "^"], "1"], " ", "=", " ", "-", "q", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]"}], TraditionalForm]],ExpressionUUID->
  "d7ca1e67-966c-46a0-bb26-eebf0d59f15e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], "\[CenterDot]", 
    OverscriptBox["n", "^"], " ", "=", " ", "q", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]"}], TraditionalForm]],ExpressionUUID->
  "43836579-2bb4-4069-af8f-7931333ce105"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"1c937d52-153e-4309-94f9-ec3fed8ad23b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coefV", "[", 
    RowBox[{"i_", ",", "var_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"Fkin", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "var"}], "]"}], "/", "alphaK"}],
      ",", "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefQ", "[", 
    RowBox[{"i_", ",", "var_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Fkin", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", "var"}], "]"}], ",", 
     "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pressureKin", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Fkin", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"Vv", ",", "qv"}], "]"}], "->", "0"}], "]"}]}], ")"}], "/",
       "alphaK"}], ",", "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermoTan50", "=", 
   RowBox[{
    RowBox[{"-", "alphaK"}], 
    RowBox[{"(", 
     RowBox[{"3", 
      RowBox[{"nuSym", "/", "4"}]}], ")"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"aa", "/", "2"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"kap", "Tk"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thermoNor50", "=", 
   RowBox[{"alphaK", 
    RowBox[{"(", 
     RowBox[{"3", 
      RowBox[{"nuSym", "/", "4"}]}], ")"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "-", "aa"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"kap", "Tk"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuSol", "=", 
   RowBox[{"First", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"thermoNor50", "==", 
       RowBox[{"coefQ", "[", 
        RowBox[{"3", ",", "qz"}], "]"}]}], ",", "nuSym"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<pressure term: -alpha Sqrt[pi/h]/2 = -N k_B T\>\"", ",", 
      RowBox[{
       RowBox[{"zeroQ", "[", 
        RowBox[{"pressureKin", "-", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Pi", "/", "hh"}], "]"}]}], "/", "2"}]}], "}"}]}], 
        "]"}], "&&", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"alphaK", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"Pi", "/", "hh"}], "]"}], "/", "2"}]}], "-", 
          RowBox[{"nn", "kB", "Tk"}]}], "/.", 
         RowBox[{"hh", "->", 
          RowBox[{"mm", "/", 
           RowBox[{"(", 
            RowBox[{"2", "kB", "Tk"}], ")"}]}]}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<normal drag: -alpha [2 - a(1 - pi/4)] v.n\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"coefV", "[", 
         RowBox[{"3", ",", "Vz"}], "]"}], "+", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"aa", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], ")"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<tangential drag enters as -alpha(-(a/2) v.t), i.e. +(a/2) \
alpha v.t\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"coefV", "[", 
         RowBox[{"1", ",", "Vx"}], "]"}], "-", 
        RowBox[{"aa", "/", "2"}]}], "]"}], 
      ",", "\"\<Kinetic theory gives -(a/2) alpha v.t: tangential drag \
opposes the motion, like the normal drag. With the printed sign the \
tangential drag would accelerate the element. The disk and cylinder formulas \
below confirm the kinetic sign.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<ratio of normal to tangential thermophoretic stress is 2(2 - \
a)/a\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coefQ", "[", 
          RowBox[{"3", ",", "qz"}], "]"}], "/", 
         RowBox[{"coefQ", "[", 
          RowBox[{"1", ",", "qx"}], "]"}]}], "-", 
        RowBox[{"2", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "-", "aa"}], ")"}], "/", "aa"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<sign of the tangential thermophoretic stress (+(a/2) sin \
theta along t_1)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"thermoTan50", "/.", "nuSol"}], ")"}], "-", 
        RowBox[{"coefQ", "[", 
         RowBox[{"1", ",", "qx"}], "]"}]}], "]"}], 
      ",", "\"\<Kinetic theory: the tangential stress points along the \
tangential heat flux (toward the cold side), F_t1 = -(a/2) sin theta alpha (3 \
nu/4)(T'/T). The printed sign pushes toward the hot side.\>\""}], "]"}], ",", 
    
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<identified G-Y coefficient:  \[Nu] = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nuSym", "/.", "nuSol"}], "/.", 
           RowBox[{"hh", "->", 
            RowBox[{"mm", "/", 
             RowBox[{"(", 
              RowBox[{"2", "kB", "Tk"}], ")"}]}]}]}], ",", "kinAssume"}], 
         "]"}], "]"}], 
       ",", "\"\<  (with \[Kappa] the heat conductivity entering q = \
-\[Kappa]\[Del]T)\>\""}], "}"}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (50)\>\"", 
      ",", "\"\<nu is the kinematic viscosity for a monatomic gas\>\"", 
      ",", "\"\<nu = (4/15) kappa/(N k_B). With the Eucken/Chapman-Enskog \
value kappa = (15/4)(k_B/m) mu this is nu = mu/(m N) = mu/rho.\>\""}], "]"}], 
    ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 3\>\"", 
      ",", "\"\<'grad T = -T'(0,0,1), so the gas is hotter at large z (cold \
below, hot above)'\>\"", ",", "False", 
      ",", "\"\<T(z) = T0 - T' z decreases upward: the gas is colder at large \
z (hot below, cold above). The stated direction of the force (+z, toward \
cold) is correct.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"044462d6-fee2-4e79-a076-044a2bbd8f45"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "pressure term: -\[Alpha] Sqrt[\[Pi]/h]/2 = -N ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "fe4d6e7c-33c4-423c-b6a3-11d9bd88688f"],
 " T"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"6bfa3a9f-6409-4cd6-bded-1d46d0e2b229"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "normal drag: -\[Alpha] [2 - a(1 - \[Pi]/4)] v.n"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"19216f86-c9aa-4272-b0ef-1367a06b8651"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "tangential drag enters as -\[Alpha](-(a/2) v.t), i.e. +(a/2) \[Alpha] v.t",
 "\n",
 StyleBox["Kinetic theory gives -(a/2) \[Alpha] v.t: tangential drag opposes \
the motion, like the normal drag. With the printed sign the tangential drag \
would accelerate the element. The disk and cylinder formulas below confirm \
the kinetic sign.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"0a3401ea-eb04-403b-8dd8-31b5a2ea9405"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "ratio of normal to tangential thermophoretic stress is 2(2 - a)/a"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"045be3fc-d4d8-4149-af89-bdc59e49678e"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "sign of the tangential thermophoretic stress (+(a/2) sin \[Theta] along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", 
    StyleBox["1",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9cab071b-bfa8-446e-89da-e4e931f3b5ad"],
 ")",
 "\n",
 StyleBox["Kinetic theory: the tangential stress points along the tangential \
heat flux (toward the cold side), ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["t1",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "33fa37c4-6ece-4250-9b4f-ddb3999f1340"],
 StyleBox[" = -(a/2) sin \[Theta] \[Alpha] (3 \[Nu]/4)(T'/T). The printed \
sign pushes toward the hot side.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"78c8aa77-d496-4f53-9af4-f78610b2e7c7"],

Cell[BoxData[
 TemplateBox[{"\"identified G-Y coefficient:  \[Nu] = \"", 
   TagBox[
    FormBox[
     FractionBox[
      RowBox[{"4", " ", "kap"}], 
      RowBox[{"15", " ", "kB", " ", "nn"}]], TraditionalForm], 
    TraditionalForm, Editable -> True], 
   "\"  (with \[Kappa] the heat conductivity entering q = \
-\[Kappa]\[Del]T)\""},
  "RowDefault"]], "Output",ExpressionUUID->"d6a2cb94-7d4c-4d57-b6c6-\
0274a450f054"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eq. (50)",
  FontWeight->"Bold"],
 ":   ",
 "\[Nu] is the kinematic viscosity for a monatomic gas",
 "\n",
 StyleBox["\[Nu] = (4/15) \[Kappa]/(N ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "645a1f47-068d-43ff-a3e1-1beb6da266d2"],
 StyleBox["). With the Eucken/Chapman-Enskog value \[Kappa] = (15/4)(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9b8bcfa9-27e1-4129-b450-2d95e0e35b13"],
 StyleBox["/m) \[Mu] this is \[Nu] = \[Mu]/(m N) = \[Mu]/\[Rho].",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"94e38f21-de32-4b99-8db6-0a793e12d967"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Sec. 3",
  FontWeight->"Bold"],
 ":   ",
 "'\[Del]T = -T'(0,0,1), so the gas is hotter at large z (cold below, hot \
above)'",
 "\n",
 StyleBox["T(z) = T0 - T' z decreases upward: the gas is colder at large z \
(hot below, cold above). The stated direction of the force (+z, toward cold) \
is correct.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"96ccc3ed-52a2-4312-8814-4e719b9ef630"],

Cell[TextData[{
 StyleBox["Integrating over a sphere.",
  FontWeight->"Bold"],
 " Every surface element of a convex body sees the undisturbed free-molecular \
gas, so the force on the body is the surface integral of the element stress. \
With the kinetic stress we recover the two classical free-molecule results \
for a sphere: Epstein drag with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Delta]", " ", "=", " ", "1", " ", "+", " ", "\[Pi]", " ", "a", "/", 
    "8"}], TraditionalForm]],ExpressionUUID->
  "483223a0-f888-4e7c-97c0-532df5ec8067"],
 ", and Waldmann's thermophoretic force, which is independent of the \
accommodation coefficient. With the signs printed in (50), the thermophoretic \
force on a sphere would instead be proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", " ", "-", " ", "2", "a"}], TraditionalForm]],ExpressionUUID->
  "58ff3cfc-6215-474b-a8ad-63805924027d"],
 " and would vanish for diffuse reflection."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"beb84311-ae8c-4f7d-8502-a25f34e6920d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nHat", "[", 
    RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "th", "]"}], 
      RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sin", "[", "th", "]"}], 
      RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
     RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t1Hat", "[", 
    RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "th", "]"}], 
      RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Cos", "[", "th", "]"}], 
      RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
     RowBox[{"-", 
      RowBox[{"Sin", "[", "th", "]"}]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"t2Hat", "[", 
    RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
     RowBox[{"Cos", "[", "ph", "]"}], ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ct", "=", 
   RowBox[{"coefQ", "[", 
    RowBox[{"1", ",", "qx"}], "]"}]}], ";", 
  RowBox[{"Cn", "=", 
   RowBox[{"coefQ", "[", 
    RowBox[{"3", ",", "qz"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stressKin", "[", 
    RowBox[{"n_", ",", "V_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "alphaK"}], 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Pi", "/", "hh"}], "]"}], "/", "2"}], "n"}], "-", 
    RowBox[{"alphaK", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"aa", "/", "2"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"V", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"V", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"aa", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"V", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
    RowBox[{"Ct", 
     RowBox[{"(", 
      RowBox[{"q", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
    RowBox[{"Cn", 
     RowBox[{"(", 
      RowBox[{"q", ".", "n"}], ")"}], "n"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stressPDF", "[", 
    RowBox[{"n_", ",", "t1_", ",", "t2_", ",", "V_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tn", "=", 
        RowBox[{"q", ".", "n"}]}], ",", 
       RowBox[{"t1c", "=", 
        RowBox[{"q", ".", "t1"}]}], ",", 
       RowBox[{"qq", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"q", ".", "q"}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "alphaK"}], 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"Pi", "/", "hh"}], "]"}], "/", "2"}], "n"}], "-", 
       RowBox[{"alphaK", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"aa", "/", "2"}], ")"}]}], 
           RowBox[{"(", 
            RowBox[{"V", ".", "t1"}], ")"}], "t1"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"aa", "/", "2"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"V", ".", "t2"}], ")"}], "t2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{"aa", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"V", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
       RowBox[{"alphaK", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"nuSym", "/", "4"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"qq", "/", 
          RowBox[{"(", 
           RowBox[{"kap", "Tk"}], ")"}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"aa", "/", "2"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "t1c"}], "/", "qq"}], ")"}], "t1"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "-", "aa"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"tn", "/", "qq"}], ")"}], "n"}]}], ")"}]}]}], "/.", 
      "nuSol"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sphereForce", "[", "stressFn_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"stressFn", "[", 
         RowBox[{"th", ",", "ph"}], "]"}], 
        RowBox[{"Rs", "^", "2"}], 
        RowBox[{"Sin", "[", "th", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"th", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ph", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"kinAssume", "&&", 
      RowBox[{"q0", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fsph", "=", 
   RowBox[{"sphereForce", "[", 
    RowBox[{
     RowBox[{"stressKin", "[", 
      RowBox[{
       RowBox[{"nHat", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "Vs"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "q0"}], "}"}]}], "]"}], "&"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"FsphPDF", "=", 
   RowBox[{"sphereForce", "[", 
    RowBox[{
     RowBox[{"stressPDF", "[", 
      RowBox[{
       RowBox[{"nHat", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ",", 
       RowBox[{"t1Hat", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ",", 
       RowBox[{"t2Hat", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "q0"}], "}"}]}], "]"}], "&"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"waldmann", "=", 
   RowBox[{"16", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "15"}], 
    RowBox[{"Rs", "^", "2"}], "q0", 
    RowBox[{"Sqrt", "[", "hh", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epstein", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"4", 
       RowBox[{"Pi", "/", "3"}]}], ")"}]}], 
    RowBox[{"Rs", "^", "2"}], 
    RowBox[{"(", 
     RowBox[{"2", "alphaK"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Pi", 
       RowBox[{"aa", "/", "8"}]}]}], ")"}], "Vs"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<sphere force (kinetic stresses):  F_z = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Fsph", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 3 (sphere)\>\"", 
      ",", "\"\<kinetic stresses give Waldmann's force (16 Sqrt[pi]/15) R^2 \
kappa |grad T| / vbar, independent of a\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Fsph", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/.", 
          RowBox[{"Vs", "->", "0"}]}], ")"}], "-", "waldmann"}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 3 (sphere)\>\"", 
      ",", "\"\<kinetic stresses give Epstein's drag (4 pi/3) R^2 rho cbar (1 \
+ pi a/8) V\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Fsph", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/.", 
          RowBox[{"q0", "->", "0"}]}], ")"}], "-", "epstein"}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (50) (sphere)\>\"", 
      ",", "\"\<the signs printed in (50) reproduce Waldmann's force\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"FsphPDF", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "-", "waldmann"}], "]"}], ",", 
      RowBox[{"\"\<With the printed tangential sign, F_z = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"FsphPDF", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "/", "waldmann"}], "]"}], "]"}], 
        "]"}], "<>", "\"\< x Waldmann, which vanishes for full accommodation \
(a = 1).\>\""}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"8ec51be3-\
d49a-4eb6-be0c-06db8459c09f"],

Cell[BoxData[
 TemplateBox[{"\"sphere force (kinetic stresses):  F_z = \"", 
   TagBox[
    FormBox[
     RowBox[{"-", 
       FractionBox[
        RowBox[{
          SqrtBox["\[Pi]"], " ", 
          SuperscriptBox["Rs", "2"], " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{"5", " ", 
                RowBox[{"(", 
                  RowBox[{
                    RowBox[{"\[Pi]", " ", "aa"}], "+", "8"}], ")"}], " ", 
                "mm", " ", "nn", " ", "Vs"}], "-", 
              RowBox[{"16", " ", "hh", " ", "q0"}]}], ")"}]}], 
        RowBox[{"15", " ", 
          SqrtBox["hh"]}]]}], TraditionalForm], TraditionalForm, Editable -> 
    True]},
  "RowDefault"]], "Output",ExpressionUUID->"655dd413-f80b-4fc0-8d2c-\
56c2b42e4e0f"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
