Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SuperscriptBox[
        StyleBox["F",
         FontWeight->"Bold"], "b"]},
      {
       SuperscriptBox[
        StyleBox["\[Tau]",
         FontWeight->"Bold"], "b"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "=", " ", "-", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], 
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold"], 
        StyleBox["drag",
         FontSlant->"Plain"]], "0"},
      {
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], "0", 
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["drag",
         FontSlant->"Plain"]]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], 
   RowBox[{"(", GridBox[{
      {
       SuperscriptBox[
        RowBox[{"(", "\[Del]", " ", 
         StyleBox["ln",
          FontSlant->"Plain"], " ", "T", ")"}], "b"]},
      {
       SuperscriptBox[
        StyleBox["v",
         FontWeight->"Bold"], "b"]},
      {
       SuperscriptBox[
        StyleBox["\[Omega]",
         FontWeight->"Bold"], "b"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
