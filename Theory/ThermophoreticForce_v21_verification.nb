Cell[TextData[{
 "Renormalise after each step: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], " ", "\[LeftArrow]", " ", 
    StyleBox["q",
     FontWeight->"Bold"], "/", "|", 
    StyleBox["q",
     FontWeight->"Bold"], "|"}], TraditionalForm]],ExpressionUUID->
  "7f5e4446-dc23-4fcd-ad6e-f6d21808a0c7"],
 "."
}], "Text",ExpressionUUID->"46c5da35-d5a2-40c8-98df-aeaa077b1f49"],

Cell[TextData[{
 StyleBox["Verification of Section 1.6: the equations integrate consistently.",
  FontWeight->"Bold"],
 " We implement (23)\[Dash](26) directly and integrate them for a generic \
asymmetric body with random tensors of the classes in Section 1.2, in a \
uniform downward gradient. Three invariants are checked along the numerical \
solution: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["q",
     FontWeight->"Bold"], "|", " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"8dd88af1-9277-4a7e-ab9d-f2aaed966edf"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "\[Transpose]"], "R", " ", "=", " ", 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "8fea21cc-970f-42fa-b948-a93141085375"],
 ", and the mechanical energy balance ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["d", 
     RowBox[{"d", "t"}]], "(", 
    FractionBox["1", "2"], "M", 
    SuperscriptBox["v", "2"], " ", "+", " ", 
    FractionBox["1", "2"], 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "\[CenterDot]", 
    StyleBox["I",
     FontWeight->"Bold"], 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], " ", "+", " ", "M", "g", "Z", ")", " ", "=", " ", 
    SubscriptBox["P", 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "-", " ", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], "\[CenterDot]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], " ", "-", " ", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], "\[CenterDot]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "2ea550fe-d62e-4713-88f3-d2dcd0142e65"],
 ". The function ",
 StyleBox["eomRHS",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 " defined here is reused in Section 2."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"fa7ccc37-672f-475d-a073-8eb6058876ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eomRHS", "[", 
    RowBox[{
     RowBox[{"s_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}], ")"}]}], ",", 
     "pars_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"s", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ",", 
       RowBox[{"v", "=", 
        RowBox[{"s", "[", 
         RowBox[{"[", 
          RowBox[{"4", ";;", "6"}], "]"}], "]"}]}], ",", 
       RowBox[{"q", "=", 
        RowBox[{"s", "[", 
         RowBox[{"[", 
          RowBox[{"7", ";;", "10"}], "]"}], "]"}]}], ",", 
       RowBox[{"w", "=", 
        RowBox[{"s", "[", 
         RowBox[{"[", 
          RowBox[{"11", ";;", "13"}], "]"}], "]"}]}], ",", "R", ",", 
       RowBox[{"gl", "=", 
        RowBox[{"pars", "[", "\"\<gradLnT\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"R", "=", 
       RowBox[{"quatR", "[", 
        RowBox[{"q", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"q", ".", "q"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"Join", "[", 
       RowBox[{"v", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"pars", "[", "\"\<M\>\"", "]"}]}], 
            RowBox[{"pars", "[", "\"\<g\>\"", "]"}], "Zhat"}], "-", 
           RowBox[{"R", ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"pars", "[", "\"\<fth\>\"", "]"}], ".", 
               RowBox[{"Transpose", "[", "R", "]"}], ".", "gl"}], "+", 
              RowBox[{
               RowBox[{"pars", "[", "\"\<fdrag\>\"", "]"}], ".", 
               RowBox[{"Transpose", "[", "R", "]"}], ".", "v"}]}], ")"}]}]}], 
          ")"}], "/", 
         RowBox[{"pars", "[", "\"\<M\>\"", "]"}]}], ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], 
         RowBox[{
          RowBox[{"Qmat", "[", "q", "]"}], ".", "w"}]}], ",", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"pars", "[", "\"\<I\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Cross", "[", 
             RowBox[{"w", ",", 
              RowBox[{
               RowBox[{"pars", "[", "\"\<I\>\"", "]"}], ".", "w"}]}], "]"}]}],
            "-", 
           RowBox[{
            RowBox[{"pars", "[", "\"\<Tth\>\"", "]"}], ".", 
            RowBox[{"Transpose", "[", "R", "]"}], ".", "gl"}], "-", 
           RowBox[{
            RowBox[{"pars", "[", "\"\<Tdrag\>\"", "]"}], ".", "w"}]}]}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"integrateEOM", "[", 
    RowBox[{"pars_", ",", "s0_List", ",", "tmax_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"y", ",", "tt", ",", "sol"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "tt", "]"}], "==", 
            RowBox[{"eomRHS", "[", 
             RowBox[{
              RowBox[{"y", "[", "tt", "]"}], ",", "pars"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", 
            RowBox[{"N", "[", "s0", "]"}]}]}], "}"}], ",", "y", ",", 
         RowBox[{"{", 
          RowBox[{"tt", ",", "0", ",", "tmax"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", "Infinity"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}], ",", 
         RowBox[{"AccuracyGoal", "->", "12"}]}], "]"}]}], ";", "sol"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateFns", "[", "sol_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f1", ",", "f2", ",", "f3", ",", "f4"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"f1", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"sol", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"f2", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"sol", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"4", ";;", "6"}], "]"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"f3", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"sol", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"7", ";;", "10"}], "]"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"f4", "[", 
        RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"sol", "[", "t", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"11", ";;", "13"}], "]"}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{"f1", ",", "f2", ",", "f3", ",", "f4"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"randSPD", "[", "scale_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"scale", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "3", "]"}], "+", 
        RowBox[{"0.3", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", 
            RowBox[{"Transpose", "[", "m", "]"}]}], ")"}], "/", "2"}]}]}], 
       ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"genericPars", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<M\>\"", "->", "1."}], ",", 
     RowBox[{"\"\<g\>\"", "->", "1."}], ",", 
     RowBox[{"\"\<I\>\"", "->", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"{", 
        RowBox[{"0.10", ",", "0.13", ",", "0.17"}], "}"}], "]"}]}], ",", 
     RowBox[{"\"\<fth\>\"", "->", 
      RowBox[{"randSPD", "[", "1.", "]"}]}], ",", 
     RowBox[{"\"\<fdrag\>\"", "->", 
      RowBox[{"randSPD", "[", "1.", "]"}]}], ",", 
     RowBox[{"\"\<Tth\>\"", "->", 
      RowBox[{"0.2", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], ",", 
     RowBox[{"\"\<Tdrag\>\"", "->", 
      RowBox[{"randSPD", "[", "1.", "]"}]}], ",", 
     RowBox[{"\"\<gradLnT\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"-", "1."}]}], "}"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xs", ",", "vs", ",", "qs", ",", "ws"}], "}"}], "=", 
   RowBox[{"stateFns", "[", 
    RowBox[{"integrateEOM", "[", 
     RowBox[{"genericPars", ",", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"Normalize", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0.2", ",", 
           RowBox[{"-", "0.3"}], ",", "0.1"}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], ",", "200."}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"energy", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"0.5", 
     RowBox[{"genericPars", "[", "\"\<M\>\"", "]"}], 
     RowBox[{
      RowBox[{"vs", "[", "t", "]"}], ".", 
      RowBox[{"vs", "[", "t", "]"}]}]}], "+", 
    RowBox[{"0.5", 
     RowBox[{
      RowBox[{"ws", "[", "t", "]"}], ".", 
      RowBox[{"genericPars", "[", "\"\<I\>\"", "]"}], ".", 
      RowBox[{"ws", "[", "t", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"genericPars", "[", "\"\<M\>\"", "]"}], 
     RowBox[{"genericPars", "[", "\"\<g\>\"", "]"}], 
     RowBox[{
      RowBox[{"xs", "[", "t", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"power", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"R", "=", 
        RowBox[{"quatR", "[", 
         RowBox[{"Normalize", "[", 
          RowBox[{"qs", "[", "t", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"gl", "=", 
        RowBox[{"genericPars", "[", "\"\<gradLnT\>\"", "]"}]}], ",", "vb", ",",
        "g0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"vb", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "R", "]"}], ".", 
        RowBox[{"vs", "[", "t", "]"}]}]}], ";", 
      RowBox[{"g0", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "R", "]"}], ".", "gl"}]}], ";", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"vb", ".", 
         RowBox[{"genericPars", "[", "\"\<fth\>\"", "]"}], ".", "g0"}]}], "-", 
       RowBox[{
        RowBox[{"ws", "[", "t", "]"}], ".", 
        RowBox[{"genericPars", "[", "\"\<Tth\>\"", "]"}], ".", "g0"}], "-", 
       RowBox[{"vb", ".", 
        RowBox[{"genericPars", "[", "\"\<fdrag\>\"", "]"}], ".", "vb"}], "-", 
       
       RowBox[{
        RowBox[{"ws", "[", "t", "]"}], ".", 
        RowBox[{"genericPars", "[", "\"\<Tdrag\>\"", "]"}], ".", 
        RowBox[{"ws", "[", "t", "]"}]}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"work", "=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"power", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "200."}], "}"}], ",", 
     RowBox[{"MaxRecursion", "->", "30"}], ",", 
     RowBox[{"PrecisionGoal", "->", "8"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qdev", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"qs", "[", "t", "]"}], "]"}], "-", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "200.", ",", "0.5"}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"odev", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"quatR", "[", 
           RowBox[{"qs", "[", "t", "]"}], "]"}], "]"}], ".", 
         RowBox[{"quatR", "[", 
          RowBox[{"qs", "[", "t", "]"}], "]"}]}], "-", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "200.", ",", "0.5"}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ebal", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"energy", "[", "200.", "]"}], "-", 
        RowBox[{"energy", "[", "0", "]"}]}], ")"}], "-", "work"}], "]"}], "/", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "work", "]"}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (23)-(26)\>\"", 
      ",", "\"\<integration conserves |q| = 1 (without explicit \
renormalisation)\>\"", ",", 
      RowBox[{"qdev", "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "7"}]}]}], ",", 
      RowBox[{"\"\<max | |q| - 1 | = \>\"", "<>", 
       RowBox[{"sci", "[", "qdev", "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (23)-(26)\>\"", 
      ",", "\"\<R(q)^T R(q) = 1 along the solution\>\"", ",", 
      RowBox[{"odev", "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}], ",", 
      RowBox[{"\"\<max deviation = \>\"", "<>", 
       RowBox[{"sci", "[", "odev", "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (23)-(26)\>\"", 
      ",", "\"\<mechanical energy balance with thermophoretic power and \
dissipation\>\"", ",", 
      RowBox[{"ebal", "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}]}], ",", 
      RowBox[{"\"\<relative residual = \>\"", "<>", 
       RowBox[{"sci", "[", "ebal", "]"}]}]}], "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ListLinePlot3D", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"xs", "[", "t", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "200", ",", "0.2"}], "}"}]}], "]"}], 
          ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<CoM trajectory, generic body\>\""}],
           ",", 
          RowBox[{"ImageSize", "->", "300"}]}], "]"}], ",", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"t", ",", "#"}], "}"}], "&"}], "/@", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"quatR", "[", 
                   RowBox[{"Normalize", "[", 
                    RowBox[{"qs", "[", "t", "]"}], "]"}], "]"}], "]"}], ".", 
                 "Zhat"}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "0", ",", "200", ",", "0.2"}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<u1\>\"", ",", "\"\<u2\>\"", ",", "\"\<u3\>\""}], 
            "}"}]}], ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<u = R^T Z (body-frame gradient axis)\>\""}],
           ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<t\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "340"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"Spacer", "[", "10", "]"}]}], "]"}]}], "}"}], "]"}]}], "Input",E\
xpressionUUID->"a5f4d085-4088-4055-b5aa-0bf627157e80"],

