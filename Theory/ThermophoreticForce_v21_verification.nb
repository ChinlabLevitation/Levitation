   OverscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "."], " ", "=", " ", "-", "M", "g", "\[ThinSpace]", 
   
   OverscriptBox["Z", "^"], " ", "-", " ", "R", "(", 
