     FractionBox[
      RowBox[{
        RowBox[{"(", 
          RowBox[{
            RowBox[{"\[Pi]", " ", "aa"}], "+", "8"}], ")"}], " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{"3", " ", "aa", " ", "lr"}], "+", "8"}], ")"}]}], 
      RowBox[{"8", " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{"aa", " ", 
              RowBox[{"(", 
                RowBox[{
                  RowBox[{"3", " ", "lr"}], "+", "\[Pi]"}], ")"}]}], "+", 
            "8"}], ")"}]}]], TraditionalForm], TraditionalForm, Editable -> 
    True]},
  "RowDefault"]], "Output",ExpressionUUID->"54bade9e-78cf-49c9-8d4e-\
2877491ffebb"],

