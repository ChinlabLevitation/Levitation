     RowBox[{"None", ",", 
      RowBox[{"{", "LightGray", "}"}]}], "}"}]}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",ExpressionUUID->\
"87a887e1-87f2-416e-b318-7020fa79d4ee"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"group\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"f_th (sym)\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"f_drag\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"T_th\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"T_drag\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"total\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"f_th if not assumed symmetric\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"C1 (generic asymmetric)\"\>", "6", "6", "9", "6", "27", "9"},
    {"\<\"D2h (three mirror planes)\"\>", "3", "3", "0", "3", "9", "3"},
    {"\<\"Dinfh (cylinder, spheroid)\"\>", "2", "2", "0", "2", "6", "2"},
    {"\<\"Cinfv (cone: axis + containing mirrors)\"\>", "2", "2", "1", "2", 
     "7", "2"},
    {"\<\"Dinf (helix-like, chiral)\"\>", "2", "2", "2", "2", "8", "2"},
    {"\<\"Cinf (propeller, chiral polar)\"\>", "2", "2", "3", "2", "9", "3"},
    {"\<\"O(3) (sphere)\"\>", "1", "1", "0", "1", "3", "1"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"e198b540-e2d4-484a-bfd1-e647bdcc94ea"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", "name_", "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"Select", "[", 
     RowBox[{"symTab", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "==", "name"}], "&"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (27)\>\"", 
      ",", "\"\<generic body: 6 + 6 + 9 + 6 = 27\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", "\"\<C1 (generic asymmetric)\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "6"}], "]"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"6", ",", "6", ",", "9", ",", "6", ",", "27"}], "}"}]}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (28)\>\"", 
      ",", "\"\<three mirror planes: diagonal tensors and T_th = 0, total 9\>\
\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", "\"\<D2h (three mirror planes)\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "6"}], "]"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3", ",", "0", ",", "3", ",", "9"}], "}"}]}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 1.7\>\"", ",", "\"\<Level 2 heading '(18 DOF)'\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", "\"\<D2h (three mirror planes)\>\"", "]"}], "[", 
        RowBox[{"[", "6", "]"}], "]"}], "==", "18"}], 
      ",", "\"\<The group analysis gives 3 + 3 + 0 + 3 = 9, as the text below \
(28) and Table 1 also state; the '(18 DOF)' in the heading is a typo.\>\""}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (29)\>\"", 
      ",", "\"\<uniaxial class 'C_{inf v}' has T_th = 0 (6 DOF total)\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
        "row", "[", "\"\<Cinfv (cone: axis + containing mirrors)\>\"", "]"}], 
        "[", 
        RowBox[{"[", "4", "]"}], "]"}], "==", "0"}], 
      ",", "\"\<For C_{inf v} (e.g. a cone, or any body of revolution that is \
not symmetric end to end) the pseudotensor T_th has one invariant: an \
antisymmetric part lambda [e_3]x, giving the aligning torque tau ~ e_3 x grad \
ln T. T_th = 0 holds for D_{inf h}, the actual symmetry of cylinders and \
spheroids. So (29) is correct for the bodies listed, but the group label \
should be D_{inf h}.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (29)\>\"", 
      ",", "\"\<cylinders and spheroids (D_{inf h}): 2 + 2 + 0 + 2 = 6\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", "\"\<Dinfh (cylinder, spheroid)\>\"", "]"}], "[", 
        
        RowBox[{"[", 
         RowBox[{"2", ";;", "6"}], "]"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "0", ",", "2", ",", "6"}], "}"}]}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (30)\>\"", ",", "\"\<sphere: 1 + 1 + 0 + 1 = 3\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"row", "[", "\"\<O(3) (sphere)\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ";;", "6"}], "]"}], "]"}], "==", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "0", ",", "1", ",", "3"}], "}"}]}]}], 
     "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Sec. 1.7\>\"", 
      ",", "\"\<chiral bodies allow an antisymmetric part of f_th\>\"", 
      ",", "\"\<For C_{inf} (and C1) a general f_th has more DOF than the \
symmetric count (last column). The assumed symmetry of f_th in (4) therefore \
removes the transverse 'swirl' coupling of chiral particles.\>\""}], "]"}]}], 
   "}"}], "]"}]}], "Input",ExpressionUUID->"74a26e0b-cc00-4229-95c6-\
e06e669b0d7d"],

