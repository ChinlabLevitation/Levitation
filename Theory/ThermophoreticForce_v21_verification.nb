Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (50) (sphere)",
  FontWeight->"Bold"],
 ":   ",
 "the signs printed in (50) reproduce Waldmann's force",
 "\n",
 StyleBox["With the printed tangential sign, ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["z",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "62bc65ea-3463-4065-a5eb-93687f163416"],
 StyleBox[" = \!\(\*FormBox[RowBox[{\"1\", \"-\", \"aa\"}], \
TraditionalForm]\) x Waldmann, which vanishes for full accommodation (a = 1).",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"20c11e53-39ac-4fe5-876e-d5ee6985cc69"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Thermophoretic force on a disk", "Section",ExpressionUUID->"c8819c74-6a16-42a6-a31c-28e28669ecba"],

Cell[TextData[{
 "A disk of area ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "8714474d-f244-4c10-9632-e19a8c3c3aa4"],
 " with normal tilted by ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "b429aa8d-0830-4bec-aab3-5726d7c26d7e"],
 " from ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["z", "^"], TraditionalForm]],ExpressionUUID->
  "45e226a5-1cc9-4ba3-8df5-66c1782a81f9"],
 " in the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "20a0cb93-2646-4a3e-838d-291fc19aa0eb"],
 "-",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "5aa38bbc-72b3-4f36-836a-ddf2a2cd2410"],
 " plane has two surfaces with normals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    OverscriptBox["n", "^"]}], TraditionalForm]],ExpressionUUID->
  "372f6bac-4362-489b-88cd-ba7b6cf14126"],
 ". Summing both surfaces (pressure cancels, drag and thermophoresis \
double):"
}], "Text",ExpressionUUID->"2d9aa9e6-3897-4ced-85a3-b91fe845cd43"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["F", 
        SubscriptBox["t", "1"]]},
      {
       SubscriptBox["F", 
        SubscriptBox["t", "2"]]},
      {
       SubscriptBox["F", "n"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "=", " ", "\[Alpha]", " ", "a", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        SubscriptBox[
         OverscriptBox["t", "^"], "1"]}]},
      {
       RowBox[{
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        SubscriptBox[
         OverscriptBox["t", "^"], "2"]}]},
      {
       RowBox[{
       "-", "2", "[", "2", " ", "-", " ", "a", "(", "1", " ", "-", " ", 
        "\[Pi]", "/", "4", ")", "]", 
        StyleBox["v",
         FontWeight->"Bold"], "\[CenterDot]", 
        OverscriptBox["n", "^"]}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "+", " ", "\[Alpha]", 
   FractionBox[
    RowBox[{"3", "\[Nu]"}], "4"], 
   FractionBox[
    RowBox[{"T", "'"}], "T"], 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"a", 
        StyleBox["sin",
         FontSlant->"Plain"], "\[Theta]"}]},
      {"0"},
      {
       RowBox[{"2", "(", "2", " ", "-", " ", "a", ")", 
        StyleBox["cos",
         FontSlant->"Plain"], "\[Theta]"}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(51)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"3817b347-877e-4e8b-bed2-1197c2b2ac36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nD", "=", 
   RowBox[{"nHat", "[", 
    RowBox[{"thD", ",", "0"}], "]"}]}], ";", 
  RowBox[{"t1D", "=", 
   RowBox[{"t1Hat", "[", 
    RowBox[{"thD", ",", "0"}], "]"}]}], ";", 
  RowBox[{"t2D", "=", 
   RowBox[{"t2Hat", "[", 
    RowBox[{"thD", ",", "0"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vd", "=", 
   RowBox[{"{", 
    RowBox[{"Vdx", ",", "Vdy", ",", "Vdz"}], "}"}]}], ";", 
  RowBox[{"qd", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "q0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fdisk", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"stressKin", "[", 
       RowBox[{"nD", ",", "Vd", ",", "qd"}], "]"}], "+", 
      RowBox[{"stressKin", "[", 
       RowBox[{
        RowBox[{"-", "nD"}], ",", "Vd", ",", "qd"}], "]"}]}], ",", 
     "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FdiskLocal", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Fdisk", ".", "t1D"}], ",", 
      RowBox[{"Fdisk", ".", "t2D"}], ",", 
      RowBox[{"Fdisk", ".", "nD"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F51", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"alphaK", "aa", 
        RowBox[{"(", 
         RowBox[{"Vd", ".", "t1D"}], ")"}]}], ",", 
       RowBox[{"alphaK", "aa", 
        RowBox[{"(", 
         RowBox[{"Vd", ".", "t2D"}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], "alphaK", "aa", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"aa", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"Vd", ".", "nD"}], ")"}]}]}], "}"}], "+", 
     RowBox[{"alphaK", 
      RowBox[{"(", 
       RowBox[{"3", 
        RowBox[{"nuSym", "/", "4"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"q0", "/", 
        RowBox[{"(", 
         RowBox[{"kap", "Tk"}], ")"}]}], ")"}], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"aa", 
         RowBox[{"Sin", "[", "thD", "]"}]}], ",", "0", ",", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{"2", "-", "aa"}], ")"}], 
         RowBox[{"Cos", "[", "thD", "]"}]}]}], "}"}]}]}], "/.", "nuSol"}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (51)\>\"", 
      ",", "\"\<pressure cancels between the two faces\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Fdisk", "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"Vd", ",", 
            RowBox[{"{", "q0", "}"}]}], "]"}], "->", "0"}], "]"}]}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (51)\>\"", 
      ",", "\"\<thermophoretic normal stress doubles to 2(2 - a) cos \
theta\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FdiskLocal", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", 
          RowBox[{"F51", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/.", 
        RowBox[{"Thread", "[", 
         RowBox[{"Vd", "->", "0"}], "]"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (51)\>\"", 
      ",", "\"\<normal drag is -2 alpha a [2 - a(1 - pi/4)] v.n\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FdiskLocal", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", 
          RowBox[{"F51", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/.", 
        RowBox[{"q0", "->", "0"}]}], "]"}], 
      ",", "\"\<Kinetic result: -2 alpha [2 - a(1 - pi/4)] v.n, the doubled \
normal term of (50). The extra factor a multiplying the normal drag in (51) \
is spurious.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (51)\>\"", 
      ",", "\"\<tangential terms: +alpha a v.t and +alpha (3 nu/4)(T'/T) a \
sin theta\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"FdiskLocal", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"F51", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], 
      ",", "\"\<Kinetic result: -alpha a v.t and -alpha (3 nu/4)(T'/T) a sin \
theta. Both tangential signs inherit the sign slips of (50); the magnitudes \
(doubling) are correct.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUI\
D->"1fa144e8-d109-417d-893b-c46ee088133b"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (51)",
  FontWeight->"Bold"],
 ":   ",
 "pressure cancels between the two faces"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"689543c8-06e2-4bbe-b03d-41e576985f77"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (51)",
  FontWeight->"Bold"],
 ":   ",
 "thermophoretic normal stress doubles to 2(2 - a) cos \[Theta]"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"5fab5708-0f54-4737-a836-d8ac57e23463"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (51)",
  FontWeight->"Bold"],
 ":   ",
 "normal drag is -2 \[Alpha] a [2 - a(1 - \[Pi]/4)] v.n",
 "\n",
 StyleBox["Kinetic result: -2 \[Alpha] [2 - a(1 - \[Pi]/4)] v.n, the doubled \
normal term of (50). The extra factor a multiplying the normal drag in (51) \
is spurious.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"165f7e8a-94b4-44bf-a373-c83b6b546b38"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (51)",
  FontWeight->"Bold"],
 ":   ",
 "tangential terms: +\[Alpha] a v.t and +\[Alpha] (3 \[Nu]/4)(T'/T) a sin \
\[Theta]",
 "\n",
 StyleBox["Kinetic result: -\[Alpha] a v.t and -\[Alpha] (3 \[Nu]/4)(T'/T) a \
sin \[Theta]. Both tangential signs inherit the sign slips of (50); the \
magnitudes (doubling) are correct.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"6479f410-1daa-40cb-9f57-78550d588f3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Thermophoretic force on a cylinder", "Section",ExpressionUUID->"5f7949da-5f13-46b2-b7a3-71121d36be21"],

Cell[TextData[{
 "For a cylinder of radius ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "5e038f79-ec9d-4a4a-ab1f-63e5cb25ec15"],
 " and length ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "a7b041cf-f27b-48da-845b-bd1034f7fbef"],
 " with its axis tilted at angle ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "5b4f4cff-6518-40d1-b2cb-0f2ff1b41dda"],
 " from the ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "824b58d4-f938-4bba-b154-b13779975cb5"],
 "-axis in the ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "4f4790bc-4749-450b-a9d8-1ee94eabc5be"],
 "-",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "5035c2b0-594d-4e8f-82f4-f8f7eefcfe60"],
 " plane, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "(", "-", "v", ",", " ", "0", ",", 
    " ", "0", ")"}], TraditionalForm]],ExpressionUUID->
  "20943ec5-7785-42d8-9a25-bf76c8750c3f"],
 ", the lab-frame force components are (Garcia-Ybarra & Rosner 1989, Eq. \
24):"
}], "Text",ExpressionUUID->"bce59666-f6e6-44e8-9f91-d940c03beb3f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "X"], " ", "=", " ", 
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A", 
          SuperscriptBox[
           StyleBox["sin",
            FontSlant->"Plain"], "2"], "\[Theta]"}], " ", "+", " ", 
         RowBox[{"C", 
          SuperscriptBox[
           StyleBox["cos",
            FontSlant->"Plain"], "2"], "\[Theta]"}]}], ")"}], "v"}], " ", "+",
       " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"B", " ", "-", " ", "D"}], ")"}], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[Theta]", 
       StyleBox["cos",
        FontSlant->"Plain"], "\[Theta]", 
       FractionBox[
        RowBox[{"T", "'"}], "T"]}]}], "]"}]}], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(52)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"c44ed690-114a-424f-9608-5e1f883866f7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "Z"], " ", "=", " ", 
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"A", " ", "-", " ", "C"}], ")"}], 
       StyleBox["sin",
        FontSlant->"Plain"], "\[Theta]", 
       StyleBox["cos",
        FontSlant->"Plain"], "\[Theta]", "\[ThinSpace]", "v"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"B", 
          SuperscriptBox[
           StyleBox["cos",
            FontSlant->"Plain"], "2"], "\[Theta]"}], " ", "+", " ", 
         RowBox[{"D", 
          SuperscriptBox[
           StyleBox["sin",
            FontSlant->"Plain"], "2"], "\[Theta]"}]}], ")"}], 
       FractionBox[
        RowBox[{"T", "'"}], "T"]}]}], "]"}]}], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(53)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"bae43a2c-7ee0-4902-aefd-2f633e17dd81"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", "m", "N", "\[Pi]", " ", "r", "L", "/", 
    SqrtBox["h"]}], TraditionalForm]],ExpressionUUID->
  "3beda6d0-a292-4c05-b5e6-b4069bbc5254"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "A", " ", "=", " ", "2", "(", "1", " ", "+", " ", "a", "(", "\[Pi]", " ", "-",
     " ", "2", ")", "/", "8", ")"}], TraditionalForm]],ExpressionUUID->
  "f210485c-17f2-4a7b-a4a9-b4f62b396e59"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", " ", "=", " ", 
    FractionBox[
     RowBox[{"3", "\[Nu]"}], "2"], "(", "1", " ", "-", " ", "a", "/", "4", 
    ")"}], TraditionalForm]],ExpressionUUID->
  "a45df57c-89c4-4577-ac09-c541299dcb67"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "427e85dd-dcd8-41ce-89f9-fd3157fd0c55"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", " ", "=", " ", "3", "\[Nu]", " ", "a", "/", "4"}], 
   TraditionalForm]],ExpressionUUID->"41cb5a82-93a2-4e28-9ddb-3577f77111bb"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"v", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "3ad8cefc-471d-4b33-9aed-c6d4108db3a8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "a07e0fc8-3a67-4d1c-8f7c-acfaa1b50bb5"],
 " (cylinder axis along ",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]],ExpressionUUID->
  "7816ecb5-3558-4674-9d17-0cf26d9f450f"],
 "), the levitation force is"
}], "Text",ExpressionUUID->"9a47da7e-e3b8-4bf3-8784-fe8a3bb5e161"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["F", "\[RightVector]"], " ", "=", " ", 
   FractionBox[
    RowBox[{"m", "N", "\[Pi]", " ", "r", "L"}], 
    SqrtBox["h"]], 
   FractionBox[
    RowBox[{"3", "\[Nu]", "(", "1", " ", "-", " ", "a", "/", "4", ")"}], "2"], 
   FractionBox[
    RowBox[{"T", "'"}], "T"], 
   OverscriptBox["Z", "^"], " ", ","}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(54)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"838db67b-af0b-441a-bc99-e41e65add653"],

Cell[TextData[{
 "directed upward (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "0d0737f6-7ccb-4cda-bfe8-6f21efbf8a57"],
 ") to oppose gravity. This is proportional to the cylinder volume ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "c"], " ", "=", " ", "\[Pi]", " ", 
    SuperscriptBox["r", "2"], "L"}], TraditionalForm]],ExpressionUUID->
  "8138672e-8496-47ef-8966-cbedc81c9645"],
 " in the same way as the sphere result is proportional to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "o"], " ", "=", " ", 
    FractionBox["4", "3"], "\[Pi]", " ", 
    SuperscriptBox["r", "3"]}], TraditionalForm]],ExpressionUUID->
  "5d40547d-f2f4-42b9-afee-fe394ceae2bd"],
 ":"
}], "Text",ExpressionUUID->"69ca4f97-640d-4623-83bb-a4db3c2b6d33"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    OverscriptBox["F", "\[RightVector]"], 
    SubscriptBox["V", "c"]], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      FractionBox["a", "4"]}], ")"}], 
    RowBox[{
     FractionBox[
      SubscriptBox[
       OverscriptBox["F", "\[RightVector]"], "o"], 
      SubscriptBox["V", "o"]], " ", "."}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(55)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"b8b5b306-53a7-4ef2-a247-0ce50db0619c"],

Cell["\<\
The conversion between the Zheng (2002) and Garcia-Ybarra conventions is\
\>", "Text",ExpressionUUID->"53b279ae-ed38-46ce-bdf7-2ead93c2fd46"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"2", "m", "N", "\[Pi]", "\[Nu]"}], 
    SqrtBox["h"]], " ", "=", " ", 
   FractionBox[
    RowBox[{"\[Eta]", "\[Kappa]"}], 
    OverscriptBox["v", "_"]], " ", ",", " ", "\:2003\:2003", " ", 
   OverscriptBox["v", "_"], " ", "=", " ", 
   SqrtBox[
    RowBox[{"2", 
     SubscriptBox["k", "B"], "T", "/", "m"}]], " ", ",", " ", "\:2003\:2003", 
   " ", "\[Eta]", " ", "=", " ", 
   FractionBox[
    RowBox[{"16", 
     SqrtBox["\[Pi]"]}], "15"], " ", "\[TildeTilde]", " ", "1.89", " ", "\[ThickSpace]",
    "(", 
   StyleBox[
    RowBox[{"free", "\[ThickSpace]", " ", "molecular"}],
    FontSlant->"Plain"], ")", " ", "."}], TraditionalForm]], "DisplayFormula",\

 CellFrameLabels->{{None, 
    Cell["(56)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"c1957fd4-21f8-41f9-b84a-d0daa02a78aa"],

Cell[TextData[{
 StyleBox["Verification of (52)\[Dash](56) by integrating the kinetic stress \
over the lateral surface.",
  FontWeight->"Bold"],
 " We use an axis ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["a", "^"], " ", "=", " ", "(", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Theta]", ",", " ", "0", ",", " ", "-", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "d4ff7f01-28a9-4e22-b078-95ac360f0b3e"],
 " (tilted by ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "571d30e0-dcbe-4605-976f-9d1647fe673b"],
 " below the ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "7be62938-7fa7-47b2-8696-f777e4b614c1"],
 "-axis; the opposite tilt sense flips the sign of the two cross terms), \
cylinder velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "-", "v", ",", " ", "0", ",", " ", "0", ")"}], 
   TraditionalForm]],ExpressionUUID->"41351917-c3c4-420d-9de1-fa321c2a3fbb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], " ", "=", " ", "\[Kappa]", " ", "T", "'", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "a17f7c8e-862c-4c5f-a73a-7767ccfc2ba0"],
 ". The end caps are neglected (",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", " ", "\[GreaterGreater]", " ", "r"}], TraditionalForm]],
  ExpressionUUID->"62bd4dcd-f691-45c3-b4b7-fdaa85720dfb"],
 "), as in the notes. The kinetic heat flux is written through ",
 Cell[BoxData[
  FormBox["\[Nu]", TraditionalForm]],ExpressionUUID->
  "bf693add-3f02-4e4b-ae87-a3ec932d2943"],
 " (from the identification above) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "'", "/", "T"}], TraditionalForm]],ExpressionUUID->
  "55a774ff-58e6-48ee-917d-e0041c345160"],
 ". The results fix the prefactor and the angle convention."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"8ffcb6d7-2d5f-4b0e-807c-e136cee7d392"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"axC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "thC", "]"}], ",", "0", ",", 
     RowBox[{"-", 
      RowBox[{"Sin", "[", "thC", "]"}]}]}], "}"}]}], ";", 
  RowBox[{"e1C", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "thC", "]"}], ",", "0", ",", 
     RowBox[{"Cos", "[", "thC", "]"}]}], "}"}]}], ";", 
  RowBox[{"e2C", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nC", "[", "ph_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "ph", "]"}], "e1C"}], "+", 
    RowBox[{
     RowBox[{"Sin", "[", "ph", "]"}], "e2C"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qOfTau", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"kap", "Tk", "tau"}], "/.", 
      RowBox[{"First", "@", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nuSym", "/.", "nuSol"}], ")"}], "==", "nuG"}], ",", 
         "kap"}], "]"}]}]}], ",", "kinAssume"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fcyl", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"stressKin", "[", 
         RowBox[{
          RowBox[{"nC", "[", "ph", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "vC"}], ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "qOfTau"}], "}"}]}], "]"}], "rC", 
        "LC"}], ",", 
       RowBox[{"{", 
        RowBox[{"ph", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", "kinAssume"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fPDF", "=", 
   RowBox[{"mm", "nn", "Pi", "rC", 
    RowBox[{"LC", "/", 
     RowBox[{"Sqrt", "[", "hh", "]"}]}]}]}], ";", 
  RowBox[{"fKin", "=", 
   RowBox[{"mm", "nn", 
    RowBox[{"Sqrt", "[", "Pi", "]"}], "rC", 
    RowBox[{"LC", "/", 
     RowBox[{"Sqrt", "[", "hh", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Acoef", "=", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"aa", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Pi", "-", "2"}], ")"}], "/", "8"}]}]}], ")"}]}]}], ";", 
  RowBox[{"Bcoef", "=", 
   RowBox[{"3", 
    RowBox[{"nuG", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"aa", "/", "4"}]}], ")"}]}]}], ";", 
  RowBox[{"Ccoef", "=", "aa"}], ";", 
  RowBox[{"Dcoef", "=", 
   RowBox[{"3", "nuG", 
    RowBox[{"aa", "/", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F52", "[", "f_", "]"}], ":=", 
   RowBox[{"f", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Acoef", 
          RowBox[{
           RowBox[{"Sin", "[", "thC", "]"}], "^", "2"}]}], "+", 
         RowBox[{"Ccoef", 
          RowBox[{
           RowBox[{"Cos", "[", "thC", "]"}], "^", "2"}]}]}], ")"}], "vC"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Bcoef", "-", "Dcoef"}], ")"}], 
       RowBox[{"Sin", "[", "thC", "]"}], 
       RowBox[{"Cos", "[", "thC", "]"}], "tau"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F53", "[", "f_", "]"}], ":=", 
   RowBox[{"f", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Acoef", "-", "Ccoef"}], ")"}], 
       RowBox[{"Sin", "[", "thC", "]"}], 
       RowBox[{"Cos", "[", "thC", "]"}], "vC"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Bcoef", 
          RowBox[{
           RowBox[{"Cos", "[", "thC", "]"}], "^", "2"}]}], "+", 
         RowBox[{"Dcoef", 
          RowBox[{
           RowBox[{"Sin", "[", "thC", "]"}], "^", "2"}]}]}], ")"}], "tau"}]}],
      ")"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<kinetic lateral-surface force:  F_X = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Fcyl", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", "fKin"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"vC", ",", "tau"}], "}"}], ",", "Simplify"}], "]"}], "]"}],
        ",", "\"\< f,   F_Z = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Fcyl", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "/", "fKin"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"vC", ",", "tau"}], "}"}], ",", "Simplify"}], "]"}], "]"}],
        ",", "\"\< f\>\""}], "}"}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (52)-(53)\>\"", 
      ",", "\"\<angular structure and coefficients A, B, C, D (with f = mN \
Sqrt[pi] r L/Sqrt[h])\>\"", ",", 
      RowBox[{
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"Fcyl", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", 
         RowBox[{"F52", "[", "fKin", "]"}]}], "]"}], "&&", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"Fcyl", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "-", 
         RowBox[{"F53", "[", "fKin", "]"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (52)-(53)\>\"", 
      ",", "\"\<prefactor f = m N pi r L / Sqrt[h]\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"Fcyl", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"F52", "[", "fPDF", "]"}]}], "]"}], 
      ",", "\"\<The kinetic prefactor is f = m N Sqrt[pi] r L/Sqrt[h] = alpha \
pi r L; the printed f is too large by Sqrt[pi].\>\""}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eqs. (52)-(53)\>\"", ",", "\"\<sense of the tilt angle\>\"",
       ",", "\"\<The printed cross terms (A - C) and (B - D) correspond to \
the axis tilted below the X-axis, a = (cos theta, 0, -sin theta). For a = \
(cos theta, 0, +sin theta) both cross terms change sign; the notes should \
state which sense is meant.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (54)\>\"", 
      ",", "\"\<theta = 0 corresponds to the cylinder axis along Z\>\"", ",", 
      
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"axC", "/.", 
          RowBox[{"thC", "->", "0"}]}], ")"}], "-", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], 
      ",", "\"\<With the angle measured from the X-axis, as stated before \
(52), theta = 0 puts the axis along X, perpendicular to the gradient. (54), F \
= f B T'/T, is therefore the force on a horizontal cylinder. A vertical \
cylinder (theta = pi/2) feels F = f D T'/T = f (3 nu a/4) T'/T.\>\""}], "]"}],
     ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (54)\>\"", 
      ",", "\"\<levitation force of a horizontal cylinder is f B T'/T along \
+Z\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Fcyl", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"thC", "->", "0"}], ",", 
            RowBox[{"vC", "->", "0"}]}], "}"}]}], ")"}], "-", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"fKin", "Bcoef", "tau"}]}], "}"}]}], "]"}]}], "]"}]}], 
   "}"}], "]"}]}], "Input",ExpressionUUID->"340ccd8b-f58a-4665-a81a-\
51279485c5df"],

Cell[BoxData[
 TemplateBox[{"\"kinetic lateral-surface force:  F_X = \"", 
   TagBox[
    FormBox[
     RowBox[{
       RowBox[{"vC", " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{
               FractionBox["1", "4"], " ", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[Pi]", "-", 
                    RowBox[{"6"}]}], ")"}], " ", "aa"}], "+", "8"}], ")"}], 
               " ", 
               RowBox[{
                 SuperscriptBox["sin", "2"], "(", "thC", ")"}]}], "+", "aa"}],
            ")"}]}], "-", 
       RowBox[{
         FractionBox["3", "8"], " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"3", " ", "aa"}], "-", "4"}], ")"}], " ", "nuG", " ", 
         "tau", " ", 
         RowBox[{"sin", "(", "thC", ")"}], " ", 
         RowBox[{"cos", "(", "thC", ")"}]}]}], TraditionalForm], 
    TraditionalForm, Editable -> True], "\" f,   F_Z = \"", 
   TagBox[
    FormBox[
     RowBox[{
       RowBox[{
         FractionBox["3", "8"], " ", "nuG", " ", "tau", " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{
               RowBox[{"(", 
                 RowBox[{"4", "-", 
                   RowBox[{"3", " ", "aa"}]}], ")"}], " ", 
               RowBox[{
                 SuperscriptBox["cos", "2"], "(", "thC", ")"}]}], "+", 
             RowBox[{"2", " ", "aa"}]}], ")"}]}], "+", 
       RowBox[{
         FractionBox["1", "8"], " ", 
         RowBox[{"(", 
           RowBox[{
             RowBox[{
               RowBox[{"(", 
                 RowBox[{"\[Pi]", "-", 
                   RowBox[{"6"}]}], ")"}], " ", "aa"}], "+", "8"}], ")"}], 
         " ", "vC", " ", 
         RowBox[{"sin", "(", 
           RowBox[{"2", " ", "thC"}], ")"}]}]}], TraditionalForm], 
    TraditionalForm, Editable -> True], "\" f\""},
  "RowDefault"]], "Output",ExpressionUUID->"1837a1f3-e197-4c3a-bd53-\
242f7bd2d56b"]
}, Open  ]],

