   None, None}},ExpressionUUID->"e0715f6f-49e4-4608-b322-72cf5cd2d0e2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "81d413af-09e5-4a2b-abcf-c06c20048608"],
 " is in general a full ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "3e8e0d09-5e9d-47d0-a0ba-f2f1c8789241"],
 " matrix (9 DOF) with no symmetry required. For bodies with three mutually \
perpendicular mirror planes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"b18d7095-365f-4359-96d1-787b1c893d89"],
 "."
}], "Text",ExpressionUUID->"eded4c9b-604f-4e9c-a0dc-d28394a8ec19"],

Cell[TextData[{
 StyleBox["Rotational drag tensor ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "14075e63-ca0b-4af7-b1a6-dec8e24ee0bc"],
 StyleBox[" (symmetric, 6 DOF).",
  FontWeight->"Bold"],
 " The tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9a09f6b1-a219-49cf-b23e-183849f0d994"],
 " relates angular velocity to the resistive torque in the body frame:"
}], "Text",ExpressionUUID->"374b97ee-3524-4c73-b3a0-82e5f339dc77"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["\[Tau]",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "b"], " ", "=", " ", "-", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SuperscriptBox[
