dimensionally consistent",
 "\n",
 StyleBox["LHS has units kg/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]],ExpressionUUID->
  "da023c6d-24e3-4347-9d44-17800499edf1"],
 StyleBox[", RHS kg/(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]],ExpressionUUID->
  "4c17ec20-d37b-4185-83b9-e089138fa7ec"],
 StyleBox[" K): a factor T is missing on the right.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
