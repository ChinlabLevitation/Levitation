  FormBox[
   RowBox[{"6", "\[Times]", "6"}], TraditionalForm]],ExpressionUUID->
  "d58b3c67-69e6-401d-83db-d61de819efb4"],
 " linear response:"
}], "Text",ExpressionUUID->"c75ee0f4-7b10-4dca-84be-1808c81b3293"],

