Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (46)",
  FontWeight->"Bold"],
 ":   ",
 "the two expressions in (46) agree to first order",
 "\n",
 StyleBox["Expanding the first form gives 1 - \[CurlyEpsilon] (dA)_33/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "98438a3a-6394-4dd9-a4ca-329215501556"],
 StyleBox[", not 1 - \[CurlyEpsilon] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d51fb40e-f820-481c-8f4a-16c14443d6ed"],
 StyleBox[" (dA)_33.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"6fea0afb-58a8-411e-a656-822223be6b5b"],

Cell[TextData[{
 StyleBox["First-order body-frame velocity.",
  FontWeight->"Bold"],
 " With the levitation gradient (46) substituted back into Eq. (43), the \
body-frame velocity becomes, to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"71cb6f7a-916a-4219-af88-c7d2e6a71b27"],
 ":"
}], "Text",ExpressionUUID->"4c281439-d981-4641-be99-561fec615dd0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "b"], " ", "=", " ", "\[CurlyEpsilon]", " ", 
   SubscriptBox["G", "0"], "\[ThinSpace]", "\[Delta]", 
   StyleBox["A",
    FontWeight->"Bold"], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "-", " ", "\[CurlyEpsilon]", " ", 
   SubscriptBox["G", "0"], 
   SubscriptBox["A", "0"], 
   SubscriptBox[
    RowBox[{"(", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], ")"}], "33"], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "+", " ", "O", "(", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], ")", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(47)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"bc178388-dde1-4f40-aaa2-5b40d047dd8c"],

Cell[TextData[{
 "The two terms together ensure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"29a76752-74a3-460e-a258-f3f6a3e38121"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"e772335e-7448-4742-b10d-528701bd938a"],
 ": the body-frame velocity has ",
 StyleBox["no projection along",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "3afdb941-2577-4ac2-bb00-101936f03e9b"],
 ", so there is no residual vertical drift. The lab-frame velocity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "R", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "c2d80c46-0c77-4074-a1c7-bbc6176e7721"],
 " and lies entirely in the plane perpendicular to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Z", "^"], TraditionalForm]],ExpressionUUID->
  "e0b518b5-6981-45c9-a6b6-61092b9909c4"],
 "."
}], "Text",ExpressionUUID->"99611f0d-ae82-4b64-8cb3-ae0b8b282696"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vbAtLev", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"vb42", "/.", 
         RowBox[{"Thread", "[", 
          RowBox[{"uvec", "->", "uE3"}], "]"}]}], ")"}], "/.", 
       RowBox[{"G", "->", "Gexact"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dAmat", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"dfth", "-", 
      RowBox[{
       RowBox[{"gam0", "/", "xi0"}], "dfdr"}]}], ")"}], "/", "xi0"}]}], ";", 
  RowBox[{"G0", "=", 
   RowBox[{"Mm", 
    RowBox[{"gg", "/", "gam0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vb47", "=", 
   RowBox[{
    RowBox[{"eps", "G0", 
     RowBox[{"dAmat", ".", "uE3"}]}], "-", 
    RowBox[{"eps", "G0", 
     RowBox[{"gam0", "/", "xi0"}], 
     RowBox[{"dAmat", "[", 
      RowBox[{"[", 
       RowBox[{"3", ",", "3"}], "]"}], "]"}], "uE3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vbCorrect", "=", 
   RowBox[{"eps", 
    RowBox[{"G0", "/", "xi0"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"dfth", ".", "uE3"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"uE3", ".", "dfth", ".", "uE3"}], ")"}], "uE3"}]}], ")"}]}]}],
   ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (47)\>\"", 
      ",", "\"\<first-order body-frame velocity at levitation\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"vbAtLev", "-", "vb47"}], "]"}], 
      ",", "\"\<Exact: v^b = (eps G_0/xi_0) Pi_u df_th u, the component of \
df_th u perpendicular to u. Drag anisotropy does not enter.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (47)\>\"", 
      ",", "\"\<the two terms of (47) give u . v^b = 0\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"uE3", ".", "vb47"}], "]"}], ",", 
      RowBox[{"\"\<u . v^b = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"TraditionalForm", "[", 
         RowBox[{"Simplify", "[", 
          RowBox[{"uE3", ".", "vb47"}], "]"}], "]"}], "]"}], 
       "<>", "\"\<, which vanishes only if A_0 = 1.\>\""}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (47), corrected\>\"", 
      ",", "\"\<v^b = (eps G_0/xi_0)(df_th u - (u.df_th u) u) is the exact \
first-order result and is horizontal\>\"", ",", 
      RowBox[{
       RowBox[{"zeroQ", "[", 
        RowBox[{"vbAtLev", "-", "vbCorrect"}], "]"}], "&&", 
       RowBox[{"zeroQ", "[", 
        RowBox[{"uE3", ".", "vbCorrect"}], "]"}]}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"325d6acb-1510-4029-8670-9f1d87853b6b"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (47)",
  FontWeight->"Bold"],
 ":   ",
 "first-order body-frame velocity at levitation",
 "\n",
 StyleBox["Exact: ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "b"], TraditionalForm]],ExpressionUUID->
  "c0f0065a-578d-4c9c-8517-86c3eaab2513"],
 StyleBox[" = (\[CurlyEpsilon] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "333eface-1aa1-41e5-95fc-37a70ceb58f0"],
 StyleBox["/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7beae4fa-a41c-4fe1-bece-fbaaf088587e"],
 StyleBox[") ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPi]", 
    StyleBox["u",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "46e8fd30-26fd-43cb-99b5-9b678dc16c75"],
 StyleBox[" ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "822a14f8-09e9-442a-8cc5-515f915f5d36"],
 StyleBox[" u, the component of ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "148a15d6-42e0-4fed-89f7-24aff76f4c14"],
 StyleBox[" u perpendicular to u. Drag anisotropy does not enter.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"c07ce9d3-f975-467a-949b-7b00f4aa420f"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (47)",
  FontWeight->"Bold"],
 ":   ",
 "the two terms of (47) give u . ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "b"], TraditionalForm]],ExpressionUUID->
  "b94e3bff-495d-4c6f-9377-b0fd54a3b88b"],
 " = 0",
 "\n",
 StyleBox["u . ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "b"], TraditionalForm]],ExpressionUUID->
  "13d83ec2-40e1-4999-ad3e-0bc7cc3c39bc"],
 StyleBox[" = \!\(\*FormBox[FractionBox[RowBox[{\"\[CurlyEpsilon]\", \" \", \
\"gg\", \" \", \"Mm\", \" \", RowBox[{\"(\", RowBox[{\"gam0\", \"-\", \
\"\[Xi]0\"}], \")\"}], \" \", RowBox[{\"(\", RowBox[{RowBox[{\"gam0\", \" \", \
RowBox[{\"dd\", \"(\", RowBox[{\"3\", \",\", \"3\"}], \")\"}]}], \"-\", \
RowBox[{\"\[Xi]0\", \" \", RowBox[{\"df\", \"(\", RowBox[{\"3\", \",\", \
\"3\"}], \")\"}]}]}], \")\"}]}], RowBox[{\"gam0\", \" \", SuperscriptBox[\"\
\[Xi]0\", \"3\"]}]], TraditionalForm]\), which vanishes only if ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b2d7a60a-c219-4af8-bf73-cd74b6ff290d"],
 StyleBox[" = 1.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"e6ea82d7-df24-4408-b788-f54e6298faa9"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (47), corrected",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "b"], TraditionalForm]],ExpressionUUID->
  "ccc4e8b6-d958-4495-97d7-01e20ff78b0e"],
 " = (\[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "01f8e14b-e192-48a1-b02a-fad8edfc712f"],
 "/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "dfc09788-4709-4e0e-9f95-89321504cbe7"],
 ")(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8ed79af8-e51f-4065-ab22-bb5d77893f89"],
 " u - (u.",
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4e0e2080-118a-425a-927a-d1b09a559124"],
 " u) u) is the exact first-order result and is horizontal"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"92707a57-e3c1-47f8-8a86-ce07a9c17801"],

Cell[TextData[{
 StyleBox["General steady solutions.",
  FontWeight->"Bold"],
 " We now enumerate the possible steady motions depending on the orientation \
state."
}], "Text",ExpressionUUID->"ee907790-680d-4125-9bcb-3253551cfaa4"],

Cell[TextData[{
 StyleBox["Case 1: Symmetric body ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"8d2401cd-4423-42e8-9244-9c28afe9fee2"],
 ").* Then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"6157cdb9-ba59-4690-8865-4031eb09813a"],
 ", ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "b2eb89b8-468d-4d37-b207-91fb1de42115"],
 " is constant, and Eq. (47) gives a constant body-frame velocity. The \
lab-frame velocity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", "\[CurlyEpsilon]", " ", "G", "\[ThinSpace]",
     "R", "\[ThinSpace]", "\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"], "\[ThinSpace]", 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "77db4559-1ebf-47d5-9e23-822ff0e0b272"],
 " is also constant. This is straight-line drift in a fixed direction. At \
levitation, the drift is purely horizontal."
}], "Text",ExpressionUUID->"a174bff4-5ea9-4b1b-841b-137032fdf395"],

Cell[TextData[{
 StyleBox["Case 2: Asymmetric body, transient phase.",
  FontSlant->"Italic"],
 " Before the orientation has converged to a fixed point, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "37fae764-166f-4fba-9a39-f022d6ddd9da"],
 " evolves on the alignment timescale ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tilde]", " ", 
    SubscriptBox["I", "0"], "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "20a6734c-35c2-4d99-bd0e-824452997ab3"],
 ". The CoM trajectory is non-periodic and traces a curved path depending on \
the initial orientation."
}], "Text",ExpressionUUID->"63cdc9fe-a6cf-42db-ba49-80fade3dcd0f"],

Cell[TextData[{
 StyleBox["Case 3: Asymmetric body, steady precession (attractor).",
  FontSlant->"Italic"],
 " At the fixed point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "673557e9-48f1-40bf-8648-352c1c8c03b9"],
 " the lab-frame angular velocity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "3"], " ", "=", " ", "(", "G", "\[CurlyEpsilon]", 
    SubscriptBox["\[Lambda]", "3"], "/", 
    SubscriptBox["c", "0"], ")", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "60fb79f6-2ed2-4af6-97d1-e41de1a48140"],
 " (Eq. (40)), parallel to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Z", "^"], TraditionalForm]],ExpressionUUID->
  "b89dd710-32d0-49d0-ad79-e48884b1a435"],
 ". The body therefore precesses about ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Z", "^"], TraditionalForm]],ExpressionUUID->
  "94b19cff-899a-42a6-adb3-c7ae0bb691e5"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "t", ")", " ", "=", " ", 
    SubscriptBox["R", "Z"], "(", 
    SubscriptBox["\[CapitalOmega]", "3"], "t", ")", 
    SubscriptBox["R", "0"]}], TraditionalForm]],ExpressionUUID->
  "162fe004-1632-4fc0-8691-256d9b81a1a5"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "0"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], " ", "=", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "cc1312e1-4654-4151-9852-225900b69a7b"],
 ". With the levitation gradient (46) imposed, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "b"], TraditionalForm]],ExpressionUUID->
  "c2c4af9e-f7d8-426a-8e17-19f6030ad9c6"],
 " has no projection along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "b2cfee1a-8e3d-4fcb-a04e-ae9c6461153b"],
 ", so the lab-frame velocity is entirely horizontal:"
}], "Text",ExpressionUUID->"c8c31e3f-f2e5-42c2-9430-4fd1552b3826"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["v",
    FontWeight->"Bold"], "(", "t", ")", " ", "=", " ", "\[CurlyEpsilon]", " ", 
   SubscriptBox["G", "0"], "\[ThinSpace]", 
   SubscriptBox["R", "Z"], "(", 
   SubscriptBox["\[CapitalOmega]", "3"], "t", ")", "\[ThinSpace]", 
   SubscriptBox["\[CapitalPi]", "\[UpTee]"], "\[Delta]", 
   StyleBox["A",
    FontWeight->"Bold"], "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox["\[CapitalPi]", "\[UpTee]"], " ", "=", " ", 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "-", " ", 
   OverscriptBox["Z", "^"], 
   SuperscriptBox[
    OverscriptBox["Z", "^"], "\[Transpose]"], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(48)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"3481f5ea-401c-417a-af66-1c3695b7c95e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "Z"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"32ef908d-121c-4fce-bd5e-987adc4a7d1b"],
 " by construction and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"481420a3-eb7d-4d5c-9a5a-79526cb942fa"],
 " having constant magnitude. Since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "\[UpTee]"], TraditionalForm]],ExpressionUUID->
  "4cd24992-bf49-4481-988d-c4a0178bcbba"],
 " lies in the horizontal plane and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "3"], " ", "\[DoubleVerticalBar]", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "8a09d418-a0eb-4d0e-a2cf-dfaeb828bee0"],
 ", we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "\[UpTee]", 
    SubscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "341eede5-0937-43da-ab0b-98643efb7983"],
 ". The two conditions for circular motion are therefore: (1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "3"], " ", "\[DoubleVerticalBar]", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "2dab535a-593c-4571-ae9b-881c5340c016"],
 " \[LongDash] from the fixed-point geometry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], " ", "=", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "20e93892-ab9d-4907-bf1f-0e16846f9b3a"],
 "; (2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "\[UpTee]", 
    SubscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "15533f8f-9886-4fb8-b374-525e05413a51"],
 " \[LongDash] automatically, since ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "\[UpTee]"], TraditionalForm]],ExpressionUUID->
  "8e85dd3d-555a-49c9-9692-71102bd98958"],
 " lies in the horizontal plane. This is circular orbit motion."
}], "Text",ExpressionUUID->"50f35cb8-ac37-40a7-83dd-5d3cd9db3fbf"],

Cell[TextData[{
 StyleBox["Circular orbit radius.",
  FontWeight->"Bold"],
 " For the levitated case (gradient ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "2045c2f9-8fb9-4d10-a147-11f0a4d4d6ce"],
 " given by Eq. (46)), both the orbital speed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "|", " ", "=", " ", "\[CurlyEpsilon]",
     " ", 
    SubscriptBox["G", "0"], "|", 
    SubscriptBox["\[CapitalPi]", "\[UpTee]"], 
    SubscriptBox["R", "0"], "\[ThinSpace]", "\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], "|"}], TraditionalForm]],ExpressionUUID->
  "d391d49e-3ada-4718-b651-6697ceb816e9"],
 " and the spin rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["\[CapitalOmega]", "3"], "|", " ", "=", " ", 
    SubscriptBox["G", "0"], "\[CurlyEpsilon]", "|", 
    SubscriptBox["\[Lambda]", "3"], "|", "/", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "7d76340d-430a-45e9-bbea-f633bd5d3c54"],
 " are linear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "7828bef0-561c-40e7-af22-dce3f7a75b69"],
 ", so their ratio is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "a8366e58-089c-4bdb-8dd7-4c070fdbfd41"],
 ":"
}], "Text",ExpressionUUID->"af6ef640-7544-486d-b052-317ced24d6bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[CapitalOmega]", "3"], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["G", "0"], "\[CurlyEpsilon]", 
     SubscriptBox["\[Lambda]", "3"]}], 
    SubscriptBox["c", "0"]], " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], " ", "=", " ", 
   FractionBox[
    RowBox[{"|", 
     SubscriptBox[
      StyleBox["v",
       FontWeight->"Bold"], "\[UpTee]"], "|"}], 
    RowBox[{"|", 
     SubscriptBox["\[CapitalOmega]", "3"], "|"}]], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["c", "0"], "|", 
     SubscriptBox["\[CapitalPi]", "\[UpTee]"], 
     SubscriptBox["R", "0"], "\[ThinSpace]", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], "\[ThinSpace]", 
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold"], "3"], "|"}], 
    RowBox[{"|", 
     SubscriptBox["\[Lambda]", "3"], "|"}]], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(49)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"6fd71a2a-8fd4-4b71-9657-0f16c4126cd0"],

Cell[TextData[{
 "Key features: (1) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "22a0f118-e296-4453-8a63-59a041a8ec0d"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]],ExpressionUUID->
  "5c50565e-479f-4521-bee7-11e6ee9b6b90"],
 ": it is independent of both ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "ad348de0-0b14-4117-bddc-ff6054092155"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "0"], TraditionalForm]],ExpressionUUID->
  "c95ec9e2-55a3-41a7-ac2f-0419be63edee"],
 ", since the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "37c6e4d1-ac28-4ecd-92b3-fe17e9f49775"],
 " factors cancel in the ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "|", "/", "|", 
    SubscriptBox["\[CapitalOmega]", "3"], "|"}], TraditionalForm]],
  ExpressionUUID->"c5fb39ca-41ec-40ee-8754-5aa520295078"],
 ". ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["orbit",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d3a18064-1df1-4413-8321-9f30483df50e"],
 " depends only on the particle shape through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "a3438f3a-da85-44fe-9be4-684d81e52871"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "3"], TraditionalForm]],ExpressionUUID->
  "8314f9fe-ea97-4722-a0a0-696f48c7269a"],
 ". (2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "3"], " ", "\[Proportional]", " ", 
    "\[CurlyEpsilon]", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "bd1a6104-8b5b-40e8-bf48-72d3182b44ca"],
 ": a more asymmetric body or a stronger gradient spins faster, and the \
orbital speed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[UpTee]"], "|", " ", "\[Proportional]", " ", 
    "\[CurlyEpsilon]", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "91fdd8b6-d6b4-4426-8e5f-4678ef2fb4da"],
 " grows at the same rate, keeping the radius fixed. (3) If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPi]", "\[UpTee]"], 
    SubscriptBox["R", "0"], "\[ThinSpace]", "\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"], "\[ThinSpace]", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"60fea4a9-8b6b-47ae-ada0-ae7b176188e9"],
 " (the anisotropic drift of eigenmotion 3 is purely along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Z", "^"], TraditionalForm]],ExpressionUUID->
  "06b348dc-42c1-497c-8cb7-20b0fbd3f5b0"],
 "), then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     StyleBox["orbit",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"8ed84b87-e7b1-4c87-8eef-03ecf61426e8"],
 ": the particle hovers at a fixed point with no horizontal motion. This \
occurs when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "ef350c7c-3e50-4a67-879b-344dbadba2ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "e31ff988-d592-4748-8999-b4aca922df87"],
 " are simultaneously diagonal in the same basis as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "0c47e3cb-e77b-4c05-b56d-fafbd16d66c5"],
 "; in this case the levitation correction in Eq. (46) accounts for all \
anisotropy and no horizontal orbit appears. (4) No orbit for a symmetric \
body: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"16fe3fe7-d5b2-451d-869e-ea1529a6ae35"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "3"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"28ecbc2c-5b33-4f45-a6e4-e279614d24b9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "3"], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"3e1253ff-2395-4eb2-b538-a2324f6da62d"],
 ", and the particle drifts in a fixed direction (or hovers if the drift is \
vertical)."
}], "Text",ExpressionUUID->"22fee627-6f9a-48d3-81a7-079e97d615d1"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"Condition", 
    FormBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"],
     TraditionalForm], "Trajectory"},
   {
    RowBox[{
     FormBox[
      RowBox[{"\[Delta]", 
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], " ", "=", " ", "0"}],
      TraditionalForm], 
     RowBox[{" ", 
      RowBox[{"(", "symmetric", ")"}]}]}], "0", 
    RowBox[{"straight", "-", 
     RowBox[{"line", " ", "drift", " ", 
      RowBox[{"(", 
       RowBox[{"or", " ", "hover"}], ")"}]}]}]},
   {
    RowBox[{
     FormBox[
      RowBox[{"\[Delta]", 
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], " ", "\[NotEqual]", " ", "0"}],
      TraditionalForm], 
     RowBox[{",", " ", "transient"}]}], 
    RowBox[{"time", "-", "varying"}], 
    RowBox[{"curved", ",", " ", 
     RowBox[{"non", "-", "periodic"}]}]},
   {
    RowBox[{
     FormBox[
      RowBox[{"\[Delta]", 
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["th",
         FontSlant->"Plain"]], " ", "\[NotEqual]", " ", "0"}],
      TraditionalForm], 
     RowBox[{",", " ", 
      RowBox[{"eigenmotion", " ", "3"}]}]}], 
    FormBox[
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "3"], 
      OverscriptBox["Z", "^"]}],
     TraditionalForm], 
    RowBox[{"horizontal", " ", "circle", " ", 
     RowBox[{"(", 
      RowBox[{"or", " ", "hover"}], ")"}]}]},
   {
    RowBox[{"Eigenmotion", " ", "1", " ", "or", " ", "2"}], 
    FormBox[
     RowBox[{
      SubscriptBox["\[CapitalOmega]", 
       RowBox[{"1", ",", "2"}]], 
      OverscriptBox["Z", "^"]}],
     TraditionalForm], 
    RowBox[{"circle", " ", 
     RowBox[{"(", "unstable", ")"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxBackground->{"Rows" -> {
      RGBColor[0.9, 0.93, 0.97], None}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}]],
 FontFamily->
  "Source Sans Pro",ExpressionUUID->"238a45c1-84bf-4826-bb44-2bd8aa14ea9a"]], \
"Text",ExpressionUUID->"0440eb96-ca2e-4e31-ab5b-7e9c487f2cdd"],

Cell[TextData[{
 StyleBox["Verification of the orbit (48)\[Dash](49) by direct simulation.",
  FontWeight->"Bold"],
 " We integrate the full equations of motion (23)\[Dash](26) with the \
function of Section 1.6. The body is a near-sphere with random traceless ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "e1bcd9ee-2992-402b-bbfa-e9263875109a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "718dd40e-5170-4d32-be7b-31fccb814431"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "acbe8bdc-a91a-4690-9f34-17919c8d9dde"],
 " and a positive-definite ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "7a65ed85-2023-455c-80fe-5e38f93f98fe"],
 ", so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "94df96bb-ec04-45b7-beef-d7cb11e8f5ea"],
 " is the attractor. The gradient is set to the exact levitation value, and \
the simulation starts on the steady state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "0793956c-f46c-4ce3-a5f6-011f767348e1"],
 ". The measured radius is compared with three predictions: (49) as printed, \
(49) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"], "\[RightArrow]", "\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], "/", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "395e8902-8182-4bc4-978d-4db99eede060"],
 " as the corrected (47) requires, and the exact quasi-steady value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox["\[CapitalPi]", "\[UpTee]"], 
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], "(", "G", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "-", " ", "M", "g", ")", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], "|", "/", 
    SubscriptBox["\[CapitalOmega]", "3"]}], TraditionalForm]],ExpressionUUID->
  "4b23969b-3661-415a-ab1d-cff2dfaf7010"],
 " including the centripetal correction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox[
     RowBox[{"1", " ", "+", " ", 
      SuperscriptBox[
       RowBox[{"(", "M", 
        SubscriptBox["\[CapitalOmega]", "3"], "/", 
        SubscriptBox["\[Xi]", "0"], ")"}], "2"]}]]}], TraditionalForm]],
  ExpressionUUID->"21a1c1b1-3986-43cb-89bc-6c5ed6267db0"],
 " that (42) neglects."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"7a8bf94f-bbc1-43ac-88c7-120be64032fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"orbitTest", "[", 
    RowBox[{"epsv_", ",", "seed_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "symTL", ",", "dfthN", ",", "dfdrN", ",", "dTdrN", ",", "Qm", ",", 
       "dTthN", ",", "pars", ",", "lam", ",", "vec", ",", "e3v", ",", "lam3", 
       ",", "Glev", ",", "dAN", ",", "proj", ",", "Rpdf", ",", "Rcorr", ",", 
       "Om3", ",", "vbss", ",", "Rexact", ",", "q0v", ",", "s0", ",", "sol", ",",
        "xs2", ",", "ctr", ",", "rad", ",", 
       RowBox[{"gam0v", "=", "1."}], ",", 
       RowBox[{"xi0v", "=", "1."}], ",", 
       RowBox[{"c0v", "=", "1."}], ",", 
       RowBox[{"I0v", "=", "0.5"}], ",", 
       RowBox[{"Mv", "=", "1."}], ",", 
       RowBox[{"gv", "=", "1."}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
      RowBox[{
       RowBox[{"symTL", "[", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"m", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"m", "+", 
              RowBox[{"Transpose", "[", "m", "]"}]}], ")"}], "/", "2"}]}], ";", 
          RowBox[{"m", "-", 
           RowBox[{
            RowBox[{
             RowBox[{"Tr", "[", "m", "]"}], "/", "3"}], 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]}]}], "]"}]}], ";", 
      RowBox[{"dfthN", "=", 
       RowBox[{"symTL", "[", "]"}]}], ";", 
      RowBox[{"dfdrN", "=", 
       RowBox[{"symTL", "[", "]"}]}], ";", 
      RowBox[{"dTdrN", "=", 
       RowBox[{"symTL", "[", "]"}]}], ";", 
      RowBox[{"Qm", "=", 
       RowBox[{"Orthogonalize", "[", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Det", "[", "Qm", "]"}], "<", "0"}], ",", 
        RowBox[{
         RowBox[{"Qm", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "=", 
         RowBox[{"-", 
          RowBox[{"Qm", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}], ";", 
      RowBox[{"dTthN", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "Qm", "]"}], ".", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "1.", ",", "2."}], "}"}], "]"}], ".", "Qm"}]}], 
      ";", 
      RowBox[{"pars", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<M\>\"", "->", "Mv"}], ",", 
         RowBox[{"\"\<g\>\"", "->", "gv"}], ",", 
         RowBox[{"\"\<I\>\"", "->", 
          RowBox[{"I0v", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ",", 
         RowBox[{"\"\<fth\>\"", "->", 
          RowBox[{
           RowBox[{"gam0v", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
           RowBox[{"epsv", "dfthN"}]}]}], ",", 
         RowBox[{"\"\<fdrag\>\"", "->", 
          RowBox[{
           RowBox[{"xi0v", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
           RowBox[{"epsv", "dfdrN"}]}]}], ",", 
         RowBox[{"\"\<Tth\>\"", "->", 
          RowBox[{"epsv", "dTthN"}]}], ",", 
         RowBox[{"\"\<Tdrag\>\"", "->", 
          RowBox[{
           RowBox[{"c0v", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
           RowBox[{"epsv", "dTdrN"}]}]}]}], "|>"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lam", ",", "vec"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", 
          RowBox[{"pars", "[", "\"\<Tdrag\>\"", "]"}], "]"}], ".", 
         RowBox[{"pars", "[", "\"\<Tth\>\"", "]"}]}], "]"}]}], ";", 
      RowBox[{"e3v", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{"vec", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"lam3", "=", 
       RowBox[{"First", "@", 
        RowBox[{"Eigenvalues", "[", "dTthN", "]"}]}]}], ";", 
      RowBox[{"Glev", "=", 
       RowBox[{"Mv", "gv", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"e3v", ".", 
           RowBox[{"Inverse", "[", 
            RowBox[{"pars", "[", "\"\<fdrag\>\"", "]"}], "]"}], ".", "e3v"}], 
          ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"e3v", ".", 
           RowBox[{"Inverse", "[", 
            RowBox[{"pars", "[", "\"\<fdrag\>\"", "]"}], "]"}], ".", 
           RowBox[{"pars", "[", "\"\<fth\>\"", "]"}], ".", "e3v"}], 
          ")"}]}]}]}], ";", 
      RowBox[{"dAN", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dfthN", "-", 
          RowBox[{
           RowBox[{"gam0v", "/", "xi0v"}], "dfdrN"}]}], ")"}], "/", 
        "xi0v"}]}], ";", 
      RowBox[{
       RowBox[{"proj", "[", 
        RowBox[{"v_", ",", "u_"}], "]"}], ":=", 
       RowBox[{"v", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"u", ".", "v"}], ")"}], "u"}]}]}], ";", 
      RowBox[{"Rpdf", "=", 
       RowBox[{"c0v", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"proj", "[", 
           RowBox[{
            RowBox[{"dAN", ".", "e3v"}], ",", "e3v"}], "]"}], "]"}], "/", 
         RowBox[{"Abs", "[", "lam3", "]"}]}]}]}], ";", 
      RowBox[{"Rcorr", "=", 
       RowBox[{"c0v", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"proj", "[", 
           RowBox[{
            RowBox[{"dfthN", ".", "e3v"}], ",", "e3v"}], "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"xi0v", 
           RowBox[{"Abs", "[", "lam3", "]"}]}], ")"}]}]}]}], ";", 
      RowBox[{"Om3", "=", 
       RowBox[{"Glev", 
        RowBox[{"lam", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
      RowBox[{"vbss", "=", 
       RowBox[{
        RowBox[{"Inverse", "[", 
         RowBox[{"pars", "[", "\"\<fdrag\>\"", "]"}], "]"}], ".", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Glev", 
           RowBox[{"pars", "[", "\"\<fth\>\"", "]"}]}], "-", 
          RowBox[{"Mv", "gv", 
           RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ")"}], ".", 
        "e3v"}]}], ";", 
      RowBox[{"Rexact", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"proj", "[", 
           RowBox[{"vbss", ",", "e3v"}], "]"}], "]"}], "/", 
         RowBox[{"Abs", "[", "Om3", "]"}]}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Mv", 
             RowBox[{"Om3", "/", "xi0v"}]}], ")"}], "^", "2"}]}], "]"}]}]}], ";", 
      RowBox[{"q0v", "=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ax", "=", 
            RowBox[{"Cross", "[", 
             RowBox[{"e3v", ",", "Zhat"}], "]"}]}], ",", 
           RowBox[{"ang", "=", 
            RowBox[{"ArcCos", "[", 
             RowBox[{"e3v", ".", "Zhat"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Cos", "[", 
             RowBox[{"ang", "/", "2"}], "]"}], "}"}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"ang", "/", "2"}], "]"}], 
            RowBox[{"Normalize", "[", "ax", "]"}]}]}], "]"}]}], "]"}]}], ";", 
      
      RowBox[{
       RowBox[{"pars", "[", "\"\<gradLnT\>\"", "]"}], "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "Glev"}]}], "}"}]}], ";", 
      RowBox[{"s0", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{
          RowBox[{"quatR", "[", "q0v", "]"}], ".", "vbss"}], ",", "q0v", ",", 
         
         RowBox[{"Om3", "e3v"}]}], "]"}]}], ";", 
      RowBox[{"sol", "=", 
       RowBox[{"integrateEOM", "[", 
        RowBox[{"pars", ",", "s0", ",", 
         RowBox[{"12", 
          RowBox[{"Pi", "/", 
           RowBox[{"Abs", "[", "Om3", "]"}]}]}]}], "]"}]}], ";", 
      RowBox[{"xs2", "=", 
       RowBox[{"Most", "@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sol", "[", "t", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "3"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"6", 
             RowBox[{"Pi", "/", 
              RowBox[{"Abs", "[", "Om3", "]"}]}]}], ",", 
            RowBox[{"12", 
             RowBox[{"Pi", "/", 
              RowBox[{"Abs", "[", "Om3", "]"}]}]}], ",", 
            RowBox[{"0.01", 
             RowBox[{"(", 
              RowBox[{"2", 
               RowBox[{"Pi", "/", 
                RowBox[{"Abs", "[", "Om3", "]"}]}]}], ")"}]}]}], "}"}]}], 
         "]"}]}]}], ";", 
      RowBox[{"ctr", "=", 
       RowBox[{"Mean", "[", 
        RowBox[{"xs2", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"rad", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"#", "-", "ctr"}], "]"}], "&"}], "/@", 
        RowBox[{"xs2", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "2"}]}], "]"}], "]"}]}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<eps\>\"", "->", "epsv"}], ",", 
        RowBox[{"\"\<Omega3\>\"", "->", "Om3"}], ",", 
        RowBox[{"\"\<R_sim\>\"", "->", 
         RowBox[{"Mean", "[", "rad", "]"}]}], ",", 
        RowBox[{"\"\<R_sim spread\>\"", "->", 
         RowBox[{
          RowBox[{"StandardDeviation", "[", "rad", "]"}], "/", 
          RowBox[{"Mean", "[", "rad", "]"}]}]}], ",", 
        RowBox[{"\"\<vZ_sim\>\"", "->", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"xs2", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "3"}], "]"}], "]"}], "-", 
            RowBox[{"xs2", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "3"}], "]"}], "]"}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"6", 
            RowBox[{"Pi", "/", 
             RowBox[{"Abs", "[", "Om3", "]"}]}]}], ")"}]}]}], ",", 
        RowBox[{"\"\<R_exact\>\"", "->", "Rexact"}], ",", 
        RowBox[{"\"\<R_corrected (49)\>\"", "->", "Rcorr"}], ",", 
        RowBox[{"\"\<R_PDF (49)\>\"", "->", "Rpdf"}], ",", 
        RowBox[{"\"\<traj\>\"", "->", "xs2"}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"orbitRuns", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"orbitTest", "[", 
      RowBox[{"e", ",", "7"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", 
       RowBox[{"{", 
        RowBox[{"0.04", ",", "0.02", ",", "0.01"}], "}"}]}], "}"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", "[", "\"\<eps\>\"", "]"}], ",", 
            RowBox[{"r", "[", "\"\<R_sim\>\"", "]"}], ",", 
            RowBox[{"r", "[", "\"\<R_exact\>\"", "]"}], ",", 
            RowBox[{"r", "[", "\"\<R_corrected (49)\>\"", "]"}], ",", 
            RowBox[{"r", "[", "\"\<R_PDF (49)\>\"", "]"}], ",", 
            RowBox[{"sci", "[", 
             RowBox[{"r", "[", "\"\<R_sim spread\>\"", "]"}], "]"}], ",", 
            RowBox[{"sci", "[", 
             RowBox[{"r", "[", "\"\<vZ_sim\>\"", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "orbitRuns"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<eps\>\"", ",", "\"\<R simulated\>\"", 
           ",", "\"\<R exact quasi-steady\>\"", 
           ",", "\"\<R corrected (49)\>\"", ",", "\"\<R as printed (49)\>\"", 
           ",", "\"\<radius spread\>\"", ",", "\"\<vertical drift\>\""}], 
          "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"orbitRuns", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", "\"\<traj\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], ",", 
      RowBox[{"AspectRatio", "->", "1"}], ",", 
      RowBox[{
      "PlotLabel", "->", "\"\<simulated orbit (eps = 0.02), top view\>\""}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\""}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "260"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (48)-(49)\>\"", 
      ",", "\"\<the steady precession is a horizontal circle with v_Z = 0\>\"",
       ",", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"orbitRuns", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", "\"\<R_sim spread\>\"", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", "\"\<vZ_sim\>\"", "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "4"}]}]}]}], "&"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (49), corrected\>\"", 
      ",", "\"\<R_orbit = c0 |Pi_perp df_th e3|/(xi0 |lambda3|) converges to \
the simulation as eps -> 0\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"errs", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<R_corrected (49)\>\"", "]"}], "/", 
               RowBox[{"#", "[", "\"\<R_sim\>\"", "]"}]}], "-", "1"}], "]"}], 
            "&"}], "/@", "orbitRuns"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"errs", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", 
          RowBox[{"errs", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{"errs", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0.05"}]}]}], "]"}], ",", 
      RowBox[{"\"\<relative errors for eps = 0.04, 0.02, 0.01: \>\"", "<>", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"sci", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<R_corrected (49)\>\"", "]"}], "/", 
               RowBox[{"#", "[", "\"\<R_sim\>\"", "]"}]}], "-", "1"}], "]"}], 
            "]"}], "&"}], "/@", "orbitRuns"}], ",", "\"\<, \>\""}], "]"}]}]}],
      "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (49)\>\"", 
      ",", "\"\<exact quasi-steady radius matches the simulation, with the \
residual shrinking like eps^2\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"errs", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<R_exact\>\"", "]"}], "/", 
               RowBox[{"#", "[", "\"\<R_sim\>\"", "]"}]}], "-", "1"}], "]"}], 
            "&"}], "/@", "orbitRuns"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"errs", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "2*^-4"}], "&&", 
         RowBox[{
          RowBox[{
           RowBox[{"errs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", 
           RowBox[{"errs", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ">", "8"}]}]}], "]"}], ",", 
      RowBox[{"\"\<relative errors for eps = 0.04, 0.02, 0.01: \>\"", "<>", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"sci", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<R_exact\>\"", "]"}], "/", 
               RowBox[{"#", "[", "\"\<R_sim\>\"", "]"}]}], "-", "1"}], "]"}], 
            "]"}], "&"}], "/@", "orbitRuns"}], ",", "\"\<, \>\""}], "]"}]}]}],
      "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (49)\>\"", 
      ",", "\"\<R_orbit as printed (with dA containing df_drag) matches the \
simulated orbit\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"orbitRuns", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_PDF (49)\>\"", "]"}], 
          "/", 
          RowBox[{
           RowBox[{"orbitRuns", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_sim\>\"", "]"}]}], "-",
          "1"}], "]"}], "<", "0.05"}], ",", 
      RowBox[{"\"\<The printed radius misses by \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", 
         RowBox[{"100", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"orbitRuns", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_PDF (49)\>\"", 
              "]"}], "/", 
             RowBox[{
              RowBox[{"orbitRuns", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_sim\>\"", "]"}]}], 
            "-", "1"}], "]"}]}], "]"}], "]"}], 
       "<>", "\"\<% at eps = 0.01, and the error does not shrink with eps; \
the corrected radius is within \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"100", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"orbitRuns", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_corrected (49)\>\"",
               "]"}], "/", 
             RowBox[{
              RowBox[{"orbitRuns", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_sim\>\"", "]"}]}], 
            "-", "1"}], "]"}]}], ",", "2"}], "]"}], "<>", "\"\<%.\>\""}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.3, key feature 1\>\"", 
      ",", "\"\<R_orbit is independent of eps (to leading order)\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"orbitRuns", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<R_sim\>\"", "]"}], "/", 
          
          RowBox[{
           RowBox[{"orbitRuns", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<R_sim\>\"", "]"}]}], "-",
          "1"}], "]"}], "<", "0.1"}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Sec. 2.3, key feature 3\>\"", 
      ",", "\"\<the hover condition involves only df_th\>\"", 
      ",", "\"\<With the corrected (47), R_orbit = 0 when df_th e3 is \
parallel to e3 (df_th and dT_th share the eigenvector e3); the drag tensor \
plays no role at this order.\>\""}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (42)\>\"", 
      ",", "\"\<the 'steady' translational balance neglects the centripetal \
acceleration M Omega3 x v\>\"", 
      ",", "\"\<The exact circular solution has |v_perp| reduced by 1/Sqrt[1 \
+ (M Omega3/xi0)^2]; this is O(eps^2) here but matters for heavy particles or \
strong asymmetry.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"5eada190-dcd2-49b0-8fbd-017fc20bdbb4"],

