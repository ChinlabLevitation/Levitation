Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (61)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["omega",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7d4e831e-456c-41af-ba90-0ce599357dcb"],
 " = 1.5e-9 N (with the notes' ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox["r",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "81033cbe-09a0-43cd-8a93-34666083d44e"],
 ")"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"991fc1d1-cc16-4202-aeec-e7b2eb6feb9e"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (62)",
  FontWeight->"Bold"],
 ":   ",
 "analytic form (\[Eta] \[Kappa] T/vbar) 8 \[Pi]/(15 P l) equals the first \
form",
 "\n",
 StyleBox["The printed factor 8 \[Pi]/(15 P l) gives 4.47; substituting ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox["r",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "312ddd25-5788-42cb-abc9-9ed86051a22b"],
 StyleBox[" = (8 \[Pi]/15)(P/vbar) ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "4"], TraditionalForm]],ExpressionUUID->
  "40eb889c-fce3-4829-963c-e91d73afb50a"],
 StyleBox[" gives 15/(8 \[Pi] P l) and the stated 1.59.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"85caa620-fed7-4db6-9b38-3902f810dda3"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (62)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["omega",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "5d041f8c-52c6-4cb8-b03c-39becd6b8f0b"],
 "/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7598b362-76bb-464e-89ca-3da551599ee0"],
 " of about 1.6 and of about 3 Kn"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"4b28e9ac-1021-4e42-8577-ab464115096d"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eq. (62)",
  FontWeight->"Bold"],
 ":   ",
 "the Kn scaling, made explicit",
 "\n",
 StyleBox["Writing \[Kappa] = (15/4)(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8fe02bad-eb17-4eb5-b2f3-d84b33814d8f"],
 StyleBox["/m) \[Mu] and \[Lambda] = (\[Mu]/P) Sqrt[\[Pi] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", 
    StyleBox["B",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e776d433-8cfb-4d46-b87f-44a1174e0eac"],
 StyleBox[" T/2m] turns the corrected (62) into ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["omega",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9accf706-c046-4b30-a783-68f00cda116f"],
 StyleBox["/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "048cadeb-356e-4633-be45-b24cb0aaa34a"],
 StyleBox[" = \!\(\*FormBox[FractionBox[\"15\", RowBox[{\"2\", \" \", \"\[Pi]\
\"}]], TraditionalForm]\) Kn = 2.39 Kn. The quoted 3 Kn uses the total \
conductivity of air.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"0fd61578-1de0-4738-a241-fcc1ba5402a8"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eqs. (61)-(62)",
  FontWeight->"Bold"],
 ":   ",
 "status of the gyrophoretic estimate",
 "\n",
 StyleBox["\[CapitalLambda]' ~ \[CapitalLambda]/(l vbar) is a dimensional \
guess, not a derived coupling. Within the \[CurlyEpsilon]-expansion of \
Section 2, where the notes neglect the coupling as O(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "3a58e679-8150-4d85-bf72-b22f15b755db"],
 StyleBox["), a coupling of order \[CurlyEpsilon] times a spin of order \
\[CurlyEpsilon] gives ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["omega",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8c7a7e4a-c3ef-4276-94f9-1c643ce4fc15"],
 StyleBox["/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "60194671-84ed-4008-b25b-86bc6e96c294"],
 StyleBox[" = O(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "f9c6c755-f425-43d6-9468-a472b9fdc14a"],
 StyleBox["). The O(1) ratio found here assumes an O(1) asymmetry, \
\[CurlyEpsilon] ~ 1. With the kinetic ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox["r",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "dd5d9bdc-08ef-4788-a60a-ea685a918646"],
 StyleBox[" the ratio drops to 0.56.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"b22e9422-ca97-4cb5-b31b-56742811d8cd"],

Cell[TextData[{
 StyleBox["Summary of the hierarchy.",
  FontWeight->"Bold"],
 " Table 2 summarises all four responses for the present system."
}], "Text",ExpressionUUID->"a5e1acf2-a1b1-44ad-bea5-cad23b7b7ba5"],

