Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (41)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["kj",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "0b464793-3037-4958-af0f-9ee2d5a09bd0"],
 " = G \[CurlyEpsilon] (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c77c7362-6758-4e89-bdb9-ef0a3e03974e"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["j",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ed4419df-6d2a-4c67-9ba5-6f7bfbe4cefa"],
 ") ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["j",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6aa3c999-232d-4de9-8a7e-2d2147e0b8d9"],
 "/(I0 c0) has units of a rate (1/s)",
 "\n",
 StyleBox["Units of (41): 1 per kilogram meter squared second (with [G] = \
1/m, [\[CurlyEpsilon] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["dT", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b995331c-72c1-4cbc-85b9-9f473b0fce58"],
 StyleBox["] = N ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]],ExpressionUUID->
  "0362404a-c401-4e4a-b207-d934c308876c"],
 StyleBox[", [I0] = kg ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]],ExpressionUUID->
  "ed7c2fa3-5a6f-44c1-8e64-bad051bfb1ed"],
 StyleBox[", [c0] = N m s). The exact rate scales as (G \[CurlyEpsilon])",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "2"], TraditionalForm]],ExpressionUUID->
  "69d8b5ff-1c2a-4439-b77c-6ffad1675e14"],
 StyleBox[" I0 ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "2"], TraditionalForm]],ExpressionUUID->
  "10471702-97f9-4df5-9439-ea459cca3667"],
 StyleBox["/c0",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "3"], TraditionalForm]],ExpressionUUID->
  "fdc8b9df-8842-4e39-b586-43d48c33eeca"],
 StyleBox[".",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"45d862d1-4eea-4aba-9dc2-9d4e2ed343d4"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Sec. 2.2",
  FontWeight->"Bold"],
 ":   ",
 "'for \[Lambda]3 > \[Lambda]2 > \[Lambda]1 > 0 ... the stable attractor is \
then e1'",
 "\n",
 StyleBox["Exact analysis: for a positive spectrum e3 is stable and e1 \
unstable, as in the table that follows.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"c5ecc836-69a3-4ea6-9aa3-aa0f0bebb5cd"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Sec. 2.2 table",
  FontWeight->"Bold"],
 ":   ",
 "positive spectrum: e1 repeller, e2 saddle, e3 stable attractor"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"6d4d06d4-8756-4fb2-b693-71f400360413"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Sec. 2.2",
  FontWeight->"Bold"],
 ":   ",
 "'all generic initial conditions converge to eigenmotion 3' (general \
spectra)",
 "\n",
 StyleBox["True only when the spectrum is positive. For a negative spectrum \
e1 (the largest |\[Lambda]|) is the attractor; for some mixed-sign spectra, \
such as {-1, 0.5, 2}, no eigenmotion is stable at all.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"e274dbfc-054d-4701-81b3-43a169b93c1d"],

Cell[TextData[{
 StyleBox["Nonlinear check.",
  FontWeight->"Bold"],
 " We integrate the full reduced system (37) from random initial orientations \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "562a5a93-a244-4817-a00c-10d800b2b2a3"],
 " given random eigenvectors, and record where ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "8b85f2c8-e1ae-4fcf-96bc-ecbaa8574a7d"],
 " ends up in the eigenbasis. We also test the Lyapunov claim: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "=", " ", 
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "\[Transpose]"], "\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "005d25e6-919f-47b5-9882-632abed6b3ac"],
 " should increase monotonically along a trajectory."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"ae795053-7b15-442d-9f04-837ed3c7df57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"simU", "[", 
    RowBox[{"lv_", ",", "seed_", ",", 
     RowBox[{"tmax_", ":", "400"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dTm", ",", "Qm", ",", "sol", ",", "w", ",", "u", ",", "t"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
      RowBox[{"Qm", "=", 
       RowBox[{"Orthogonalize", "[", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"dTm", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "Qm", "]"}], ".", 
        RowBox[{"DiagonalMatrix", "[", "lv", "]"}], ".", "Qm"}]}], ";", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"w", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"dTm", ".", 
                RowBox[{"u", "[", "t", "]"}]}], "-", 
               RowBox[{"w", "[", "t", "]"}]}], ")"}], "/", "0.2"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"u", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"-", 
             RowBox[{"Cross", "[", 
              RowBox[{
               RowBox[{"w", "[", "t", "]"}], ",", 
               RowBox[{"u", "[", "t", "]"}]}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"w", "[", "0", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
           RowBox[{
            RowBox[{"u", "[", "0", "]"}], "==", 
            RowBox[{"Normalize", "[", 
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "3"}], "]"}], 
             "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "w"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{"Qm", ",", "dTm", ",", "sol"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"finalAxis", "[", 
    RowBox[{"lv_", ",", "seed_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", "=", 
       RowBox[{"simU", "[", 
        RowBox[{"lv", ",", "seed"}], "]"}]}], "}"}], ",", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ".", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "1"}], "]"}], "]"}], "[", "400", "]"}]}], "]"}],
        ",", "0.001"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"runs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lv", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"finalAxis", "[", 
          RowBox[{"lv", ",", "sd"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"sd", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lv", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "3"}], ",", 
           RowBox[{"-", "2"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "0.5", ",", "2"}], "}"}]}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vmono", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"simU", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "5", ",", "80"}], 
         "]"}]}], ",", "Vt"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Vt", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "1"}], "]"}], "]"}], "[", "t", "]"}], ".", 
          RowBox[{"r", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ".", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "1"}], "]"}], "]"}], "[", "t", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "80", ",", "0.05"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Min", "[", 
       RowBox[{"Differences", "[", "Vt", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"Sequence", "@@", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
         "runs"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<spectrum\>\"", 
           ",", "\"\<|u| in eigenbasis (seed 1)\>\"", ",", "\"\<(seed 2)\>\"",
            ",", "\"\<(seed 3)\>\""}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2\>\"", 
      ",", "\"\<positive spectrum: trajectories converge to e3\>\"", ",", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"runs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#", "-", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "2"}]}]}], "&"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2\>\"", 
      ",", "\"\<negative spectrum converges to e3 (claim applied beyond the \
positive case)\>\"", ",", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"runs", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{"#", "-", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "2"}]}]}], "&"}]}], "]"}], 
      ",", "\"\<Trajectories converge to e1, the most negative \
eigenvalue.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2\>\"", 
      ",", "\"\<V = u^T dT_th u increases monotonically (positive spectrum)\>\
\"", ",", 
      RowBox[{"Vmono", ">", 
       RowBox[{"-", 
        RowBox[{"10", "^", 
         RowBox[{"-", "9"}]}]}]}], ",", 
      RowBox[{"\"\<min dV per step = \>\"", "<>", 
       RowBox[{"sci", "[", "Vmono", "]"}]}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"d5d0fb92-42a7-4710-ad2a-95740161aa73"],

