    OverscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "."], "b"], " ", "=", " ", "-", 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], "\[Times]", "(", 
   StyleBox["I",
    FontWeight->"Bold"], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], ")", " ", "-", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   SuperscriptBox["R", "\[Transpose]"], "\[Del]", 
   StyleBox["ln",
    FontSlant->"Plain"], " ", "T", " ", "-", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 0}},
 CellMargins->{{66, 10}, {0, 0}},
 CellFrameColor->GrayLevel[0.4],
 CellFrameLabels->{{None, 
    Cell["(15)", "Text", FontSize -> 12]}, {None, None}},
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"81523398-b95c-4620-a1ef-6713a4ce09cd"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    StyleBox["a",
     FontWeight->"Bold"], "^"], TraditionalForm]],ExpressionUUID->
  "ce6d89a8-f371-4d09-8067-bc629fa80a49"],
 " denotes the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "3419e8d5-8252-4b21-9929-a039eb291e7d"],
 " skew-symmetric matrix associated with a vector ",
 Cell[BoxData[
  FormBox[
   StyleBox["a",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "bc1b17ac-b90e-4e65-9e7a-7fb5d66b3dc7"],
 ", defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["a",
      FontWeight->"Bold"], "^"], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    StyleBox["a",
     FontWeight->"Bold"], "\[Times]", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "dc045281-f01e-491b-bbf4-7b52fab55e1a"],
 " for all ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f9a1b2ed-6704-4be1-9fee-50f6ed387910"],
 ", with entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["a", "^"], 
     RowBox[{"i", "j"}]], " ", "=", " ", "-", 
    SubscriptBox["\[CurlyEpsilon]", 
     RowBox[{"i", "j", "k"}]], 
    SubscriptBox["a", "k"]}], TraditionalForm]],ExpressionUUID->
  "4f1ad5e7-0461-4a5a-aa7f-ffd47f40e4e6"],
 ". In (13) gravity acts downward (",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "d60d8173-6c49-4980-8df2-45dac2f82d95"],
 ") and the temperature gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T"}], TraditionalForm]],ExpressionUUID->
  "f0e77558-25af-4039-94b8-38c931703e07"],
 " is also taken along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "4cea4a26-7367-42a6-bafd-88981bf77aed"],
 " (hot above cold), so the thermophoretic force ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SuperscriptBox["R", "\[Transpose]"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "b4305738-1626-41df-a49e-fddda55b2efc"],
 " points upward and can levitate the particle. Equation (14) is equivalent \
to the lab-frame form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["R", "."], " ", "=", " ", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "^"], 
     StyleBox["lab",
      FontSlant->"Plain"]], "R"}], TraditionalForm]],ExpressionUUID->
  "ed59ead9-9ad1-4840-9c75-f010fa4d586e"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], 
     StyleBox["lab",
      FontSlant->"Plain"]], " ", "=", " ", "R", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "f7f9625e-6ea2-425c-a890-749f2b883854"],
 "."
}], "Text",ExpressionUUID->"4f5c73d2-c21c-4fa6-9cb1-6b50595d3ac1"],

Cell[TextData[{
 StyleBox["Verification of Section 1.4.",
  FontWeight->"Bold"],
 " (i) Rotating the body-frame force (8) into the lab and adding gravity \
gives (13). (ii) The hat map has entries ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[CurlyEpsilon]", 
     RowBox[{"i", "j", "k"}]], 
    SubscriptBox["a", "k"]}], TraditionalForm]],ExpressionUUID->
  "40232842-aa1b-41fa-af08-8108164e265d"],
 ". (iii) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "^"], "b"], 
    SuperscriptBox["R", "\[Transpose]"], " ", "=", " ", 
    OverscriptBox[
     RowBox[{"R", 
      SuperscriptBox[
       StyleBox["\[Omega]",
        FontWeight->"Bold"], "b"]}], "^"]}], TraditionalForm]],ExpressionUUID->
  "84a29550-d963-407f-8b67-4bd6ce89aa56"],
 " for any rotation, which proves the equivalence of the body and lab forms \
of (14). (iv) The direction statement: with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T", " ", "=", " ", "-", "|", "\[Del]", " ", "T", "|", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "657b83e9-fc1d-4ca4-88f0-7d7052087a78"],
 " the temperature ",
 StyleBox["decreases",
  FontSlant->"Italic"],
 " with height, so the gas is hot ",
 StyleBox["below",
  FontSlant->"Italic"],
 " and cold above, and the force on a sphere points up."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"28e09434-b921-41b4-96d6-503a3737ec79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lnTlab", "=", 
   RowBox[{"{", 
    RowBox[{"gx", ",", "gy", ",", "gz"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fb8", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"fth", ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Transpose", "[", "Rq", "]"}], ".", "lnTlab"}], ")"}]}]}], "-", 
    RowBox[{"fdr", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Transpose", "[", "Rq", "]"}], ".", 
       RowBox[{"{", 
        RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (13)\>\"", 
      ",", "\"\<M dv/dt = -M g Z - R[f_th R^T grad ln T + f_drag R^T v] \
follows from (8)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "Mm"}], "gg", "Zhat"}], "+", 
          RowBox[{"Rq", ".", "Fb8"}]}], ")"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "Mm"}], "gg", "Zhat"}], "-", 
          RowBox[{"Rq", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"fth", ".", 
              RowBox[{"Transpose", "[", "Rq", "]"}], ".", "lnTlab"}], "+", 
             RowBox[{"fdr", ".", 
              RowBox[{"Transpose", "[", "Rq", "]"}], ".", 
              RowBox[{"{", 
               RowBox[{"vx", ",", "vy", ",", "vz"}], "}"}]}]}], ")"}]}]}], 
         ")"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 1.4\>\"", 
      ",", "\"\<hat map entries are -epsilon_ijk a_k\>\"", ",", 
      RowBox[{
       RowBox[{"hat", "[", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}], "]"}], "===", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"LeviCivitaTensor", "[", "3", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"a1", ",", "a2", ",", "a3"}], "}"}], "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (14)\>\"", 
      ",", "\"\<R hat(w^b) R^T = hat(R w^b), so dR/dt = R hat(w^b) = \
hat(w^lab) R\>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Rq", ".", 
           RowBox[{"hat", "[", "wb", "]"}], ".", 
           RowBox[{"Transpose", "[", "Rq", "]"}]}], "-", 
          RowBox[{"hat", "[", 
           RowBox[{"Rq", ".", "wb"}], "]"}]}], ",", "unit"}], "]"}], "===", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 1.4\>\"", 
      ",", "\"\<'grad T along -Z (hot above cold)'\>\"", ",", "False", 
      ",", "\"\<With grad T = -|grad T| Z the temperature falls with height: \
hot below, cold above. The conclusion that the thermophoretic force points up \
(+Z, toward cold) is correct: -f0 R^T grad ln T = +f0 |grad ln T| Z for an \
isotropic f_th.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"f2e9e1e8-98fe-4e0e-8f87-8dbcbc75c884"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (13)",
  FontWeight->"Bold"],
 ":   ",
 "M dv/dt = -M g Z - R[",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "bb5d532e-5283-4bab-8845-0c1a664291e9"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "7bd37adc-c13e-4733-beb3-b26b95cc48b5"],
 " \[Del]ln T + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "21bc4f18-62c1-42aa-b04b-2704fc9834fa"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "25aaa5ca-090f-4553-a34e-2b78cc882149"],
 " v] follows from (8)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"4caa5153-a34c-4c91-a69e-4836138a66af"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Sec. 1.4",
  FontWeight->"Bold"],
 ":   ",
 "hat map entries are -",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    StyleBox["ijk",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f1c19ace-2254-4454-b4e5-c749212d773a"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "a8c005b0-dfdb-435b-bd05-122342947441"]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"0e97ee68-3ab9-481a-9214-c3cd580430d0"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (14)",
  FontWeight->"Bold"],
 ":   ",
 "R hat(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "50e25083-9744-49f9-8b02-c48f6a2ee5b9"],
 ") ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "a92aaa1b-28f8-4af7-b786-bcc4f0ed7a83"],
 " = hat(R ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "7272bba0-e8cf-4c1e-8d17-4685a0567736"],
 "), so dR/dt = R hat(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "06cb6498-a8a4-44e6-b94e-27167ed80054"],
 ") = hat(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "lab"], TraditionalForm]],ExpressionUUID->
  "f4a64b10-e8af-4f7b-b9b2-0224da0d7d3a"],
 ") R"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"2bb8acae-86c1-42e1-8aa9-ebbdee759149"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Sec. 1.4",
  FontWeight->"Bold"],
 ":   ",
 "'\[Del]T along -Z (hot above cold)'",
 "\n",
 StyleBox["With \[Del]T = -|\[Del]T| Z the temperature falls with height: hot \
below, cold above. The conclusion that the thermophoretic force points up \
(+Z, toward cold) is correct: -f0 ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "02768f4a-bb7a-45c0-84a1-95a14d1bbeb5"],
 StyleBox[" \[Del]ln T = +f0 |\[Del]ln T| Z for an isotropic ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "5effa3f2-400b-438f-83ee-817e106e43be"],
 StyleBox[".",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"388d6408-698d-46cb-8c08-097228e8d281"],

Cell[TextData[{
 StyleBox["Gyroscopic term.",
  FontWeight->"Bold"],
 " The term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], "\[Times]", "(", 
    StyleBox["I",
     FontWeight->"Bold"], 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ")"}], TraditionalForm]],ExpressionUUID->
  "cbae77c5-7374-4a14-b197-d96935e42878"],
 " in Eq. (15) is the gyroscopic (Euler) term arising from the non-inertial \
body frame:"
}], "Text",ExpressionUUID->"d2870111-86c3-45dd-b180-df203a5e9610"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], "\[Times]", "(", 
   StyleBox["I",
    FontWeight->"Bold"], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], ")", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"(", 
        SubscriptBox["I", "3"], " ", "-", " ", 
        SubscriptBox["I", "2"], ")", 
        SubsuperscriptBox["\[Omega]", "2", "b"], 
        SubsuperscriptBox["\[Omega]", "3", "b"]}]},
      {
       RowBox[{"(", 
        SubscriptBox["I", "1"], " ", "-", " ", 
        SubscriptBox["I", "3"], ")", 
        SubsuperscriptBox["\[Omega]", "3", "b"], 
        SubsuperscriptBox["\[Omega]", "1", "b"]}]},
      {
       RowBox[{"(", 
        SubscriptBox["I", "2"], " ", "-", " ", 
        SubscriptBox["I", "1"], ")", 
        SubsuperscriptBox["\[Omega]", "1", "b"], 
        SubsuperscriptBox["\[Omega]", "2", "b"]}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(16)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"4119fcec-32a8-4fc9-b4e1-fc869199c322"],

Cell[TextData[{
 "It vanishes for a sphere (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "1"], " ", "=", " ", 
    SubscriptBox["I", "2"], " ", "=", " ", 
    SubscriptBox["I", "3"]}], TraditionalForm]],ExpressionUUID->
  "0ed78338-6e25-4818-8a14-6000c43dbc90"],
 ") and when ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], TraditionalForm]],ExpressionUUID->
  "3dfd6852-333e-4c24-afff-06a836d2f27d"],
 " is parallel to a principal axis."
}], "Text",ExpressionUUID->"99650131-92ab-4682-8458-6960d277e866"],

Cell[TextData[{
 StyleBox["Practical implementation.",
  FontWeight->"Bold"],
 " For numerical integration, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "\[Element]", 
    StyleBox["SO",
     FontSlant->"Plain"], "(", "3", ")"}], TraditionalForm]],ExpressionUUID->
  "1d904370-51be-4b61-a443-5b99d81aef65"],
 " is represented by a unit quaternion ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "eb28fe98-230b-44ec-9ddd-0869c8081926"],
 " to avoid the gimbal-lock singularity of Euler angles. Equation (14) then \
becomes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q",
      FontWeight->"Bold"], "."], " ", "=", " ", 
    FractionBox["1", "2"], "Q", "(", 
    StyleBox["q",
     FontWeight->"Bold"], ")", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "c071c10d-164b-435d-a692-bcfadece1c12"],
 " (see Section 1.5)."
}], "Text",ExpressionUUID->"79f02b74-5090-41c2-9631-b27cf4f04954"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Iten", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"I1", ",", "I2", ",", "I3"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (16)\>\"", ",", "\"\<component form of w x (I w)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"Cross", "[", 
         RowBox[{"wb", ",", 
          RowBox[{"Iten", ".", "wb"}]}], "]"}], "-", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"I3", "-", "I2"}], ")"}], "w2", "w3"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"I1", "-", "I3"}], ")"}], "w3", "w1"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"I2", "-", "I1"}], ")"}], "w1", "w2"}]}], "}"}]}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (16)\>\"", 
      ",", "\"\<gyroscopic term vanishes for a sphere and for w along a \
principal axis\>\"", ",", 
      RowBox[{
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"Cross", "[", 
          RowBox[{"wb", ",", 
           RowBox[{"Iten", ".", "wb"}]}], "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"I2", "->", "I1"}], ",", 
           RowBox[{"I3", "->", "I1"}]}], "}"}]}], "]"}], "&&", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
         RowBox[{
          RowBox[{"zeroQ", "[", 
           RowBox[{"Cross", "[", 
            RowBox[{
             RowBox[{"s", "#"}], ",", 
             RowBox[{"Iten", ".", 
              RowBox[{"(", 
               RowBox[{"s", "#"}], ")"}]}]}], "]"}], "]"}], "&"}]}], 
        "]"}]}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"ff7a639c-\
e39b-4c86-bd32-49f95ce35a52"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (16)",
  FontWeight->"Bold"],
 ":   ",
 "component form of w x (I w)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"fcf4b412-3ee3-43be-b8b0-9bf9540a4618"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (16)",
  FontWeight->"Bold"],
 ":   ",
 "gyroscopic term vanishes for a sphere and for w along a principal axis"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"fcc7ec94-843f-4f85-84aa-701148dbcfa7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.5 Attitude kinematics \[LongDash] quaternion representation", \
"Subsection",ExpressionUUID->"9df0e72a-ecab-495a-9ce0-485effc5bd83"],

Cell[TextData[{
 "Euler angles develop a coordinate singularity (gimbal lock) at pitch ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox["90", "\[Degree]"]}], TraditionalForm]],ExpressionUUID->
  "5fc914f7-a8c5-44be-b2fa-d7ea162037f1"],
 ". We instead represent the orientation by a unit quaternion"
}], "Text",ExpressionUUID->"1fc29753-36e1-4d44-80ab-431c7010ee08"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["q",
    FontWeight->"Bold"], " ", "=", " ", "(", 
   SubscriptBox["q", "0"], ",", " ", 
   SubscriptBox["q", "1"], ",", " ", 
   SubscriptBox["q", "2"], ",", " ", 
   SubscriptBox["q", "3"], ")", " ", "\[Element]", " ", 
   SuperscriptBox["\[DoubleStruckCapitalR]", "4"], " ", ",", " ", 
   "\:2003\:2003", " ", "|", 
   StyleBox["q",
    FontWeight->"Bold"], 
   SuperscriptBox["|", "2"], " ", "\[Congruent]", " ", 
   SubsuperscriptBox["q", "0", "2"], " ", "+", " ", 
   SubsuperscriptBox["q", "1", "2"], " ", "+", " ", 
   SubsuperscriptBox["q", "2", "2"], " ", "+", " ", 
   SubsuperscriptBox["q", "3", "2"], " ", "=", " ", "1", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(17)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"3d44f023-029d-44ae-b34a-4b7347ab260d"],

Cell[TextData[{
 "The scalar part is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "0"], " ", "=", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "(", "\[Psi]", "/", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"fc7d93ee-a977-488c-a309-afa4ecc6650c"],
 " and the vector part is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], " ", "=", " ", "(", 
    SubscriptBox["q", "1"], ",", " ", 
    SubscriptBox["q", "2"], ",", " ", 
    SubscriptBox["q", "3"], ")", " ", "=", " ", 
    OverscriptBox["k", "^"], 
    StyleBox["sin",
     FontSlant->"Plain"], "(", "\[Psi]", "/", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"4b6f2e43-c0b5-4251-b1fc-b0bc10d85c7c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["k", "^"], TraditionalForm]],ExpressionUUID->
  "0cb71345-3fd0-4881-97e3-f5c3c3f42f01"],
 " is the unit rotation axis and ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]],ExpressionUUID->
  "32b1f53f-cd7e-4744-ac9a-806ad440057c"],
 " is the rotation angle."
}], "Text",ExpressionUUID->"d0ee0035-6540-49ec-ad31-c76212406d42"],

Cell[TextData[StyleBox["Rotation matrix from quaternion.",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"216d4d9b-6aa8-4ba4-8260-\
a21cbcc52178"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", "(", 
   StyleBox["q",
    FontWeight->"Bold"], ")", " ", "=", " ", "(", 
   SubsuperscriptBox["q", "0", "2"], " ", "-", " ", "|", 
   OverscriptBox["q", "\[RightVector]"], 
   SuperscriptBox["|", "2"], ")", 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "2", 
   OverscriptBox["q", "\[RightVector]"], "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox["q", "\[RightVector]"], "\[Transpose]"], " ", "+", " ", "2", 
   SubscriptBox["q", "0"], "\[ThinSpace]", 
   OverscriptBox[
    OverscriptBox["q", "\[RightVector]"], "^"], " ", ",", " ", "\:2003\:2003",
    " ", 
   OverscriptBox[
    OverscriptBox["q", "\[RightVector]"], "^"], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", 
        SubscriptBox["q", "3"]}], 
       SubscriptBox["q", "2"]},
      {
       SubscriptBox["q", "3"], "0", 
       RowBox[{"-", 
        SubscriptBox["q", "1"]}]},
      {
       RowBox[{"-", 
        SubscriptBox["q", "2"]}], 
       SubscriptBox["q", "1"], "0"}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(18)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"56ce20f6-0f8d-4719-a0e5-9fe5ccdbf267"],

Cell[TextData[StyleBox["Explicit axis-angle form.",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"6dc98ee7-10b7-437c-9e57-\
414e7ff4835f"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", "(", 
   OverscriptBox["k", "^"], ",", " ", "\[Psi]", ")", " ", "=", " ", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[Psi]", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "(", "1", " ", "-", " ", 
   StyleBox["cos",
    FontSlant->"Plain"], "\[Psi]", ")", 
   OverscriptBox["k", "^"], 
   SuperscriptBox[
    OverscriptBox["k", "^"], "\[Transpose]"], " ", "+", " ", 
   StyleBox["sin",
    FontSlant->"Plain"], "\[Psi]", "\[ThinSpace]", 
   OverscriptBox[
    OverscriptBox["k", "^"], "^"], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(19)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"188430a6-5aa5-48b7-9318-2f4f37fca6fc"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", " ", "\[Congruent]", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "\[Psi]"}], TraditionalForm]],ExpressionUUID->
  "022ac45b-ae33-4f92-b7a8-8365559fd623"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", " ", "\[Congruent]", " ", 
    StyleBox["sin",
     FontSlant->"Plain"], "\[Psi]"}], TraditionalForm]],ExpressionUUID->
  "8e783f31-2365-4e99-b865-1c3873e5e595"],
 ":"
}], "Text",ExpressionUUID->"1e833157-c913-4e6d-b70e-e9585693bcbf"],

Cell[BoxData[
 FormBox[
  RowBox[{"R", "(", 
   OverscriptBox["k", "^"], ",", " ", "\[Psi]", ")", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubsuperscriptBox["k", "1", "2"], "(", "1", " ", "-", " ", "c", ")", 
        " ", "+", " ", "c"}], 
       RowBox[{
        SubscriptBox["k", "1"], 
        SubscriptBox["k", "2"], "(", "1", " ", "-", " ", "c", ")", " ", "-", 
        " ", 
        SubscriptBox["k", "3"], "s"}], 
       RowBox[{
        SubscriptBox["k", "1"], 
        SubscriptBox["k", "3"], "(", "1", " ", "-", " ", "c", ")", " ", "+", 
        " ", 
        SubscriptBox["k", "2"], "s"}]},
      {
       RowBox[{
        SubscriptBox["k", "1"], 
        SubscriptBox["k", "2"], "(", "1", " ", "-", " ", "c", ")", " ", "+", 
        " ", 
        SubscriptBox["k", "3"], "s"}], 
       RowBox[{
        SubsuperscriptBox["k", "2", "2"], "(", "1", " ", "-", " ", "c", ")", 
        " ", "+", " ", "c"}], 
       RowBox[{
        SubscriptBox["k", "2"], 
        SubscriptBox["k", "3"], "(", "1", " ", "-", " ", "c", ")", " ", "-", 
        " ", 
        SubscriptBox["k", "1"], "s"}]},
      {
       RowBox[{
        SubscriptBox["k", "1"], 
        SubscriptBox["k", "3"], "(", "1", " ", "-", " ", "c", ")", " ", "-", 
        " ", 
        SubscriptBox["k", "2"], "s"}], 
       RowBox[{
        SubscriptBox["k", "2"], 
        SubscriptBox["k", "3"], "(", "1", " ", "-", " ", "c", ")", " ", "+", 
        " ", 
        SubscriptBox["k", "1"], "s"}], 
       RowBox[{
        SubsuperscriptBox["k", "3", "2"], "(", "1", " ", "-", " ", "c", ")", 
        " ", "+", " ", "c"}]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(20)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"a1a04da4-d253-4d75-99bb-15962c02df97"],

Cell[TextData[StyleBox["Kinematic differential equation.",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"0bc96667-6862-4522-93b8-\
ca98b73140e0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    StyleBox["q",
     FontWeight->"Bold"], "."], " ", "=", " ", 
   FractionBox["1", "2"], "Q", "(", 
   StyleBox["q",
    FontWeight->"Bold"], ")", 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", ",", " ", "\:2003\:2003", " ", "Q", "(", 
   
   StyleBox["q",
    FontWeight->"Bold"], ")", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", 
        SubscriptBox["q", "1"]}], 
       RowBox[{"-", 
        SubscriptBox["q", "2"]}], 
       RowBox[{"-", 
        SubscriptBox["q", "3"]}]},
      {
       SubscriptBox["q", "0"], 
       RowBox[{"-", 
        SubscriptBox["q", "3"]}], 
       SubscriptBox["q", "2"]},
      {
       SubscriptBox["q", "3"], 
       SubscriptBox["q", "0"], 
       RowBox[{"-", 
        SubscriptBox["q", "1"]}]},
      {
       RowBox[{"-", 
        SubscriptBox["q", "2"]}], 
       SubscriptBox["q", "1"], 
       SubscriptBox["q", "0"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(21)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"84dd678b-15c5-4990-b36f-a5ea644c6c3d"],

Cell[TextData[{
 "To prevent numerical drift, ",
 Cell[BoxData[
  FormBox[
   StyleBox["q",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "b467ea05-546b-4e28-a298-40f1ea302b0a"],
 " must be renormalised after each integration step: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], " ", "\[LeftArrow]", " ", 
    StyleBox["q",
     FontWeight->"Bold"], "/", "|", 
    StyleBox["q",
     FontWeight->"Bold"], "|"}], TraditionalForm]],ExpressionUUID->
  "171f33c1-d5b4-45a0-9b85-a3e6febe8c08"],
 "."
}], "Text",ExpressionUUID->"e65717ef-fd05-4635-946c-b260f6579a4b"],

Cell[TextData[{
 StyleBox["Verification of Section 1.5.",
  FontWeight->"Bold"],
 " (i) Substituting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["q", "0"], " ", "=", " ", 
    StyleBox["cos",
     FontSlant->"Plain"], "(", "\[Psi]", "/", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"33a8f25f-5bbb-4bfb-a02e-697cb555700d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["q", "\[RightVector]"], " ", "=", " ", 
    OverscriptBox["k", "^"], 
    StyleBox["sin",
     FontSlant->"Plain"], "(", "\[Psi]", "/", "2", ")"}], TraditionalForm]],
  ExpressionUUID->"716ea4c6-f0b8-4686-b42d-644dab564671"],
 " into (18) gives (19). (ii) The explicit matrix (20) equals (19). (iii) \
Most importantly, the quaternion ODE (21) must reproduce the attitude \
equation (14). Differentiate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", 
    StyleBox["q",
     FontWeight->"Bold"], "(", "t", ")", ")"}], TraditionalForm]],
  ExpressionUUID->"a2bcdb08-c3df-487a-b032-d7fa2f9b38e1"],
 " along ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["q",
      FontWeight->"Bold"], "."], " ", "=", " ", 
    FractionBox["1", "2"], "Q", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "80aa389c-3371-4098-845b-ece7a2cb85c1"],
 " and compare with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "^"], "b"]}], TraditionalForm]],ExpressionUUID->
  "6770fabd-87a3-4b59-998f-d125e3e7b340"],
 ". (iv) The ODE preserves ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["q",
     FontWeight->"Bold"], "|"}], TraditionalForm]],ExpressionUUID->
  "a42999c9-796d-4d5a-95b3-4e941060c84f"],
 " exactly, since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], "\[CenterDot]", " ", "Q", "(", 
    StyleBox["q",
     FontWeight->"Bold"], ")", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"4f5241cb-e9b3-4abe-b373-a9f3df906198"],
 "; renormalisation only removes integrator round-off."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"042f2d7f-907c-4a3b-ad09-0c8e29dd3851"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kk", "=", 
   RowBox[{"{", 
    RowBox[{"k1", ",", "k2", ",", "k3"}], "}"}]}], ";", 
  RowBox[{"kunit", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"k1", "^", "2"}], "+", 
     RowBox[{"k2", "^", "2"}], "+", 
     RowBox[{"k3", "^", "2"}]}], "==", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R19", "=", 
   RowBox[{"axisAngleR", "[", 
    RowBox[{"kk", ",", "psi"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R20", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"k1", "^", "2"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", "c"}], ",", 
        RowBox[{
         RowBox[{"k1", "k2", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "-", 
         RowBox[{"k3", "s"}]}], ",", 
        RowBox[{
         RowBox[{"k1", "k3", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", 
         RowBox[{"k2", "s"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"k1", "k2", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", 
         RowBox[{"k3", "s"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"k2", "^", "2"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", "c"}], ",", 
        RowBox[{
         RowBox[{"k2", "k3", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "-", 
         RowBox[{"k1", "s"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"k1", "k3", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "-", 
         RowBox[{"k2", "s"}]}], ",", 
        RowBox[{
         RowBox[{"k2", "k3", 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", 
         RowBox[{"k1", "s"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"k3", "^", "2"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", "c"}], ")"}]}], "+", "c"}]}], "}"}]}], "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "->", 
       RowBox[{"Cos", "[", "psi", "]"}]}], ",", 
      RowBox[{"s", "->", 
       RowBox[{"Sin", "[", "psi", "]"}]}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qdotRule", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q0d", ",", "q1d", ",", "q2d", ",", "q3d"}], "}"}], "->", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], 
      RowBox[{
       RowBox[{"Qmat", "[", 
        RowBox[{"{", 
         RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}], "]"}], ".", 
       "wb"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rdot", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"Rq", ",", "var"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"var", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"q0", "->", "q0d"}], ",", 
           RowBox[{"q1", "->", "q1d"}], ",", 
           RowBox[{"q2", "->", "q2d"}], ",", 
           RowBox[{"q3", "->", "q3d"}]}], "}"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"var", ",", 
        RowBox[{"{", 
         RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}]}], "}"}]}], 
     "]"}], "/.", "qdotRule"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (18)-(19)\>\"", 
      ",", "\"\<quaternion form with q0 = cos(psi/2), q = k sin(psi/2) equals \
the axis-angle form\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"quatR", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Cos", "[", 
               RowBox[{"psi", "/", "2"}], "]"}], "}"}], ",", 
             RowBox[{"kk", 
              RowBox[{"Sin", "[", 
               RowBox[{"psi", "/", "2"}], "]"}]}]}], "]"}], "]"}], "-", 
          "R19"}], ",", "kunit"}], "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (20)\>\"", 
      ",", "\"\<explicit matrix (20) equals (19)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"R20", "-", "R19"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (21)\>\"", 
      ",", "\"\<dq/dt = Q(q) w^b / 2 implies dR/dt = R hat(w^b), i.e. \
reproduces (14)\>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Rdot", "-", 
          RowBox[{"Rq", ".", 
           RowBox[{"hat", "[", "wb", "]"}]}]}], ",", "unit"}], "]"}], "===", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (21)\>\"", 
      ",", "\"\<the quaternion ODE conserves |q| exactly (q . Q(q) w = 0)\>\"",
       ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}], ".", 
        RowBox[{"Qmat", "[", 
         RowBox[{"{", 
          RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}], "]"}], ".", 
        "wb"}], "]"}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"3f3810de-cba3-4126-bb17-67ea8dce300e"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eqs. (18)-(19)",
  FontWeight->"Bold"],
 ":   ",
 "quaternion form with q0 = cos(\[Psi]/2), q = k sin(\[Psi]/2) equals the \
axis-angle form"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
