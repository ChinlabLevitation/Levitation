Cell[CellGroupData[{

Cell["\<\
1. General formalism for rigid-body motion in a thermal gas cell\
\>", "Section",ExpressionUUID->"0072e760-d037-4849-bd47-89a26746a07b"],

Cell[TextData[{
 "The disk and cylinder examples in Sections 2 and 3 exploit specific \
geometric symmetries to simplify the force expressions. In this section we \
derive the equations of motion for a rigid body of completely arbitrary \
shape, making no symmetry assumption. The only assumption throughout Sections \
1.1\[Dash]1.6 is that gravity acts along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "1fabf30d-dbf2-49b0-a59e-7111c2e74328"],
 ". The temperature gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T"}], TraditionalForm]],ExpressionUUID->
  "e0332898-9c5e-48cd-ac0e-b8d7f72162f7"],
 " is treated as a general vector with arbitrary direction. Symmetric bodies \
such as cylinders and spheroids emerge as special cases of this formulation, \
which are discussed in Section 1.7."
}], "Text",ExpressionUUID->"707767e1-8243-4367-aca2-d57ba8a44ab1"],

Cell[CellGroupData[{

Cell["1.1 Reference frames, rotation matrix, and inertia tensor", "Subsection",ExpressionUUID->"c6916a5e-c635-48cd-b82b-73c828fb0dfc"],

Cell[TextData[{
 StyleBox["Lab frame.",
  FontWeight->"Bold"],
 " We work in a fixed inertial frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    OverscriptBox["X", "^"], ",", " ", 
    OverscriptBox["Y", "^"], ",", " ", 
    OverscriptBox["Z", "^"], ")"}], TraditionalForm]],ExpressionUUID->
  "7b8afddd-af83-4d65-b8b4-7d7949592673"],
 ". The only assumption placed on the external fields is that gravity acts \
along ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "379f1c0c-a456-4707-8fbc-99cc7c25c065"],
 ":"
}], "Text",ExpressionUUID->"f631ed19-54b3-4492-8306-ba39bea3c778"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["g",
    FontWeight->"Bold"], " ", "=", " ", "-", "g", "\[ThinSpace]", 
   OverscriptBox["Z", "^"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(1)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"8799ea58-2133-4c48-943a-42d100b4bffe"],

Cell[TextData[{
 "The macroscopic temperature gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T"}], TraditionalForm]],ExpressionUUID->
  "8ab48d4f-d94a-45f9-a4a3-95e9021050f8"],
 " is a prescribed vector field in the lab frame. No assumption is made about \
its direction."
}], "Text",ExpressionUUID->"6a9a4f21-d558-4faf-8e4a-51c14b022c06"],

Cell[TextData[{
 StyleBox["Body frame and inertia tensor.",
  FontWeight->"Bold"],
 " We attach a frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox[
     OverscriptBox["e", "^"], "1"], ",", " ", 
    SubscriptBox[
     OverscriptBox["e", "^"], "2"], ",", " ", 
    SubscriptBox[
     OverscriptBox["e", "^"], "3"], ")"}], TraditionalForm]],ExpressionUUID->
  "df12cb16-2c77-4f16-b0fc-244335aa2770"],
 " to the rigid body with its origin at the centre of mass (CoM), aligned \
with the principal axes of inertia so that the inertia tensor is diagonal:"
}], "Text",ExpressionUUID->"a2971036-d57d-453f-8684-11a5ab025fd0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["I",
    FontWeight->"Bold"], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["I", "1"], "0", "0"},
      {"0", 
       SubscriptBox["I", "2"], "0"},
      {"0", "0", 
       SubscriptBox["I", "3"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(2)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"0a36cc12-8173-464f-ad34-e23f1fba4ba4"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "1"], ",", " ", 
    SubscriptBox["I", "2"], ",", " ", 
    SubscriptBox["I", "3"]}], TraditionalForm]],ExpressionUUID->
  "0428e879-8d26-47f9-881a-cc9b1b404d9d"],
 " are the three principal moments of inertia. In general all three are \
distinct, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "1"], " ", "\[NotEqual]", " ", 
    SubscriptBox["I", "2"], " ", "\[NotEqual]", " ", 
    SubscriptBox["I", "3"]}], TraditionalForm]],ExpressionUUID->
  "f141e88a-b654-4de4-a055-d51016dc3026"],
 "."
}], "Text",ExpressionUUID->"65e14841-41bd-4dc6-89df-f6c02bc1eceb"],

Cell[TextData[{
 StyleBox["Rotation matrix.",
  FontWeight->"Bold"],
 " The instantaneous orientation of the body is described by the rotation \
matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "\[Element]", " ", 
    StyleBox["SO",
     FontSlant->"Plain"], "(", "3", ")"}], TraditionalForm]],ExpressionUUID->
  "01afcab4-57a5-4ad8-8ab4-a5719a3135c1"],
 ", defined so that a vector ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "504b5d6b-73ab-4c5a-b223-5c7b61e4ae5a"],
 " with components in the body frame has lab-frame components ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "R", 
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "0d7f36a1-443c-412f-891b-4754661dbff5"],
 ", with inverse ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "b"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "c3838a0c-2cdb-436c-b13f-05eb9dbedfbe"],
 ". In particular, the temperature gradient and the CoM velocity in the body \
frame are"
}], "Text",ExpressionUUID->"731fb6a3-5266-4d62-86a1-9f49b8d34368"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", "\[Del]", " ", "T", ")"}], "b"], " ", "=", " ", 
   SuperscriptBox["R", "\[Transpose]"], "\[Del]", " ", "T", " ", ",", " ", 
   "\:2003\:2003", " ", 
   SuperscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "b"], " ", "=", " ", 
   SuperscriptBox["R", "\[Transpose]"], 
   StyleBox["v",
    FontWeight->"Bold"], " ", ","}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(3)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"9717f732-dbea-40fd-bfd7-65667c25bec9"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "=", " ", 
    OverscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "."]}], TraditionalForm]],ExpressionUUID->
  "2e34938d-26e9-4dc7-ac70-301855ed66d6"],
 " is the lab-frame CoM velocity. The evolution of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "65e0f8c3-6415-4870-bcc9-ed074b8b219f"],
 " in time is governed by the quaternion kinematics derived in Section 1.5."
}], "Text",ExpressionUUID->"5b780755-cfdc-4bef-841c-5fcb4c71efc9"],

Cell[TextData[{
 StyleBox["Verification of (3).",
  FontWeight->"Bold"],
 " The inverse ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "b"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "0580dd03-394e-4160-9e14-d3d99b07ec61"],
 " requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "\[Transpose]"], "R", " ", "=", " ", 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "84cb65d9-d6c8-492b-940d-365f045b210d"],
 ". We check this, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["det",
     FontSlant->"Plain"], " ", "R", " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"68c60ea5-605f-4866-9e67-96a7628256ae"],
 ", for the general unit-quaternion parametrisation (18) used later."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"de85171d-a427-4843-b35e-9a0e382f684d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Rq", "=", 
   RowBox[{"quatR", "[", 
    RowBox[{"{", 
     RowBox[{"q0", ",", "q1", ",", "q2", ",", "q3"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"unit", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"q0", "^", "2"}], "+", 
     RowBox[{"q1", "^", "2"}], "+", 
     RowBox[{"q2", "^", "2"}], "+", 
     RowBox[{"q3", "^", "2"}]}], "==", "1"}]}], ";"}], "\n", 
 RowBox[{"verify", "[", 
  RowBox[{"\"\<Eq. (3)\>\"", 
   ",", "\"\<R(q) is orthogonal with det R = 1, so u^b = R^T u inverts u = R \
u^b\>\"", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "Rq", "]"}], ".", "Rq"}], ",", "unit"}], 
      "]"}], "===", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "&&", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Det", "[", "Rq", "]"}], ",", "unit"}], "]"}], "===", 
     "1"}]}]}], "]"}]}], "Input",ExpressionUUID->"ba5bae54-1b1f-4a89-a1b5-\
f0b8bce8e296"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (3)",
  FontWeight->"Bold"],
 ":   ",
 "R(q) is orthogonal with det R = 1, so ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "b"], TraditionalForm]],ExpressionUUID->
  "fa69e2ce-2b77-4a09-926e-2f938d7ac7ee"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "a837ff82-b9f7-4a64-a6c1-417411a19501"],
 " u inverts u = R ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "b"], TraditionalForm]],ExpressionUUID->
  "634b8214-8794-42d5-898b-c44bf0783365"]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"bc5e8d7c-1d32-4f3b-82d5-ed679dde3d8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2 Gas-interaction tensors for an arbitrary shape", "Subsection",ExpressionUUID->"2d1cc900-0e74-473f-8e77-591120e03664"],

Cell["\<\
In the low-velocity, small-temperature-gradient limit all forces and torques \
respond linearly to their driving fields. We introduce four tensors in the \
natural order: the two forces (from temperature gradient and from velocity) \
followed by the two torques (from temperature gradient and from angular \
velocity).\
\>", "Text",ExpressionUUID->"9803aba1-d2ab-4672-a28f-b7e5dcc1a5d0"],

Cell[TextData[{
 StyleBox["Thermophoretic force tensor ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "c89d0470-7b71-4de4-8cd6-41232f8905d1"],
 StyleBox[" (symmetric, 6 DOF).",
  FontWeight->"Bold"],
 " Thermophoresis drives particles from hot toward cold. The tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "cec97587-eeff-452d-8331-340a85cb18de"],
 " relates the temperature gradient to the thermophoretic force in the body \
frame:"
}], "Text",ExpressionUUID->"2d6146f0-80b0-45a8-9a1e-9742d347dddc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["F",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"], "b"], " ", "=", " ", "-", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    RowBox[{"(", "\[Del]", " ", 
     StyleBox["ln",
      FontSlant->"Plain"], " ", "T", ")"}], "b"], " ", ",", " ", 
   "\:2003\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["f", "11"], 
       SubscriptBox["f", "12"], 
       SubscriptBox["f", "13"]},
      {
       SubscriptBox["f", "12"], 
       SubscriptBox["f", "22"], 
       SubscriptBox["f", "23"]},
      {
       SubscriptBox["f", "13"], 
       SubscriptBox["f", "23"], 
       SubscriptBox["f", "33"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(4)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"2c3300f7-4e6b-48f5-8017-581ad0aea79f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c61799f3-f6de-4c4c-a380-2edf417ef1e6"],
 " is symmetric positive-definite (6 DOF). The off-diagonal entry ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    RowBox[{"i", "j"}]], TraditionalForm]],ExpressionUUID->
  "5312bc6f-dc81-442a-ac78-fa8289cff113"],
 " means a gradient along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "j"], TraditionalForm]],ExpressionUUID->
  "76d0ed07-7ecb-4ce7-a306-17917a0bb429"],
 " drives a force component along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "i"], TraditionalForm]],ExpressionUUID->
  "be26104b-b7fe-4f8e-8dbc-1ae5b2713cc8"],
 "."
}], "Text",ExpressionUUID->"a32cda23-6d74-437b-b3ab-9acb1ed14157"],

Cell[TextData[{
 StyleBox["Drag force tensor ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "631778c0-2abd-4992-b2dd-07159af7e8f3"],
 StyleBox[" (symmetric, 6 DOF).",
  FontWeight->"Bold"],
 " The tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b467b581-b7dd-4d00-910e-eba214f67f5b"],
 " relates the CoM velocity to the drag force in the body frame:"
}], "Text",ExpressionUUID->"378cc80d-91c2-4016-a92e-a51e5178b547"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["F",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"], "b"], " ", "=", " ", "-", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "b"], " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["d", "11"], 
       SubscriptBox["d", "12"], 
       SubscriptBox["d", "13"]},
      {
       SubscriptBox["d", "12"], 
       SubscriptBox["d", "22"], 
       SubscriptBox["d", "23"]},
      {
       SubscriptBox["d", "13"], 
       SubscriptBox["d", "23"], 
       SubscriptBox["d", "33"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(5)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"dd99a40d-eed2-4e65-b935-dd1f66af55f0"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "749262a8-944c-49c8-8b99-a13c99520246"],
 " is symmetric positive-definite (6 DOF): drag power ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " ", "=", " ", "-", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[Transpose]"], 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    StyleBox["v",
     FontWeight->"Bold"], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"87e70026-40cb-47a8-9922-81a662856439"],
 " for all ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "e6346a62-e90c-4808-82f8-ba3674385ae5"],
 " forces positive-definiteness, and only the symmetric part contributes to \
",
 Cell[BoxData[
  FormBox["P", TraditionalForm]],ExpressionUUID->
  "80db8ee3-277a-496f-91aa-6cabbe59f42a"],
 "."
}], "Text",ExpressionUUID->"c8eedd2d-a17b-46e3-96bb-f66d9c74fd5f"],

Cell[TextData[{
 StyleBox["Verification of the dissipation argument.",
  FontWeight->"Bold"],
 " Only the symmetric part of a matrix contributes to the quadratic form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "\[Transpose]"], 
    StyleBox["A",
     FontWeight->"Bold"], 
    StyleBox["v",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "ae976fcc-8c47-4a6b-bb98-80bf97b2841c"],
 ", because the antisymmetric part gives zero identically. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "<", "0"}], TraditionalForm]],ExpressionUUID->
  "60e60215-6eb2-4533-88a8-50d09c1ddc78"],
 " for all ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "640d7d8e-315d-4dc9-a9f2-860d5803c06f"],
 " is then exactly the statement that the symmetric part is \
positive-definite. The symmetry of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7703a238-9181-42ed-beee-5d3aff5ddba6"],
 " itself does not follow from dissipation; it follows from the \
Lorentz/Onsager reciprocal relations. The same remark applies to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e3097586-7bb7-4a2c-a36d-ce7fdf19d72d"],
 ", which is ",
 StyleBox["assumed",
  FontSlant->"Italic"],
 " symmetric here."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"1f6aaaaf-fe66-47fd-96ce-b95a7103283e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vv", "=", 
   RowBox[{"{", 
    RowBox[{"v1", ",", "v2", ",", "v3"}], "}"}]}], ";", 
  RowBox[{"Aanti", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "a12", ",", "a13"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a12"}], ",", "0", ",", "a23"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a13"}], ",", 
       RowBox[{"-", "a23"}], ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (5)\>\"", 
      ",", "\"\<antisymmetric part of the drag tensor does no work (v.A.v = \
0)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"vv", ".", "Aanti", ".", "vv"}], "]"}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eqs. (4)-(5)\>\"", 
      ",", "\"\<symmetry of f_drag rests on reciprocity; symmetry of f_th is \
an assumption\>\"", 
      ",", "\"\<Dissipation only constrains the symmetric part. No symmetry \
principle makes f_th symmetric for a generic (chiral) body; see the symmetry \
analysis in Section 1.7, where the chiral group C_inf allows an antisymmetric \
part of f_th.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"d90370fd-3e9f-4032-abfb-8b58ca6a7f58"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (5)",
  FontWeight->"Bold"],
 ":   ",
 "antisymmetric part of the drag tensor does no work (v.A.v = 0)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"bbeb0eb5-ef8e-4f78-8751-dd2eaa8c86d8"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eqs. (4)-(5)",
  FontWeight->"Bold"],
 ":   ",
 "symmetry of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "89789065-fa10-449c-ab63-abc8391ce4b1"],
 " rests on reciprocity; symmetry of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "15d9e955-bd5f-4202-810f-0a14c54ef96b"],
 " is an assumption",
 "\n",
 StyleBox["Dissipation only constrains the symmetric part. No symmetry \
principle makes ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "01e1c514-342e-475a-978d-ccc740047c96"],
 StyleBox[" symmetric for a generic (chiral) body; see the symmetry analysis \
in Section 1.7, where the chiral group ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox["inf",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "81a53fff-9b40-4d0e-99dd-3354d8143bc3"],
 StyleBox[" allows an antisymmetric part of ",
  FontSize->11,
