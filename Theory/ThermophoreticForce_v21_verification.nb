Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eqs. (52)-(53)",
  FontWeight->"Bold"],
 ":   ",
 "prefactor f = m N \[Pi] r L / Sqrt[h]",
 "\n",
 StyleBox["The kinetic prefactor is f = m N \[Sqrt]\[Pi] r L/Sqrt[h] = \
\[Alpha] \[Pi] r L; the printed f is too large by \[Sqrt]\[Pi].",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"c5a27a85-a26d-4adc-9ebb-14093b979ca4"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eqs. (52)-(53)",
  FontWeight->"Bold"],
 ":   ",
 "sense of the tilt angle",
 "\n",
 StyleBox["The printed cross terms (A - C) and (B - D) correspond to the axis \
tilted below the X-axis, a = (cos \[Theta], 0, -sin \[Theta]). For a = (cos \
\[Theta], 0, +sin \[Theta]) both cross terms change sign; the notes should \
state which sense is meant.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"bbe26e13-c9a6-481f-80bd-8aa3b894673a"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (54)",
  FontWeight->"Bold"],
 ":   ",
 "\[Theta] = 0 corresponds to the cylinder axis along Z",
 "\n",
 StyleBox["With the angle measured from the X-axis, as stated before (52), \
\[Theta] = 0 puts the axis along X, perpendicular to the gradient. (54), F = \
f B T'/T, is therefore the force on a horizontal cylinder. A vertical \
cylinder (\[Theta] = \[Pi]/2) feels F = f D T'/T = f (3 \[Nu] a/4) T'/T.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"34dc0be0-348b-41de-852f-9391e452d804"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (54)",
  FontWeight->"Bold"],
 ":   ",
 "levitation force of a horizontal cylinder is f B T'/T along +Z"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"c5cf134d-eb46-4c41-a598-602af7cfa30e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"FsphNu", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"waldmann", "/.", 
       RowBox[{"q0", "->", "qOfTau"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"Rs", "->", "rC"}], "}"}]}], ",", "kinAssume"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ratio55", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Fcyl", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"thC", "->", "0"}], ",", 
            RowBox[{"vC", "->", "0"}]}], "}"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"Pi", 
          RowBox[{"rC", "^", "2"}], "LC"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"FsphNu", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"4", "/", "3"}], "Pi", 
          RowBox[{"rC", "^", "3"}]}], ")"}]}], ")"}]}], ",", "kinAssume"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eta56", "=", 
   RowBox[{"16", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "15"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lhs56", "=", 
   RowBox[{"2", "mm", "nn", "Pi", 
    RowBox[{"nuG", "/", 
     RowBox[{"Sqrt", "[", "hh", "]"}]}]}]}], ";", 
  RowBox[{"rhs56", "=", 
   RowBox[{"eta56", 
    RowBox[{"kap", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "kB", 
       RowBox[{"Tk", "/", "mm"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kapOfNu", "=", 
   RowBox[{"kap", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"nuSym", "/.", "nuSol"}], ")"}], "==", "nuG"}], ",", "kap"}],
       "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<sphere force in G-Y variables:  F_o = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", "FsphNu", "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (55)\>\"", ",", "\"\<F/V_c = (1 - a/4) F_o/V_o\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"ratio55", "-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"aa", "/", "4"}]}], ")"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (56)\>\"", 
      ",", "\"\<conversion 2 m N pi nu/Sqrt[h] = eta kappa/vbar is \
dimensionally consistent\>\"", ",", 
      RowBox[{"CompatibleUnitQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", "\"\<Kilograms\>\""}], "]"}], 
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{"1", "/", 
            RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}], 
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{
            RowBox[{"\"\<Meters\>\"", "^", "2"}], "/", "\"\<Seconds\>\""}]}], 
          "]"}], 
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{"\"\<Watts\>\"", "/", 
            RowBox[{"(", 
             RowBox[{"\"\<Meters\>\"", "\"\<Kelvins\>\""}], ")"}]}]}], "]"}], 
         "/", 
         RowBox[{"Quantity", "[", 
          RowBox[{"1", ",", 
           RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}]}], 
       "]"}], ",", "\"\<LHS has units kg/s^2, RHS kg/(s^2 K): a factor T is \
missing on the right.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (56)\>\"", 
      ",", "\"\<value of the conversion (with kappa from the kinetic \
identification)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"lhs56", "-", 
             RowBox[{"rhs56", "Tk"}]}], ")"}], "/.", 
           RowBox[{"kap", "->", "kapOfNu"}]}], "/.", 
          RowBox[{"hh", "->", 
           RowBox[{"mm", "/", 
            RowBox[{"(", 
             RowBox[{"2", "kB", "Tk"}], ")"}]}]}]}], ",", 
         RowBox[{"kinAssume", "&&", 
          RowBox[{"kB", ">", "0"}], "&&", 
          RowBox[{"Tk", ">", "0"}]}]}], "]"}], "]"}], 
      ",", "\"\<Kinetic identification: 2 Sqrt[pi] m N nu/Sqrt[h] = eta kappa \
T/vbar. The printed form has pi instead of Sqrt[pi] and lacks the factor T.\>\
\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (56), corrected\>\"", 
      ",", "\"\<2 Sqrt[pi] m N nu/Sqrt[h] = eta kappa T/vbar holds \
exactly\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             RowBox[{"Sqrt", "[", "Pi", "]"}], "mm", "nn", 
             RowBox[{"nuG", "/", 
              RowBox[{"Sqrt", "[", "hh", "]"}]}]}], "-", 
            RowBox[{"rhs56", "Tk"}]}], ")"}], "/.", 
          RowBox[{"kap", "->", "kapOfNu"}]}], "/.", 
         RowBox[{"hh", "->", 
          RowBox[{"mm", "/", 
           RowBox[{"(", 
            RowBox[{"2", "kB", "Tk"}], ")"}]}]}]}], "]"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (56)\>\"", 
      ",", "\"\<free-molecule limit eta = 16 Sqrt[pi]/15 = 1.89 \
(Waldmann)\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"N", "[", "eta56", "]"}], "-", "1.89"}], "]"}], "<", 
       "0.005"}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"409ae504-ad7d-4255-be7f-4799d1c26afe"],

Cell[BoxData[
 TemplateBox[{"\"sphere force in G-Y variables:  F_o = \"", 
   TagBox[
    FormBox[
     FractionBox[
      RowBox[{"2", " ", 
        SqrtBox["\[Pi]"], " ", "mm", " ", "nn", " ", "nuG", " ", 
        SuperscriptBox["rC", "2"], " ", "tau"}], 
      SqrtBox["hh"]], TraditionalForm], TraditionalForm, Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"6e545777-5160-41f9-9f2a-\
1bbb1cca812f"]
}, Open  ]],

