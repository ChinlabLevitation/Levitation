Cell[TextData[{
 "DOF: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "2", " ", "+", " ", "2", " ", "+", " ", "0", " ", "+", " ", "2", " ", "=", 
    " ", "6"}], TraditionalForm]],ExpressionUUID->
  "b09fd2e7-5fe4-4654-bb07-1d6bc155eea4"],
 ". Bodies: cylinders, spheroids."
}], "Text",ExpressionUUID->"8f0375d7-6ca2-40d1-89a5-db4844b83929"],

Cell[TextData[{
 StyleBox["Level 3b \[LongDash] Sphere, SO(3) symmetry (3 DOF).",
  FontWeight->"Bold"],
 " Full isotropy collapses every tensor to a scalar multiple of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "0ae7f27e-1ff1-4b90-9b3a-f97aecbb78f6"],
 ":"
}], "Text",ExpressionUUID->"a7dc8f1a-df42-4288-b5c9-708c92acf22c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["f", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["d", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["r", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "0", " ", ",", " ", "\:2003", " ", 
   SubscriptBox["I", "1"], " ", "=", " ", 
   SubscriptBox["I", "2"], " ", "=", " ", 
   SubscriptBox["I", "3"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(30)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"ee2755b6-3198-4174-a4f9-ae82e28dabaa"],

Cell[TextData[{
 "DOF: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "1", " ", "+", " ", "1", " ", "+", " ", "0", " ", "+", " ", "1", " ", "=", 
    " ", "3"}], TraditionalForm]],ExpressionUUID->
  "479cd780-f7a9-45df-80c7-2abf4d026b11"],
 ". The gyroscopic term vanishes, the rotational equation decouples from \
translation, and the thermophoretic force reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "-", 
    SubscriptBox["f", "0"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "977e5a1f-a58a-4894-9163-048f962cfa8d"],
 ", consistent with Waldmann's free-molecule result."
}], "Text",ExpressionUUID->"e5ee40d4-bccb-4a7b-98a7-624a62a57083"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"Body", 
    FormBox[
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold"], 
      StyleBox["th",
       FontSlant->"Plain"]],
     TraditionalForm], 
    FormBox[
     SubscriptBox[
      StyleBox["f",
       FontWeight->"Bold"], 
      StyleBox["drag",
       FontSlant->"Plain"]],
     TraditionalForm], 
    FormBox[
     SubscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      StyleBox["th",
       FontSlant->"Plain"]],
     TraditionalForm], 
    FormBox[
     SubscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      StyleBox["drag",
       FontSlant->"Plain"]],
     TraditionalForm], "Total"},
   {
    RowBox[{"Generic", " ", "asymmetric"}], "6", "6", "9", "6", "27"},
   {
    RowBox[{"Three", " ", "mirror", " ", "planes"}], "3", "3", "0", "3", 
    "9"},
   {
    RowBox[{
     RowBox[{"Uniaxial", " ", "("}], 
     FormBox[
      SubscriptBox["C", 
       RowBox[{"\[Infinity]", " ", "v"}]],
      TraditionalForm], ")"}], "2", "2", "0", "2", "6"},
   {
    RowBox[{"Sphere", " ", 
     RowBox[{"(", 
      RowBox[{"SO", 
       RowBox[{"(", "3", ")"}]}], ")"}]}], "1", "1", "0", "1", "3"}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxBackground->{"Rows" -> {
      RGBColor[0.9, 0.93, 0.97], None}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}]],
 FontFamily->
  "Source Sans Pro",ExpressionUUID->"7b75c9eb-1888-4a8a-8d0d-db8434f99a38"]], \
"Text",ExpressionUUID->"70d94ec9-825e-4bce-96bf-186a514c6e5f"],

Cell[TextData[{
 StyleBox["Table 1: Degrees of freedom by symmetry class (excluding the \
inertia tensor).",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "fe05c367-e407-41f7-9a4d-e4d806215d40"],
 " counts 9 DOF when non-zero since no symmetry argument forces it to be \
symmetric.*"
}], "Text",ExpressionUUID->"bdbc44ed-746a-43dd-8cf1-2922388f46cd"],

Cell[TextData[{
 StyleBox["Verification of Section 1.7 by group theory.",
  FontWeight->"Bold"],
 " For each point group we solve the invariance conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", " ", "=", " ", "g", "X", 
    SuperscriptBox["g", "\[Transpose]"]}], TraditionalForm]],ExpressionUUID->
  "760b4012-a3a6-4f3f-95d3-e7b231466d23"],
 " for the true tensors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e0fd68e8-06be-4f37-96b8-1d8d5ef50864"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "1ca5237e-b823-4b46-9abb-46571e76b97a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4245820f-8904-4586-9745-105c7be9b7d5"],
 " (taken symmetric, as in the notes) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", " ", "=", " ", 
    StyleBox["det",
     FontSlant->"Plain"], "(", "g", ")", "\[ThinSpace]", "g", "X", 
    SuperscriptBox["g", "\[Transpose]"]}], TraditionalForm]],ExpressionUUID->
  "28cbacb7-887f-440f-9fde-7b527466bf9a"],
 " for the pseudotensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b84c983d-7495-4a4e-9b6e-8fb9ff72a159"],
 ", over the group generators. A ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "7"], TraditionalForm]],ExpressionUUID->
  "8ae4fde4-1bd8-49c7-aeec-c62edb3210de"],
 " rotation represents the continuous axial groups exactly for rank-2 \
tensors. Two groups are added that the notes do not list: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"\[Infinity]", " ", "h"}]], TraditionalForm]],ExpressionUUID->
  "520c5722-fdc4-48f5-ab11-e18cc2de504a"],
 ", the true symmetry of cylinders and spheroids (an axis plus a mirror plane \
perpendicular to it), and the chiral groups ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", "\[Infinity]"], TraditionalForm]],ExpressionUUID->
  "3f505f66-589a-40ba-9278-0d60642f7c08"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "\[Infinity]"], TraditionalForm]],ExpressionUUID->
  "45bc96c0-e69e-45ff-ad7e-42a81b629e29"],
 ". The last column checks whether a general (non-symmetric) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ef7c1765-9a40-42a0-b0f9-e9415559adbd"],
 " acquires extra DOF."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"a890aed6-75bd-4474-9631-1b577678375b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rotZ", "=", 
   RowBox[{"RotationMatrix", "[", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"Pi", "/", "7"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"rotX", "=", 
   RowBox[{"RotationMatrix", "[", 
    RowBox[{
     RowBox[{"2", 
      RowBox[{"Pi", "/", "7"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c2x", "=", 
   RowBox[{"RotationMatrix", "[", 
    RowBox[{"Pi", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<C1 (generic asymmetric)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "}"}]}], ",", 
     RowBox[{"\"\<D2h (three mirror planes)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Dinfh (cylinder, spheroid)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"rotZ", ",", 
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Cinfv (cone: axis + containing mirrors)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"rotZ", ",", 
        RowBox[{"mirror", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"\"\<Dinf (helix-like, chiral)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"rotZ", ",", "c2x"}], "}"}]}], ",", 
     RowBox[{"\"\<Cinf (propeller, chiral polar)\>\"", "->", 
      RowBox[{"{", "rotZ", "}"}]}], ",", 
     RowBox[{"\"\<O(3) (sphere)\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"rotZ", ",", "rotX", ",", 
        RowBox[{"-", 
         RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dof", "[", 
    RowBox[{"gens_", ",", "symQ_", ",", "pseudoQ_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "=", 
        RowBox[{"If", "[", 
         RowBox[{"symQ", ",", 
          RowBox[{"symMat", "[", "y", "]"}], ",", 
          RowBox[{"genMat", "[", "y", "]"}]}], "]"}]}], ",", "vars", ",", 
       "eqs", ",", "cm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"Variables", "[", "X", "]"}]}], ";", 
      RowBox[{"eqs", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"X", "-", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"pseudoQ", ",", 
              RowBox[{"Det", "[", "gm", "]"}], ",", "1"}], "]"}], 
            RowBox[{"gm", ".", "X", ".", 
             RowBox[{"Transpose", "[", "gm", "]"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"gm", ",", "gens"}], "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"eqs", ",", "PossibleZeroQ"}], "]"}], ",", 
        RowBox[{"Length", "[", "vars", "]"}], ",", 
        RowBox[{
         RowBox[{"cm", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{
             RowBox[{"CoefficientArrays", "[", 
              RowBox[{"eqs", ",", "vars"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"Length", "[", "vars", "]"}], "-", 
          RowBox[{"MatrixRank", "[", 
           RowBox[{"cm", ",", 
            RowBox[{"Tolerance", "->", 
             RowBox[{"10", "^", 
              RowBox[{"-", "9"}]}]}]}], "]"}]}]}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"symTab", "=", 
   RowBox[{"KeyValueMap", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"name", ",", "gens"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"name", ",", 
         RowBox[{"dof", "[", 
          RowBox[{"gens", ",", "True", ",", "False"}], "]"}], ",", 
         RowBox[{"dof", "[", 
          RowBox[{"gens", ",", "True", ",", "False"}], "]"}], ",", 
         RowBox[{"dof", "[", 
          RowBox[{"gens", ",", "False", ",", "True"}], "]"}], ",", 
         RowBox[{"dof", "[", 
          RowBox[{"gens", ",", "True", ",", "False"}], "]"}], ",", 
         RowBox[{
          RowBox[{"dof", "[", 
           RowBox[{"gens", ",", "True", ",", "False"}], "]"}], "+", 
          RowBox[{"dof", "[", 
           RowBox[{"gens", ",", "True", ",", "False"}], "]"}], "+", 
          RowBox[{"dof", "[", 
           RowBox[{"gens", ",", "False", ",", "True"}], "]"}], "+", 
          RowBox[{"dof", "[", 
           RowBox[{"gens", ",", "True", ",", "False"}], "]"}]}], ",", 
         RowBox[{"dof", "[", 
          RowBox[{"gens", ",", "False", ",", "False"}], "]"}]}], "}"}]}], 
      "]"}], ",", "groups"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{"symTab", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{"\"\<group\>\"", ",", "\"\<f_th (sym)\>\"", 
        ",", "\"\<f_drag\>\"", ",", "\"\<T_th\>\"", ",", "\"\<T_drag\>\"", 
        ",", "\"\<total\>\"", ",", "\"\<f_th if not assumed symmetric\>\""}], 
       "}"}]}]}], "]"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Background", "->", 
