   None, None}},ExpressionUUID->"07848859-5785-416b-80f4-a72ac706de03"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d3a250aa-339a-41ce-9fdd-3a83356504c6"],
 " is symmetric positive-definite (6 DOF) by the same dissipation argument as \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "362907cf-9a05-4add-80f1-073473a40508"],
 "."
}], "Text",ExpressionUUID->"44ff4d6f-118c-40bd-90d6-41536adb3b83"],

Cell[TextData[{
 StyleBox["Verification of \"",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox[
      StyleBox["T",
       FontWeight->"Bold"], 
      StyleBox["th",
       FontSlant->"Plain"]], "=", "0"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "4991eb30-b029-4447-ba2e-99935e9c9102"],
 StyleBox[" for three mirror planes\".",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f977e10f-efcd-4d6e-8868-56caa1fc9f2a"],
 " maps a polar vector (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "4832ba4d-5beb-4c47-b1de-213476b9c0ba"],
 ") to an axial vector (torque), so it transforms as a pseudotensor, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T",
     FontWeight->"Bold"], "\[RightArrow]", 
    StyleBox["det",
     FontSlant->"Plain"], "(", "g", ")", "\[ThinSpace]", "g", 
    StyleBox["T",
     FontWeight->"Bold"], 
    SuperscriptBox["g", "\[Transpose]"]}], TraditionalForm]],ExpressionUUID->
  "0b851daa-d94c-4ff3-bad4-309793309a98"],
 ". Invariance under the three reflections ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[RightArrow]", "-", "x"}], TraditionalForm]],ExpressionUUID->
  "a1d94847-7a2f-4556-b1dd-2dace7050156"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "\[RightArrow]", "-", "y"}], TraditionalForm]],ExpressionUUID->
  "dbdf73a4-e9fc-4199-946c-a19b31169e93"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "\[RightArrow]", "-", "z"}], TraditionalForm]],ExpressionUUID->
  "423db6b3-6572-4555-b45c-e4d6b13b4f20"],
 " forces every entry to vanish. (Section 1.7 repeats this analysis for every \
symmetry class.)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"c2369ad8-a948-4482-94e4-d4d19706b0f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mirror", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"IdentityMatrix", "[", "3", "]"}], "-", 
    RowBox[{"2", 
     RowBox[{
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "n", ",", "n"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"n", ".", "n"}], ")"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pseudoInvariantSolution", "[", "gens_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "=", 
        RowBox[{"genMat", "[", "t", "]"}]}], ",", "eqs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"eqs", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"X", "-", 
           RowBox[{
            RowBox[{"Det", "[", "gm", "]"}], 
            RowBox[{"gm", ".", "X", ".", 
             RowBox[{"Transpose", "[", "gm", "]"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"gm", ",", "gens"}], "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"X", "/.", 
       RowBox[{"First", "@", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"eqs", "==", "0"}], "]"}], ",", 
          RowBox[{"Flatten", "[", "X", "]"}]}], "]"}]}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"TthD2h", "=", 
   RowBox[{"pseudoInvariantSolution", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mirror", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], "]"}], ",", 
      RowBox[{"mirror", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}], ",", 
      RowBox[{"mirror", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"verify", "[", 
  RowBox[{"\"\<Sec. 1.2\>\"", 
   ",", "\"\<three mutually perpendicular mirror planes force T_th = 0\>\"", ",", 
   RowBox[{"TthD2h", "===", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}]}], "]"}]}], "Input",Expressio\
nUUID->"384fcbb9-7540-442f-a7c2-55a08ee7390b"],

