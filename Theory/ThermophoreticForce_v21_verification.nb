Cell[TextData[{
 StyleBox["Summary of the stability verification.",
  FontWeight->"Bold"],
 " The table in the notes (and the statement that follows it) is correct for \
the physically common case of a positive-definite ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "1c35eebb-72ec-4e51-84d7-980a39917f4a"],
 ". The rate formula (41), the sentence concluding that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "7131f4c6-6118-4145-a640-3d627852b811"],
 " is the attractor, and the extension to spectra of arbitrary sign are not."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"0709080a-6a98-4dee-95f8-6fc862295af3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Translational dynamics and general steady motion", "Subsection",ExpressionUUID->"9fb6f1dc-dc07-4678-90d4-c6f89cd22d83"],

Cell[TextData[{
 "Once the angular velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], TraditionalForm]],ExpressionUUID->
  "a77225ef-2a39-45c7-beb3-ac0a76c71efd"],
 " is determined from the rotational steady state (Section 2.2), the \
translational equation (13) in the body frame at steady state (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "."], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"1c8a4fbb-5599-4127-bbaa-8d8480f5a0a2"],
 ") becomes, using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "51ace620-7663-46c3-8a4d-0d78cf548097"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "a6f1ef82-540e-47a9-909f-4b33c6cb8bb0"],
 ":"
}], "Text",ExpressionUUID->"bcb5365c-102c-44ed-abdf-01ff4b36d38a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], 
   SuperscriptBox[
    StyleBox["v",
     FontWeight->"Bold"], "b"], " ", "=", " ", "G", "\[ThinSpace]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "-", " ", "M", "g", "\[ThinSpace]", 
   StyleBox["u",
    FontWeight->"Bold"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(42)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"d27ee114-f4ec-4a04-aaa9-08085b1bb150"],

Cell[TextData[{
 "Expanding with Eq. (34), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
     "\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "bc84b395-b8c6-4d92-a372-a84bff1fcdc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubscriptBox["\[Xi]", "0"], 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
     "\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "282045dc-14c3-4268-826a-884238f113bb"],
 ":"
}], "Text",ExpressionUUID->"2f0859de-38cc-4fa4-9c9c-58eb22594a20"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Xi]", "0"], 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Gamma]", "0"], "G"}], " ", "-", " ", 
       RowBox[{"M", "g"}]}], ")"}], 
     StyleBox["u",
      FontWeight->"Bold"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]", "[", 
      RowBox[{
       RowBox[{"G", "\[ThinSpace]", "\[Delta]", 
        SubscriptBox[
         StyleBox["f",
          FontWeight->"Bold"], 
         StyleBox["th",
          FontSlant->"Plain"]]}], " ", "-", " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["\[Gamma]", "0"], "G", " ", "-", " ", "M", "g"}], 
         SubscriptBox["\[Xi]", "0"]], "\[Delta]", 
        SubscriptBox[
         StyleBox["f",
          FontWeight->"Bold"], 
         StyleBox["drag",
          FontSlant->"Plain"]]}]}], "]"}], 
     RowBox[{
      StyleBox["u",
       FontWeight->"Bold"], " ", "."}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(43)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"dd21c4a2-0122-404d-b571-22e8814ea562"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dfth", "=", 
   RowBox[{"symMat", "[", "df", "]"}]}], ";", 
  RowBox[{"dfdr", "=", 
   RowBox[{"symMat", "[", "dd", "]"}]}], ";", 
  RowBox[{"uvec", "=", 
   RowBox[{"{", 
    RowBox[{"ua", ",", "ub", ",", "uc"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vb42", "=", 
   RowBox[{
    RowBox[{"Inverse", "[", 
     RowBox[{
      RowBox[{"xi0", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
      RowBox[{"eps", "dfdr"}]}], "]"}], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"G", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"gam0", 
          RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
         RowBox[{"eps", "dfth"}]}], ")"}]}], "-", 
      RowBox[{"Mm", "gg", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], ")"}], ".", "uvec"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"vb43", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"gam0", "G"}], "-", 
         RowBox[{"Mm", "gg"}]}], ")"}], "uvec"}], "+", 
      RowBox[{"eps", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"G", "dfth"}], "-", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"gam0", "G"}], "-", 
              RowBox[{"Mm", "gg"}]}], ")"}], "/", "xi0"}], "dfdr"}]}], ")"}], 
        ".", "uvec"}]}]}], ")"}], "/", "xi0"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (42)\>\"", 
      ",", "\"\<steady state of (13) with dv/dt = 0 gives f_drag v^b = G f_th \
u - M g u\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vbS", "=", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], ",", 
          RowBox[{"uq", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "Rq", "]"}], ".", "Zhat"}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", "Rq", "]"}], ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "Mm"}], "gg", "Zhat"}], "-", 
               RowBox[{"Rq", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"fth", ".", 
                   RowBox[{"Transpose", "[", "Rq", "]"}], ".", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "G"}], "Zhat"}], ")"}]}], "+", 
                  RowBox[{"fdr", ".", "vbS"}]}], ")"}]}]}], ")"}]}], "-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"G", 
               RowBox[{"fth", ".", "uq"}]}], "-", 
              RowBox[{"Mm", "gg", "uq"}], "-", 
              RowBox[{"fdr", ".", "vbS"}]}], ")"}]}], ",", "unit"}], "]"}], "===", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (43)\>\"", 
      ",", "\"\<first-order expansion of f_drag^{-1}(G f_th - M g) u\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{"vb42", ",", 
           RowBox[{"{", 
            RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "-", 
        "vb43"}], "]"}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"a21ad472-627f-4bf6-91fb-e059859ed899"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
