Cell[TextData[{
 StyleBox["Waldmann consistency of (30).",
  FontWeight->"Bold"],
 " For a sphere the notes' Section 6 gives Waldmann's force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "T"], " ", "=", " ", "\[Eta]", "(", "\[Kappa]", "/", 
    OverscriptBox["v", "_"], ")", 
    SuperscriptBox["\[ScriptL]", "2"], "|", "\[Del]", " ", "T", "|"}], 
   TraditionalForm]],ExpressionUUID->"08f41638-8f1f-4143-aabe-3ce8ed134766"],
 ". Writing it as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["f", "0"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "766851a0-e5cb-427d-81a6-3f6cebd32ce7"],
 " requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "0"], " ", "=", " ", "\[Eta]", "\[Kappa]", 
    SuperscriptBox["\[ScriptL]", "2"], "T", "/", 
    OverscriptBox["v", "_"]}], TraditionalForm]],ExpressionUUID->
  "8eef3096-a536-4b5e-8ad4-97ca4099eafe"],
 ". This factor of ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "df5ba152-201f-472d-b96c-c6d807586124"],
 " matters for the definition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "0"], TraditionalForm]],ExpressionUUID->
  "db67a533-6f7c-4e24-bc87-7513e7496cc2"],
 " in Section 2.1."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"77d667f1-b5dc-43d3-8a03-7b3321e58351"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Near-sphere perturbation theory", "Section",ExpressionUUID->"7191e6e8-7027-4922-a1fe-54cb2046d532"],

Cell["\<\
The general equations of motion in Section 1 contain five tensors with up to \
24 independent parameters. For a particle that is nearly spherical, the \
deviation from sphere symmetry is small and the tensors can be expanded \
perturbatively. This approach gives analytical insight into how shape \
asymmetry couples translation to rotation, and predicts a distinctive helical \
trajectory that is absent for a perfect sphere.\
\>", "Text",ExpressionUUID->"8a3b34f7-cea8-4239-8f31-4046b56f859d"],

Cell[BoxData[
 RowBox[{"verify", "[", 
  RowBox[{"\"\<Sec. 2 intro\>\"", 
   ",", "\"\<'five tensors with up to 24 independent parameters'\>\"", ",", 
   "False", ",", "\"\<Section 1 has four tensors with 6 + 6 + 9 + 6 = 27 \
parameters (Table 1), or 33 including the inertia tensor. Five tensors / 24 \
parameters matches neither count.\>\""}], "]"}]], "Input",ExpressionUUID->\
"f79753ed-42e8-473c-ad55-43c6510f1522"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Sec. 2 intro",
  FontWeight->"Bold"],
 ":   ",
 "'five tensors with up to 24 independent parameters'",
 "\n",
 StyleBox["Section 1 has four tensors with 6 + 6 + 9 + 6 = 27 parameters \
(Table 1), or 33 including the inertia tensor. Five tensors / 24 parameters \
matches neither count.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"18b65d80-aeb6-4149-a631-15f45b0802ce"],

Cell[CellGroupData[{

Cell["2.1 Perturbative expansion of the tensors", "Subsection",ExpressionUUID->"08b342b0-c260-494d-9e06-412654cc58a4"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", " ", "\[LessLess]", " ", "1"}], 
   TraditionalForm]],ExpressionUUID->"a21cbde2-0233-4fe2-8a18-e510af4817a4"],
 " be a dimensionless measure of the deviation from spherical symmetry (e.g. \
the fractional difference between the longest and shortest semi-axes). We \
expand each tensor around its spherical value."
}], "Text",ExpressionUUID->"66a7a550-d178-42a4-944e-a4dfe39dcdd7"],

Cell[TextData[{
 StyleBox["Thermophoretic force tensor.",
  FontWeight->"Bold"],
 " For a sphere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "1f141286-0258-43cc-9f0c-ea8e304041d3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], " ", "=", " ", "\[Eta]", "(", "\[Kappa]", "/", 
    OverscriptBox["v", "_"], ")", 
    SuperscriptBox["\[ScriptL]", "2"]}], TraditionalForm]],ExpressionUUID->
  "9b628756-a68f-40ee-80a3-44c8c4c2365f"],
 ". A near-sphere breaks the three-fold degeneracy and, for a generic \
asymmetric shape, also introduces off-diagonal couplings. The full ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"fd462d96-f856-4a41-8339-e36d747d556a"],
 " expansion is therefore a complete symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "50b1c132-8684-4128-95df-1ebd75e49443"],
 " matrix:"
}], "Text",ExpressionUUID->"9c626c3c-5750-4120-b992-3e36a3bac750"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["\[Gamma]", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
    "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", ",", " ", "\:2003\:2003", " ", "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["\[Gamma]", "0"], 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["g", "11"], 
       SubscriptBox["g", "12"], 
       SubscriptBox["g", "13"]},
      {
       SubscriptBox["g", "12"], 
       SubscriptBox["g", "22"], 
       SubscriptBox["g", "23"]},
      {
       SubscriptBox["g", "13"], 
       SubscriptBox["g", "23"], 
       SubscriptBox["g", "33"]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox["g", "11"], " ", "+", " ", 
   SubscriptBox["g", "22"], " ", "+", " ", 
   SubscriptBox["g", "33"], " ", "=", " ", "0", " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(31)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"eb5a34c3-74dc-44cd-a6fe-80e0319d7135"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"i", "j"}]], " ", "=", " ", "O", "(", "1", ")"}], 
   TraditionalForm]],ExpressionUUID->"998a737e-ece6-478e-83d9-016a09e3c701"],
 ". Off-diagonal entries ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"i", "j"}]], TraditionalForm]],ExpressionUUID->
  "04ea65fb-5d9f-437e-99f5-0a8a8ee0c705"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", "\[NotEqual]", " ", "j"}], TraditionalForm]],
  ExpressionUUID->"429cb7bd-9278-4cf7-aaa6-88ed03539a59"],
 ") mean that a temperature gradient along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "j"], TraditionalForm]],ExpressionUUID->
  "6a8ea44b-2be9-4b05-b5cc-9e7c1be67abc"],
 " produces a thermophoretic force component along ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "i"], TraditionalForm]],ExpressionUUID->
  "dca0e174-7bda-458e-afb3-acc72dc40446"],
 ". Tracelessness follows because the sphere value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "0"], TraditionalForm]],ExpressionUUID->
  "8715d930-09cb-408a-b66d-ac4c5e49b3cb"],
 " accounts for the mean response."
}], "Text",ExpressionUUID->"3783db45-df01-410f-be2b-d52907b2e7db"],

Cell[TextData[{
 StyleBox["Verification of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["\[Gamma]", "0"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "a2cbbd36-c342-4006-8184-d136850bf0ef"],
 StyleBox[" by units.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ae0273a7-af88-4687-9795-ea8e1a453b70"],
 " multiplies ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "be40fe55-da0f-4fca-8c45-229444b48c1a"],
 " and must carry units of force times length (Eq. 11). The sphere value \
quoted, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "(", "\[Kappa]", "/", 
    OverscriptBox["v", "_"], ")", 
    SuperscriptBox["\[ScriptL]", "2"]}], TraditionalForm]],ExpressionUUID->
  "df6c84da-0b47-4d95-9ac3-2760c9eb5319"],
 ", has units J/K, which is off by one power of temperature. Waldmann's force \
(Eq. 58) is written with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T"}], TraditionalForm]],ExpressionUUID->
  "21e270b4-74c4-4102-8081-805d10f8b61c"],
 ", and converting it to a coefficient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "\[Del]", " ", "T", "/", 
    "T"}], TraditionalForm]],ExpressionUUID->
  "b85361d5-bc93-4053-a3db-b9475ee7152b"],
 " supplies the missing factor ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "dd0b5479-9234-4203-9b41-d40db4045a51"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"189ea9e9-7915-48be-827c-fbb2bad558a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"kappaQ", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"\"\<Watts\>\"", "/", 
      RowBox[{"(", 
       RowBox[{"\"\<Meters\>\"", "\"\<Kelvins\>\""}], ")"}]}]}], "]"}]}], ";", 
  RowBox[{"vbarQ", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";", 
  RowBox[{"ellQ", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", "\"\<Meters\>\""}], "]"}]}], ";", 
  RowBox[{"TQ", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", "\"\<Kelvins\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fthUnits", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"\"\<Newtons\>\"", "\"\<Meters\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (31)\>\"", 
      ",", "\"\<gamma_0 = eta (kappa/vbar) l^2 has the units of f_th (N \
m)\>\"", ",", 
      RowBox[{"CompatibleUnitQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"kappaQ", "/", "vbarQ"}], 
         RowBox[{"ellQ", "^", "2"}]}], ",", "fthUnits"}], "]"}], ",", 
      RowBox[{"\"\<Units of eta kappa l^2/vbar: \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"UnitSimplify", "[", 
         RowBox[{
          RowBox[{"kappaQ", "/", "vbarQ"}], 
          RowBox[{"ellQ", "^", "2"}]}], "]"}], "]"}], 
       "<>", "\"\<. Corrected: gamma_0 = eta kappa l^2 T / vbar, which is \
compatible: \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"CompatibleUnitQ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"kappaQ", "/", "vbarQ"}], 
           RowBox[{"ellQ", "^", "2"}], "TQ"}], ",", "fthUnits"}], "]"}], 
        "]"}], "<>", "\"\<.\>\""}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (31)\>\"", 
      ",", "\"\<tracelessness of delta f_th is a definition of gamma_0 (the \
mean response), not a consequence\>\"", ",", "\"\<\>\""}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"050073a4-1944-4a4b-b452-cb96d72316ec"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (31)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c0d935c0-9039-4714-9fdd-3f7dc66e64f2"],
 " = \[Eta] (\[Kappa]/vbar) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "2"], TraditionalForm]],ExpressionUUID->
  "99172755-d8da-4c25-bb7f-f61a6739f844"],
 " has the units of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d6acc8b2-d921-4dc6-a886-8206a0c41add"],
 " (N m)",
 "\n",
 StyleBox["Units of \[Eta] \[Kappa] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "2"], TraditionalForm]],ExpressionUUID->
  "fc8947c6-b397-4d28-b658-9295c2c06dcf"],
 StyleBox["/vbar: 1 joule per kelvin. Corrected: ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8b594587-1803-4cd8-804b-e90882d922ad"],
 StyleBox[" = \[Eta] \[Kappa] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["l", "2"], TraditionalForm]],ExpressionUUID->
  "863df0f7-69f0-4b57-9239-5574bbd33a52"],
 StyleBox[" T / vbar, which is compatible: True.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"4b24c0ef-60c9-451f-8db2-6bd904033ab6"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Eq. (31)",
  FontWeight->"Bold"],
 ":   ",
 "tracelessness of \[Delta] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "73532868-12c1-4281-b461-2dfe4c35310b"],
 " is a definition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "832e57e9-a37e-41ec-9592-d5831c5c81a2"],
 " (the mean response), not a consequence"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"bea6ad77-e995-4e70-9755-fd9a792ae7d0"],

Cell[TextData[{
 StyleBox["Resistance and rotational drag tensors.",
  FontWeight->"Bold"],
 " By the same argument, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "25b29da3-5773-40ca-8001-7611be5de2aa"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "396615af-b388-402d-9670-a51d1834b1ac"],
 " each acquire a full symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"70e72c1c-24f6-456c-b330-af454569feed"],
 " correction:"
}], "Text",ExpressionUUID->"d5e16d8d-10b2-4d7b-bc43-1146c618520d"],

