Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Sec. 5 (literature)",
  FontWeight->"Bold"],
 ":   ",
 "the kinetic stresses reproduce the Garcia-Ybarra & Rosner sphero-cylinder \
trends quoted by Zheng (+31%, about -6%, up to 12 deg)",
 "\n",
 StyleBox["For full accommodation the parallel speed-up reaches +31% at L/r \
of about 15 and tends to \[Pi]/8 = +39% for very long rods, the perpendicular \
slow-down is about 7-9%, and the maximum deviation tends to 12 deg. The \
review does not state the aspect ratio or accommodation behind its numbers, \
so this is a consistency check rather than an exact comparison.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"a3b81840-9ec4-42e4-ba69-5cf8f373ef64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Hierarchy of forces and torques for a levitating particle", "Section",ExpressionUUID->"86ef2abc-62f2-4bf9-a430-cd10956ffeca"],

Cell[TextData[{
 "We now estimate the magnitudes of all four responses \[LongDash] \
thermophoretic force, thermophoretic torque, gyrophoretic force, and \
rotational drag torque \[LongDash] for a particle levitated in our thermal \
cell. The system parameters are: particle radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", " ", "=", " ", "20", "\[ThinSpace]", "\[Mu]"}], 
   TraditionalForm]],ExpressionUUID->"81920412-f8f4-4c4d-a5da-cd754b5859f1"],
 "m, particle density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", " ", "=", " ", "1", "\[ThinSpace]", 
    StyleBox[
     RowBox[{"g", "/", 
      SuperscriptBox["cm", "3"]}],
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "a0b4a528-e7ff-46f3-91a5-13d3f385c196"],
 ", temperature gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Del]", " ", "T", "|", " ", "=", " ", "200"}], 
   TraditionalForm]],ExpressionUUID->"7a714087-76ac-4831-a904-9e7a3202cb4e"],
 " K/cm, gas pressure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " ", "=", " ", "5"}], TraditionalForm]],ExpressionUUID->
  "b54c9183-9817-4153-9b58-f0e634bb67b3"],
 " Torr, and temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", " ", "300"}], TraditionalForm]],ExpressionUUID->
  "506188b3-d9b8-44b2-8ffc-b930772c193e"],
 " K (rarefied air). The temperature gradient is directed downward (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T", " ", "=", " ", "-", "|", "\[Del]", " ", "T", "|", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "3ecda7e2-7267-4065-a2aa-c47feeefba82"],
 "), so the thermophoretic force on a sphere points upward (",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "d0c212ab-6c43-4110-a4c0-583c08495958"],
 ") and can balance gravity."
}], "Text",ExpressionUUID->"09de09cd-2c28-4809-825c-acc58830e7b5"],

Cell[TextData[{
 StyleBox["Gas and particle properties.",
  FontWeight->"Bold"],
 " The mean thermal speed of air molecules is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["v", "_"], " ", "=", " ", 
    SqrtBox[
     RowBox[{"2", 
      SubscriptBox["k", "B"], "T", "/", "m"}]], " ", "\[TildeTilde]", " ", 
    "415"}], TraditionalForm]],ExpressionUUID->
  "619e1af6-2bef-4b3e-88e5-c5e0298d54fa"],
 " m/s. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " ", "=", " ", "5"}], TraditionalForm]],ExpressionUUID->
  "856c151c-9272-4288-afeb-4f4402e9529f"],
 " Torr the mean free path is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Lambda]", " ", "\[TildeTilde]", " ", "10", "\[ThinSpace]", "\[Mu]"}], 
   TraditionalForm]],ExpressionUUID->"dd5814ec-7f83-4df0-8ae8-74c6c5beaa39"],
 "m, giving a Knudsen number"
}], "Text",ExpressionUUID->"26ef811a-d383-4b35-b4d3-ec013a22f5d0"],

Cell[BoxData[
 FormBox[
  RowBox[{
  "K", "n", " ", "=", " ", "\[Lambda]", "/", "\[ScriptL]", " ", "\[TildeTilde]",
    " ", "0.5", " ", ","}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(57)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"378ced58-d2ba-4723-a10c-179f17640fd4"],

Cell[TextData[{
 "placing the particle firmly in the transition regime between continuum and \
free-molecule flow. The particle mass is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", " ", "=", " ", 
    FractionBox["4", "3"], "\[Pi]", 
    SuperscriptBox["\[ScriptL]", "3"], "\[Rho]", " ", "\[TildeTilde]", " ", 
    "3.4", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "11"}]]}], TraditionalForm]],ExpressionUUID->
  "70610122-6e35-47ec-85e6-2d7c6b90319f"],
 " kg."
}], "Text",ExpressionUUID->"f37eeda2-0aa0-4fc7-bddb-32be54319592"],

Cell[TextData[{
 StyleBox["Verification of the parameters.",
  FontWeight->"Bold"],
 " We recompute every number with physical units. The molecular mass of air (",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " ", "=", " ", "4.81", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "26"}]]}], TraditionalForm]],ExpressionUUID->
  "231cd99c-307e-48a0-8dab-eedd2e0d9045"],
 " kg, as in the lab's legacy code) and the viscosity of air at 300 K (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Mu]", " ", "=", " ", "1.85", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], TraditionalForm]],ExpressionUUID->
  "a9646617-b8bf-4b24-915a-891971c6e1eb"],
 " Pa s) are the only inputs not stated in the notes. The mean free path uses \
the standard hard-sphere relation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", " ", "=", " ", "(", "\[Mu]", "/", "P", ")", 
    SqrtBox[
     RowBox[{"\[Pi]", " ", 
      SubscriptBox["k", "B"], "T", "/", "2", "m"}]]}], TraditionalForm]],
  ExpressionUUID->"52ea9988-fed5-40a7-9df8-e5f8fc74b2cb"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"e1223d92-7862-429d-ab34-d7ec9fb95e93"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kBq", "=", 
   RowBox[{"Quantity", "[", "\"\<BoltzmannConstant\>\"", "]"}]}], ";", 
  RowBox[{"mAir", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"4.81*^-26", ",", "\"\<Kilograms\>\""}], "]"}]}], ";", 
  RowBox[{"Tq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"300.", ",", "\"\<Kelvins\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"5.", ",", "\"\<Torr\>\""}], "]"}]}], ";", 
  RowBox[{"ellq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"20.", ",", "\"\<Micrometers\>\""}], "]"}]}], ";", 
  RowBox[{"rhoq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1.", ",", 
     RowBox[{"\"\<Grams\>\"", "/", 
      RowBox[{"\"\<Centimeters\>\"", "^", "3"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gradTq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"200.", ",", 
     RowBox[{"\"\<Kelvins\>\"", "/", "\"\<Centimeters\>\""}]}], "]"}]}], ";", 
  
  RowBox[{"kappaq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"0.026", ",", 
     RowBox[{"\"\<Watts\>\"", "/", 
      RowBox[{"(", 
       RowBox[{"\"\<Meters\>\"", "\"\<Kelvins\>\""}], ")"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"9.81", ",", 
     RowBox[{"\"\<Meters\>\"", "/", 
      RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "]"}]}], ";", 
  RowBox[{"muq", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1.85*^-5", ",", 
     RowBox[{"\"\<Pascals\>\"", "\"\<Seconds\>\""}]}], "]"}]}], ";", 
  RowBox[{"eta", "=", 
   RowBox[{"16", 
    RowBox[{
     RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "15"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vbar", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "kBq", 
       RowBox[{"Tq", "/", "mAir"}]}], "]"}], ",", 
     RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lam", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"muq", "/", "Pq"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Pi", "kBq", 
        RowBox[{"Tq", "/", 
         RowBox[{"(", 
          RowBox[{"2", "mAir"}], ")"}]}]}], "]"}]}], 
     ",", "\"\<Micrometers\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Kn", "=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"lam", "/", "ellq"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Mp", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"4", "/", "3"}], "Pi", 
      RowBox[{"ellq", "^", "3"}], "rhoq"}], ",", "\"\<Kilograms\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"close", "[", 
    RowBox[{"x_", ",", "target_", ",", "tol_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"QuantityMagnitude", "[", "x", "]"}], "/", "target"}], "-", 
      "1"}], "]"}], "<", "tol"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<vbar\>\"", ",", "vbar"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<lambda\>\"", ",", "lam"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Kn\>\"", ",", "Kn"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<M\>\"", ",", "Mp"}], "}"}]}], "}"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6\>\"", ",", "\"\<vbar = Sqrt[2 k_B T/m] = 415 m/s\>\"",
       ",", 
      RowBox[{"close", "[", 
       RowBox[{"vbar", ",", "415", ",", "0.01"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (57)\>\"", 
      ",", "\"\<lambda of about 10 um and Kn of about 0.5 at 5 Torr\>\"", ",", 
      RowBox[{
       RowBox[{"close", "[", 
        RowBox[{"lam", ",", "10", ",", "0.1"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Kn", "-", "0.5"}], "]"}], "<", "0.05"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 6\>\"", 
      ",", "\"\<M = (4/3) pi l^3 rho = 3.4e-11 kg\>\"", ",", 
      RowBox[{"close", "[", 
       RowBox[{"Mp", ",", "3.4*^-11", ",", "0.02"}], "]"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"140f16d0-5602-42ec-9cf1-bde08b10b346"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"vbar\"\>", 
     TemplateBox[{"414.9967812915281`", 
       RowBox[{
        "\"m\"", "\[InvisibleSpace]", "\"/\"", "\[InvisibleSpace]", "\"s\""}],
        "meters per second", 
       FractionBox["\"Meters\"", "\"Seconds\""]},
      "Quantity"]},
    {"\<\"lambda\"\>", 
     TemplateBox[{
      "10.206771045819591`", "\"\[Mu]m\"", "micrometers", "\"Micrometers\""},
      "Quantity"]},
    {"\<\"Kn\"\>", "0.5103385522909796`"},
    {"\<\"M\"\>", 
     TemplateBox[{
      "3.351032163829113`*^-11", "\"kg\"", "kilograms", "\"Kilograms\""},
      "Quantity"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"326ee936-9f5d-43d9-a5de-d317acc9eedb"]
}, Open  ]],

