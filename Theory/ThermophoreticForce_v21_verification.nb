Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (21)",
  FontWeight->"Bold"],
 ":   ",
 "dq/dt = Q(q) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "929ba50e-4b59-4577-82ee-afa404ebdeaa"],
 " / 2 implies dR/dt = R hat(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "99fb5b4b-2bc3-4fc5-a5e6-9548052d7016"],
 "), i.e. reproduces (14)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
