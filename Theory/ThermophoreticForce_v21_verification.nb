Cell[CellGroupData[{

Cell["1.4 Equations of motion", "Subsection",ExpressionUUID->"7b8c06a6-f3e2-40e9-be94-3bb33e309184"],

Cell[TextData[{
 "Substituting the forces (8) and torques (9) into Newton's second law and \
Euler's equation, and expressing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", ")"}], "b"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "c2bb70a3-c090-44d2-acc5-da54bf911d10"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    StyleBox["v",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "e8789a3b-c207-4436-bf53-44990514e4ea"],
 ", the complete equations of motion for the state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    StyleBox["x",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["v",
     FontWeight->"Bold"], ",", " ", "R", ",", " ", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ")"}], TraditionalForm]],ExpressionUUID->
  "a18de29d-88a8-46ba-acfa-bf35fa41d277"],
 " are:"
}], "Text",ExpressionUUID->"4c994c28-aba1-4dbf-943a-1363deb1118d"],

