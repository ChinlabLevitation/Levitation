    RowBox[{
     RowBox[{"Thermophoretic", " ", "force", " "}], 
     FormBox[
      SubscriptBox["F", "T"],
      TraditionalForm]}], 
    FormBox[
     RowBox[{"\[CapitalGamma]", "|", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", "|"}],
     TraditionalForm], 
