Notebook[{

Cell[CellGroupData[{
Cell["Notes on Thermophoretic Force: a Mathematica verification", "Title",ExpressionUUID->"0b5d95aa-195d-4388-b582-e93b390b6c75"],

Cell["\<\
Reproduction and check of C. Chin, \"Notes on Thermophoretic Force\" \
(ThermophoreticForce_v21.pdf, February 2026)\
\>", "Subtitle",ExpressionUUID->"20bcd434-61af-4766-9b32-8a58db1e3699"],

Cell[TextData[{
 "This notebook reproduces the notes section by section: the text, the \
equations with their original numbers, and the tables. After each claim that \
can be checked, a shaded ",
 StyleBox["Verification",
  FontWeight->"Bold"],
 " block tests it with symbolic algebra, numerical integration, unit analysis \
or an independent kinetic-theory derivation. Every test ends in a badge:"
}], "Text",ExpressionUUID->"e2c5194d-3bca-481f-9a72-fb25a6f5ea4a"],

Cell[TextData[{
 StyleBox["VERIFIED",
  FontWeight->"Bold"],
 " means the statement in the notes holds as written. ",
 StyleBox["DISCREPANCY",
  FontWeight->"Bold"],
 " means it does not, and the block shows the corrected form. ",
 StyleBox["NOTE",
  FontWeight->"Bold"],
 " marks a remark that is not a pass/fail test, such as a hidden assumption \
or a range of validity. Section 7 collects every result in one table."
}], "Text",ExpressionUUID->"fe4c5df3-d224-4a8a-b2aa-e0b5da0d5026"],

Cell["\<\
The text in the unshaded cells follows the original notes. Text in shaded \
cells, and all code, belongs to the verification. Equation numbers in the \
right margin are those of the PDF.\
\>", "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.35, 0.55, 0.85],
 Background->RGBColor[
  0.96, 0.97, 1.],ExpressionUUID->"ca5ee0a3-f530-411f-a636-c33f11426edf"],

Cell[CellGroupData[{

Cell["0. Verification toolkit", "Section",ExpressionUUID->"b1096dfc-e176-4bb0-baf1-89e3711065f8"],

Cell["\<\
Helper definitions used throughout: the hat (skew) map, the quaternion \
rotation matrix and kinematic matrix of Section 1.5, symmetry-group \
generators, and the bookkeeping for verification results.\
\>", "Text",ExpressionUUID->"9ae357c5-cf57-4167-92fd-aae9d7725cd1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$verifications", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"badge", "[", "status_", "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{"status", ",", "\"\<VERIFIED\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<\[Checkmark] VERIFIED\>\"", ",", "Bold", ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.1", ",", "0.5", ",", "0.15"}], "]"}]}], "]"}], 
     ",", "\"\<DISCREPANCY\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<\[WarningSign] DISCREPANCY\>\"", ",", "Bold", ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.75", ",", "0.1", ",", "0.1"}], "]"}]}], "]"}], 
     ",", "\"\<NOTE\>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<\[FilledCircle] NOTE\>\"", ",", "Bold", ",", 
       RowBox[{"RGBColor", "[", 
        RowBox[{"0.15", ",", "0.35", ",", "0.75"}], "]"}]}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"record", "[", 
    RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"$verifications", ",", 
       RowBox[{"{", 
        RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "}"}]}], 
      "]"}], ";", 
     RowBox[{"VR", "[", 
      RowBox[{"ref", ",", "claim", ",", "status", ",", "detail"}], "]"}]}], 
    ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VR", "/:", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"VR", "[", 
      RowBox[{"ref_", ",", "claim_", ",", "status_", ",", "detail_"}], "]"}], 
     ",", "fmt_"}], "]"}], ":=", 
   RowBox[{"ToBoxes", "[", 
    RowBox[{
     RowBox[{"Panel", "[", 
      RowBox[{
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"badge", "[", "status", "]"}], ",", "\"\<    \>\"", ",", 
              RowBox[{"Style", "[", 
               RowBox[{"ref", ",", "Bold"}], "]"}], ",", "\"\<:   \>\"", ",", 
              "claim"}], "}"}], "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"detail", "===", "\"\<\>\""}], ",", "Nothing", ",", 
             RowBox[{"Style", "[", 
              RowBox[{"detail", ",", "11", ",", 
               RowBox[{"GrayLevel", "[", "0.25", "]"}]}], "]"}]}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"Spacings", "->", "0.6"}]}], "]"}], ",", 
       RowBox[{"Background", "->", 
        RowBox[{"Switch", "[", 
         RowBox[{"status", ",", "\"\<VERIFIED\>\"", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.92", ",", "0.97", ",", "0.92"}], "]"}], 
          ",", "\"\<DISCREPANCY\>\"", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.99", ",", "0.92", ",", "0.92"}], "]"}], ",", "_", ",", 
          RowBox[{"RGBColor", "[", 
           RowBox[{"0.92", ",", "0.94", ",", "0.99"}], "]"}]}], "]"}]}], ",", 
       
       RowBox[{"FrameMargins", "->", "10"}], ",", 
       RowBox[{"ImageSize", "->", "Full"}]}], "]"}], ",", "fmt"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"verify", "[", 
    RowBox[{"ref_String", ",", "claim_String", ",", "test_", ",", 
     RowBox[{"detail_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"record", "[", 
    RowBox[{"ref", ",", "claim", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "test", "]"}], ",", "\"\<VERIFIED\>\"", 
       ",", "\"\<DISCREPANCY\>\""}], "]"}], ",", "detail"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"note", "[", 
    RowBox[{"ref_String", ",", "claim_String", ",", 
     RowBox[{"detail_", ":", "\"\<\>\""}]}], "]"}], ":=", 
   RowBox[{"record", "[", 
    RowBox[{"ref", ",", "claim", ",", "\"\<NOTE\>\"", ",", "detail"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sci", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"Log10", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], "/", 
            RowBox[{"10", "^", "e"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}], "<>", "\"\<e\>\"",
         "<>", 
        RowBox[{"ToString", "[", "e", "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"num", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"n_", ":", "3"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "==", "0"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"TextString", "[", 
      RowBox[{"N", "[", 
       RowBox[{"Round", "[", 
        RowBox[{"x", ",", 
         RowBox[{"10.", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{"Log10", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"N", "[", "x", "]"}], "]"}], "]"}], "]"}], "-", "n", "+",
             "1"}], ")"}]}]}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "expr_", "]"}], ":=", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"Simplify", "[", "expr", "]"}], "}"}], "]"}], ",", 
     "PossibleZeroQ"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hat", "[", 
    RowBox[{"{", 
     RowBox[{"a1_", ",", "a2_", ",", "a3_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "a3"}], ",", "a2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"a3", ",", "0", ",", 
       RowBox[{"-", "a1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "a2"}], ",", "a1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vecOfHat", "[", "m_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "[", 
      RowBox[{"[", 
       RowBox[{"3", ",", "2"}], "]"}], "]"}], ",", 
     RowBox[{"m", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", 
     RowBox[{"m", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"quatR", "[", 
    RowBox[{"{", 
     RowBox[{"q0_", ",", "q1_", ",", "q2_", ",", "q3_"}], "}"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"q0", "^", "2"}], "-", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], ".", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}]}], ")"}], 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
    RowBox[{"2", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}]}], "]"}]}], "+", 
    RowBox[{"2", "q0", 
     RowBox[{"hat", "[", 
      RowBox[{"{", 
       RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Qmat", "[", 
    RowBox[{"{", 
     RowBox[{"q0_", ",", "q1_", ",", "q2_", ",", "q3_"}], "}"}], "]"}], ":=", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "q1"}], ",", 
       RowBox[{"-", "q2"}], ",", 
       RowBox[{"-", "q3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q0", ",", 
       RowBox[{"-", "q3"}], ",", "q2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q3", ",", "q0", ",", 
       RowBox[{"-", "q1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "q2"}], ",", "q1", ",", "q0"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"axisAngleR", "[", 
    RowBox[{"k_", ",", "psi_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "psi", "]"}], 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "psi", "]"}]}], ")"}], 
     RowBox[{"Outer", "[", 
