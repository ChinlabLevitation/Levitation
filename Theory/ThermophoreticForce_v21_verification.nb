Cell[TextData[{
 "The total DOF for a body of arbitrary shape is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "+", "6", "+", "9", "+", "6", " ", "=", " ", "27"}], 
   TraditionalForm]],ExpressionUUID->"3c09968f-d39d-447d-b6df-28b117bfbb16"],
 " (plus 6 for the inertia tensor). See Section 1.7 for how symmetry reduces \
this."
}], "Text",ExpressionUUID->"743d1f53-ebb5-4cf3-bfb1-b7675f78eb60"],

Cell[TextData[{
 StyleBox["Verification of (10) against (8)\[Dash](9).",
  FontWeight->"Bold"],
 " Multiply out the block matrix of (10). The force row reproduces (8). The \
torque row, however, gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", ")"}], "b"], "-", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "93354a87-540f-4269-ae3f-73ce2f6cca38"],
 ", i.e. rotational drag driven by the ",
 StyleBox["linear",
  FontSlant->"Italic"],
 " velocity, whereas (7) and (9) have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "75998db8-c1dc-4244-a1ba-103c3be56db3"],
 ". The two are not even dimensionally compatible: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], 
    StyleBox["v",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "59347e69-5e99-47de-82c5-903870696009"],
 " is not a torque. The consistent form needs three driving fields. The \
general linear response additionally has translation\[Dash]rotation coupling \
blocks, which (8)\[Dash](9) omit."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"7df358aa-840c-4ecc-873a-ec5bee88fc3d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fth", "=", 
   RowBox[{"symMat", "[", "f", "]"}]}], ";", 
  RowBox[{"fdr", "=", 
   RowBox[{"symMat", "[", "d", "]"}]}], ";", 
  RowBox[{"Tth", "=", 
   RowBox[{"genMat", "[", "t", "]"}]}], ";", 
  RowBox[{"Tdr", "=", 
   RowBox[{"symMat", "[", "r", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gb", "=", 
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2", ",", "g3"}], "}"}]}], ";", 
  RowBox[{"vb", "=", 
   RowBox[{"{", 
    RowBox[{"vb1", ",", "vb2", ",", "vb3"}], "}"}]}], ";", 
  RowBox[{"wb", "=", 
   RowBox[{"{", 
    RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"blockEq10", "=", 
   RowBox[{"-", 
    RowBox[{
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fth", ",", "fdr"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Tth", ",", "Tdr"}], "}"}]}], "}"}], "]"}], ".", 
     RowBox[{"Join", "[", 
      RowBox[{"gb", ",", "vb"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (10)\>\"", 
      ",", "\"\<force rows of (10) reproduce (8)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"blockEq10", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "3"}], "]"}], "]"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"fth", ".", "gb"}]}], "-", 
          RowBox[{"fdr", ".", "vb"}]}], ")"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (10)\>\"", 
      ",", "\"\<torque rows of (10) reproduce (9)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"blockEq10", "[", 
         RowBox[{"[", 
          RowBox[{"4", ";;", "6"}], "]"}], "]"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Tth", ".", "gb"}]}], "-", 
          RowBox[{"Tdr", ".", "wb"}]}], ")"}]}], "]"}], 
      ",", "\"\<The torque rows give -T_th g - T_drag v^b instead of -T_th g \
- T_drag w^b. The text below (10), 'the driving fields are grad ln T and v \
(not w)', repeats the slip.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",Expressio\
nUUID->"b9b3c9ab-c901-41ad-8bc9-e087a471ff3f"],

