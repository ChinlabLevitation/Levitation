         Offset[0.2]}}], ")"}]}], TraditionalForm]], "DisplayFormula",Expressi\
onUUID->"7940fee2-bafd-4fab-8326-1960246ffba1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"units", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<F\>\"", "->", 
      RowBox[{"Quantity", "[", 
       RowBox[{"1", ",", "\"\<Newtons\>\""}], "]"}]}], ",", 
     RowBox[{"\"\<L\>\"", "->", 
      RowBox[{"Quantity", "[", 
       RowBox[{"1", ",", "\"\<Meters\>\""}], "]"}]}], ",", 
     RowBox[{"\"\<T\>\"", "->", 
      RowBox[{"Quantity", "[", 
       RowBox[{"1", ",", "\"\<Seconds\>\""}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gradLnT", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"1", "/", "\"\<Meters\>\""}]}], "]"}]}], ";", 
  RowBox[{"vel", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"\"\<Meters\>\"", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";", 
  RowBox[{"omega", "=", 
   RowBox[{"Quantity", "[", 
    RowBox[{"1", ",", 
     RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dimOK", "[", 
    RowBox[{"coef_", ",", "driving_", ",", "response_"}], "]"}], ":=", 
   RowBox[{"CompatibleUnitQ", "[", 
    RowBox[{
     RowBox[{"coef", "driving"}], ",", "response"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (11)\>\"", 
      ",", "\"\<[f_th] = F L: f_th times grad ln T is a force\>\"", ",", 
      RowBox[{"dimOK", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{"units", "[", "\"\<L\>\"", "]"}]}], ",", "gradLnT", ",", 
        RowBox[{"units", "[", "\"\<F\>\"", "]"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (11)\>\"", 
      ",", "\"\<[f_drag] = F T/L: f_drag times v is a force\>\"", ",", 
      RowBox[{"dimOK", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{
          RowBox[{"units", "[", "\"\<T\>\"", "]"}], "/", 
          RowBox[{"units", "[", "\"\<L\>\"", "]"}]}]}], ",", "vel", ",", 
        RowBox[{"units", "[", "\"\<F\>\"", "]"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (11)\>\"", 
      ",", "\"\<[T_th] = F L^2: T_th times grad ln T is a torque\>\"", ",", 
      RowBox[{"dimOK", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{
          RowBox[{"units", "[", "\"\<L\>\"", "]"}], "^", "2"}]}], ",", 
        "gradLnT", ",", 
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{"units", "[", "\"\<L\>\"", "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (11)\>\"", 
      ",", "\"\<[T_drag] = F L^2 T/L (= F L T): T_drag times omega is a \
torque\>\"", ",", 
      RowBox[{"dimOK", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{
          RowBox[{"units", "[", "\"\<L\>\"", "]"}], "^", "2"}], 
         RowBox[{
          RowBox[{"units", "[", "\"\<T\>\"", "]"}], "/", 
          RowBox[{"units", "[", "\"\<L\>\"", "]"}]}]}], ",", "omega", ",", 
        RowBox[{
         RowBox[{"units", "[", "\"\<F\>\"", "]"}], 
         RowBox[{"units", "[", "\"\<L\>\"", "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 1.3\>\"", ",", "\"\<DOF count 6 + 6 + 9 + 6 = 27\>\"", 
      ",", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"Variables", "[", 
         RowBox[{"{", 
          RowBox[{"fth", ",", "fdr", ",", "Tth", ",", "Tdr"}], "}"}], "]"}], 
        "]"}], "==", "27"}]}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID\
->"e61d1a1a-777f-4121-a937-9e68d24d53cd"],

