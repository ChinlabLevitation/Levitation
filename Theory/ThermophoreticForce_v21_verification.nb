Cell[TextData[{
 "Note that the driving fields are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "84e86f56-e3ca-4bb6-b779-1ba1ba69a1c0"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "667dedfb-5c16-4b77-8afd-3dbb13fd0da5"],
 " (not ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Omega]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7e810f6e-88b9-4616-b350-b0db632e0768"],
 "); the rotational responses ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d28930f0-7f18-441c-b1c9-75bb01fdb9b5"],
 " and the translational drag ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "596a50f2-b035-4947-b691-cdf33434f303"],
 " both arise from velocity fields in the gas. The four blocks have different \
physical dimensions:"
}], "Text",ExpressionUUID->"5173a61d-5e89-425f-b8f7-379d272c8779"],

Cell[BoxData[
 FormBox[
  RowBox[{"[", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], "]", " ", "=", " ", "F", "\[CenterDot]", " ", "L", 
   " ", ",", " ", "\:2003", " ", "[", 
