Cell[TextData[{
 StyleBox["Gyrophoretic force at steady-state spin.",
  FontWeight->"Bold"],
 " The gyrophoretic force (from angular velocity coupling) at steady-state \
spin ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", 
    StyleBox["ss",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6048ae62-e49f-476c-9af0-7c729c2df417"],
 " is"
}], "Text",ExpressionUUID->"f67152e6-ade4-49c6-a80b-21f5711eb1ef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["F", "\[Omega]"], " ", "\[Tilde]", " ", "\[CapitalLambda]", "'", 
   SubscriptBox["\[Omega]", 
    StyleBox["ss",
     FontSlant->"Plain"]], " ", "=", " ", 
   FractionBox["\[CapitalLambda]", 
    RowBox[{"\[ScriptL]", 
     OverscriptBox["v", "_"]}]], "\[CenterDot]", 
   FractionBox[
    RowBox[{
     SubscriptBox["F", "T"], "\[ScriptL]"}], 
    SubscriptBox["C", "r"]], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["F", "T"], "\[ScriptL]"}], 
    RowBox[{
     OverscriptBox["v", "_"], 
     SubscriptBox["C", "r"]}]], "\[CenterDot]", 
   FractionBox[
    SubscriptBox["F", "T"], 
    RowBox[{"|", "\[Del]", 
     StyleBox["ln",
      FontSlant->"Plain"], " ", "T", "|"}]], " ", "\[TildeTilde]", " ", "1.5",
    "\[Times]", 
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], "\[ThinSpace]", 
   StyleBox["N",
    FontSlant->"Plain"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(61)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"b79725a2-350a-4071-9b07-d0789a5876cc"],

Cell["This can be expressed analytically as", "Text",ExpressionUUID->"8703986d-5d12-417c-af6b-8f222cd1e90f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    SubscriptBox["F", "\[Omega]"], 
    SubscriptBox["F", "T"]], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["F", "T"], "\[ScriptL]"}], 
    RowBox[{"|", "\[Del]", 
     StyleBox["ln",
      FontSlant->"Plain"], " ", "T", "|", 
     OverscriptBox["v", "_"], 
     SubscriptBox["C", "r"]}]], " ", "=", " ", 
   FractionBox[
    RowBox[{"\[Eta]", "\[Kappa]", " ", "T"}], 
    OverscriptBox["v", "_"]], 
   FractionBox[
    RowBox[{"8", "\[Pi]"}], 
    RowBox[{"15", "P", "\[ScriptL]"}]], " ", "\[TildeTilde]", " ", "3", "K", 
   "n", " ", "\[TildeTilde]", " ", "1.6", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(62)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"b7992c93-32cf-4fba-b809-f85e14a9ff7e"],

Cell[TextData[{
 "The gyrophoretic force is therefore comparable to the thermophoretic force \
for a non-spherical particle spinning at its steady-state rate. This is \
perhaps surprising: although ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "=", " ", 
    SubscriptBox["\[Omega]", 
     StyleBox["ss",
      FontSlant->"Plain"]], "\[ScriptL]", "/", 
    OverscriptBox["v", "_"], " ", "\[TildeTilde]", " ", "0.002"}], 
   TraditionalForm]],ExpressionUUID->"58f4fafa-297b-4c7a-9d5a-00be561acb8b"],
 ", the smallness of ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]],ExpressionUUID->
  "bb49d716-bf03-4266-98bb-69a49195c357"],
 " is compensated by the large ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], "|", "/", "|", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]], "|", " ", "\[Tilde]", " ", 
    OverscriptBox["v", "_"], "/", 
    SuperscriptBox["\[ScriptL]", "2"]}], TraditionalForm]],ExpressionUUID->
  "af6c7c40-8086-4547-a47e-bc9eb05596b9"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "\[Omega]"], " ", "\[Tilde]", " ", "\[Delta]", "\[CenterDot]",
     "(", 
    OverscriptBox["v", "_"], "/", "\[ScriptL]", ")", "\[CenterDot]", " ", 
    SubscriptBox["F", "T"], "/", "|", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", "|", "\[CenterDot]", "|", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", "|", " ", "\[Tilde]", " ", 
    SubscriptBox["F", "T"]}], TraditionalForm]],ExpressionUUID->
  "47feb73c-9918-44b4-93df-38b77a8f6804"],
 ". The ratio scales as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n"}], TraditionalForm]],ExpressionUUID->
  "01620f0c-58cf-4ca6-9b13-80a7a5dfd120"],
 " \[LongDash] it is a rarefaction effect, vanishing in the continuum limit \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", " ", "\[GreaterGreater]", " ", "\[Lambda]"}], 
   TraditionalForm]],ExpressionUUID->"4452e9bf-485d-4d72-8ff4-7a61539221a7"],
 "."
}], "Text",ExpressionUUID->"7367be7c-0063-48af-8ded-426f625a8051"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Fw", "=", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{
     RowBox[{"FT", 
      RowBox[{"ellq", "/", 
       RowBox[{"(", 
        RowBox[{"vbar", "CrPDF"}], ")"}]}], 
      RowBox[{"FT", "/", "gradLnTq"}]}], ",", "\"\<Newtons\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ratio62arith", "=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"FT", 
     RowBox[{"ellq", "/", 
      RowBox[{"(", 
       RowBox[{"gradLnTq", "vbar", "CrPDF"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ratio62printed", "=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"eta", "kappaq", 
     RowBox[{"Tq", "/", "vbar"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"8", "Pi"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"15", "Pq", "ellq"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ratio62fixed", "=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"eta", "kappaq", 
     RowBox[{"Tq", "/", "vbar"}], 
     RowBox[{"15", "/", 
      RowBox[{"(", 
       RowBox[{"8", "Pi", "Pq", "ellq"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ratioKin", "=", 
   RowBox[{"UnitSimplify", "[", 
    RowBox[{"FT", 
     RowBox[{"ellq", "/", 
      RowBox[{"(", 
       RowBox[{"gradLnTq", "vbar", "CrKinQ"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"knCoef", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"eta", 
         RowBox[{"(", 
          RowBox[{"15", "/", "4"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"kB", "/", "mm"}], ")"}], "mu", 
         RowBox[{"Tk", "/", "vbarS"}], 
         RowBox[{"15", "/", 
          RowBox[{"(", 
           RowBox[{"8", "Pi", "Pp", "ell"}], ")"}]}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"mu", "/", "Pp"}], 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Pi", "kB", 
             RowBox[{"Tk", "/", 
              RowBox[{"(", 
               RowBox[{"2", "mm"}], ")"}]}]}], "]"}]}], ")"}], "/", "ell"}], 
        ")"}]}], "/.", 
      RowBox[{"mm", "->", 
       RowBox[{"2", "kB", 
        RowBox[{"Tk", "/", 
         RowBox[{"vbarS", "^", "2"}]}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kB", ">", "0"}], ",", 
       RowBox[{"Tk", ">", "0"}], ",", 
       RowBox[{"vbarS", ">", "0"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<F_omega (61)\>\"", ",", "Fw"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<F_omega/F_T from the first form of (62)\>\"", ",", 
          "ratio62arith"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<(62) as printed: (eta kappa T/vbar) 8 pi/(15 P l)\>\"", 
          ",", "ratio62printed"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<(62) with 15/(8 pi P l)\>\"", ",", "ratio62fixed"}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<3 Kn\>\"", ",", 
          RowBox[{"3", "Kn"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<F_omega/F_T with the kinetic C_r\>\"", ",", 
          "ratioKin"}], "}"}]}], "}"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Alignment", "->", "Left"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (61)\>\"", 
      ",", "\"\<F_omega = 1.5e-9 N (with the notes' C_r)\>\"", ",", 
      RowBox[{"close", "[", 
       RowBox[{"Fw", ",", "1.5*^-9", ",", "0.05"}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (62)\>\"", 
      ",", "\"\<analytic form (eta kappa T/vbar) 8 pi/(15 P l) equals the \
first form\>\"", ",", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"ratio62printed", "/", "ratio62arith"}], "-", "1"}], "]"}], "<",
        "0.01"}], ",", 
      RowBox[{"\"\<The printed factor 8 pi/(15 P l) gives \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"ratio62printed", ",", "3"}], "]"}], 
       "<>", "\"\<; substituting C_r = (8 pi/15)(P/vbar) l^4 gives 15/(8 pi P \
l) and the stated \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{"ratio62fixed", ",", "3"}], "]"}], "<>", "\"\<.\>\""}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (62)\>\"", 
      ",", "\"\<F_omega/F_T of about 1.6 and of about 3 Kn\>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"ratio62arith", "-", "1.6"}], "]"}], "<", "0.05"}], "&&", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"ratio62arith", "/", 
           RowBox[{"(", 
            RowBox[{"3", "Kn"}], ")"}]}], "-", "1"}], "]"}], "<", "0.1"}]}]}],
      "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eq. (62)\>\"", ",", "\"\<the Kn scaling, made explicit\>\"",
       ",", 
      RowBox[{"\"\<Writing kappa = (15/4)(k_B/m) mu and lambda = (mu/P) \
Sqrt[pi k_B T/2m] turns the corrected (62) into F_omega/F_T = \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"TraditionalForm", "[", "knCoef", "]"}], "]"}], 
       "<>", "\"\< Kn = \>\"", "<>", 
       RowBox[{"num", "[", 
        RowBox[{
         RowBox[{"N", "[", "knCoef", "]"}], ",", "3"}], "]"}], 
       "<>", "\"\< Kn. The quoted 3 Kn uses the total conductivity of \
air.\>\""}]}], "]"}], ",", 
    RowBox[{"note", "[", 
     RowBox[{"\"\<Eqs. (61)-(62)\>\"", 
      ",", "\"\<status of the gyrophoretic estimate\>\"", ",", 
      RowBox[{"\"\<Lambda' ~ Lambda/(l vbar) is a dimensional guess, not a \
derived coupling. Within the epsilon-expansion of Section 2, where the notes \
neglect the coupling as O(eps^2), a coupling of order eps times a spin of \
order eps gives F_omega/F_T = O(eps^2). The O(1) ratio found here assumes an \
O(1) asymmetry, eps ~ 1. With the kinetic C_r the ratio drops to \>\"", "<>", 
       
       RowBox[{"num", "[", 
        RowBox[{"ratioKin", ",", "2"}], "]"}], "<>", "\"\<.\>\""}]}], "]"}]}],
    "}"}], "]"}]}], "Input",ExpressionUUID->"e23055c1-65da-424a-9ed4-\
9a10d919c07f"],

