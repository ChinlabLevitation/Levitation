    RowBox[{
     RowBox[{"Sin", "[", "psi", "]"}], 
     RowBox[{"hat", "[", "k", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"symMat", "[", "s_", "]"}], ":=", 
   RowBox[{"Table", "[", 
