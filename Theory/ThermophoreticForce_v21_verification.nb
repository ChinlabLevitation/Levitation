     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "08cbe18f-5afb-4a7d-b0fe-51bd20b9d337"],
 "\n",
 StyleBox["For ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    StyleBox["inf",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "26fbc2ee-2b2c-4a3e-8973-25fee308a71b"],
 StyleBox[" (and C1) a general ",
