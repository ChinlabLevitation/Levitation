Cell[TextData[{
 StyleBox["Literature cross-check: Garcia-Ybarra & Rosner's sphero-cylinders.",
  FontWeight->"Bold"],
 " Zheng's review (2002), which the notes cite, summarises Garcia-Ybarra & \
Rosner (1989) as follows. A long sphero-cylinder aligned with the gradient \
drifts 31% faster than a sphere of the same radius; aligned perpendicular it \
drifts about 6% slower; and at intermediate angles the drift deviates from \
the gradient by up to 12\[Degree]. A sphero-cylinder is a cylinder plus a \
sphere (its two caps), so the same kinetic stresses give these numbers \
directly as functions of the aspect ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "/", "r"}], TraditionalForm]],ExpressionUUID->
  "fbbb268b-fb75-49b3-b8b9-698d4c4f9332"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"cbf309c9-2194-412e-97b7-4735851ed621"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"axialDrag", "[", "L_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"stressKin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nC", "[", "ph", "]"}], "/.", 
             RowBox[{"thC", "->", 
              RowBox[{"Pi", "/", "2"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", "vC"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ")"}], "rC", "L"}], ",", 
       RowBox[{"{", 
        RowBox[{"ph", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", "kinAssume"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"perpDrag", "[", "L_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"stressKin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nC", "[", "ph", "]"}], "/.", 
             RowBox[{"thC", "->", "0"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", "vC"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], ")"}], "rC", "L"}], ",", 
       RowBox[{"{", 
        RowBox[{"ph", ",", "0", ",", 
         RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], ",", "kinAssume"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sphDrag", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"epstein", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Vs", "->", 
        RowBox[{"-", "vC"}]}], ",", 
       RowBox[{"Rs", "->", "rC"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FparL", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Fcyl", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"thC", "->", 
         RowBox[{"Pi", "/", "2"}]}], ",", 
        RowBox[{"vC", "->", "0"}]}], "}"}]}], ")"}], "+", "FsphNu"}]}], ";", 
  RowBox[{"FperpL", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Fcyl", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"thC", "->", "0"}], ",", 
        RowBox[{"vC", "->", "0"}]}], "}"}]}], ")"}], "+", "FsphNu"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"DparL", "=", 
   RowBox[{
    RowBox[{"axialDrag", "[", "LC", "]"}], "+", "sphDrag"}]}], ";", 
  RowBox[{"DperpL", "=", 
   RowBox[{
    RowBox[{"perpDrag", "[", "LC", "]"}], "+", "sphDrag"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vRatio", "[", 
    RowBox[{"Fx_", ",", "Dx_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Fx", "/", 
        RowBox[{"(", 
         RowBox[{"Dx", "/", "vC"}], ")"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"FsphNu", "/", 
        RowBox[{"(", 
         RowBox[{"sphDrag", "/", "vC"}], ")"}]}], ")"}]}], ",", "kinAssume"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"parRatio", "=", 
   RowBox[{"vRatio", "[", 
    RowBox[{"FparL", ",", "DparL"}], "]"}]}], ";", 
  RowBox[{"perpRatio", "=", 
   RowBox[{"vRatio", "[", 
    RowBox[{"FperpL", ",", "DperpL"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"devAngle", "[", 
    RowBox[{"Lr_", ",", "av_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mu1", "=", 
        RowBox[{"FparL", "/", 
         RowBox[{"(", 
          RowBox[{"DparL", "/", "vC"}], ")"}]}]}], ",", 
       RowBox[{"mu2", "=", 
        RowBox[{"FperpL", "/", 
         RowBox[{"(", 
          RowBox[{"DperpL", "/", "vC"}], ")"}]}]}], ",", "r12"}], "}"}], ",", 
     
     RowBox[{
      RowBox[{"r12", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"mu2", "/", "mu1"}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"LC", "->", 
             RowBox[{"Lr", "rC"}]}], ",", 
            RowBox[{"aa", "->", "av"}]}], "}"}]}], "//", "Simplify"}], 
        "]"}]}], ";", 
      RowBox[{
       RowBox[{"NMaxValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"ArcTan", "[", 
              RowBox[{"r12", 
               RowBox[{"Tan", "[", "x", "]"}]}], "]"}], "-", "x"}], "]"}], ",", 
           RowBox[{"0", "<", "x", "<", 
            RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", "x"}], "]"}], "/", 
       "Degree"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<parallel / sphere velocity ratio:  \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"parRatio", "/.", 
           RowBox[{"LC", "->", 
            RowBox[{"lr", "rC"}]}]}], ",", "kinAssume"}], "]"}], "]"}]}], 
      "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"lr", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{"parRatio", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"LC", "->", 
                   RowBox[{"lr", "rC"}]}], ",", 
                  RowBox[{"aa", "->", "1"}]}], "}"}]}], "]"}], ",", "3"}], 
             "]"}], ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{"perpRatio", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"LC", "->", 
                   RowBox[{"lr", "rC"}]}], ",", 
                  RowBox[{"aa", "->", "1"}]}], "}"}]}], "]"}], ",", "3"}], 
             "]"}], ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"devAngle", "[", 
               RowBox[{"lr", ",", "1"}], "]"}], ",", "3"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"lr", ",", 
            RowBox[{"{", 
             RowBox[{
             "5", ",", "10", ",", "15", ",", "20", ",", "50", ",", "1000"}], 
             "}"}]}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<L/r\>\"", ",", "\"\<v_par / v_sphere\>\"", 
           ",", "\"\<v_perp / v_sphere\>\"", 
           ",", "\"\<max deviation (deg)\>\""}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
