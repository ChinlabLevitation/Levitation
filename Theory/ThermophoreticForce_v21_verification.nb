     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "180ec137-0570-4eae-b1ab-5eaaf13cfbe1"],
 " are symmetric traceless ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "1ea924ed-171d-4163-8280-b900ba9ea141"],
 " matrices."
}], "Text",ExpressionUUID->"03805fa2-2ab3-42cc-9697-14b9fe759e0e"],

Cell[TextData[{
 StyleBox["Thermophoretic torque tensor.",
  FontWeight->"Bold"],
 " For a perfect sphere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"0431a4fe-f464-4955-8e33-cd770115dc95"],
 ". For a near-sphere the broken symmetry produces a non-zero thermophoretic \
torque at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"9007f005-8fef-4ca1-85bc-b9ddf2f1da35"],
 ":"
}], "Text",ExpressionUUID->"096579a6-68db-4abd-9423-770223bba7a5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "\[CurlyEpsilon]", "\[ThinSpace]", 
   "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", ",", " ", "\:2003\:2003", " ", "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "O", "(", "1", ")", " ", 
   "\[ThickSpace]", " ", "(", 
   StyleBox["general",
    FontSlant->"Plain"], "\[ThickSpace]", " ", "3", "\[Times]", "3", " ", "\[ThickSpace]", 
   StyleBox["matrix",
    FontSlant->"Plain"], ")", " ", "."}], TraditionalForm]], "DisplayFormula",\

 CellFrameLabels->{{None, 
    Cell["(33)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"ae374a85-8523-41d8-b820-1d7acc0de182"],

Cell["\<\
Both diagonal and off-diagonal entries are generically non-zero.\
\>", "Text",ExpressionUUID->"bc904f6d-2e4d-4fe3-aa90-4593be2e7c6d"],

Cell[TextData[{
 StyleBox["Note on gyrophoretic coupling.",
  FontWeight->"Bold"],
 " Since no experimental evidence currently constrains the relationship and \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "21961b28-104d-4876-a796-449b8164cbab"],
 "; any gyrophoretic coupling is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"bf4361a3-3b0d-4b70-8323-e782e10bae90"],
 " and is neglected."
}], "Text",ExpressionUUID->"46ab5ff3-e101-4ee7-87ef-9b6357ef1dd8"],

Cell[TextData[{
 StyleBox["Summary of orders (to leading order in ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox["\[CurlyEpsilon]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "141693d1-02d7-487f-b99a-a710b6588e60"],
 StyleBox[").",
  FontWeight->"Bold"],
 " Collecting Eqs. (31)\[Dash](33):"
}], "Text",ExpressionUUID->"bae45c4e-07b4-46ff-80de-c4a407b174d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["f", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
    "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["d", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
    "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "\[CurlyEpsilon]", "\[ThinSpace]", 
   "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["r", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
    "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrame->{{1, 1}, {1, 1}},
 CellMargins->{{66, 10}, {0, 0}},
 CellFrameColor->GrayLevel[0.4],
 CellFrameLabels->{{None, 
    Cell["(34)", "Text", FontSize -> 12]}, {None, None}},
 Background->RGBColor[
  0.97, 0.98, 1.],ExpressionUUID->"ffa2081c-7f40-4fde-b0b6-8cd931743f0f"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "0"], " ", "\[Congruent]", " ", 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "41fd2e74-7435-4356-9206-03ac13e452c5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "0"], " ", "\[Congruent]", " ", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "f8ed22b5-0391-49fa-9cc6-38e7f778fcfd"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], " ", "\[Congruent]", " ", 
    SubscriptBox["c", "0"]}], TraditionalForm]],ExpressionUUID->
  "89e77a09-ffcd-40a2-a258-8e10649f15a2"],
 " are the scalar sphere values, and the four correction tensors ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "14bd9195-7664-4fd0-93ac-a6c8c42a20e4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "2887d81c-5d45-4214-9836-7a601f6bdf1b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "fdad3ffa-6327-43b8-8954-e033bf5a9235"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "0f64490c-6656-49b2-bf95-6ad5d4702284"],
 " are defined in Eqs. (31)\[Dash](33) above. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "0"], ")"}], TraditionalForm]],
  ExpressionUUID->"ff9da1f2-7572-42ee-9795-cd1e82f0de3c"],
 " each tensor is isotropic; all anisotropy and the thermophoretic torque \
enter at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"cc20a215-4d04-4176-949b-2085298e13ac"],
 " through these corrections."
}], "Text",ExpressionUUID->"7751827b-e7f8-433d-bf67-4dcaa4e3ffa0"],

Cell[BoxData[
 RowBox[{"note", "[", 
  RowBox[{"\"\<Sec. 2.1\>\"", 
   ",", "\"\<the 'Note on gyrophoretic coupling' sentence is incomplete, and \
conflicts with Section 6\>\"", 
   ",", "\"\<The sentence appears to be missing a word ('... constrains the \
relationship [between the gyrophoretic coupling] and T_th'). Within the \
epsilon-expansion a coupling of order epsilon multiplied by a spin of order \
epsilon is indeed O(epsilon^2). Section 6 nevertheless concludes that the \
gyrophoretic force is comparable to F_T; see the discussion there.\>\""}], 
  "]"}]], "Input",ExpressionUUID->"43dde4b0-005d-4d7f-a699-517989835695"],

Cell[TextData[{
 StyleBox["\[FilledCircle] NOTE",
  FontWeight->"Bold",
  FontColor->RGBColor[0.15, 0.35, 0.75]],
 "    ",
 StyleBox["Sec. 2.1",
  FontWeight->"Bold"],
 ":   ",
 "the 'Note on gyrophoretic coupling' sentence is incomplete, and conflicts \
with Section 6",
 "\n",
 StyleBox["The sentence appears to be missing a word ('... constrains the \
relationship [between the gyrophoretic coupling] and ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "46db5862-1188-4765-9818-cec0c2a9a237"],
 StyleBox["'). Within the \[CurlyEpsilon]-expansion a coupling of order \
\[CurlyEpsilon] multiplied by a spin of order \[CurlyEpsilon] is indeed O(",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[CurlyEpsilon]", "2"], TraditionalForm]],ExpressionUUID->
  "605040fe-ed88-4a13-826b-782b5943e173"],
 StyleBox["). Section 6 nevertheless concludes that the gyrophoretic force is \
comparable to ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    StyleBox["T",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c23f2fc3-6f42-443e-ae48-c812fae49a67"],
 StyleBox["; see the discussion there.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.15, 0.35, 0.75],
 Background->RGBColor[
  0.92, 0.94, 0.99],ExpressionUUID->"2e9fef7a-9fc7-4194-9b83-cac0840affba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Rotational dynamics and orientation selection", "Subsection",ExpressionUUID->"a5d085da-13a0-47e6-8da7-11b876312208"],

Cell[TextData[{
 StyleBox["Equations of motion for ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "b"], ",", " ", "R", ")"}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "0d5c0f55-bd35-43a7-99f5-8248d553e0fc"],
 StyleBox[".",
  FontWeight->"Bold"],
 " For a near-sphere (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox["I", "0"], 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold"], "3"], " ", "+", " ", "O", "(", "\[CurlyEpsilon]", 
    ")"}], TraditionalForm]],ExpressionUUID->
  "dce5c68d-a97a-445b-8bc8-5cc068687c72"],
 ") the Euler equation (15) in the body frame, keeping only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"51d2e70f-1794-435c-85a3-f8719fd4c585"],
 " terms, is:"
}], "Text",ExpressionUUID->"caef9201-5d56-43df-827a-82fdfc41af25"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["I", "0"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "."], "b"], " ", "=", " ", "G", "\[CurlyEpsilon]", 
   "\[ThinSpace]", "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   SuperscriptBox["R", "\[Transpose]"], 
   OverscriptBox["Z", "^"], " ", "-", " ", 
   SubscriptBox["c", "0"], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", "+", " ", "O", "(", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], ")", " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(35)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"f4708562-8897-44b5-bc09-baee7e668888"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["R", "."], " ", "=", " ", "R", "\[ThinSpace]", 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "^"], "b"], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(36)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"52300823-f153-41cc-a36f-b8fc5576c942"],

Cell[TextData[{
 "where we substituted ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", ")"}], "b"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "a101bb51-03fa-4ac3-a069-70242fcc1cb5"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", "|", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", "|", " ", "=", " ", "|", "\[Del]", " ", 
    "T", "|", "/", "T", " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"6696c450-472b-490e-8cee-e67f2ecad744"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "661d3e26-2759-4e8f-8f0b-6d4055734acf"],
 " pointing downward), so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SuperscriptBox[
     RowBox[{"(", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", ")"}], "b"], " ", "=", " ", "+", "G", "\[ThinSpace]",
     "\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "f549bc59-db7a-4d67-aeb6-a97134e7b81b"],
 ", and dropped the gyroscopic term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], "\[Times]", "(", 
    SubscriptBox["I", "0"], 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ")"}], TraditionalForm]],ExpressionUUID->
  "a71ce7eb-2edb-4d1c-8a25-175527d4bd1b"],
 " (it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"bfa52b86-932d-482f-bdbb-1a6e48537d24"],
 " since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], " ", "=", " ", "O", "(", "\[CurlyEpsilon]", 
    ")"}], TraditionalForm]],ExpressionUUID->
  "062d2313-5133-4113-83b9-f55503904918"],
 "). Equations (35)\[Dash](36) together form a closed system for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ",", " ", "R", ")", " ", "\[Element]", " ", 
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"], "\[Times]", 
    StyleBox["SO",
     FontSlant->"Plain"], "(", "3", ")"}], TraditionalForm]],ExpressionUUID->
  "12fd04d5-83bd-4a82-8818-636130901505"],
 "."
}], "Text",ExpressionUUID->"f1a1796c-c53d-47b3-a9d9-eb7b6b691ad0"],

Cell[TextData[{
 StyleBox["Reduced form via ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     StyleBox["u",
      FontWeight->"Bold"], " ", "=", " ", 
     SuperscriptBox["R", "\[Transpose]"], 
     OverscriptBox["Z", "^"]}],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "2b6091b7-717b-48a6-8bb2-33b514f31f70"],
 StyleBox[".",
  FontWeight->"Bold"],
 " It is convenient to project onto the body-frame gradient direction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "\[Congruent]", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "5a4c1a0e-72c5-4e2e-aff1-cb8d5abee8e7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u",
     FontWeight->"Bold"], "|", " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"d490c528-1dcc-44e3-9c8f-63e8cb90cfc1"],
 ". Differentiating Eq. (36): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "."], " ", "=", " ", 
    SuperscriptBox[
     OverscriptBox["R", "."], "\[Transpose]"], 
    OverscriptBox["Z", "^"], " ", "=", " ", "-", 
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "^"], "b"], 
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "-", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], "\[Times]", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "ec97b422-fd95-4fcf-bcb5-521c5721015f"],
 ". Equations (35)\[Dash](36) reduce to:"
}], "Text",ExpressionUUID->"c7ebfc90-9737-49a4-b836-5bd5fff0ee9a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["I", "0"], 
   SuperscriptBox[
    OverscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "."], "b"], " ", "=", " ", "G", "\[CurlyEpsilon]", 
   "\[ThinSpace]", "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "-", " ", 
   SubscriptBox["c", "0"], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", ",", " ", "\:2003\:2003", " ", 
   OverscriptBox[
    StyleBox["u",
     FontWeight->"Bold"], "."], " ", "=", " ", "-", 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], "\[Times]", 
   StyleBox["u",
    FontWeight->"Bold"], " ", ","}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(37)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"57c85bde-9143-44f2-9600-487dd6469c8b"],

Cell[TextData[{
 "a closed 6-DOF ODE on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[DoubleStruckCapitalR]", "3"], "\[Times]", " ", 
    SuperscriptBox["S", "2"]}], TraditionalForm]],ExpressionUUID->
  "94455aa7-2e11-419f-9ca4-b9c902b2e749"],
 ", exact to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"a84a8288-e8ff-4bd6-bd53-ed32f8a1326f"],
 ". Once ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "2a5eece6-8a6e-4ec3-a240-cc8878d98461"],
 " is known, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "b7c4866a-c4e8-4810-b5d2-2a9e07fbea2d"],
 " can be recovered by integrating Eq. (36)."
}], "Text",ExpressionUUID->"adfac3a3-e8bd-40c9-8bd0-9050fd789d5f"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (35)\>\"", 
      ",", "\"\<-eps dT_th (grad ln T)^b = +G eps dT_th R^T Z for grad ln T = \
-G Z\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "eps"}], 
         RowBox[{
          RowBox[{"genMat", "[", "dT", "]"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Transpose", "[", "Rq", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "G"}], "Zhat"}], ")"}]}], ")"}]}]}], "-", 
        RowBox[{"G", "eps", 
         RowBox[{
          RowBox[{"genMat", "[", "dT", "]"}], ".", 
          RowBox[{"Transpose", "[", "Rq", "]"}], ".", "Zhat"}]}]}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (37)\>\"", 
      ",", "\"\<u = R^T Z obeys du/dt = -w^b x u under (36)\>\"", ",", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "Rdot", "]"}], ".", "Zhat"}], "+", 
          RowBox[{"Cross", "[", 
           RowBox[{"wb", ",", 
            RowBox[{
             RowBox[{"Transpose", "[", "Rq", "]"}], ".", "Zhat"}]}], "]"}]}], 
         ",", "unit"}], "]"}], "===", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (35)\>\"", 
      ",", "\"\<gyroscopic term is second order for a near-sphere: w x (I w) \
with I = I0 + eps dI and w = O(eps)\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"dI", "=", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{"i1", ",", "i2", ",", "i3"}], "}"}], "]"}]}], ",", 
          RowBox[{"w", "=", 
           RowBox[{"eps", 
            RowBox[{"{", 
             RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}]}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Series", "[", 
             RowBox[{
              RowBox[{"Cross", "[", 
               RowBox[{"w", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"I0", 
                    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
                   RowBox[{"eps", "dI"}]}], ")"}], ".", "w"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"eps", ",", "0", ",", "2"}], "}"}]}], "]"}], "//", 
            "Normal"}], "//", "Simplify"}], "//", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"#", ",", "eps", ",", "1"}], "]"}], "&"}], ")"}]}], "//",
          "zeroQ"}]}], "]"}]}], "]"}]}], "}"}], "]"}]], "Input",ExpressionUUID\
->"22f97e04-3afd-4982-97ea-3fc6543ac7ac"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (35)",
  FontWeight->"Bold"],
 ":   ",
 "-\[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["dT", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "1a67bde0-ae03-4453-a173-86f7c384919b"],
 " (\[Del]ln T)",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "b"], TraditionalForm]],ExpressionUUID->
  "e1b5f2eb-5936-47f6-bbdd-1f449bdb8815"],
 " = +G \[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["dT", 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "f627d378-86fd-4c3d-9576-c48f3a9a482b"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "364012e3-bbda-4c53-b685-1f8d6d3f4646"],
 " Z for \[Del]ln T = -G Z"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"e40da9cb-0002-4eb5-a224-df0c234bef88"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (37)",
  FontWeight->"Bold"],
 ":   ",
 "u = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "T"], TraditionalForm]],ExpressionUUID->
  "094c244c-285c-475d-8ab6-04e7ef3ec6ec"],
 " Z obeys du/dt = -",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "574edc97-885b-4017-9252-cdf86c1b05c2"],
 " x u under (36)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"858c41a5-3449-4bfa-8502-29b179cb7db1"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (35)",
  FontWeight->"Bold"],
 ":   ",
 "gyroscopic term is second order for a near-sphere: w x (I w) with I = I0 + \
\[CurlyEpsilon] dI and w = O(\[CurlyEpsilon])"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"6e6b04de-1fdb-4838-872e-a7bd428b166a"],

Cell[TextData[{
 StyleBox["Steady states: eigenvalue problem.",
  FontWeight->"Bold"],
 " Setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[Omega]",
       FontWeight->"Bold"], "."], "b"], " ", "=", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"d5aac478-5157-4c36-8413-b5f7b1d0d436"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "."], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"68f2f6c8-15f3-4c68-8569-3772e034f873"],
 " in Eq. (37):"
}], "Text",ExpressionUUID->"a41f7cfe-69f4-4284-8a05-1ae10c97d2a8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "0"], 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", "=", " ", "G", "\[CurlyEpsilon]", "\[ThinSpace]",
    "\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   StyleBox["u",
    FontWeight->"Bold"], " ", ",", " ", "\:2003\:2003", " ", 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], "\[Times]", 
   StyleBox["u",
    FontWeight->"Bold"], " ", "=", " ", "0", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(38)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"5f1f387d-e130-4019-bf61-828538b9bfc3"],

Cell[TextData[{
 "The second condition requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], " ", "\[DoubleVerticalBar]", " ", 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "25224051-9758-4826-8181-37fcbd3f3b74"],
 ". Substituting into the first:"
}], "Text",ExpressionUUID->"06285c12-1f9d-42ef-aa3a-20e5efa04251"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Delta]", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "=", " ", "\[Lambda]", 
   StyleBox["u",
    FontWeight->"Bold"], " ", ",", " ", "\:2003\:2003", " ", 
   SuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "b"], " ", "=", " ", 
   FractionBox[
    RowBox[{"G", "\[CurlyEpsilon]", "\[Lambda]"}], 
    SubscriptBox["c", "0"]], 
   StyleBox["u",
    FontWeight->"Bold"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(39)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"e1d78f29-ac4b-4897-bbcf-6f721fe2b0ee"],

Cell[TextData[{
 "The steady-state body-frame gradient ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "fb202e35-47ce-4959-9fd0-8946d212a712"],
 " must be an eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "a6a14551-0f5c-4a1c-8b2b-08d06bb8aeac"],
 " with eigenvalue ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "c0e422c4-5b45-48a3-8c25-f67a15e6ff9b"],
 ". For a general ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[Times]", "3"}], TraditionalForm]],ExpressionUUID->
  "88a6b2dd-1c0c-4ace-9fea-785a1e9d6c10"],
 " matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "ab695ffc-795d-435e-9e3d-1647895ee422"],
 " there are three such eigenmotions."
}], "Text",ExpressionUUID->"73b3b00f-8988-4be3-8892-fdc3cd764ff4"],

Cell[TextData[{
 StyleBox["The three eigenmotions in the lab frame.",
  FontWeight->"Bold"],
 " Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "1"], ",", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "2"], ",", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], "}"}], TraditionalForm]],ExpressionUUID->
  "b7c146bf-e33f-465c-bf0e-4709b626d57d"],
 " be the eigenvectors of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "7168ab60-7ed7-47b2-b24b-a9d1e80f1a4b"],
 " with real eigenvalues ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "1"], " ", "\[LessEqual]", " ", 
    SubscriptBox["\[Lambda]", "2"], " ", "\[LessEqual]", " ", 
    SubscriptBox["\[Lambda]", "3"]}], TraditionalForm]],ExpressionUUID->
  "2847a967-b3dc-43d7-b04f-6ce2963db87d"],
 " (real eigenvalues exist when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "c270a254-77b4-400f-9173-bf5548a7537c"],
 " is symmetric; for a non-symmetric matrix the analysis extends to the real \
Schur form). Each eigenvector defines a distinct steady state. At the fixed \
point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"]}], TraditionalForm]],ExpressionUUID->
  "5e2a1b60-f244-414d-8279-6b13bd9db800"],
 " we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"]}], TraditionalForm]],ExpressionUUID->
  "8fc1a106-ba43-48b7-ad93-0fa59bc06877"],
 ", equivalently ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"], " ", "=", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "0347425d-128e-46c8-b467-0854acf689fb"],
 ": the body orients so that its ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], TraditionalForm]],ExpressionUUID->
  "be88ae9f-6029-48dd-a417-7b7cabcaea58"],
 "-axis aligns with the vertical (the temperature-gradient direction)."
}], "Text",ExpressionUUID->"aed237b3-ed61-41a8-9e6f-70521a4f6c67"],

Cell[TextData[{
 "From Eq. (39) the angular velocity in the body frame is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "k", "b"], " ", "=", " ", "(", "G", 
    "\[CurlyEpsilon]", 
    SubscriptBox["\[Lambda]", "k"], "/", 
    SubscriptBox["c", "0"], ")", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"]}], TraditionalForm]],ExpressionUUID->
  "a69839f6-3aac-45e2-98bf-76deec2637ae"],
 ", a spin about the body axis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], TraditionalForm]],ExpressionUUID->
  "789f8f0b-9c8d-4d43-b3ed-fc603ff9fbd4"],
 ". Transforming to the lab frame gives"
}], "Text",ExpressionUUID->"04739366-72e2-4d62-9b6f-ffdf093764ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[CapitalOmega]",
     FontWeight->"Bold"], "k"], " ", "=", " ", "R", 
   SubsuperscriptBox[
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "k", "b"], " ", "=", " ", 
   FractionBox[
    RowBox[{"G", "\[CurlyEpsilon]", 
     SubscriptBox["\[Lambda]", "k"]}], 
    SubscriptBox["c", "0"]], "R", 
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], " ", "=", " ", 
   FractionBox[
    RowBox[{"G", "\[CurlyEpsilon]", 
     SubscriptBox["\[Lambda]", "k"]}], 
    SubscriptBox["c", "0"]], 
   OverscriptBox["Z", "^"], " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(40)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"c7981b34-a687-4b75-b661-cd917a96a5a4"],

Cell[TextData[{
 "The lab-frame angular velocity is exactly along ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Z", "^"], TraditionalForm]],ExpressionUUID->
  "d9ba28a2-6f3f-4c21-bb71-907c16effb47"],
 " for all three eigenmotions \[LongDash] this is a direct consequence of the \
fixed-point geometry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"], " ", "=", " ", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "408fdb4e-b50a-4cb5-8d00-6ee98dbf3b17"],
 ". Physically, the body spins about the temperature-gradient direction."
}], "Text",ExpressionUUID->"b6c0ad3e-c3bd-47c6-888c-db07673b3562"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rhs37", "[", 
    RowBox[{"w_", ",", "u_", ",", "dTm_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"G", "eps", 
         RowBox[{"dTm", ".", "u"}]}], "-", 
        RowBox[{"c0", "w"}]}], ")"}], "/", "I0"}], ",", 
     RowBox[{"-", 
      RowBox[{"Cross", "[", 
       RowBox[{"w", ",", "u"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lamsym", "=", 
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2", ",", "l3"}], "}"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eqs. (38)-(39)\>\"", 
      ",", "\"\<u = e_k, w^b = (G eps lambda_k / c0) e_k is a fixed point of \
(37)\>\"", ",", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"Range", "[", "3", "]"}], ",", 
        RowBox[{
         RowBox[{"zeroQ", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"rhs37", "[", 
            RowBox[{
             RowBox[{"G", "eps", 
              RowBox[{
               RowBox[{"lamsym", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "/", "c0"}], 
              RowBox[{"UnitVector", "[", 
               RowBox[{"3", ",", "#"}], "]"}]}], ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"3", ",", "#"}], "]"}], ",", 
             RowBox[{"DiagonalMatrix", "[", "lamsym", "]"}]}], "]"}], "]"}], 
          "]"}], "&"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (40)\>\"", 
      ",", "\"\<lab angular velocity R w^b_k = (G eps lambda_k/c0) Z when R \
e_k = Z\>\"", ",", "True", 
      ",", "\"\<Immediate: R w^b_k = (G eps lambda_k/c0) R e_k and R e_k = Z \
by definition of the fixed point.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",Exp\
ressionUUID->"83ec5e05-744b-4cdd-af2e-aba4e3b278d4"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eqs. (38)-(39)",
  FontWeight->"Bold"],
 ":   ",
 "u = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "cb7b7e32-cd4c-409f-af1d-a684a114f638"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "c2180020-73fa-47c1-bd56-a17568e918bd"],
 " = (G \[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ad4c7312-e3d3-4a90-adb5-1f0b6a1003a0"],
 " / c0) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "0cebb5be-df13-4871-b9aa-76f578bbd5b1"],
 " is a fixed point of (37)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"28a93d4a-5bf6-47fd-b180-c717bb0a3963"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["Eq. (40)",
  FontWeight->"Bold"],
 ":   ",
 "lab angular velocity R ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "3cf2570f-2081-4a8e-bba8-b25998802d82"],
 "_k = (G \[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "1f34974b-78e8-4ee2-acbc-f7c804e1091d"],
 "/c0) Z when R ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "456f749b-2370-4f32-b2e8-bacbbc868c2a"],
 " = Z",
 "\n",
 StyleBox["Immediate: R ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["w", "b"], TraditionalForm]],ExpressionUUID->
  "8c68124d-2e95-4e08-a698-441670525474"],
 StyleBox["_k = (G \[CurlyEpsilon] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e25f2d3f-869c-4213-9a03-eae43b13d359"],
 StyleBox["/c0) R ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "50543a72-3a4e-48fb-aeb3-3ac8275b68eb"],
 StyleBox[" and R ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", 
    StyleBox["k",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "74c7fa9c-fde4-4c7b-bdaa-91bd975b3c3d"],
 StyleBox[" = Z by definition of the fixed point.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"464f41a2-e6e7-44a4-ba31-250a6dd2d386"],

Cell[TextData[{
 StyleBox["Stability of the three eigenmotions.",
  FontWeight->"Bold"],
 " Linearising Eq. (37) about the fixed point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"]}], TraditionalForm]],ExpressionUUID->
  "44040655-4c7d-4c18-a367-706f0310d166"],
 " with perturbation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox["\[Sum]", 
     RowBox[{"j", "\[NotEqual]", " ", "k"}]], "\[Delta]", " ", 
    SubscriptBox["u", "j"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "j"]}], TraditionalForm]],ExpressionUUID->
  "969dc8bc-f6a9-4f8d-bf76-8c70f982ebba"],
 ", the deviation decays or grows at rate:"
}], "Text",ExpressionUUID->"00c2e0c8-5b59-45bf-a574-f7d8561a0043"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Sigma]", 
    RowBox[{"k", "j"}]], " ", "=", " ", 
   FractionBox[
    RowBox[{"G", "\[CurlyEpsilon]", "(", 
     SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
     SubscriptBox["\[Lambda]", "j"], ")", 
     SubscriptBox["\[Lambda]", "j"]}], 
    RowBox[{
     SubscriptBox["I", "0"], 
     SubscriptBox["c", "0"]}]], " ", "\:2003", " ", "(", "j", " ", "\[NotEqual]",
    " ", "k", ")", " ", "."}], TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(41)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"e60f248b-cda3-46da-bf9b-37f2bcc903fe"],

Cell[TextData[{
 "The fixed point ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], TraditionalForm]],ExpressionUUID->
  "cc5a97ec-c3a3-4106-82fc-5dc4eed98e27"],
 " is stable if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"k", "j"}]], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"c1f9b331-c3ea-4c34-870f-f4442b1b7825"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "\[NotEqual]", " ", "k"}], TraditionalForm]],
  ExpressionUUID->"2cd536fc-dc80-490e-b776-5848790fb4b4"],
 ". For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "k"], TraditionalForm]],ExpressionUUID->
  "b75667e6-cf6c-403e-a311-c97b74b57632"],
 " the largest eigenvalue, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "j"], ")", " ", ">", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"93cd4671-2c8b-4c23-b874-68d39331fc19"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "j"], " ", "<", " ", 
    SubscriptBox["\[Lambda]", "k"]}], TraditionalForm]],ExpressionUUID->
  "a72265e4-bc38-4754-80e3-7cf6558ee812"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"k", "j"}]], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"f7ab66ae-96da-47bb-971b-0c3b9eb93aa3"],
 " requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "j"], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"da0aeddc-a904-4c6f-8918-13f28fb725c6"],
 "; alternatively, if all eigenvalues are positive, stability requires ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "k"], " ", "<", " ", 
    SubscriptBox["\[Lambda]", "j"]}], TraditionalForm]],ExpressionUUID->
  "644042e2-f292-4c99-b1a0-ae5c15a76ec2"],
 ". In general the sign of ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "3ac6d2d5-f7c8-49d9-b2e4-7f6cef301701"],
 " depends on the body: the stable attractor is the orientation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], TraditionalForm]],ExpressionUUID->
  "0819e202-fae1-49d5-a5de-d49e8807f6cc"],
 " for which ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"k", "j"}]], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"a7be37c2-2aa3-4b52-9335-c22ec97d1f31"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "\[NotEqual]", " ", "k"}], TraditionalForm]],
  ExpressionUUID->"d341cb9c-6595-4e40-8773-7ed2b1d9414d"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "j"], ")", 
    SubscriptBox["\[Lambda]", "j"], " ", "<", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"df045cd8-cc2b-4a79-858c-2088a63203a7"],
 " for all ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "38f53820-a8af-4184-86ff-66297235f2ea"],
 ", which is guaranteed when ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "k"], TraditionalForm]],ExpressionUUID->
  "7237ec3f-7622-4821-94c8-818900b3c938"],
 " is the eigenvalue of largest magnitude with sign opposite to all others, \
or when all ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "j"], TraditionalForm]],ExpressionUUID->
  "87dcc79d-2e10-4b8d-907c-ff2f4f9f3aa6"],
 " have the same sign and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "k"], TraditionalForm]],ExpressionUUID->
  "bda6e9b1-2d13-4d52-9c5e-6775c2f8d384"],
 " is the largest. For the common case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "3"], " ", ">", " ", 
    SubscriptBox["\[Lambda]", "2"], " ", ">", " ", 
    SubscriptBox["\[Lambda]", "1"], " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"8bc24e94-ec13-4d20-8b77-447b3a077af5"],
 " the largest eigenvalue ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "3"], TraditionalForm]],ExpressionUUID->
  "7d0b7a55-aa9c-42c9-8694-c2b1cb9886df"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     RowBox[{"3", "j"}]], " ", "=", " ", "G", "\[CurlyEpsilon]", "(", 
    SubscriptBox["\[Lambda]", "3"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "j"], ")", 
    SubscriptBox["\[Lambda]", "j"], "/", "(", 
    SubscriptBox["I", "0"], 
    SubscriptBox["c", "0"], ")", " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"56b873c8-0850-4aa2-ac74-0e0d48ba6c96"],
 " (all terms positive), which is ",
 StyleBox["unstable",
  FontSlant->"Italic"],
 ". The stable attractor is then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "6bc6c1c9-23a7-4b14-9277-a13009f0ca66"],
 " (smallest eigenvalue). The general rule is: *the stable orientation is the \
eigenvector of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "6158d7d8-b6f4-4f4e-bd96-4043ed34524e"],
 " that maximises ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", 
    StyleBox["u",
     FontWeight->"Bold"], ")", " ", "=", " ", "-", 
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "\[Transpose]"], "\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "3f00a036-254f-4e3f-8854-2ec62968d0c9"],
 StyleBox[", i.e. the eigenvector with the most-negative eigenvalue when the \
gradient drives alignment, or equivalently the orientation that minimises the \
thermophoretic torque-gradient product. The three eigenmotions therefore have \
the following stability character",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"2b7fed83-3dab-4c3b-80bb-79f410933b48"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"Eigenmotion", "Eigenvalue", "Stability"},
   {
    FormBox[
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold"], "1"],
     TraditionalForm], 
    RowBox[{
     FormBox[
      SubscriptBox["\[Lambda]", "1"],
      TraditionalForm], 
     RowBox[{" ", 
      RowBox[{"(", "smallest", ")"}]}]}], 
    RowBox[{"unstable", " ", 
     RowBox[{"(", "repeller", ")"}]}]},
   {
    FormBox[
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold"], "2"],
     TraditionalForm], 
    RowBox[{
     FormBox[
      SubscriptBox["\[Lambda]", "2"],
      TraditionalForm], 
     RowBox[{" ", 
      RowBox[{"(", "middle", ")"}]}]}], 
    RowBox[{"saddle", " ", 
     RowBox[{"(", "unstable", ")"}]}]},
   {
    FormBox[
     SubscriptBox[
      StyleBox["e",
       FontWeight->"Bold"], "3"],
     TraditionalForm], 
    RowBox[{
     FormBox[
      SubscriptBox["\[Lambda]", "3"],
      TraditionalForm], 
     RowBox[{" ", 
      RowBox[{"(", "largest", ")"}]}]}], 
    RowBox[{"stable", " ", "attractor"}]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxBackground->{"Rows" -> {
      RGBColor[0.9, 0.93, 0.97], None}},
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.6}}}]],
 FontFamily->
  "Source Sans Pro",ExpressionUUID->"7b076980-c7bf-4679-ad70-1fce1decfdcc"]], \
"Text",ExpressionUUID->"9b59bb2e-369c-4eca-88a9-122ae733ff28"],

Cell[TextData[{
 "All generic initial conditions converge to eigenmotion 3: the body aligns \
the axis with the largest eigenvalue of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "e90469e6-1dd4-46e1-8c49-f7854697befd"],
 " with the temperature gradient. This maximises the Lyapunov function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", 
    StyleBox["u",
     FontWeight->"Bold"], ")", " ", "=", " ", 
    SuperscriptBox[
     StyleBox["u",
      FontWeight->"Bold"], "\[Transpose]"], "\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "39a55dfa-6a41-46a3-8618-5a059d5cb6f5"],
 ", which measures the projection of the thermophoretic torque onto the \
gradient direction."
}], "Text",ExpressionUUID->"64eb023d-f67b-470c-85ef-df5f530dddfb"],

Cell[TextData[{
 StyleBox["Physical interpretation.",
  FontWeight->"Bold"],
 " The body rotates until the torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "4eb7b65d-5f8f-4051-9691-66a66c788882"],
 " is parallel to the driving field ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "cb54ab01-cd89-4c99-868a-3fb59efc5fe9"],
 ", leaving no torque component perpendicular to ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "d3ab884e-2977-498e-9e34-38edc123b92a"],
 " to drive further reorientation. Among the three possible aligned \
orientations only the one with the largest eigenvalue is stable: a \
perturbation away from this orientation generates a restoring torque that \
drives the body back. This is not a minimisation of rotational energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", 
     StyleBox["rot",
      FontSlant->"Plain"]], " ", "\[Proportional]", " ", 
    SubsuperscriptBox["\[Lambda]", "k", "2"]}], TraditionalForm]],
  ExpressionUUID->"2eac8056-65ba-4897-afa9-99c8fe3bb05e"],
 " (which is also maximised at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "3"], TraditionalForm]],ExpressionUUID->
  "c1f6489c-788e-4ccf-a76f-684ff1187c00"],
 ") but rather a maximisation of the torque-gradient alignment ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "8455f6f1-29bf-4c26-b227-af06f12abaa5"],
 "."
}], "Text",ExpressionUUID->"17a7a919-552f-4424-a43b-be90bbe3b1dd"],

Cell[TextData[{
 StyleBox["Verification of (41) and the stability statements.",
  FontWeight->"Bold"],
 " The text gives two opposite conclusions for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "3"], " ", ">", " ", 
    SubscriptBox["\[Lambda]", "2"], " ", ">", " ", 
    SubscriptBox["\[Lambda]", "1"], " ", ">", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"e2c4e34e-9aa5-458f-8319-74c89269ee78"],
 ": first that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "16371c02-7e72-4a6f-8bd0-fd414f84d715"],
 " is the attractor, then (table and following paragraph) that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "211f067f-3ff0-492d-9b63-62668b399eb6"],
 " is. We settle this with the exact linearisation of (37) about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ",", " ", 
    StyleBox["u",
     FontWeight->"Bold"], ")", " ", "=", " ", "(", "G", "\[CurlyEpsilon]", 
    SubscriptBox["\[Lambda]", "k"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"], "/", 
    SubscriptBox["c", "0"], ",", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "k"], ")"}], TraditionalForm]],ExpressionUUID->
  "f3f1358c-2add-43f1-b0cc-cc946177ee97"],
 ", working in the eigenbasis of a symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "66a593db-5a66-43e3-93af-400020db465d"],
 ". The characteristic polynomial factorises into a neutral mode (the \
constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["u",
     FontWeight->"Bold"], "|", " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"48f16c2c-910a-496c-930c-4e25c7836bc9"],
 "), an axial spin-down at rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "0"], "/", 
    SubscriptBox["I", "0"]}], TraditionalForm]],ExpressionUUID->
  "e142aaa8-4783-482b-8517-3e96d5040f65"],
 ", and a quartic that governs the transverse dynamics."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"d89dcce6-8140-4efe-8664-e6f3515056c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"jac37", "[", "k_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vars", "=", 
        RowBox[{"{", 
         RowBox[{
         "w1", ",", "w2", ",", "w3", ",", "u1", ",", "u2", ",", "u3"}], 
         "}"}]}], ",", "st"}], "}"}], ",", 
     RowBox[{
      RowBox[{"st", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"G", "eps", 
          RowBox[{
           RowBox[{"lamsym", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "/", "c0"}], 
          RowBox[{"UnitVector", "[", 
           RowBox[{"3", ",", "k"}], "]"}]}], ",", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"3", ",", "k"}], "]"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"rhs37", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"u1", ",", "u2", ",", "u3"}], "}"}], ",", 
            RowBox[{"DiagonalMatrix", "[", "lamsym", "]"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "vars", "}"}]}], "]"}], "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{"vars", "->", "st"}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"charPoly", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Factor", "[", 
      RowBox[{"CharacteristicPolynomial", "[", 
       RowBox[{
        RowBox[{"jac37", "[", "k", "]"}], ",", "s"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"quartic", "[", "k_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fl", "=", 
       RowBox[{"FactorList", "[", 
        RowBox[{"Numerator", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"charPoly", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
     
     RowBox[{"Expand", "[", 
      RowBox[{"First", "@", 
       RowBox[{"SelectFirst", "[", 
        RowBox[{"fl", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Exponent", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "s"}], "]"}], "==", "4"}], 
          "&"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TraditionalForm", "[", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"quartic", "[", "3", "]"}], ",", "s", ",", "Factor"}], "]"}], 
  "]"}]}], "Input",ExpressionUUID->"dda0ff51-48a2-418d-8ac0-ba5319fe89e2"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["s", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["c0", "4"], "+", 
       RowBox[{
        SuperscriptBox["eps", "2"], " ", 
        SuperscriptBox["G", "2"], " ", 
        SuperscriptBox["I0", "2"], " ", 
        SuperscriptBox["l3", "2"]}]}], ")"}]}], "+", 
    RowBox[{"2", " ", 
     SuperscriptBox["c0", "3"], " ", "I0", " ", 
     SuperscriptBox["s", "3"]}], "+", 
    RowBox[{
     SuperscriptBox["c0", "2"], " ", 
     SuperscriptBox["eps", "2"], " ", 
     SuperscriptBox["G", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"l1", "-", "l3"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"l2", "-", "l3"}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["c0", "2"], " ", 
     SuperscriptBox["I0", "2"], " ", 
     SuperscriptBox["s", "4"]}], "-", 
    RowBox[{"c0", " ", 
     SuperscriptBox["eps", "2"], " ", 
     SuperscriptBox["G", "2"], " ", "I0", " ", "l3", " ", "s", " ", 
     RowBox[{"(", 
      RowBox[{"l1", "+", "l2", "-", 
       RowBox[{"2", " ", "l3"}]}], ")"}]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Output",ExpressionUUID->"13a6d637-fd22-4337-99bd-\
4d86b6962e4f"]
}, Open  ]],

Cell[TextData[{
 "The quartic for eigenmotion ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "e911c121-a7df-4bbb-aadf-09e796a17104"],
 " (with ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "1e50c1da-d00c-4ec4-9a35-265e9f0d5e24"],
 ", ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "eaa22451-0fc8-4575-9bb4-6ace8756196a"],
 " the other two indices and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", " ", "\[Congruent]", " ", "G", "\[CurlyEpsilon]"}], 
   TraditionalForm]],ExpressionUUID->"177ecd62-3256-4472-bcfe-0d74c7b1d176"],
 ") is"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"5acc7dbe-f877-4503-b4b5-8d55f4ef1ff8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["c", "0", "2"], 
   SubsuperscriptBox["I", "0", "2"], 
   SuperscriptBox["s", "4"], " ", "+", " ", "2", 
   SubsuperscriptBox["c", "0", "3"], 
   SubscriptBox["I", "0"], 
   SuperscriptBox["s", "3"], " ", "+", " ", "(", 
   SubsuperscriptBox["c", "0", "4"], " ", "+", " ", 
   SuperscriptBox["g", "2"], 
   SubsuperscriptBox["I", "0", "2"], 
   SubsuperscriptBox["\[Lambda]", "k", "2"], ")", 
   SuperscriptBox["s", "2"], " ", "+", " ", 
   SubscriptBox["c", "0"], 
   SuperscriptBox["g", "2"], 
   SubscriptBox["I", "0"], 
   SubscriptBox["\[Lambda]", "k"], "(", "2", 
   SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
   SubscriptBox["\[Lambda]", "j"], " ", "-", " ", 
   SubscriptBox["\[Lambda]", "l"], ")", "s", " ", "+", " ", 
   SubsuperscriptBox["c", "0", "2"], 
   SuperscriptBox["g", "2"], "(", 
   SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
   SubscriptBox["\[Lambda]", "j"], ")", "(", 
   SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
   SubscriptBox["\[Lambda]", "l"], ")", " ", "=", " ", "0", " ", "."}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"d6a1129f-82e1-41ac-\
be29-ae8d3374a6db"],

Cell[TextData[{
 "Routh\[Dash]Hurwitz applied to it gives the exact stability conditions. For \
weak inertia (",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", 
    SubscriptBox["I", "0"], "\[Lambda]", "/", 
    SubsuperscriptBox["c", "0", "2"], " ", "\[LessLess]", " ", "1"}], 
   TraditionalForm]],ExpressionUUID->"760a3195-a329-4a17-9a28-c9275e4d843b"],
 ") they reduce to (a) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "j"], ")", "(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "l"], ")", " ", ">", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"abf8cbf1-b3b0-49c0-b07d-01838bd27acc"],
 ", meaning ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "k"], TraditionalForm]],ExpressionUUID->
  "5b05edfa-dfc9-48d1-b432-a1c8b142a18d"],
 " must be the largest or the smallest eigenvector (the middle one is always \
a saddle), and (b) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Lambda]", "j"], "(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "l"], ")", " ", "+", " ", 
    SubscriptBox["\[Lambda]", "l"], "(", 
    SubscriptBox["\[Lambda]", "k"], " ", "-", " ", 
    SubscriptBox["\[Lambda]", "j"], ")", " ", ">", " ", "0"}], 
   TraditionalForm]],ExpressionUUID->"440b9b1e-f79b-427d-9db5-0e9747ff748c"],
 ". The transverse relaxation rate is of order ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "2"], 
    SubscriptBox["I", "0"], 
    SuperscriptBox["\[Lambda]", "2"], "/", 
    SubsuperscriptBox["c", "0", "3"]}], TraditionalForm]],ExpressionUUID->
  "a4532fd6-ad88-4147-bb11-6421e5c0c873"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "\[Lambda]", "/", "(", 
    SubscriptBox["I", "0"], 
    SubscriptBox["c", "0"], ")"}], TraditionalForm]],ExpressionUUID->
  "bb9adf4c-2e5b-4940-ae57-5fb2b48fff8b"],
 ". In particular (41) is not even dimensionally a rate:"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"4e129b83-e4e9-4af0-9dcc-2081e621641c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hurwitzStable", "[", 
    RowBox[{"k_", ",", "vals_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cf", "=", 
        RowBox[{"CoefficientList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"quartic", "[", "k", "]"}], "/.", "vals"}], ",", "s"}], 
         "]"}]}], ",", "a0", ",", "a1", ",", "a2", ",", "a3", ",", "a4"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a0", ",", "a1", ",", "a2", ",", "a3", ",", "a4"}], "}"}], "=",
        "cf"}], ";", 
      RowBox[{
       RowBox[{"And", "@@", 
        RowBox[{"Thread", "[", 
         RowBox[{"cf", ">", "0"}], "]"}]}], "&&", 
       RowBox[{
        RowBox[{"a3", "a2", "a1"}], ">", 
        RowBox[{
         RowBox[{
          RowBox[{"a1", "^", "2"}], "a4"}], "+", 
         RowBox[{
          RowBox[{"a3", "^", "2"}], "a0"}]}]}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numVals", "[", "lv_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"l1", "->", 
      RowBox[{"lv", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"l2", "->", 
      RowBox[{"lv", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"l3", "->", 
      RowBox[{"lv", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ",", 
     RowBox[{"G", "->", "1"}], ",", 
     RowBox[{"eps", "->", "1"}], ",", 
     RowBox[{"c0", "->", "1"}], ",", 
     RowBox[{"I0", "->", "0.2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxRe", "[", 
    RowBox[{"k_", ",", "lv_"}], "]"}], ":=", 
   RowBox[{"Max", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"s", "/.", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"quartic", "[", "k", "]"}], "/.", 
         RowBox[{"numVals", "[", "lv", "]"}]}], ",", "s"}], "]"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cases", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3"}], ",", 
       RowBox[{"-", "2"}], ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0.5", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", 
       RowBox[{"-", "0.5"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "2", ",", "3"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stabTab", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ToString", "[", "lv", "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"hurwitzStable", "[", 
            RowBox[{"k", ",", 
             RowBox[{"numVals", "[", "lv", "]"}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<stable\>\"", ",", 
             RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<unstable\>\"", ",", "Red"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"maxRe", "[", 
            RowBox[{"k", ",", "lv"}], "]"}], ",", "3"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lv", ",", "cases"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaUnits", "=", 
   RowBox[{
    RowBox[{"Quantity", "[", 
     RowBox[{"1", ",", 
      RowBox[{"1", "/", "\"\<Meters\>\""}]}], "]"}], 
    RowBox[{
     RowBox[{"Quantity", "[", 
      RowBox[{"1", ",", 
       RowBox[{"\"\<Newtons\>\"", 
        RowBox[{"\"\<Meters\>\"", "^", "2"}]}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Quantity", "[", 
        RowBox[{"1", ",", 
         RowBox[{"\"\<Kilograms\>\"", 
          RowBox[{"\"\<Meters\>\"", "^", "2"}]}]}], "]"}], 
       RowBox[{"Quantity", "[", 
        RowBox[{"1", ",", 
         RowBox[{"\"\<Newtons\>\"", "\"\<Meters\>\"", "\"\<Seconds\>\""}]}], 
        "]"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Flatten", "/@", "stabTab"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
         RowBox[{"{", 
          
          RowBox[{"\"\<{lambda1, lambda2, lambda3}\>\"", ",", "\"\<e1\>\"", 
           ",", "\"\<e2\>\"", ",", "\"\<e3\>\"", ",", "\"\<max Re s (e1)\>\"",
            ",", "\"\<max Re s (e2)\>\"", ",", "\"\<max Re s (e3)\>\""}], 
          "}"}]}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Background", "->", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (41)\>\"", 
      ",", "\"\<sigma_kj = G eps (lambda_k - lambda_j) lambda_j/(I0 c0) has \
units of a rate (1/s)\>\"", ",", 
      RowBox[{"CompatibleUnitQ", "[", 
       RowBox[{"sigmaUnits", ",", 
        RowBox[{"Quantity", "[", 
         RowBox[{"1", ",", 
          RowBox[{"1", "/", "\"\<Seconds\>\""}]}], "]"}]}], "]"}], ",", 
      RowBox[{"\"\<Units of (41): \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"UnitSimplify", "[", "sigmaUnits", "]"}], "]"}], 
       "<>", "\"\< (with [G] = 1/m, [eps dT_th] = N m^2, [I0] = kg m^2, [c0] \
= N m s). The exact rate scales as (G eps)^2 I0 lambda^2/c0^3.\>\""}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2\>\"", 
      ",", "\"\<'for lambda3 > lambda2 > lambda1 > 0 ... the stable attractor \
is then e1'\>\"", ",", 
      RowBox[{"hurwitzStable", "[", 
       RowBox[{"1", ",", 
        RowBox[{"numVals", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "]"}], 
      ",", "\"\<Exact analysis: for a positive spectrum e3 is stable and e1 \
unstable, as in the table that follows.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2 table\>\"", 
      ",", "\"\<positive spectrum: e1 repeller, e2 saddle, e3 stable \
attractor\>\"", ",", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"hurwitzStable", "[", 
         RowBox[{"1", ",", 
          RowBox[{"numVals", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "]"}]}], "&&", 
       
       RowBox[{"!", 
        RowBox[{"hurwitzStable", "[", 
         RowBox[{"2", ",", 
          RowBox[{"numVals", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "]"}]}], "&&", 
       
       RowBox[{"hurwitzStable", "[", 
        RowBox[{"3", ",", 
         RowBox[{"numVals", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "]"}]}]}], 
     "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Sec. 2.2\>\"", 
      ",", "\"\<'all generic initial conditions converge to eigenmotion 3' \
(general spectra)\>\"", ",", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"cases", ",", 
        RowBox[{
         RowBox[{"hurwitzStable", "[", 
          RowBox[{"3", ",", 
           RowBox[{"numVals", "[", "#", "]"}]}], "]"}], "&"}]}], "]"}], 
      ",", "\"\<True only when the spectrum is positive. For a negative \
spectrum e1 (the largest |lambda|) is the attractor; for some mixed-sign \
spectra, such as {-1, 0.5, 2}, no eigenmotion is stable at all.\>\""}], 
     "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->"9bee58d5-3b5a-445c-\
9083-6dbb31a20ff8"],

