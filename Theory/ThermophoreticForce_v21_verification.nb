Cell[CellGroupData[{

Cell["1.7 Tensor simplification by geometric symmetry", "Subsection",ExpressionUUID->"aa358c5b-5eae-4b86-b44b-71fa3de84bdf"],

Cell["\<\
The 27 DOF of a generic body reduce dramatically when the body has geometric \
symmetry. We organise the simplification into three levels, from most general \
to most symmetric.\
\>", "Text",ExpressionUUID->"017f2897-00ef-44e3-9f36-7e16312d0607"],

Cell[TextData[{
 StyleBox["Level 1 \[LongDash] Generic asymmetric body (27 DOF).",
  FontWeight->"Bold"],
 " All four tensors are full matrices with their maximum DOF:"
}], "Text",ExpressionUUID->"fcb11185-72e8-492e-8df7-3df4569c0979"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], ":", " ", "6", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], ":", " ", "6", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], ":", " ", "9", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], ":", " ", "6", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(27)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"b3be9741-1682-4580-ac34-f4985e519b1a"],

Cell[TextData[{
 "Examples: a helix, an asymmetric two-sphere aggregate, any body lacking \
mirror-plane symmetry. The thermophoretic torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "\[NotEqual]", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"e958a641-11e2-44a8-862e-013d4226675f"],
 " drives steady rotation and, via the coupling to translation, circular \
orbits (Section 2.2)."
}], "Text",ExpressionUUID->"ebf0543e-02cc-44c9-9d28-486a1cb670f5"],

Cell[TextData[{
 StyleBox["Level 2 \[LongDash] Three mutually perpendicular mirror planes (18 \
DOF).",
  FontWeight->"Bold"],
 " The mirror symmetry cancels all off-diagonal elements of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b27a00aa-6f2d-4fde-b609-31216e0435a7"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "58053e43-b940-4043-9b01-d96c9c5c1427"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7aa86d13-dd76-4984-a905-4ec6a466e8c9"],
 ", and forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"ac871a53-c9e7-415a-849b-527981855355"],
 " (Garcia-Ybarra & Rosner 1989):"
}], "Text",ExpressionUUID->"41c6e554-3006-4c02-b079-da605f4e5d4d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   StyleBox["diag",
    FontSlant->"Plain"], "(", 
   SubscriptBox["f", "1"], ",", " ", 
   SubscriptBox["f", "2"], ",", " ", 
   SubscriptBox["f", "3"], ")", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   StyleBox["diag",
    FontSlant->"Plain"], "(", 
   SubscriptBox["d", "1"], ",", " ", 
   SubscriptBox["d", "2"], ",", " ", 
   SubscriptBox["d", "3"], ")", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   StyleBox["diag",
    FontSlant->"Plain"], "(", 
   SubscriptBox["r", "1"], ",", " ", 
   SubscriptBox["r", "2"], ",", " ", 
   SubscriptBox["r", "3"], ")", " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", "0", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(28)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"48e1231d-b8b1-42ca-ac5e-bcbbd75bf37a"],

Cell[TextData[{
 "DOF: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "3", " ", "+", " ", "3", " ", "+", " ", "0", " ", "+", " ", "3", " ", "=", 
    " ", "9"}], TraditionalForm]],ExpressionUUID->
  "fc8c1a5e-438a-4ff3-b0c1-09ea71408e40"],
 ". Bodies in this class: spheroids, cylinders, disks, rectangular blocks. \
With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"af0952e1-3a61-4afe-9170-4cf18194d213"],
 " there is no thermophoretic torque; the particle drifts without spinning."
}], "Text",ExpressionUUID->"4499a7f9-745c-4347-b04c-885a7bbbc065"],

Cell[TextData[{
 StyleBox["Level 3a \[LongDash] Uniaxial symmetry, ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["C", 
     RowBox[{"\[Infinity]", " ", "v"}]],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "45f7b520-1e88-45bf-818e-6183700d2f8e"],
 StyleBox[" (6 DOF).",
  FontWeight->"Bold"],
 " With a single symmetry axis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "3"], TraditionalForm]],ExpressionUUID->
  "5c60faf8-93aa-4cbb-aff5-4eb3c7f30d55"],
 ", the two transverse directions are equivalent: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "1"], " ", "=", " ", 
    SubscriptBox["f", "2"], " ", "\[Congruent]", " ", 
    SubscriptBox["f", "\[UpTee]"]}], TraditionalForm]],ExpressionUUID->
  "1530540c-ffa6-40d3-98d0-348162ce4933"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "3"], " ", "\[Congruent]", " ", 
    SubscriptBox["f", "\[DoubleVerticalBar]"]}], TraditionalForm]],
  ExpressionUUID->"ad5d201c-b7af-484d-9848-4dbec145b487"],
 " (and similarly for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "631b9581-41f6-4b97-8ced-238de349a9f5"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6c8f55f1-cfc2-4f2e-bbe3-d45cb137b07e"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"e1c8198d-51c8-42fa-ba18-5fff8e6934cb"],
 ":"
}], "Text",ExpressionUUID->"c1ccabaf-2e67-420a-865e-97208ed8d1f9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   StyleBox["diag",
    FontSlant->"Plain"], "(", 
   SubscriptBox["f", "\[UpTee]"], ",", " ", 
   SubscriptBox["f", "\[UpTee]"], ",", " ", 
