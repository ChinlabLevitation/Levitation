Cell[TextData[{
 StyleBox["Levitation condition to first order in ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox["\[CurlyEpsilon]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "23e92af0-10fd-4d75-9742-fb8efe243d74"],
 StyleBox[".",
  FontWeight->"Bold"],
 " The lab-frame vertical velocity is obtained by projecting Eq. (43) onto ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "fc0eee10-28f6-44f4-b39f-e9fa2178499b"],
 " (using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "Z"], " ", "=", " ", 
    OverscriptBox["Z", "^"], "\[CenterDot]", " ", "R", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], " ", "=", " ", 
    StyleBox["u",
     FontWeight->"Bold"], "\[CenterDot]", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"]}], TraditionalForm]],ExpressionUUID->
  "0ea575fc-3562-43f5-88db-9c7df8c73cac"],
 "):"
}], "Text",ExpressionUUID->"5b79d704-195a-4506-91ca-00d56ac7691c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["v", "Z"], " ", "=", " ", 
   FractionBox[
    RowBox[{
     SubscriptBox["\[Gamma]", "0"], "G", " ", "-", " ", "M", "g"}], 
    SubscriptBox["\[Xi]", "0"]], " ", "+", " ", "\[CurlyEpsilon]", " ", "G", "\[ThinSpace]", 
   SubscriptBox[
    RowBox[{"(", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], ")"}], "33"], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(44)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"dced90f0-e1cb-4b23-bde6-a7d503d4ebfe"],

Cell["where we define the anisotropic mobility tensor", "Text",ExpressionUUID->"e8c2abc9-91ed-44ee-8c88-4f4c4ec45a1f"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Delta]", 
   StyleBox["A",
    FontWeight->"Bold"], " ", "\[Congruent]", " ", 
   FractionBox["1", 
    SubscriptBox["\[Xi]", "0"]], "(", "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "-", " ", 
   SubscriptBox["A", "0"], "\[ThinSpace]", "\[Delta]", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], ")", " ", ",", " ", "\:2003", " ", 
   SubscriptBox["A", "0"], " ", "\[Congruent]", " ", 
   FractionBox[
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox["\[Xi]", "0"]], " ", ","}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(45)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"067e8e59-a339-4292-9e17-13c46df73827"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", "\[Delta]", 
      StyleBox["A",
       FontWeight->"Bold"], ")"}], "33"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], "\[CenterDot]", "\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"]}], TraditionalForm]],ExpressionUUID->
  "c30e7c20-1b8a-45fd-9e7a-6612def5a193"],
 " is its component along the precession axis. The ",
 StyleBox["full",
  FontSlant->"Italic"],
 " levitation condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\:3008", " ", 
    SubscriptBox["v", "Z"], "\:3009", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"76110620-f7b9-4cf1-8ecd-af14809b32a0"],
 " applied to Eq. (44) gives a single equation for the required \
temperature-gradient magnitude:"
}], "Text",ExpressionUUID->"c6703949-3152-461b-b187-0edda684fab7"],

Cell[BoxData[
 FormBox[
  RowBox[{"G", " ", "=", " ", 
   FractionBox[
    RowBox[{"M", "g"}], 
    RowBox[{
     SubscriptBox["\[Gamma]", "0"], " ", "+", " ", "\[CurlyEpsilon]", 
     SubscriptBox["\[Xi]", "0"], 
     SubscriptBox[
      RowBox[{"(", "\[Delta]", 
       StyleBox["A",
        FontWeight->"Bold"], ")"}], "33"]}]], " ", "=", " ", 
   FractionBox[
    RowBox[{"M", "g"}], 
    SubscriptBox["\[Gamma]", "0"]], "[", "1", " ", "-", " ", 
   "\[CurlyEpsilon]", " ", 
   SubscriptBox["A", "0"], 
   SubscriptBox[
    RowBox[{"(", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], ")"}], "33"], " ", "+", " ", "O", "(", 
   SuperscriptBox["\[CurlyEpsilon]", "2"], ")", "]", " ", "."}], 
  TraditionalForm]], "DisplayFormula",
 CellFrameLabels->{{None, 
    Cell["(46)", "Text", FontSize -> 12]}, {
   None, None}},ExpressionUUID->"5f858b5a-ffc3-4c84-accc-9d3b883f0c3d"],

Cell[TextData[{
 "The zeroth-order levitation gradient is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "0"], " ", "=", " ", "M", "g", "/", 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "e459bbd5-76de-4dc3-b13c-38e5e78bf8e7"],
 ", and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"7fa08e12-1342-4ea5-828a-32c8728b1151"],
 " correction shifts ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "b1ec1146-5af3-460f-bdbb-c5eb8ccd4aaa"],
 " by an amount proportional to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], ")"}], "33"], TraditionalForm]],ExpressionUUID->
  "3c2b7614-97a2-4f0a-96c5-c36c985ac33c"],
 ": the asymmetry of the body modifies the gradient needed to keep the \
particle suspended. There is no separate constraint on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", "\[Delta]", 
     StyleBox["A",
      FontWeight->"Bold"], ")"}], "33"], TraditionalForm]],ExpressionUUID->
  "82d4d4ec-779a-46e7-afde-c256229e8a3a"],
 "; it is a property of the particle shape that the experimenter accommodates \
by tuning ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "70362124-a24a-4f16-9eef-8f311df6623f"],
 "."
}], "Text",ExpressionUUID->"91a581d8-4163-4690-83e5-dec5d14c82d2"],

Cell[TextData[{
 StyleBox["Verification of (44)\[Dash](46).",
  FontWeight->"Bold"],
 " Project (43) on ",
 Cell[BoxData[
  FormBox[
   StyleBox["u",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "030865a2-c224-459f-963f-4c110b581e69"],
 " and compare with (44). The drag correction in (43) is multiplied by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Gamma]", "0"], "G", " ", "-", " ", "M", "g", ")"}], 
   TraditionalForm]],ExpressionUUID->"e049afe3-8b49-4439-bfaf-4f44db83f336"],
 ", but (45) replaces that factor by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "G"}], TraditionalForm]],ExpressionUUID->
  "a9978e10-7325-45e7-a828-8eaebf0748c2"],
 ", dropping the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "M", "g"}], TraditionalForm]],ExpressionUUID->
  "78a0f94e-6351-45bc-aefc-cb3345682c35"],
 ". Near levitation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Gamma]", "0"], "G", " ", "-", " ", "M", "g", ")", " ", "=",
     " ", "O", "(", "\[CurlyEpsilon]", ")"}], TraditionalForm]],
  ExpressionUUID->"4678d46c-47db-40cf-8dff-7165c085d564"],
 ", so the drag term is really ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"acc6a95c-7094-45d7-8a84-c22d0c88fcd7"],
 " and drops out. The exact levitation condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["u",
     FontWeight->"Bold"], "\[CenterDot]", 
    SubsuperscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"], 
     RowBox[{"-", "1"}]], "(", "G", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "-", " ", "M", "g", ")", 
    StyleBox["u",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"3ea9da6e-eeb1-4f9c-b242-aa07e6f45302"],
 ", expanded in ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "af79db83-9a58-4b96-b35b-731f4ceb7267"],
 ", gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", "M", "g", "/", "(", 
    SubscriptBox["\[Gamma]", "0"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
     "\[Delta]", " ", 
    SubscriptBox["f", 
     StyleBox[
      RowBox[{"th", ",", "33"}],
      FontSlant->"Plain"]], ")", " ", "+", " ", "O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"c1ba1702-edeb-4864-a187-8d05f3f86c5d"],
 ": ",
 StyleBox["drag anisotropy does not enter the levitation gradient at first \
order.",
  FontWeight->"Bold"],
 " Separately, the two forms written in (46) disagree with each other unless ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "0"], " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"33746875-bdba-4516-9c9f-b9c698e4d279"],
 "."
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellFrameColor->RGBColor[0.85, 0.55, 0.15],
 Background->RGBColor[
  0.985, 0.965, 0.92],ExpressionUUID->"9b9548b6-dea6-4744-af84-45571021a47b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"uE3", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vZexact", "=", 
   RowBox[{"uE3", ".", 
    RowBox[{"(", 
     RowBox[{"vb42", "/.", 
      RowBox[{"Thread", "[", 
       RowBox[{"uvec", "->", "uE3"}], "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vZpdf", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gam0", "G"}], "-", 
       RowBox[{"Mm", "gg"}]}], ")"}], "/", "xi0"}], "+", 
    RowBox[{"eps", "G", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dfth", "-", 
          RowBox[{
           RowBox[{"gam0", "/", "xi0"}], "dfdr"}]}], ")"}], "/", "xi0"}], 
       ")"}], "[", 
      RowBox[{"[", 
       RowBox[{"3", ",", "3"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vZfirst", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{"vZexact", ",", 
      RowBox[{"{", 
       RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gexact", "=", 
   RowBox[{"G", "/.", 
    RowBox[{"First", "@", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Numerator", "[", 
         RowBox[{"Together", "[", "vZexact", "]"}], "]"}], "==", "0"}], ",", 
       "G"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gfirst", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{"Gexact", ",", 
      RowBox[{"{", 
       RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gpdf46a", "=", 
   RowBox[{"Mm", 
    RowBox[{"gg", "/", 
     RowBox[{"(", 
      RowBox[{"gam0", "+", 
       RowBox[{"eps", "xi0", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"dfth", "-", 
             RowBox[{
              RowBox[{"gam0", "/", "xi0"}], "dfdr"}]}], ")"}], "/", "xi0"}], 
          ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "3"}], "]"}], "]"}]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gpdf46b", "=", 
   RowBox[{"Mm", 
    RowBox[{"gg", "/", "gam0"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"eps", 
       RowBox[{"gam0", "/", "xi0"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dfth", "-", 
            RowBox[{
             RowBox[{"gam0", "/", "xi0"}], "dfdr"}]}], ")"}], "/", "xi0"}], 
         ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", "3"}], "]"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<exact first-order vertical drift:  v_Z = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Collect", "[", 
         RowBox[{"vZfirst", ",", "eps", ",", "Simplify"}], "]"}], "]"}]}], 
      "}"}], "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<exact first-order levitation gradient:  G = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Collect", "[", 
         RowBox[{"Gfirst", ",", "eps", ",", "Simplify"}], "]"}], "]"}]}], 
      "}"}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (44)\>\"", 
      ",", "\"\<v_Z = (gamma_0 G - M g)/xi_0 + eps G (dA)_33 to first order\>\
\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"vZfirst", "-", "vZpdf"}], "]"}], 
      ",", "\"\<Exact: v_Z = (gamma_0 G - Mg)/xi_0 + (eps/xi_0)[G df_33 - \
(gamma_0 G - Mg) dd_33/xi_0]. The notes' dA replaces (gamma_0 G - Mg) by \
gamma_0 G in the drag term.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (46)\>\"", 
      ",", "\"\<levitation gradient G = Mg/(gamma_0 + eps xi_0 (dA)_33) to \
first order\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"Gpdf46a", "-", "Gexact"}], ",", 
          RowBox[{"{", 
           RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}], 
      ",", "\"\<Exact first order: G = Mg/gamma_0 (1 - eps df_33/gamma_0). \
The drag anisotropy dd_33 does not appear.\>\""}], "]"}], ",", 
    RowBox[{"verify", "[", 
     RowBox[{"\"\<Eq. (46)\>\"", 
      ",", "\"\<the two expressions in (46) agree to first order\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"Gpdf46a", "-", "Gpdf46b"}], ",", 
          RowBox[{"{", 
           RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}], 
      ",", "\"\<Expanding the first form gives 1 - eps (dA)_33/A_0, not 1 - \
eps A_0 (dA)_33.\>\""}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"b3574dd9-0f43-4eca-aa25-4ea15b47b14f"],

Cell[BoxData[
 TemplateBox[{"\"exact first-order vertical drift:  v_Z = \"", 
   TagBox[
    FormBox[
     RowBox[{
       FractionBox[
        RowBox[{"eps", " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{"-", 
                RowBox[{
                  RowBox[{"G"}], " ", "gam0", " ", 
                  RowBox[{"dd", "(", 
                    RowBox[{"3", ",", "3"}], ")"}]}]}], "+", 
              RowBox[{"gg", " ", "Mm", " ", 
                RowBox[{"dd", "(", 
                  RowBox[{"3", ",", "3"}], ")"}]}], "+", 
              RowBox[{"G", " ", "xi0", " ", 
                RowBox[{"df", "(", 
                  RowBox[{"3", ",", "3"}], ")"}]}]}], ")"}]}], 
        SuperscriptBox["xi0", "2"]], "+", 
       FractionBox[
        RowBox[{
          RowBox[{"G", " ", "gam0"}], "-", 
          RowBox[{"gg", " ", "Mm"}]}], "xi0"]}], TraditionalForm], 
    TraditionalForm, Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"068601ec-ae81-41b4-8265-\
2bad881f5974"],

Cell[BoxData[
 TemplateBox[{"\"exact first-order levitation gradient:  G = \"", 
   TagBox[
    FormBox[
     RowBox[{
       FractionBox[
        RowBox[{"gg", " ", "Mm"}], "gam0"], "-", 
       FractionBox[
        RowBox[{"eps", " ", "gg", " ", "Mm", " ", 
          RowBox[{"df", "(", 
            RowBox[{"3", ",", "3"}], ")"}]}], 
        SuperscriptBox["gam0", "2"]]}], TraditionalForm], TraditionalForm, 
    Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"ad526374-d8b5-4899-bddd-\
1b94cc9d2848"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (44)",
  FontWeight->"Bold"],
 ":   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9573baae-3e70-49dd-bac2-2958632ae941"],
 " = (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "944b9560-0386-4281-93e9-04e45ee3f8e2"],
 " G - M g)/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "d5c73032-96ed-4bf7-89a2-b2e6a8b7ddda"],
 " + \[CurlyEpsilon] G (dA)_33 to first order",
 "\n",
 StyleBox["Exact: ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", 
    StyleBox["Z",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "78492c05-5a7c-44e3-9ce1-4b34abdbd21f"],
 StyleBox[" = (",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "403d0d63-29d6-406f-b2f5-6c012302ff90"],
 StyleBox[" G - Mg)/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "c592e2dc-18e9-4b50-b214-163dfb595e03"],
 StyleBox[" + (\[CurlyEpsilon]/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b1923b40-10de-43b2-bf59-c8bf2d5d432e"],
 StyleBox[")[G ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["33",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "0d1e3a44-796d-485f-9789-e101e5e96dda"],
 StyleBox[" - (",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "864ce083-05cf-4a23-9b95-368778521add"],
 StyleBox[" G - Mg) ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["dd", 
    StyleBox["33",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8308352f-1ec2-4669-9f89-ec24ae495b15"],
 StyleBox["/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "4adc7b6a-c2d1-4bcf-8b14-ad4909139fc2"],
 StyleBox["]. The notes' dA replaces (",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "bd641109-061a-4717-9898-d0faa4b69cda"],
 StyleBox[" G - Mg) by ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6800fc65-dde6-4348-98f1-47d1b9893591"],
 StyleBox[" G in the drag term.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.75, 0.1, 0.1],
 Background->RGBColor[
  0.99, 0.92, 0.92],ExpressionUUID->"e3fda37e-b563-4b63-952a-e1b9c2135271"],

Cell[TextData[{
 StyleBox["\[WarningSign] DISCREPANCY",
  FontWeight->"Bold",
  FontColor->RGBColor[0.75, 0.1, 0.1]],
 "    ",
 StyleBox["Eq. (46)",
  FontWeight->"Bold"],
 ":   ",
 "levitation gradient G = Mg/(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "b02d65e1-54ff-4c93-9d1b-8d8a1ef69632"],
 " + \[CurlyEpsilon] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Xi]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "8394ee55-51c5-41c1-ba3c-8a44fae4f7ea"],
 " (dA)_33) to first order",
 "\n",
 StyleBox["Exact first order: G = Mg/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ab2c912b-592b-427a-9714-d290432f2ebb"],
 StyleBox[" (1 - \[CurlyEpsilon] ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["df", 
    StyleBox["33",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "91923478-da25-484c-b3b2-9eeaff6fa992"],
 StyleBox["/",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    StyleBox["0",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "1a98d520-497e-49bb-8c5a-145628ea74b0"],
 StyleBox["). The drag anisotropy ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["dd", 
    StyleBox["33",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "dbe695ca-9fa2-486c-8f61-1964f180b589"],
 StyleBox[" does not appear.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
