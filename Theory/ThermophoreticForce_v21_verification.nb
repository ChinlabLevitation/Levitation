Cell[TextData[StyleBox["Principal corrections to the notes.",
 FontWeight->"Bold"]], "Text",ExpressionUUID->"38870de0-6356-4a85-aa45-\
2e53d6f6080d"],

Cell[TextData[{
 StyleBox["Eq. (10).",
  FontWeight->"Bold"],
 " The block response pairs ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "a99282eb-68cd-456c-8464-915749e561bf"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "2830a7cf-e01e-453b-9b85-841db9260c66"],
 ". It needs three driving fields, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox[
     RowBox[{"(", "\[Del]", 
      StyleBox["ln",
       FontSlant->"Plain"], " ", "T", ")"}], "b"], ",", " ", 
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], ",", " ", 
    SuperscriptBox[
     StyleBox["\[Omega]",
      FontWeight->"Bold"], "b"], ")"}], TraditionalForm]],ExpressionUUID->
  "fa1ab562-4685-4d4a-ade1-9ef4308acc58"],
 "."
}], "ItemNumbered",ExpressionUUID->"fbf22a73-1ef6-4ce2-9c42-3c57f60fa2d0"],

Cell[TextData[{
 StyleBox["Directions.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", " ", "T", " ", "=", " ", "-", "|", "\[Del]", " ", "T", "|", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "1b790447-f513-414e-9488-1131b9ff91a6"],
 " means hot ",
 StyleBox["below",
  FontSlant->"Italic"],
 ", cold above (Sections 1.4 and 3)."
}], "ItemNumbered",ExpressionUUID->"698c261b-5424-4cdd-8d88-1d7b3d7e01b9"],

Cell[TextData[{
 StyleBox["Section 1.7.",
  FontWeight->"Bold"],
 " Three mirror planes give 9 DOF, not 18. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"636449f6-5e06-4220-9862-886bade26a79"],
 " holds for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"\[Infinity]", " ", "h"}]], TraditionalForm]],ExpressionUUID->
  "81ed5460-1f7a-495c-a66f-c6bc94302a1f"],
 " (cylinders, spheroids), not for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", 
    RowBox[{"\[Infinity]", " ", "v"}]], TraditionalForm]],ExpressionUUID->
  "86b51052-9d1c-4d1a-bf02-3a4f0e376c64"],
 ", which allows an aligning torque."
}], "ItemNumbered",ExpressionUUID->"a5e43359-7b23-4556-ac35-54be5bd4bc5b"],

Cell[TextData[{
 StyleBox["Units of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["\[Gamma]", "0"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "1b9eac93-5e79-4255-986e-a2b40dc283dc"],
 StyleBox[" (Eq. 31) and of the conversion (56).",
  FontWeight->"Bold"],
 " Both are missing a factor ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "cf140ab1-a641-42be-976f-51e0dd269aeb"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], " ", "=", " ", "\[Eta]", "\[Kappa]", 
    SuperscriptBox["\[ScriptL]", "2"], "T", "/", 
    OverscriptBox["v", "_"]}], TraditionalForm]],ExpressionUUID->
  "36ec01d1-4d70-4fe1-af9a-d0721b1e69be"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SqrtBox["\[Pi]"], "\[ThinSpace]", "m", "N", "\[Nu]", "/", 
    SqrtBox["h"], " ", "=", " ", "\[Eta]", "\[Kappa]", " ", "T", "/", 
    OverscriptBox["v", "_"]}], TraditionalForm]],ExpressionUUID->
  "b54d35e8-30aa-43e7-9174-c4491c37791d"],
 "."
}], "ItemNumbered",ExpressionUUID->"fce52788-6ef2-48ce-a566-679f9c4fd4ab"],

Cell[TextData[{
 StyleBox["Stability (Eq. 41).",
  FontWeight->"Bold"],
 " The rate formula is dimensionally inconsistent. Exact analysis: for a \
positive-definite ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "8ed3c70f-36b4-4958-8f2f-10d58b2f52a4"],
 " the largest eigenvector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "3"], TraditionalForm]],ExpressionUUID->
  "273e6a90-4d1f-4b3a-b586-1f3cbcbe6c03"],
 " is the attractor, as in the table. For a negative spectrum it is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["e",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "0c91a96a-6e3b-4bf1-9d07-8556a13bfda7"],
 ", and for some mixed spectra no eigenmotion is stable."
}], "ItemNumbered",ExpressionUUID->"b8454c2b-a153-44c4-9948-30c494646c5c"],

Cell[TextData[{
 StyleBox["Levitation and orbit (Eqs. 44\[Dash]49).",
  FontWeight->"Bold"],
 " The drag anisotropy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["drag",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "383ecbc1-a05a-4185-b6db-13ccea00be9f"],
 " enters only at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["\[CurlyEpsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"12c09032-9b16-490c-a654-ad333eb072c4"],
 ". Replace ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    StyleBox["A",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "66f9c2b5-11b1-4a94-be7f-7600ca92def6"],
 " by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], "/", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "fd3eede0-f1ba-4175-8c5c-5ce189e50250"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", "M", "g", "/", "(", 
    SubscriptBox["\[Gamma]", "0"], " ", "+", " ", "\[CurlyEpsilon]", "\[ThinSpace]",
     "\[Delta]", " ", 
    SubscriptBox["f", 
     StyleBox[
      RowBox[{"th", ",", "33"}],
      FontSlant->"Plain"]], ")"}], TraditionalForm]],ExpressionUUID->
  "1ef4e78b-0413-4bde-93d7-41d438fd7ced"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "b"], " ", "=", " ", "(", "\[CurlyEpsilon]", " ", 
    SubscriptBox["G", "0"], "/", 
    SubscriptBox["\[Xi]", "0"], ")", 
    SubscriptBox["\[CapitalPi]", "u"], "\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    StyleBox["u",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "f40ad992-52a0-4e6c-8114-64779097542f"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     StyleBox["orbit",
      FontSlant->"Plain"]], " ", "=", " ", 
    SubscriptBox["c", "0"], "|", 
    SubscriptBox["\[CapitalPi]", "\[UpTee]"], "\[Delta]", 
    SubscriptBox[
     StyleBox["f",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]], 
    SubscriptBox[
     StyleBox["e",
      FontWeight->"Bold"], "3"], "|", "/", "(", 
    SubscriptBox["\[Xi]", "0"], "|", 
    SubscriptBox["\[Lambda]", "3"], "|", ")"}], TraditionalForm]],
  ExpressionUUID->"a2214657-513d-484b-a0c2-eef4d16a7d59"],
 ". The corrected radius is confirmed by direct simulation."
}], "ItemNumbered",ExpressionUUID->"7abbc1f0-1fdc-453c-a0ef-39ba634182a1"],

Cell[TextData[{
 StyleBox["Surface-element and disk stresses (Eqs. 50\[Dash]51).",
  FontWeight->"Bold"],
 " The tangential drag and tangential thermophoretic terms have the wrong \
sign, and (51) has a spurious factor ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "5376ee2d-7d65-493a-a342-0837c32635fb"],
 " on the normal drag."
}], "ItemNumbered",ExpressionUUID->"2890942c-416a-4989-a2ef-d2dcad1d226a"],

Cell[TextData[{
 StyleBox["Cylinder (Eqs. 52\[Dash]54).",
  FontWeight->"Bold"],
 " The prefactor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", "m", "N", 
    SqrtBox["\[Pi]"], "\[ThinSpace]", "r", "L", "/", 
    SqrtBox["h"]}], TraditionalForm]],ExpressionUUID->
  "4a25651f-94a0-49bd-b09b-7de9ac05a431"],
 ". The tilt sense should be stated, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Theta]", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "33ff5f34-eeab-47ec-a0c4-8a6017f4cc6e"],
 " is a horizontal cylinder."
}], "ItemNumbered",ExpressionUUID->"12cc3f22-355b-47a1-91e7-43871e9525c2"],

Cell[TextData[{
 StyleBox["Rotational drag and gyrophoretic ratio (Eqs. 60, 62).",
  FontWeight->"Bold"],
 " The free-molecule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["C", "r"], " ", "=", " ", "(", "8", 
    SqrtBox["\[Pi]"], "/", "3", ")", "(", "P", "/", 
    OverscriptBox["v", "_"], ")", 
    SuperscriptBox["\[ScriptL]", "4"]}], TraditionalForm]],ExpressionUUID->
  "7f0dc858-08d4-4fa0-b743-4ecfdb6632b4"],
 " is 2.8 times larger. The analytic form of (62) has ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Pi]", "/", "15"}], TraditionalForm]],ExpressionUUID->
  "f87945d4-6497-4c98-b8c1-6880acf01c86"],
 " inverted."
}], "ItemNumbered",ExpressionUUID->"2911bf59-ea31-4566-ac18-82684c915ad0"]
}, Open  ]]
}, Open  ]]
},
