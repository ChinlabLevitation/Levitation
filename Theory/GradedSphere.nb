Cell[CellGroupData[{

Cell["8. Summary", "Section",ExpressionUUID->"195c5c32-8013-409a-b848-f3383b5d57e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<checks: \>\"", ",", 
       RowBox[{"Length", "[", "$verifications", "]"}], ",", "\"\<  (\>\"", ",", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"$verifications", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "3"}], "]"}], "]"}], ",", "\"\<VERIFIED\>\""}],
         "]"}], ",", "\"\< verified)\>\""}], "}"}], "]"}], ",", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"$verifications", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "Bold"}], "]"}], "&"}], "/@", 
