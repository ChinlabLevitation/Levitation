        2 $CellContext`q0 $CellContext`hat[{$CellContext`q1, $CellContext`q2, \
$CellContext`q3}], $CellContext`hat[{
          Pattern[$CellContext`a1, 
           Blank[]], 
          Pattern[$CellContext`a2, 
           Blank[]], 
          Pattern[$CellContext`a3, 
           Blank[]]}] := {{
