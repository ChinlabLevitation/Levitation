                  RowBox[{
                   RowBox[{"10", "^", "6"}], 
                   RowBox[{"forceCentre", "[", 
                    RowBox[{"st", ",", "ph"}], "]"}]}], ",", "1.2"}], "]"}]}],
                "}"}], ",", 
