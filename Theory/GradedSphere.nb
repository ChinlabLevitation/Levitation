       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"{", "LightGray", "}"}]}], "}"}]}]}], "]"}]}], "}"}], 
  "]"}]], "Input",ExpressionUUID->"6b2942ba-9833-49cb-b917-64c7062cfdcf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"checks: \"", "17", "\"  (\"", "17", "\" verified)\""},
      "RowDefault"]},
    {
     TagBox[GridBox[{
        {
         StyleBox["\<\"item\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"statement\"\>",
          StripOnInput->False,
          FontWeight->Bold], 
         StyleBox["\<\"result\"\>",
          StripOnInput->False,
          FontWeight->Bold]},
        {"\<\"mass\"\>", "\<\"M = (4/3) pi l^3 rho0, independent of eps\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"CoM\"\>", "\<\"CoM displaced by z_c = eps l^2/5 along e3\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"inertia\"\>", "\<\"inertia about H unchanged; about CoM the \
transverse moments drop by M z_c^2\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"Waldmann\"\>", "\<\"gamma0 = (16 Sqrt[pi]/15) kappa T \
l^2/vbar\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"Epstein\"\>", "\<\"xi0 = (4 pi/3) l^2 (rho cbar)(1 + pi a/8) \
with rho cbar = 2 alpha\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"rotation\"\>", "\<\"c0 = (2 pi/3) a (rho cbar) l^4\"\>", \
"\<\"VERIFIED\"\>"},
        {"\<\"T_th\"\>", "\<\"T_th = gamma0 [r_H]x (antisymmetric, lambda_a = \
-gamma0 z_c)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"coupling\"\>", "\<\"B = -xi0 [r_H]x and T_drag = c0 + xi0 z_c^2 \
diag(1,1,0)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"Onsager\"\>", "\<\"6x6 resistance matrix is symmetric\"\>", "\<\
\"VERIFIED\"\>"},
        {"\<\"shift rule\"\>", "\<\"all blocks follow from the sphere tensors \
at H by the rigid shift r_H\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"levitation\"\>", "\<\"levitation gradient G0 = M g/gamma0 is \
independent of eps (f_th isotropic)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"righting\"\>", "\<\"restoring torque -M g z_c sin(theta) about \
the horizontal axis at G = G0\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"no spin\"\>", "\<\"the only real eigenvector of T_th is e3, \
with eigenvalue 0: no steady spin, no orbit\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"cubic\"\>", "\<\"linear coefficient is M^2 g z_c + xi0 c0 (the \
coupling cancels)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"nonlinear\"\>", "\<\"H returns to its start: X_H(end) = X_H(0) \
= z_c sin(theta0)\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"frequency\"\>", "\<\"small-tilt oscillation frequency matches \
the linear cubic\"\>", "\<\"VERIFIED\"\>"},
        {"\<\"steady state\"\>", "\<\"after 150 ms the particle is at rest: \
no spin and no orbit\"\>", "\<\"VERIFIED\"\>"}
       },
       AutoDelete->False,
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
           GrayLevel[0.85]}},
       GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"a7a57720-35fa-47f1-be3b-4a1fbda2be6c"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Tensors.",
  FontWeight->"Bold"],
 " A density-graded sphere is a sphere in the gas. Every anisotropy about its \
CoM comes from the offset of the force centre, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], " ", "=", " ", "-", "(", "\[CurlyEpsilon]", 
    SuperscriptBox["\[ScriptL]", "2"], "/", "5", ")", 
    SubscriptBox[
     OverscriptBox["e", "^"], "3"]}], TraditionalForm]],ExpressionUUID->
  "943ecf90-6cfe-431c-b9dc-9f0aca0dbf84"],
 ": an antisymmetric thermophoretic torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "H"], "]"}], "\[Times]"]}], TraditionalForm]],
  ExpressionUUID->"2b219ced-d455-4436-91fa-9d00d2b11ad2"],
 ", an antisymmetric drag coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[Xi]", "0"], 
    SubscriptBox[
     RowBox[{"[", 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold"], "H"], "]"}], "\[Times]"]}], TraditionalForm]],
  ExpressionUUID->"58acafec-8a81-4d65-8ac1-5114528a4ea5"],
 ", and a parallel-axis rotational drag ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "0"], 
    SubsuperscriptBox["z", "c", "2"]}], TraditionalForm]],ExpressionUUID->
  "43cbf75d-c961-49b6-ab3e-dda2f2fa3a5f"],
 "."
}], "Item",ExpressionUUID->"48820ea9-d445-4ea8-8813-052c9c9b3a28"],

Cell[TextData[{
 StyleBox["Steady state.",
  FontWeight->"Bold"],
 " The particle levitates at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "0"], " ", "=", " ", "M", "g", "/", 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "5fc3fe5e-6d9d-4d48-84cc-8a35eb7a0054"],
 ", independent of ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "78e4e8ab-17f3-4108-bf4c-ccc939d820a5"],
 ", heavy side down, at rest. It has no spin and no orbit, because the body \
is achiral and its thermophoretic torque only aligns it."
}], "Item",ExpressionUUID->"716e0deb-e145-4644-ac31-da4c57a6ed83"],

Cell[TextData[{
 StyleBox["Dynamics.",
  FontWeight->"Bold"],
 " Disturbances decay as a damped pendulum with stiffness ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "g", 
    SubscriptBox["z", "c"]}], TraditionalForm]],ExpressionUUID->
  "b28d644c-74fe-4393-b963-76e15098c691"],
 ". For the defaults this is a few tens of Hz with ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "367ab743-7b5d-4ce7-9702-bb67d096e5e7"],
 " of order 1. The force centre H ends exactly where it started while the CoM \
swings underneath it."
}], "Item",ExpressionUUID->"1c4ef64d-51de-4f31-8205-ce8485344a38"],

Cell[TextData[{
 StyleBox["What would produce an orbit.",
  FontWeight->"Bold"],
 " A steady spin needs a torque component along the spin axis, which requires \
chirality (for example a symmetric part of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "1619c44a-7f14-44d0-9099-154a3a6e1f9a"],
 "). A circular orbit additionally needs a lateral force that rotates with \
the body (see ",
 StyleBox["OrbitStudy.ipynb",
  FontFamily->"Source Code Pro",
  FontColor->RGBColor[0.55, 0.1, 0.1]],
 ", Route A). Neither exists for this particle."
}], "Item",ExpressionUUID->"2a7a3c51-ec6d-499e-8b1f-a127f63f161a"]
}, Open  ]]
}, Open  ]]
},
