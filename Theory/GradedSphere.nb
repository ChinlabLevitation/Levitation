                  "xi0"] $CellContext`ph[
                  "c0"]) $CellContext`s + $CellContext`ph[
                "xi0"] $CellContext`ph["M"] $CellContext`$g Abs[
                 $CellContext`ph["zc"]] == 0, $CellContext`s]]; <|
          "roots" -> $CellContext`roots, "pendulum f (Hz)" -> Max[
              Abs[
               Im[$CellContext`roots]]]/(2 Pi), 
           "pendulum decay (1/s)" -> -Re[
              First[
               SortBy[$CellContext`roots, -Abs[
                  Im[#]]& ]]]|>], $CellContext`heavyTilt[
         Pattern[$CellContext`q, 
