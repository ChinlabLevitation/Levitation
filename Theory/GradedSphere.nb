Cell[CellGroupData[{

Cell["\<\
4. Steady states: levitation, orientation, and the absence of orbits\
\>", "Section",ExpressionUUID->"8a0e45f5-2ca6-4b07-b77e-4be7bbb6f0d0"],

Cell[TextData[{
 "Take the uniform gradient of the notes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "fe0ce46a-c058-4fac-84d0-c5434e1aa3f4"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "7b7da39f-7786-4778-afdb-25a861a8776f"],
 " is isotropic, the thermophoretic force is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "029b30db-cc29-4a66-bb39-8a03119e2598"],
 " in every orientation, so the levitation gradient is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "0"], " ", "=", " ", "M", "g", "/", 
    SubscriptBox["\[Gamma]", "0"]}], TraditionalForm]],ExpressionUUID->
  "1d9a757f-125f-44f3-a33e-57572eef9ac5"],
 ", independent of ",
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]],ExpressionUUID->
  "385b798d-9a0e-4de2-bc92-6e839c2c7cd2"],
 ". The force acts at H while gravity acts at the CoM. The torque ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], "\[Times]", 
    SubscriptBox["\[Gamma]", "0"], "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "e6bc922d-008a-4f1d-aeb9-6026eb08ff27"],
 " vanishes only when ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "H"], TraditionalForm]],ExpressionUUID->
  "3060f1f1-0907-451d-be9f-ecb2ab16780e"],
 " is vertical. The stable orientation has H above the CoM, i.e. the heavy \
side down, with restoring stiffness ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Kappa]", "\[Theta]"], " ", "=", " ", "M", "g", 
    SubscriptBox["z", "c"]}], TraditionalForm]],ExpressionUUID->
  "50ee30c2-9274-4864-b79f-9d915a35c6fd"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "12365ac0-2972-4f55-bed9-29568b366d63"],
 "."
}], "Text",ExpressionUUID->"79128117-2e4e-4b12-8441-a6a890288bfe"],

Cell[TextData[{
 "In the notes' language (Section 2.2), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "e6950548-ca76-41c8-b249-49bc82d5cd66"],
 " is antisymmetric. Its only real eigenvector is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "3"], TraditionalForm]],ExpressionUUID->
  "42171e43-e1bf-42df-a58c-f2132d194033"],
 ", with eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"47473a3e-fc7a-4e4d-8fa6-76a4ef5707c5"],
 ", so the steady state has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[CapitalOmega]",
     FontWeight->"Bold"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"c0b9d3f5-5f4a-45ca-8e9f-c9ace1b1858f"],
 ": ",
 StyleBox["no spin, hence no precession and no circular orbit",
  FontWeight->"Bold"],
 " (Eq. 49 gives nothing to divide by). The particle hovers. The notes' \
symmetric-eigenvector analysis does not apply to an antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", 
    SubscriptBox[
     StyleBox["T",
      FontWeight->"Bold"], 
     StyleBox["th",
      FontSlant->"Plain"]]}], TraditionalForm]],ExpressionUUID->
  "0edf02aa-d898-4fff-a77d-33ac7f094259"],
 ": the torque here does not spin the body, it ",
 StyleBox["aligns",
  FontSlant->"Italic"],
 " it."
}], "Text",ExpressionUUID->"94ab7652-980e-4c51-b122-553d299693ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gl", "=", 
      RowBox[{
       RowBox[{"-", "G"}], "Zhat"}]}], ",", "torqueAtTilt", ",", "eig"}], 
    "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"torqueAtTilt", "[", "th_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R", "=", 
         RowBox[{
          RowBox[{"RotationMatrix", "[", 
           RowBox[{"th", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}], ".", 
          RowBox[{"RotationMatrix", "[", 
           RowBox[{"Pi", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}]}], "}"}], ",", 
       RowBox[{"R", ".", 
        RowBox[{"(", 
         RowBox[{"-", 
          RowBox[{"Tth", ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Transpose", "[", "R", "]"}], ".", "gl"}], ")"}]}]}], 
         ")"}]}]}], "]"}]}], ";", 
    RowBox[{"eig", "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"Tth", "/.", 
       RowBox[{"zc", "->", "1"}]}], "]"}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<torque (lab) at heavy-axis tilt \[Theta]:  \>\"", ",", 
          RowBox[{"TraditionalForm", "[", 
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"torqueAtTilt", "[", "\[Theta]", "]"}], "/.", 
             RowBox[{"G", "->", 
              RowBox[{"Mg", "/", "gamma0"}]}]}], "]"}], "]"}]}], "}"}], "]"}],
        ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<levitation\>\"", 
         ",", "\"\<levitation gradient G0 = M g/gamma0 is independent of eps \
(f_th isotropic)\>\"", ",", 
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"Rsp", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", ";;", "3"}], ",", 
              RowBox[{"1", ";;", "3"}]}], "]"}], "]"}], "-", 
           RowBox[{"gamma0", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<righting\>\"", 
         ",", "\"\<restoring torque -M g z_c sin(theta) about the horizontal \
axis at G = G0\>\"", ",", 
         RowBox[{"zeroQ", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"torqueAtTilt", "[", "\[Theta]", "]"}], "/.", 
             RowBox[{"G", "->", 
              RowBox[{"Mg", "/", "gamma0"}]}]}], ")"}], "-", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"-", "Mg"}], "zc", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0"}], "}"}]}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<no spin\>\"", 
         ",", "\"\<the only real eigenvector of T_th is e3, with eigenvalue \
0: no steady spin, no orbit\>\"", ",", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"eig", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Element", "[", 
              RowBox[{"#", ",", "Reals"}], "]"}], "&"}]}], "]"}], "===", 
          RowBox[{"{", "0", "}"}]}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"bdf0c385-f864-400d-a29d-b2b2e17d8cec"],

Cell[BoxData[
 TemplateBox[{"\"torque (lab) at heavy-axis tilt \[Theta]:  \"", 
   TagBox[
    FormBox[
     RowBox[{"{", 
       RowBox[{"0", ",", 
         RowBox[{
           RowBox[{"-", "Mg"}], " ", "zc", " ", 
           RowBox[{"sin", "(", "\[Theta]", ")"}]}], ",", "0"}], "}"}], 
     TraditionalForm], TraditionalForm, Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"3e21e2f8-1756-4328-8b17-\
f617090e1160"]
}, Open  ]],

