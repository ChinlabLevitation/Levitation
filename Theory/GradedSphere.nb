Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["nonlinear",
  FontWeight->"Bold"],
 ":   ",
 "H returns to its start: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6daab271-f95a-4b09-9954-918c07a96e37"],
 "(end) = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "afcd683f-2354-490f-a464-4ccc872db41a"],
 "(0) = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e4f6f262-b153-47fb-8fb8-34b14a91e4ce"],
 " sin(\[Theta]0)",
 "\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "ed62384b-b9a6-492a-9f9a-2f22edcb9109"],
 StyleBox["(0) = 1.000 um, ",
  FontSize->11,
  FontColor->GrayLevel[0.3]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", 
    StyleBox["H",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "231d0f14-1719-45ec-82e5-4467030acb09"],
 StyleBox["(end) = 1.000 um; the CoM moved from 0 to 0.999 um.",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"e6cf50fd-277c-4b69-9d93-86e76202eda0"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["frequency",
  FontWeight->"Bold"],
 ":   ",
 "small-tilt oscillation frequency matches the linear cubic",
 "\n",
 StyleBox["linear prediction 52.86 Hz",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"cb0205df-7d9d-4e63-8244-3bb9a0b86e3a"],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["steady state",
  FontWeight->"Bold"],
 ":   ",
 "after 150 ms the particle is at rest: no spin and no orbit",
 "\n",
 StyleBox["|\[Omega]| = 2.07e-6 rad/s, |v| = 6.26e-12 m/s",
  FontSize->11,
  FontColor->GrayLevel[0.3]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"ceb6ac68-9fcc-4519-9afc-7457284a4a89"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Interactive simulations", "Section",ExpressionUUID->"01a7c0e8-ccb7-4adc-a65c-57e57ecde76a"],

Cell[TextData[{
 StyleBox["Explorer.",
  FontWeight->"Bold"],
 " Change the particle and cell parameters and the initial condition, and the \
notebook integrates the full equations again. Useful things to try: an \
initial spin about a horizontal axis, which precesses and damps; a spin about \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["e", "^"], "3"], TraditionalForm]],ExpressionUUID->
  "64c57554-cf36-4af2-ab3b-3297732d5058"],
 ", which is neutral apart from drag; a gradient off levitation (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "G"], " ", "\[NotEqual]", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"1b7a2070-c0e0-439f-9475-ced59e97b2ba"],
 "), which gives drift at terminal velocity; a radial trap; and the inverted \
start (tilt near 180\[Degree]), which is unstable. Each change re-runs the \
integration, which takes a second or two."
}], "Text",ExpressionUUID->"7fa0ffd0-92db-4d36-9491-e64e0a68efb1"],

