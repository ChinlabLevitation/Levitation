                 SuperscriptBox["l", "2"]}], "0", 
               RowBox[{
                 FractionBox["1", "3"], " ", "\[Pi]", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Pi]", " ", "aa"}], "+", "8"}], ")"}], " ", 
                 "al", " ", 
                 SuperscriptBox["l", "2"], " ", "zc"}], "0", "0"}, {
              "0", "0", "\"\[Gamma]0\"", "0", "0", 
               RowBox[{
                 FractionBox["1", "3"], " ", "\[Pi]", " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"\[Pi]", " ", "aa"}], "+", "8"}], ")"}], " ", 
                 "al", " ", 
                 SuperscriptBox["l", "2"]}], "0", "0", "0"}, {"0", 
               RowBox[{"\"\[Gamma]0\"", " ", "zc"}], "0", "0", 
               RowBox[{
                 FractionBox["1", "15"], " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"5", " ", 
                    SuperscriptBox["\[Pi]", "2"], " ", "aa", " ", "al", " ", 
