                    RowBox[{"40", " ", "\[Pi]", " ", "al", " ", 
                    SuperscriptBox["l", "2"], " ", "zc"}]}], ")"}]}], "0", 
               RowBox[{
                 FractionBox["1", "15"], " ", 
                 RowBox[{"(", 
                   RowBox[{
                    RowBox[{"5", " ", "\[Pi]", " ", "aa", " ", "al", " ", 
