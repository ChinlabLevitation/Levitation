          Inverse[$CellContext`I0]; $CellContext`qDown = 
          If[$CellContext`ph["epsL"] >= 0, {0., 1., 0., 0.}, {1., 0., 0., 
            0.}]; $CellContext`q0 = Normalize[{
             Cos[$CellContext`tiltDeg (Degree/2)], 0, 
             Sin[$CellContext`tiltDeg (Degree/2)], 0}]; $CellContext`q0 = 
          Module[{$CellContext`a = $CellContext`q0, $CellContext`b = \
$CellContext`qDown}, 
            Prepend[Part[$CellContext`a, 1] Part[$CellContext`b, 
                Span[2, 4]] + Part[$CellContext`b, 1] Part[$CellContext`a, 
                Span[2, 4]] + Cross[
               Part[$CellContext`a, 
                Span[2, 4]], 
               Part[$CellContext`b, 
                Span[2, 4]]], Part[$CellContext`a, 1] Part[$CellContext`b, 1] - 
             Dot[
              Part[$CellContext`a, 
               Span[2, 4]], 
              Part[$CellContext`b, 
               Span[2, 4]]]]]; $CellContext`rhs[
            Pattern[$CellContext`s, 
             Blank[]]] := Module[{$CellContext`x = Part[$CellContext`s, 
               Span[1, 3]], $CellContext`v = Part[$CellContext`s, 
               Span[4, 6]], $CellContext`q = Part[$CellContext`s, 
               Span[7, 10]], $CellContext`w = Part[$CellContext`s, 
               Span[
               11, 13]], $CellContext`R, $CellContext`wr}, $CellContext`R = \
$CellContext`quatR[$CellContext`q/Sqrt[
                Dot[$CellContext`q, $CellContext`q]]]; $CellContext`wr = -
              Dot[$CellContext`Rm, 
                Join[
                 Dot[
                  Transpose[$CellContext`R], 
                  Dot[$CellContext`A, $CellContext`x + 
                    Dot[$CellContext`R, $CellContext`rHv]] - $CellContext`G \
$CellContext`Zhat], 
                 Dot[
                  
                  Transpose[$CellContext`R], $CellContext`v], \
$CellContext`w]]; Join[$CellContext`v, Dot[$CellContext`R, 
                 Part[$CellContext`wr, 
                  Span[
                  1, 3]]]/$CellContext`M0 - $CellContext`$g \
$CellContext`Zhat, (1/2) Dot[
                $CellContext`Qmat[$CellContext`q], $CellContext`w], 
              Dot[$CellContext`Iinv, Part[$CellContext`wr, 
                 Span[4, 6]] - Cross[$CellContext`w, 
                Dot[$CellContext`I0, $CellContext`w]]]]]; $CellContext`sc = 
          Join[
            ConstantArray[$CellContext`l0, 3], 
            ConstantArray[$CellContext`l0/$CellContext`t0, 3], {1, 1, 1, 1}, 
            ConstantArray[1/$CellContext`t0, 3]]; $CellContext`f[
            PatternTest[
             Pattern[$CellContext`yy, 
              Blank[]], 
             VectorQ[#, 
              NumericQ]& ]] := $CellContext`t0 \
($CellContext`rhs[$CellContext`sc $CellContext`yy]/$CellContext`sc); \
$CellContext`sol = 
          NDSolveValue[{
            Derivative[1][$CellContext`y][$CellContext`t] == $CellContext`f[
               $CellContext`y[$CellContext`t]], $CellContext`y[0] == 
             Join[$CellContext`x0/$CellContext`l0, {0, 0, 
               0}, $CellContext`q0, $CellContext`spin $CellContext`t0]}, \
