Cell[CellGroupData[{

Cell["5. Linear dynamics: a damped pendulum that rights about H", "Section",ExpressionUUID->"e48787e7-bfc9-41ab-a748-dd96534402e0"],

Cell[TextData[{
 "Tilt the heavy axis by a small angle ",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]],ExpressionUUID->
  "8776bf83-aa41-423d-9d7a-711bce3b61db"],
 " about ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["Y", "^"], TraditionalForm]],ExpressionUUID->
  "f14bb922-96be-4236-a296-09a3309eb422"],
 " from straight down at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "5ac50d67-ea71-48ef-b4d7-62375f08b7d8"],
 ", and let the CoM move horizontally by ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "5aac8341-3b86-4f83-aa9f-36469748222e"],
 ". The force centre is at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "H"], " ", "=", " ", "X", " ", "+", " ", 
    SubscriptBox["z", "c"], "\[Theta]"}], TraditionalForm]],ExpressionUUID->
  "1d986070-8e51-443c-a57c-31c44ab10aad"],
 " and its velocity drags. The horizontal force and the torque are"
}], "Text",ExpressionUUID->"5ff67d04-44d8-4d81-a608-a5077e2aab89"],

Cell[BoxData[
 FormBox[
  RowBox[{"M", 
   OverscriptBox["X", ".."], " ", "=", " ", "-", 
   SubscriptBox["\[Xi]", "0"], "(", 
   OverscriptBox["X", "."], " ", "+", " ", 
   SubscriptBox["z", "c"], 
   OverscriptBox["\[Theta]", "."], ")", " ", ",", " ", "\:2003\:2003", " ", 
   SubscriptBox["I", "\[UpTee]"], 
   OverscriptBox["\[Theta]", ".."], " ", "=", " ", "-", 
   SubscriptBox["z", "c"], 
   SubscriptBox["\[Xi]", "0"], "(", 
   OverscriptBox["X", "."], " ", "+", " ", 
   SubscriptBox["z", "c"], 
   OverscriptBox["\[Theta]", "."], ")", " ", "-", " ", 
   SubscriptBox["c", "0"], 
   OverscriptBox["\[Theta]", "."], " ", "-", " ", "M", "g", 
   SubscriptBox["z", "c"], "\[ThinSpace]", "\[Theta]", " ", ","}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"f1e75881-2c88-4855-\
b11e-175f5d8e0b4e"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "\[UpTee]"], " ", "=", " ", 
    FractionBox["2", "5"], "M", 
    SuperscriptBox["\[ScriptL]", "2"], " ", "-", " ", "M", 
    SubsuperscriptBox["z", "c", "2"]}], TraditionalForm]],ExpressionUUID->
  "cae44baa-9195-40a2-89cc-3eebf2486370"],
 ". The coupling is symmetric, as reciprocity requires. The characteristic \
polynomial, after removing the neutral translation mode ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "8ed6f605-cda6-4bf4-9eeb-6c9e4eeddfaa"],
 ", is a cubic in which the coupling cancels from the linear coefficient:"
}], "Text",ExpressionUUID->"44357c69-b74f-4414-8d0d-bb57ca2913b0"],

Cell[BoxData[
 FormBox[
  RowBox[{"M", 
   SubscriptBox["I", "\[UpTee]"], 
   SuperscriptBox["s", "3"], " ", "+", " ", "(", "M", 
   SubscriptBox["c", "0"], " ", "+", " ", "M", 
   SubsuperscriptBox["z", "c", "2"], 
   SubscriptBox["\[Xi]", "0"], " ", "+", " ", 
   SubscriptBox["\[Xi]", "0"], 
   SubscriptBox["I", "\[UpTee]"], ")", 
   SuperscriptBox["s", "2"], " ", "+", " ", "(", 
   SuperscriptBox["M", "2"], "g", 
   SubscriptBox["z", "c"], " ", "+", " ", 
   SubscriptBox["\[Xi]", "0"], 
   SubscriptBox["c", "0"], ")", "s", " ", "+", " ", 
   SubscriptBox["\[Xi]", "0"], "M", "g", 
   SubscriptBox["z", "c"], " ", "=", " ", "0", " ", "."}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"5ea527c5-03fc-48cf-\
aad2-0b0b12f8acd2"],

Cell[TextData[{
 "Integrating the ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "0cb50b4e-60ca-490e-8cdf-29889a613980"],
 " equation once gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", 
    OverscriptBox["X", "."], " ", "+", " ", 
    SubscriptBox["\[Xi]", "0"], "(", "X", " ", "+", " ", 
    SubscriptBox["z", "c"], "\[Theta]", ")", " ", "=", " ", 
    StyleBox["const",
     FontSlant->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "bd45c825-0eb7-4421-b638-fa47a8105665"],
 ". When the particle comes to rest, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "H"], " ", "=", " ", "X", " ", "+", " ", 
    SubscriptBox["z", "c"], "\[Theta]"}], TraditionalForm]],ExpressionUUID->
  "02674137-ce4e-4dc2-862b-8325cfb2192c"],
 " has returned to its initial value: ",
 StyleBox["H ends where it started; the CoM swings underneath it.",
  FontWeight->"Bold"],
 " The result is exact, not just linear. Because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "e3ff7e1e-ab36-4597-82a4-e432afdafd8b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "9f1b42dd-e7e8-4b28-bf9b-492a64b5059a"],
 " are isotropic, the net force is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["\[Xi]", "0"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold"], "."], "H"]}], TraditionalForm]],ExpressionUUID->
  "01af2a22-1bc2-43fc-b6c8-a15dfedee1eb"],
 " plus the balanced weight and thermophoresis, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", 
    OverscriptBox[
     StyleBox["v",
      FontWeight->"Bold"], "."], " ", "=", " ", "-", 
    SubscriptBox["\[Xi]", "0"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold"], "."], "H"]}], TraditionalForm]],ExpressionUUID->
  "2b04ab1f-c677-43a0-b0d7-4daff6054670"],
 " integrates to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "H"], "(", "\[Infinity]", ")", " ", "=", " ", 
    SubscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "H"], "(", "0", ")", " ", "+", " ", "M", 
    StyleBox["v",
     FontWeight->"Bold"], "(", "0", ")", "/", 
    SubscriptBox["\[Xi]", "0"]}], TraditionalForm]],ExpressionUUID->
  "92cdab32-6538-4a29-bb97-4b23f3492b4e"],
 ". Section 6 checks this numerically."
}], "Text",ExpressionUUID->"c79fbf90-c34b-495f-ad0f-774ab6ec90e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lin", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ip", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "/", "5"}], "Mm", 
          RowBox[{"l", "^", "2"}]}], "-", 
         RowBox[{"Mm", 
          RowBox[{"zc", "^", "2"}]}]}]}], ",", "mat", ",", "poly"}], "}"}], ",", 
     RowBox[{
      RowBox[{"mat", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Mm", 
             RowBox[{"s", "^", "2"}]}], "+", 
            RowBox[{"xi0", "s"}]}], ",", 
           RowBox[{"xi0", "zc", "s"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xi0", "zc", "s"}], ",", 
           RowBox[{
            RowBox[{"Ip", 
             RowBox[{"s", "^", "2"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"c0", "+", 
               RowBox[{"xi0", 
                RowBox[{"zc", "^", "2"}]}]}], ")"}], "s"}], "+", 
            RowBox[{"Mm", "gg0", "zc"}]}]}], "}"}]}], "}"}]}], ";", 
      RowBox[{"poly", "=", 
       RowBox[{"Factor", "[", 
        RowBox[{"Det", "[", "mat", "]"}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{"poly", ",", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"poly", "/", "s"}], "]"}], ",", "s", ",", "Simplify"}], 
         "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<det = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"lin", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<cubic\>\"", 
      ",", "\"\<linear coefficient is M^2 g z_c + xi0 c0 (the coupling \
cancels)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"lin", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "s", ",", "1"}], 
         "]"}], "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Mm", "^", "2"}], "gg0", "zc"}], "+", 
          RowBox[{"xi0", "c0"}]}], ")"}]}], "]"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"3a9eac21-6a0b-4408-aa22-b3b138cb9f84"],

Cell[BoxData[
 TemplateBox[{"\"det = \"", 
   TagBox[
    FormBox[
     RowBox[{
       FractionBox["1", "45"], " ", "s", " ", 
       RowBox[{"(", 
         RowBox[{
           RowBox[{"20", " ", 
             SuperscriptBox["\[Pi]", "3"], " ", 
             SuperscriptBox["aa", "2"], " ", 
             SuperscriptBox["al", "2"], " ", 
             SuperscriptBox["l", "6"], " ", "s"}], "+", 
           RowBox[{"160", " ", 
             SuperscriptBox["\[Pi]", "2"], " ", "aa", " ", 
             SuperscriptBox["al", "2"], " ", 
             SuperscriptBox["l", "6"], " ", "s"}], "+", 
           RowBox[{"15", " ", 
             SuperscriptBox["\[Pi]", "2"], " ", "aa", " ", "al", " ", "gg0", 
             " ", 
             SuperscriptBox["l", "2"], " ", "Mm", " ", "zc"}], "+", 
           RowBox[{"6", " ", 
             SuperscriptBox["\[Pi]", "2"], " ", "aa", " ", "al", " ", 
             SuperscriptBox["l", "4"], " ", "Mm", " ", 
             SuperscriptBox["s", "2"]}], "+", 
           RowBox[{"60", " ", "\[Pi]", " ", "aa", " ", "al", " ", 
             SuperscriptBox["l", "4"], " ", "Mm", " ", 
             SuperscriptBox["s", "2"]}], "+", 
           RowBox[{"120", " ", "\[Pi]", " ", "al", " ", "gg0", " ", 
             SuperscriptBox["l", "2"], " ", "Mm", " ", "zc"}], "+", 
           RowBox[{"48", " ", "\[Pi]", " ", "al", " ", 
             SuperscriptBox["l", "4"], " ", "Mm", " ", 
             SuperscriptBox["s", "2"]}], "+", 
           RowBox[{"45", " ", "gg0", " ", 
             SuperscriptBox["Mm", "2"], " ", "s", " ", "zc"}], "+", 
           RowBox[{"18", " ", 
             SuperscriptBox["l", "2"], " ", 
             SuperscriptBox["Mm", "2"], " ", 
             SuperscriptBox["s", "3"]}], "-", 
           RowBox[{"45", " ", 
             SuperscriptBox["Mm", "2"], " ", 
             SuperscriptBox["s", "3"], " ", 
             SuperscriptBox["zc", "2"]}]}], ")"}]}], TraditionalForm], 
    TraditionalForm, Editable -> True]},
  "RowDefault"]], "Output",ExpressionUUID->"6ed20b58-2a8a-4d8c-b3f8-\
ed5610958683"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\[Checkmark] VERIFIED",
  FontWeight->"Bold",
  FontColor->RGBColor[0.1, 0.5, 0.15]],
 "    ",
 StyleBox["cubic",
  FontWeight->"Bold"],
 ":   ",
 "linear coefficient is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["M", "2"], TraditionalForm]],ExpressionUUID->
  "54b5aa53-b1a3-4ec9-90f3-d6495f5a643e"],
 " g ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", 
    StyleBox["c",
     FontSlant->"Plain"]], TraditionalForm]],ExpressionUUID->
  "6fee6e5f-90b2-409e-b7c8-87543cdaf86d"],
 " + \[Xi]0 c0 (the coupling cancels)"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{66, 10}, {4, 4}},
 CellFrameColor->RGBColor[0.1, 0.5, 0.15],
 Background->RGBColor[
  0.92, 0.97, 0.92],ExpressionUUID->"6372e070-b98f-418a-82df-9d79a9826ba2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Realistic particles", "Section",ExpressionUUID->"d7d19391-2f4f-4b71-9fe5-f0378786602d"],

Cell[TextData[{
 "The defaults follow the notes' Section 6: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptL]", " ", "=", " ", "20", "\[ThinSpace]", "\[Mu]"}], 
   TraditionalForm]],ExpressionUUID->"0406a6c4-2236-4916-8dff-22008bc6a1ec"],
 "m, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Rho]", "p"], " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"1da1baac-442e-42c8-922c-5c286e0429b8"],
 " g/cm\.b3, air at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", " ", "=", " ", "300"}], TraditionalForm]],ExpressionUUID->
  "d42de189-89f7-440b-ab4a-dbea7d9922fd"],
 " K and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", " ", "=", " ", "5"}], TraditionalForm]],ExpressionUUID->
  "924111f4-6676-4b67-9f8a-6596b7fcecf1"],
 " Torr, full accommodation, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", " ", "=", " ", "0.026"}], TraditionalForm]],
  ExpressionUUID->"0c2e7aab-7a91-4b5e-b5b9-991b009fd8fd"],
 " W/(m K), with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", "\[ScriptL]", " ", "=", " ", "0.5"}], 
   TraditionalForm]],ExpressionUUID->"189164a9-28c8-434a-837c-f56db6500390"],
 ". The temperature field is the notes' uniform gradient ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", " ", "=", " ", "-", "G", 
    OverscriptBox["Z", "^"]}], TraditionalForm]],ExpressionUUID->
  "a424d97f-0faa-4f94-b8da-17a177b41614"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", " ", 
    SubscriptBox["f", "G"], 
    SubscriptBox["G", "0"]}], TraditionalForm]],ExpressionUUID->
  "76da39b9-aba1-4007-8614-5c4b17ccd276"],
 ". An optional harmonic curvature (radial and vertical trap frequencies ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "r"], TraditionalForm]],ExpressionUUID->
  "2599f4a7-185f-427f-934d-8ef41943af20"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "z"], TraditionalForm]],ExpressionUUID->
  "a7eaa0a1-ec0d-4dc6-b720-7a6fc62b11f9"],
 ") represents the confinement of the real cell. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "n", " ", "\[TildeTilde]", " ", "0.5"}], TraditionalForm]],
  ExpressionUUID->"ccb4e159-6b90-4ec6-933e-a9d51d2ca971"],
 " the free-molecule coefficients are only indicative."
}], "Text",ExpressionUUID->"cb2eeb79-f611-449e-9191-15e6ba3cc6e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$kB", "=", "1.380649*^-23"}], ";", 
  RowBox[{"$mAir", "=", "4.81*^-26"}], ";", 
  RowBox[{"$g", "=", "9.81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"physics", "[", "pars_Association", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<radius\>\"", "->", "20*^-6"}], ",", 
            RowBox[{"\"\<rhoP\>\"", "->", "1000."}], ",", 
            RowBox[{"\"\<epsL\>\"", "->", "0.5"}], ",", 
            RowBox[{"\"\<T\>\"", "->", "300."}], ",", 
            RowBox[{"\"\<PTorr\>\"", "->", "5."}], ",", 
            RowBox[{"\"\<kappa\>\"", "->", "0.026"}], ",", 
            RowBox[{"\"\<a\>\"", "->", "1."}], ",", 
            RowBox[{"\"\<fG\>\"", "->", "1."}], ",", 
            RowBox[{"\"\<fr\>\"", "->", "0."}], ",", 
            RowBox[{"\"\<fz\>\"", "->", "0."}]}], "|>"}], ",", "pars"}], 
         "]"}]}], ",", "l0", ",", "N0", ",", "h0", ",", "al0", ",", "M0", ",",
        "zc0", ",", "subs", ",", "gam", ",", "xi", ",", "cr", ",", "Ip", ",", 
       "I3", ",", "mu", ",", "lam", ",", "G0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"l0", "=", 
       RowBox[{"p", "[", "\"\<radius\>\"", "]"}]}], ";", 
      RowBox[{"N0", "=", 
       RowBox[{
        RowBox[{"p", "[", "\"\<PTorr\>\"", "]"}], 
        RowBox[{"133.322", "/", 
         RowBox[{"(", 
          RowBox[{"$kB", 
           RowBox[{"p", "[", "\"\<T\>\"", "]"}]}], ")"}]}]}]}], ";", 
      RowBox[{"h0", "=", 
       RowBox[{"$mAir", "/", 
        RowBox[{"(", 
         RowBox[{"2", "$kB", 
          RowBox[{"p", "[", "\"\<T\>\"", "]"}]}], ")"}]}]}], ";", 
      RowBox[{"al0", "=", 
       RowBox[{"$mAir", 
        RowBox[{"N0", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Pi", "h0"}], "]"}]}]}]}], ";", 
      RowBox[{"M0", "=", 
       RowBox[{
        RowBox[{"4", "/", "3"}], "Pi", 
        RowBox[{"l0", "^", "3"}], 
        RowBox[{"p", "[", "\"\<rhoP\>\"", "]"}]}]}], ";", 
      RowBox[{"zc0", "=", 
       RowBox[{
        RowBox[{"p", "[", "\"\<epsL\>\"", "]"}], 
        RowBox[{"l0", "/", "5"}]}]}], ";", 
      RowBox[{"subs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l", "->", "l0"}], ",", 
         RowBox[{"al", "->", "al0"}], ",", 
         RowBox[{"hh", "->", "h0"}], ",", 
         RowBox[{"kap", "->", 
          RowBox[{"p", "[", "\"\<kappa\>\"", "]"}]}], ",", 
         RowBox[{"Tk", "->", 
          RowBox[{"p", "[", "\"\<T\>\"", "]"}]}], ",", 
         RowBox[{"aa", "->", 
          RowBox[{"p", "[", "\"\<a\>\"", "]"}]}], ",", 
         RowBox[{"zc", "->", "zc0"}]}], "}"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"gam", ",", "xi", ",", "cr"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"gamma0", ",", "xi0", ",", "c0"}], "}"}], "/.", "subs"}]}], ";", 
      RowBox[{"G0", "=", 
       RowBox[{"M0", 
        RowBox[{"$g", "/", "gam"}]}]}], ";", 
      RowBox[{"Ip", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "/", "5"}], "M0", 
         RowBox[{"l0", "^", "2"}]}], "-", 
        RowBox[{"M0", 
         RowBox[{"zc0", "^", "2"}]}]}]}], ";", 
      RowBox[{"I3", "=", 
       RowBox[{
        RowBox[{"2", "/", "5"}], "M0", 
        RowBox[{"l0", "^", "2"}]}]}], ";", 
      RowBox[{"mu", "=", 
       RowBox[{"1.716*^-5", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "[", "\"\<T\>\"", "]"}], "/", "273.15"}], ")"}], "^", 
         "1.5"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"273.15", "+", "110.4"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "[", "\"\<T\>\"", "]"}], "+", "110.4"}], ")"}]}]}]}], 
      ";", 
      RowBox[{"lam", "=", 
       RowBox[{
        RowBox[{"mu", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "[", "\"\<PTorr\>\"", "]"}], "133.322"}], ")"}]}], 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Pi", "$kB", 
          RowBox[{
           RowBox[{"p", "[", "\"\<T\>\"", "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "$mAir"}], ")"}]}]}], "]"}]}]}], ";", 
      RowBox[{"Join", "[", 
       RowBox[{"p", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<M\>\"", "->", "M0"}], ",", 
          RowBox[{"\"\<zc\>\"", "->", "zc0"}], ",", 
          RowBox[{"\"\<R\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"Rsp", "/.", "subs"}], "]"}]}], ",", 
          RowBox[{"\"\<gamma0\>\"", "->", "gam"}], ",", 
          RowBox[{"\"\<xi0\>\"", "->", "xi"}], ",", 
          RowBox[{"\"\<c0\>\"", "->", "cr"}], ",", 
          RowBox[{"\"\<I\>\"", "->", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{"Ip", ",", "Ip", ",", "I3"}], "}"}], "]"}]}], ",", 
          RowBox[{"\"\<G0\>\"", "->", "G0"}], ",", 
          RowBox[{"\"\<gradT0 (K/cm)\>\"", "->", 
           RowBox[{"G0", 
            RowBox[{
             RowBox[{"p", "[", "\"\<T\>\"", "]"}], "/", "100"}]}]}], ",", 
          RowBox[{"\"\<Kn\>\"", "->", 
           RowBox[{"lam", "/", "l0"}]}], ",", 
          RowBox[{"\"\<tauV\>\"", "->", 
           RowBox[{"M0", "/", "xi"}]}], ",", 
          RowBox[{"\"\<tauR\>\"", "->", 
           RowBox[{"Ip", "/", "cr"}]}], ",", 
          RowBox[{"\"\<A\>\"", "->", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"M0", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", "Pi", 
                   RowBox[{"p", "[", "\"\<fr\>\"", "]"}]}], ")"}], "^", "2"}],
                 "/", "gam"}]}], ",", 
              RowBox[{"M0", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", "Pi", 
                   RowBox[{"p", "[", "\"\<fr\>\"", "]"}]}], ")"}], "^", "2"}],
                 "/", "gam"}]}], ",", 
              RowBox[{"M0", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"2", "Pi", 
                   RowBox[{"p", "[", "\"\<fz\>\"", "]"}]}], ")"}], "^", "2"}],
                 "/", "gam"}]}]}], "}"}], "]"}]}]}], "|>"}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linearModes", "[", "ph_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", "roots"}], "}"}], ",", 
     RowBox[{
      RowBox[{"roots", "=", 
       RowBox[{"s", "/.", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"ph", "[", "\"\<M\>\"", "]"}], 
             RowBox[{
              RowBox[{"ph", "[", "\"\<I\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], 
             RowBox[{"s", "^", "3"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ph", "[", "\"\<M\>\"", "]"}], 
                RowBox[{"ph", "[", "\"\<c0\>\"", "]"}]}], "+", 
               RowBox[{
                RowBox[{"ph", "[", "\"\<M\>\"", "]"}], 
                RowBox[{
                 RowBox[{"ph", "[", "\"\<zc\>\"", "]"}], "^", "2"}], 
                RowBox[{"ph", "[", "\"\<xi0\>\"", "]"}]}], "+", 
               RowBox[{
                RowBox[{"ph", "[", "\"\<xi0\>\"", "]"}], 
                RowBox[{
                 RowBox[{"ph", "[", "\"\<I\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], ")"}], 
             RowBox[{"s", "^", "2"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"ph", "[", "\"\<M\>\"", "]"}], "^", "2"}], "$g", 
                RowBox[{"Abs", "[", 
                 RowBox[{"ph", "[", "\"\<zc\>\"", "]"}], "]"}]}], "+", 
               RowBox[{
                RowBox[{"ph", "[", "\"\<xi0\>\"", "]"}], 
                RowBox[{"ph", "[", "\"\<c0\>\"", "]"}]}]}], ")"}], "s"}], "+", 
            RowBox[{
             RowBox[{"ph", "[", "\"\<xi0\>\"", "]"}], 
             RowBox[{"ph", "[", "\"\<M\>\"", "]"}], "$g", 
             RowBox[{"Abs", "[", 
              RowBox[{"ph", "[", "\"\<zc\>\"", "]"}], "]"}]}]}], "==", "0"}], 
          ",", "s"}], "]"}]}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<roots\>\"", "->", "roots"}], ",", 
        RowBox[{"\"\<pendulum f (Hz)\>\"", "->", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Im", "[", "roots", "]"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "Pi"}], ")"}]}]}], ",", 
        RowBox[{"\"\<pendulum decay (1/s)\>\"", "->", 
         RowBox[{"-", 
          RowBox[{"Re", "[", 
           RowBox[{"First", "[", 
            RowBox[{"SortBy", "[", 
             RowBox[{"roots", ",", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Im", "[", "#", "]"}], "]"}]}], "&"}]}], "]"}], 
            "]"}], "]"}]}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ph0", "=", 
   RowBox[{"physics", "[", 
    RowBox[{"<|", "|>"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<M (kg)\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<M\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<z_c (um)\>\"", ",", 
       RowBox[{
        RowBox[{"10", "^", "6"}], 
        RowBox[{"ph0", "[", "\"\<zc\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<gamma0 (N m)\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<gamma0\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<xi0 (N s/m)\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<xi0\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<c0 (N m s)\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<c0\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<levitation |grad T| (K/cm)\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<gradT0 (K/cm)\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Kn\>\"", ",", 
       RowBox[{"ph0", "[", "\"\<Kn\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<M/xi0 (ms)\>\"", ",", 
       RowBox[{"1000", 
        RowBox[{"ph0", "[", "\"\<tauV\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<I_perp/c0 (ms)\>\"", ",", 
       RowBox[{"1000", 
        RowBox[{"ph0", "[", "\"\<tauR\>\"", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<pendulum frequency (Hz)\>\"", ",", 
       RowBox[{
        RowBox[{"linearModes", "[", "ph0", "]"}], 
        "[", "\"\<pendulum f (Hz)\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<pendulum decay rate (1/s)\>\"", ",", 
       RowBox[{
        RowBox[{"linearModes", "[", "ph0", "]"}], 
        "[", "\"\<pendulum decay (1/s)\>\"", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Alignment", "->", "Left"}]}], "]"}]}], "Input",ExpressionUUID->\
"50cf4a97-a437-4222-b81d-27790acdf243"],

