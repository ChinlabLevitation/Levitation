Cell[BoxData[
 RowBox[{"anim", "=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ph", "=", "ph0"}], ",", 
      RowBox[{"run", "=", 
       RowBox[{"simulate", "[", 
        RowBox[{"ph0", ",", "60", ",", 
         RowBox[{"{", 
