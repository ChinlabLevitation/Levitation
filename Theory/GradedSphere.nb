         RowBox[{"Show", "[", 
          RowBox[{"sphere", ",", 
           RowBox[{"Graphics3D", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"Black", ",", 
                RowBox[{"Sphere", "[", 
                 RowBox[{"x", ",", "1.2"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"Red", ",", 
                RowBox[{"Sphere", "[", 
