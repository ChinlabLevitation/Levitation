Cell[CellGroupData[{

Cell["3. Response tensors from the surface stresses", "Section",ExpressionUUID->"d3a79191-ebe1-42ce-bd76-a0415e554542"],

Cell[TextData[{
 "The only physical input is the free-molecule stress on a surface element \
(notes v22, Eq. 50). It applies to a convex body, where every element sees \
the undisturbed gas. Here ",
 Cell[BoxData[
  FormBox[
   StyleBox["V",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "dddd82ff-f996-4c64-b031-93e14a980c3e"],
 " is the wall velocity relative to the gas, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q",
     FontWeight->"Bold"], " ", "=", " ", "-", "\[Kappa]", " ", "T", "\[Del]", 
    
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T"}], TraditionalForm]],ExpressionUUID->
  "ce8a89b8-f6ba-4e35-b581-69c41b489948"],
 " is the heat flux, ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "e89b5db0-bda2-428a-8302-c3f2c39ed27f"],
 " is the accommodation coefficient, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", " ", "=", " ", "m", "N", "/", 
    SqrtBox[
     RowBox[{"\[Pi]", " ", "h"}]]}], TraditionalForm]],ExpressionUUID->
  "651f074c-a185-4911-be16-46cafe050348"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", " ", "=", " ", "m", "/", "2", 
    SubscriptBox["k", "B"], "T"}], TraditionalForm]],ExpressionUUID->
  "5766b82c-d06b-47b8-bf76-1ed7e585df78"],
 ":"
}], "Text",ExpressionUUID->"66ee7367-87e1-42c1-b82e-99f707072fc2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[Sigma]",
    FontWeight->"Bold"], " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[Alpha]", "[", 
      RowBox[{
       RowBox[{
        FractionBox["a", "2"], 
        SubscriptBox[
         StyleBox["V",
          FontWeight->"Bold"], "t"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "-", " ", "a", " ", "+", " ", 
          FractionBox[
           RowBox[{"\[Pi]", " ", "a"}], "4"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          StyleBox["V",
           FontWeight->"Bold"], "\[CenterDot]", 
          OverscriptBox["n", "^"]}], ")"}], 
        OverscriptBox["n", "^"]}]}], "]"}]}], " ", "+", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"a", 
       SqrtBox["h"]}], 
      RowBox[{"5", 
       SqrtBox["\[Pi]"]}]], 
     SubscriptBox[
      StyleBox["q",
       FontWeight->"Bold"], "t"]}], " ", "+", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "(", "2", " ", "-", " ", "a", ")", 
       SqrtBox["h"]}], 
      RowBox[{"5", 
       SqrtBox["\[Pi]"]}]], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["q",
        FontWeight->"Bold"], "\[CenterDot]", 
       OverscriptBox["n", "^"]}], ")"}], 
     OverscriptBox["n", "^"], " ", "\:2003\:2003", " ", 
     RowBox[{"(", 
      StyleBox[
       RowBox[{
       "pressure", " ", "omitted", ":", " ", "it", " ", "cancels", " ", "on", 
        " ", "a", " ", "closed", " ", "surface"}],
       FontSlant->"Plain"], ")"}]}]}]}], TraditionalForm]], "DisplayFormula",E\
xpressionUUID->"dc2c41c9-4678-4cee-8213-5f72ce53e25f"],

Cell[TextData[{
 "Put the CoM at the origin. The sphere's surface is then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold"], " ", "=", " ", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], " ", "+", " ", "\[ScriptL]", 
    OverscriptBox["n", "^"]}], TraditionalForm]],ExpressionUUID->
  "c38cca36-2f46-473c-901d-e901706ef64a"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], " ", "=", " ", "-", 
    SubscriptBox["z", "c"], 
    SubscriptBox[
     OverscriptBox["e", "^"], "3"]}], TraditionalForm]],ExpressionUUID->
  "00434aa9-1370-4980-b3cc-ca98c2c8d286"],
 ". For a body moving with velocity ",
 Cell[BoxData[
  FormBox[
   StyleBox["v",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "dc108d6a-d976-4358-ad68-d82a22a10f74"],
 " and angular velocity ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Omega]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7c349d2f-50e4-4f85-996b-5ce64c4434bc"],
 " (body frame), the wall velocity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["v",
     FontWeight->"Bold"], " ", "+", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], "\[Times]", 
    StyleBox["r",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "c0720221-42da-4efd-9fc0-cda9a1f9e327"],
 ". Integrating ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Sigma]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "7dbb7736-ef58-4e93-8bb6-1ce15b0d0da7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold"], "\[Times]", 
    StyleBox["\[Sigma]",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "9651b2a4-cd9c-4825-82c1-634221469737"],
 " over the sphere gives the complete linear response about the CoM, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    StyleBox["F",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Tau]",
     FontWeight->"Bold"], ")", " ", "=", " ", "-", "\[ScriptCapitalR]", "\[CenterDot]",
     "(", "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", ",", " ", 
    StyleBox["v",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "b38b01d7-6f46-4dd8-a771-8e522b5eec0f"],
 ", a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "\[Times]", "9"}], TraditionalForm]],ExpressionUUID->
  "d45c0726-4902-4b15-929f-ab90260aff98"],
 " matrix."
}], "Text",ExpressionUUID->"a1211272-bf17-4a7d-90c5-e545f736aec4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nH", "[", 
    RowBox[{"th_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "th", "]"}], 
      RowBox[{"Cos", "[", "ph", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sin", "[", "th", "]"}], 
      RowBox[{"Sin", "[", "ph", "]"}]}], ",", 
     RowBox[{"Cos", "[", "th", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stress", "[", 
    RowBox[{"n_", ",", "V_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "al"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"aa", "/", "2"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"V", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"V", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"aa", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], ")"}], 
        RowBox[{"(", 
         RowBox[{"V", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
    RowBox[{"aa", 
     RowBox[{
      RowBox[{"Sqrt", "[", "hh", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"5", 
        RowBox[{"Sqrt", "[", "Pi", "]"}]}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{"q", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", ".", "n"}], ")"}], "n"}]}], ")"}]}], "+", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"2", "-", "aa"}], ")"}], 
     RowBox[{
      RowBox[{"Sqrt", "[", "hh", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"5", 
        RowBox[{"Sqrt", "[", "Pi", "]"}]}], ")"}]}], 
     RowBox[{"(", 
      RowBox[{"q", ".", "n"}], ")"}], "n"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rH", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"-", "zc"}]}], "}"}]}], ";", 
  RowBox[{"vv", "=", 
   RowBox[{"{", 
    RowBox[{"v1", ",", "v2", ",", "v3"}], "}"}]}], ";", 
  RowBox[{"ww", "=", 
   RowBox[{"{", 
    RowBox[{"w1", ",", "w2", ",", "w3"}], "}"}]}], ";", 
  RowBox[{"gg", "=", 
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2", ",", "g3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wrench", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"nH", "[", 
            RowBox[{"th", ",", "ph"}], "]"}]}], ",", "r", ",", "s"}], "}"}], ",", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"rH", "+", 
           RowBox[{"l", "n"}]}]}], ";", 
         RowBox[{"s", "=", 
          RowBox[{"stress", "[", 
           RowBox[{"n", ",", 
            RowBox[{"vv", "+", 
             RowBox[{"Cross", "[", 
              RowBox[{"ww", ",", "r"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"-", "kap"}], "Tk", "gg"}]}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"s", ",", 
            RowBox[{"Cross", "[", 
             RowBox[{"r", ",", "s"}], "]"}]}], "]"}], 
          RowBox[{"l", "^", "2"}], 
          RowBox[{"Sin", "[", "th", "]"}]}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"th", ",", "0", ",", "Pi"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ph", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Rsp", "=", 
   RowBox[{"-", 
    RowBox[{"D", "[", 
     RowBox[{"wrench", ",", 
      RowBox[{"{", 
       RowBox[{"Join", "[", 
        RowBox[{"gg", ",", "vv", ",", "ww"}], "]"}], "}"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gamma0", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
  RowBox[{"xi0", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "4"}], "]"}], "]"}]}], ";", 
  RowBox[{"c0", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{"6", ",", "9"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[Gamma]0 = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", "gamma0", "]"}], 
       ",", "\"\<,   \[Xi]0 = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"Factor", "[", "xi0", "]"}], "]"}], ",", "\"\<,   c0 = \>\"", 
       ",", 
       RowBox[{"TraditionalForm", "[", "c0", "]"}]}], "}"}], "]"}], ",", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[ScriptCapitalR] = \>\"", ",", 
       RowBox[{"TraditionalForm", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"Rsp", "/.", 
          RowBox[{"{", 
           RowBox[{"gamma0", "->", "\"\<\[Gamma]0\>\""}], "}"}]}], "]"}], 
        "]"}]}], "}"}], "]"}]}], "}"}], "]"}]}], "Input",ExpressionUUID->\
"f06e185b-0f1e-4f17-89c6-f029c36d0b5d"],

