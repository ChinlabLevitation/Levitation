Cell[TextData[{
 StyleBox["Animation.",
  FontWeight->"Bold"],
 " A particle rights itself from 60\[Degree], drawn with its density gradient \
(dark = heavy), body axis, CoM (black) and force centre H (red). Drag the \
time slider or press play."
}], "Text",ExpressionUUID->"5106e84f-5423-4b9f-abd0-c9ecc537ec8e"],

