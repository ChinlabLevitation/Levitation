      RowBox[{"l0", "=", 
       RowBox[{"ph0", "[", "\"\<radius\>\"", "]"}]}]}], "}"}], ",", 
    RowBox[{"Manipulate", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"st", "=", 
           RowBox[{
            RowBox[{"run", "[", "\"\<state\>\"", "]"}], "[", "tm", "]"}]}], ",",
           "R", ",", "x", ",", "sphere"}], "}"}], ",", 
        RowBox[{
         RowBox[{"R", "=", 
          RowBox[{"quatR", "[", 
           RowBox[{"st", "[", 
            RowBox[{"[", 
             RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"x", "=", 
          RowBox[{
           RowBox[{"10", "^", "6"}], 
           RowBox[{"st", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "3"}], "]"}], "]"}]}]}], ";", 
         RowBox[{"sphere", "=", 
          RowBox[{"ParametricPlot3D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"10", "^", "6"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"st", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", "3"}], "]"}], "]"}], "+", 
               RowBox[{"R", ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", 
                    RowBox[{"-", 
                    RowBox[{"ph", "[", "\"\<zc\>\"", "]"}]}]}], "}"}], "+", 
                  RowBox[{"l0", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Sin", "[", "u", "]"}], 
                    RowBox[{"Cos", "[", "v", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"Sin", "[", "u", "]"}], 
                    RowBox[{"Sin", "[", "v", "]"}]}], ",", 
                    RowBox[{"Cos", "[", "u", "]"}]}], "}"}]}]}], ")"}]}]}], 
              ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"u", ",", "0", ",", "Pi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"v", ",", "0", ",", 
              RowBox[{"2", "Pi"}]}], "}"}], ",", 
            RowBox[{"Mesh", "->", "None"}], ",", 
            RowBox[{"PlotPoints", "->", "25"}], ",", 
            RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
            RowBox[{"ColorFunction", "->", 
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"xx", ",", "yy", ",", "zz", ",", "uu", ",", "vv"}], 
                "}"}], ",", 
               RowBox[{"Blend", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"RGBColor", "[", 
                    RowBox[{"0.85", ",", "0.92", ",", "1"}], "]"}], ",", 
                   RowBox[{"RGBColor", "[", 
                    RowBox[{"0.1", ",", "0.25", ",", "0.6"}], "]"}]}], "}"}], 
                 ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{
                    RowBox[{"Sign", "[", 
                    RowBox[{"ph", "[", "\"\<epsL\>\"", "]"}], "]"}], 
                    RowBox[{"Cos", "[", "uu", "]"}]}]}], ")"}], "/", "2"}]}], 
