          0, -$CellContext`a1}, {-$CellContext`a2, $CellContext`a1, 
          0}}, $CellContext`Zhat = {0, 0, 1}, $CellContext`Qmat[{
          Pattern[$CellContext`q0, 
           Blank[]], 
          Pattern[$CellContext`q1, 
           Blank[]], 
          Pattern[$CellContext`q2, 
           Blank[]], 
          Pattern[$CellContext`q3, 
           
           Blank[]]}] := {{-$CellContext`q1, -$CellContext`q2, \
-$CellContext`q3}, {$CellContext`q0, -$CellContext`q3, $CellContext`q2}, \
{$CellContext`q3, $CellContext`q0, -$CellContext`q1}, {-$CellContext`q2, \
$CellContext`q1, $CellContext`q0}}, $CellContext`linearModes[
         Pattern[$CellContext`ph, 
          Blank[]]] := 
       Module[{$CellContext`s, $CellContext`roots}, $CellContext`roots = 
          ReplaceAll[$CellContext`s, 
            NSolve[$CellContext`ph["M"] Part[
                 $CellContext`ph["I"], 1, 
