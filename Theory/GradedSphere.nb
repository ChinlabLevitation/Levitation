          Blank[]]] := Part[$CellContext`st, 
          Span[1, 3]] + Dot[
          $CellContext`quatR[
           Part[$CellContext`st, 
            Span[7, 10]]], {0, 0, -$CellContext`ph["zc"]}]}; 
     Typeset`initDone$$ = True),
