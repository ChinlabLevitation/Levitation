Cell[TextData[{
 StyleBox["Simulator.",
  FontWeight->"Bold"],
 " This integrates the full nonlinear rigid-body equations (notes, Eqs. 23\
\[Dash]26), extended by the coupling blocks: body-frame wrench ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "\[ScriptCapitalR]", "\[CenterDot]", "(", 
    SuperscriptBox["R", "\[Transpose]"], "\[Del]", 
    StyleBox["ln",
     FontSlant->"Plain"], " ", "T", "(", 
    SubscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "H"], ")", ",", " ", 
    SuperscriptBox["R", "\[Transpose]"], 
    StyleBox["v",
     FontWeight->"Bold"], ",", " ", 
    StyleBox["\[Omega]",
     FontWeight->"Bold"], ")"}], TraditionalForm]],ExpressionUUID->
  "8ab5cf3b-3e4e-4e10-bda7-3ff554479bfa"],
 ", gravity at the CoM, and the field evaluated at the force centre ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x",
      FontWeight->"Bold"], "H"], " ", "=", " ", 
    StyleBox["x",
     FontWeight->"Bold"], " ", "+", " ", "R", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"]}], TraditionalForm]],ExpressionUUID->
  "07fb58ef-c29c-4586-81f5-b91ba30e5ee4"],
 ". Lengths are scaled by ",
 Cell[BoxData[
  FormBox["\[ScriptL]", TraditionalForm]],ExpressionUUID->
  "e0cf661c-0372-4921-8f0f-0b1611ee2667"],
 " and times by 1 ms internally."
}], "Text",ExpressionUUID->"dfa16da3-a71c-4d16-aa4e-f84b25694186"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"simulate", "[", 
    RowBox[{"ph_", ",", "tiltDeg_", ",", "spin_", ",", "tEndMs_", ",", 
     RowBox[{"x0_", ":", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"M0", "=", 
        RowBox[{"ph", "[", "\"\<M\>\"", "]"}]}], ",", 
       RowBox[{"I0", "=", 
        RowBox[{"ph", "[", "\"\<I\>\"", "]"}]}], ",", "Iinv", ",", 
       RowBox[{"Rm", "=", 
        RowBox[{"ph", "[", "\"\<R\>\"", "]"}]}], ",", 
       RowBox[{"rHv", "=", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"-", 
           RowBox[{"ph", "[", "\"\<zc\>\"", "]"}]}]}], "}"}]}], ",", 
       RowBox[{"A", "=", 
        RowBox[{"ph", "[", "\"\<A\>\"", "]"}]}], ",", 
       RowBox[{"G", "=", 
        RowBox[{
         RowBox[{"ph", "[", "\"\<fG\>\"", "]"}], 
         RowBox[{"ph", "[", "\"\<G0\>\"", "]"}]}]}], ",", 
       RowBox[{"l0", "=", 
        RowBox[{"ph", "[", "\"\<radius\>\"", "]"}]}], ",", 
       RowBox[{"t0", "=", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}], ",", "rhs", ",", "f", ",", "y", ",", "t", ",",
        "sol", ",", "qDown", ",", "q0", ",", "sc"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Iinv", "=", 
       RowBox[{"Inverse", "[", "I0", "]"}]}], ";", 
      RowBox[{"qDown", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ph", "[", "\"\<epsL\>\"", "]"}], ">=", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "1.", ",", "0.", ",", "0."}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1.", ",", "0.", ",", "0.", ",", "0."}], "}"}]}], "]"}]}], ";", 
      RowBox[{"q0", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"tiltDeg", 
            RowBox[{"Degree", "/", "2"}]}], "]"}], ",", "0", ",", 
          RowBox[{"Sin", "[", 
           RowBox[{"tiltDeg", 
            RowBox[{"Degree", "/", "2"}]}], "]"}], ",", "0"}], "}"}], "]"}]}],
       ";", 
      RowBox[{"q0", "=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "=", "q0"}], ",", 
           RowBox[{"b", "=", "qDown"}]}], "}"}], ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "1", "]"}], "]"}], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "4"}], "]"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", "1", "]"}], "]"}], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "4"}], "]"}], "]"}]}], "+", 
            RowBox[{"Cross", "[", 
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", 
                RowBox[{"2", ";;", "4"}], "]"}], "]"}], ",", 
              RowBox[{"b", "[", 
               RowBox[{"[", 
                RowBox[{"2", ";;", "4"}], "]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "1", "]"}], "]"}], 
             RowBox[{"b", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "-", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "4"}], "]"}], "]"}], ".", 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", "4"}], "]"}], "]"}]}]}]}], "]"}]}], "]"}]}],
       ";", 
      RowBox[{
       RowBox[{"rhs", "[", "s_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "=", 
            RowBox[{"s", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ",", 
           RowBox[{"v", "=", 
            RowBox[{"s", "[", 
             RowBox[{"[", 
              RowBox[{"4", ";;", "6"}], "]"}], "]"}]}], ",", 
           RowBox[{"q", "=", 
            RowBox[{"s", "[", 
             RowBox[{"[", 
              RowBox[{"7", ";;", "10"}], "]"}], "]"}]}], ",", 
           RowBox[{"w", "=", 
            RowBox[{"s", "[", 
             RowBox[{"[", 
              RowBox[{"11", ";;", "13"}], "]"}], "]"}]}], ",", "R", ",", 
           "wr"}], "}"}], ",", 
         RowBox[{
          RowBox[{"R", "=", 
           RowBox[{"quatR", "[", 
            RowBox[{"q", "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"q", ".", "q"}], "]"}]}], "]"}]}], ";", 
          RowBox[{"wr", "=", 
           RowBox[{"-", 
            RowBox[{"Rm", ".", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", "R", "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"A", ".", 
                   RowBox[{"(", 
                    RowBox[{"x", "+", 
                    RowBox[{"R", ".", "rHv"}]}], ")"}]}], "-", 
                  RowBox[{"G", "Zhat"}]}], ")"}]}], ",", 
               RowBox[{
                RowBox[{"Transpose", "[", "R", "]"}], ".", "v"}], ",", "w"}], 
              "]"}]}]}]}], ";", 
          RowBox[{"Join", "[", 
           RowBox[{"v", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"R", ".", 
               RowBox[{"wr", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], "/", "M0"}], "-", 
             RowBox[{"$g", "Zhat"}]}], ",", 
            RowBox[{
             RowBox[{"1", "/", "2"}], 
             RowBox[{
              RowBox[{"Qmat", "[", "q", "]"}], ".", "w"}]}], ",", 
            RowBox[{"Iinv", ".", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"wr", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ";;", "6"}], "]"}], "]"}], "-", 
               RowBox[{"Cross", "[", 
                RowBox[{"w", ",", 
                 RowBox[{"I0", ".", "w"}]}], "]"}]}], ")"}]}]}], "]"}]}]}], 
        "]"}]}], ";", 
      RowBox[{"sc", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"l0", ",", "3"}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"l0", "/", "t0"}], ",", "3"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"1", "/", "t0"}], ",", "3"}], "]"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"yy_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"VectorQ", "[", 
            RowBox[{"#", ",", "NumericQ"}], "]"}], "&"}], ")"}]}], "]"}], ":=", 
       RowBox[{"t0", 
        RowBox[{
         RowBox[{"rhs", "[", 
          RowBox[{"sc", "yy"}], "]"}], "/", "sc"}]}]}], ";", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolveValue", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"f", "[", 
             RowBox[{"y", "[", "t", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"y", "[", "0", "]"}], "==", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"x0", "/", "l0"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "q0", ",", 
              RowBox[{"spin", "t0"}]}], "]"}]}]}], "}"}], ",", "y", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tEndMs"}], "}"}], ",", 
         RowBox[{"MaxSteps", "->", 
          RowBox[{"10", "^", "6"}]}], ",", 
         RowBox[{"PrecisionGoal", "->", "9"}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}]}], "]"}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<ph\>\"", "->", "ph"}], ",", 
        RowBox[{"\"\<tEnd\>\"", "->", "tEndMs"}], ",", 
        RowBox[{"\"\<state\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "tm", "}"}], ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"yy", "=", 
               RowBox[{"sol", "[", "tm", "]"}]}], "}"}], ",", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"l0", 
                RowBox[{"yy", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ";;", "6"}], "]"}], "]"}], 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1", ",", "1", ",", 
                  RowBox[{"1", "/", "t0"}], ",", 
                  RowBox[{"1", "/", "t0"}], ",", 
                  RowBox[{"1", "/", "t0"}]}], "}"}]}], ",", 
               RowBox[{"Normalize", "[", 
                RowBox[{"yy", "[", 
                 RowBox[{"[", 
                  RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"yy", "[", 
                 RowBox[{"[", 
                  RowBox[{"11", ";;", "13"}], "]"}], "]"}], "/", "t0"}]}], 
              "]"}]}], "]"}]}], "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"heavyTilt", "[", 
    RowBox[{"q_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ArcCos", "[", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"quatR", "[", "q", "]"}], ".", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sign", "[", 
              RowBox[{"ph", "[", "\"\<epsL\>\"", "]"}], "]"}], "e3"}], 
            ")"}]}], ")"}], ".", "Zhat"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "]"}], "/", 
    "Degree"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"forceCentre", "[", 
    RowBox[{"st_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"st", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "3"}], "]"}], "]"}], "+", 
    RowBox[{
     RowBox[{"quatR", "[", 
      RowBox[{"st", "[", 
       RowBox[{"[", 
        RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ".", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{"ph", "[", "\"\<zc\>\"", "]"}]}]}], "}"}]}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"f63b4c12-00a1-45bb-a245-48d96ec52dad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"run0", "=", 
   RowBox[{"simulate", "[", 
    RowBox[{"ph0", ",", "30", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "150"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ts", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "60", ",", "0.1"}], "]"}]}], ",", "st", ",", "tilt", 
     ",", "X", ",", "XH", ",", 
     RowBox[{"lm", "=", 
      RowBox[{"linearModes", "[", "ph0", "]"}]}], ",", "fit"}], "}"}], ",", 
   RowBox[{
    RowBox[{"st", "=", 
     RowBox[{
      RowBox[{"run0", "[", "\"\<state\>\"", "]"}], "/@", "ts"}]}], ";", 
    RowBox[{"tilt", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"heavyTilt", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"7", ";;", "10"}], "]"}], "]"}], ",", "ph0"}], "]"}], 
       "&"}], "/@", "st"}]}], ";", 
    RowBox[{"X", "=", 
     RowBox[{
      RowBox[{"10", "^", "6"}], 
      RowBox[{"st", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
    RowBox[{"XH", "=", 
     RowBox[{
      RowBox[{"10", "^", "6"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"forceCentre", "[", 
           RowBox[{"#", ",", "ph0"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "st"}], ")"}]}]}], ";", 
    RowBox[{"Column", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"ts", ",", "tilt"}], "}"}], "]"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              
              RowBox[{"\"\<t (ms)\>\"", 
               ",", "\"\<heavy-axis tilt (deg)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLabel", "->", "\"\<righting from 30\[Degree]\>\""}], 
            ",", 
            RowBox[{"ImageSize", "->", "330"}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{"ts", ",", "X"}], "}"}], "]"}], ",", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{"ts", ",", "XH"}], "}"}], "]"}]}], "}"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<t (ms)\>\"", ",", "\"\<X (\[Mu]m)\>\""}], "}"}]}], 
            ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<CoM\>\"", ",", "\"\<force centre H\>\""}], "}"}]}],
             ",", 
            RowBox[{"PlotLabel", "->", "\"\<horizontal position\>\""}], ",", 
            RowBox[{"ImageSize", "->", "380"}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "}"}], "]"}], ",", 
       
       RowBox[{"check", "[", 
        RowBox[{"\"\<nonlinear\>\"", 
         ",", "\"\<H returns to its start: X_H(end) = X_H(0) = z_c \
sin(theta0)\>\"", ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"XH", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"10", "^", "6"}], 
             RowBox[{"ph0", "[", "\"\<zc\>\"", "]"}], 
             RowBox[{"Sin", "[", 
              RowBox[{"30", "Degree"}], "]"}]}]}], "]"}], "<", 
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}], 
           RowBox[{"Abs", "[", 
            RowBox[{"XH", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"\"\<X_H(0) = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"XH", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], 
          "<>", "\"\< um, X_H(end) = \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"XH", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< um; the CoM moved from 0 to \>\"", "<>", 
          RowBox[{"num", "[", 
           RowBox[{"X", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< um.\>\""}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<frequency\>\"", 
         ",", "\"\<small-tilt oscillation frequency matches the linear \
cubic\>\"", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"run", "=", 
              RowBox[{"simulate", "[", 
               RowBox[{"ph0", ",", "2", ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "40"}], 
               "]"}]}], ",", 
             RowBox[{"tt", "=", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", "40", ",", "0.01"}], "]"}]}], ",", "th", ",",
              "zeros"}], "}"}], ",", 
           RowBox[{
            RowBox[{"th", "=", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"quatR", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"run", "[", "\"\<state\>\"", "]"}], "[", "#", 
                    "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"7", ";;", "10"}], "]"}], "]"}], "]"}], ".", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Sign", "[", 
                    RowBox[{"ph0", "[", "\"\<epsL\>\"", "]"}], "]"}], "e3"}], 
                   ")"}]}], ")"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "tt"}]}], ";", 
            RowBox[{"zeros", "=", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Partition", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{"tt", ",", "th"}], "}"}], "]"}], ",", "2", ",", 
                  "1"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], 
                   RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "<", "0"}], 
                 "&"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}]}], ";", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"1000", "/", 
                 RowBox[{"(", 
                  RowBox[{"2", 
                   RowBox[{"Mean", "[", 
                    RowBox[{"Differences", "[", "zeros", "]"}], "]"}]}], 
                  ")"}]}], "/", 
                RowBox[{"lm", "[", "\"\<pendulum f (Hz)\>\"", "]"}]}], "-", 
               "1"}], "]"}], "<", "0.02"}]}]}], "]"}], ",", 
         RowBox[{"\"\<linear prediction \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"lm", "[", "\"\<pendulum f (Hz)\>\"", "]"}], ",", "4"}], 
            "]"}], "]"}], "<>", "\"\< Hz\>\""}]}], "]"}], ",", 
       RowBox[{"check", "[", 
        RowBox[{"\"\<steady state\>\"", 
         ",", "\"\<after 150 ms the particle is at rest: no spin and no orbit\
\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run0", "[", "\"\<state\>\"", "]"}], "[", "150", "]"}], 
             "[", 
             RowBox[{"[", 
              RowBox[{"11", ";;", "13"}], "]"}], "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}], "&&", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run0", "[", "\"\<state\>\"", "]"}], "[", "150", "]"}], 
             "[", 
             RowBox[{"[", 
              RowBox[{"4", ";;", "6"}], "]"}], "]"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}]}], ",", 
         RowBox[{"\"\<|omega| = \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run0", "[", "\"\<state\>\"", "]"}], "[", "150", "]"}], 
             "[", 
             RowBox[{"[", 
              RowBox[{"11", ";;", "13"}], "]"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< rad/s, |v| = \>\"", "<>", 
          RowBox[{"sci", "[", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"run0", "[", "\"\<state\>\"", "]"}], "[", "150", "]"}], 
             "[", 
             RowBox[{"[", 
              RowBox[{"4", ";;", "6"}], "]"}], "]"}], "]"}], "]"}], 
          "<>", "\"\< m/s\>\""}]}], "]"}]}], "}"}], "]"}]}]}], 
  "]"}]}], "Input",ExpressionUUID->"d5de1198-72af-4047-8ed5-2afd6bdc01ed"],

