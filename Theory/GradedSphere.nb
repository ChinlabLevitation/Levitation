          "ph" -> $CellContext`ph, "tEnd" -> $CellContext`tEndMs, "state" -> 
           Function[{$CellContext`tm}, 
             Module[{$CellContext`yy = $CellContext`sol[$CellContext`tm]}, 
              Join[$CellContext`l0 Part[$CellContext`yy, 
                 Span[1, 6]] {
                1, 1, 1, 1/$CellContext`t0, 1/$CellContext`t0, 
                 1/$CellContext`t0}, 
               Normalize[
                Part[$CellContext`yy, 
                 Span[7, 10]]], Part[$CellContext`yy, 
                 Span[11, 13]]/$CellContext`t0]]]|>], $CellContext`quatR[{
          Pattern[$CellContext`q0, 
           Blank[]], 
          Pattern[$CellContext`q1, 
           Blank[]], 
          Pattern[$CellContext`q2, 
           Blank[]], 
          Pattern[$CellContext`q3, 
           Blank[]]}] := ($CellContext`q0^2 - 
          Dot[{$CellContext`q1, $CellContext`q2, $CellContext`q3}, \
