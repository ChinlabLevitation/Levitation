}, Open  ]],

Cell[TextData[{
 "Read the blocks off, in the notation of the notes plus the coupling block \
",
 Cell[BoxData[
  FormBox[
   StyleBox["B",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "227ee850-ae73-4746-a2d1-e7368c707f5b"],
 " that the notes omit:"
}], "Text",ExpressionUUID->"fedb3fca-e894-41c4-9096-0472197c8abe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["\[Gamma]", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["f",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["\[Xi]", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", ",", " ", "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["th",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["\[Gamma]", "0"], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "H"], "]"}], "\[Times]"], " ", "=", " ", "-", 
   SubscriptBox["\[Gamma]", "0"], 
   SubscriptBox["z", "c"], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      OverscriptBox["e", "^"], "3"], "]"}], "\[Times]"], " ", ",", " ", 
   "\:2003", " ", 
   SubscriptBox[
    StyleBox["T",
     FontWeight->"Bold"], 
    StyleBox["drag",
     FontSlant->"Plain"]], " ", "=", " ", 
   SubscriptBox["c", "0"], 
   SubscriptBox[
    StyleBox["I",
     FontWeight->"Bold"], "3"], " ", "+", " ", 
   SubscriptBox["\[Xi]", "0"], 
   SubsuperscriptBox["z", "c", "2"], "\[ThinSpace]", 
   StyleBox["diag",
    FontSlant->"Plain"], "(", "1", ",", " ", "1", ",", " ", "0", ")", " ", ",",
    " ", "\:2003", " ", 
   StyleBox["B",
    FontWeight->"Bold"], " ", "=", " ", "-", 
   SubscriptBox["\[Xi]", "0"], 
   SubscriptBox[
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "H"], "]"}], "\[Times]"]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"66bbc463-192e-47b3-\
b68b-016c86910833"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"16", 
       SqrtBox["\[Pi]"]}], "15"], 
     FractionBox[
      RowBox[{"\[Kappa]", " ", "T", 
       SuperscriptBox["\[ScriptL]", "2"]}], 
      OverscriptBox["v", "_"]]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     SubscriptBox["\[Xi]", "0"]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"4", "\[Pi]"}], "3"], 
     SuperscriptBox["\[ScriptL]", "2"], 
     SubscriptBox["\[Rho]", "g"], 
     RowBox[{
      OverscriptBox["c", "_"], "(", 
      RowBox[{"1", " ", "+", " ", 
       FractionBox[
        RowBox[{"\[Pi]", " ", "a"}], "8"]}], ")"}]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     SubscriptBox["c", "0"]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "3"], "a", 
     SubscriptBox["\[Rho]", "g"], 
     OverscriptBox["c", "_"], "\[ThinSpace]", 
     SuperscriptBox["\[ScriptL]", "4"]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003\:2003", " ", 
     OverscriptBox["v", "_"]}], " ", "=", " ", 
    RowBox[{
     SqrtBox[
      RowBox[{"2", 
       SubscriptBox["k", "B"], "T", "/", "m"}]], " ", "=", " ", 
     RowBox[{"1", "/", 
      SqrtBox["h"]}]}]}], " ", ",", " ", 
   RowBox[{
    RowBox[{"\:2003", " ", 
     SubscriptBox["\[Rho]", "g"], 
     OverscriptBox["c", "_"]}], " ", "=", " ", 
    RowBox[{"2", "\[Alpha]"}]}]}], TraditionalForm]], "DisplayFormula",Express\
ionUUID->"d28881dd-d9f7-4d78-9d53-c928dbd37976"],

Cell[TextData[{
 "Everything about the CoM follows from forces applied at H. The \
thermophoretic and drag forces act at H, so they exert torques ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold"], "H"], "\[Times]", 
    StyleBox["F",
     FontWeight->"Bold"]}], TraditionalForm]],ExpressionUUID->
  "342a12de-9770-4c51-ab44-8674f44dd339"],
 " about the CoM, and rotation about the CoM moves H, so it drags. The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "\[Times]", "6"}], TraditionalForm]],ExpressionUUID->
  "cdec6efe-3b1d-431f-b2bf-665b858a515a"],
 " resistance block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       SubscriptBox[
        StyleBox["f",
         FontWeight->"Bold"], 
        StyleBox["drag",
         FontSlant->"Plain"]], 
       StyleBox["B",
        FontWeight->"Bold"]},
      {
       SuperscriptBox[
        StyleBox["B",
         FontWeight->"Bold"], "\[Transpose]"], 
       SubscriptBox[
        StyleBox["T",
         FontWeight->"Bold"], 
        StyleBox["drag",
         FontSlant->"Plain"]]}
     },
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.32]}, 
         Offset[0.2]}}], ")"}], TraditionalForm]],ExpressionUUID->
  "f073f7bc-2e91-4095-aee7-1eb954facf5d"],
 " is symmetric (Onsager) and positive-definite."
}], "Text",ExpressionUUID->"0dfb1e4a-c657-49b4-82af-fdb05dd7dbce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Tth", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"4", ";;", "6"}], ",", 
      RowBox[{"1", ";;", "3"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"Bblk", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "3"}], ",", 
      RowBox[{"7", ";;", "9"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"Res6", "=", 
   RowBox[{"Rsp", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"4", ";;", "9"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{"\"\<Waldmann\>\"", 
      ",", "\"\<gamma0 = (16 Sqrt[pi]/15) kappa T l^2/vbar\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"gamma0", "-", 
        RowBox[{"16", 
         RowBox[{
          RowBox[{"Sqrt", "[", "Pi", "]"}], "/", "15"}], "kap", "Tk", 
         RowBox[{"l", "^", "2"}], 
         RowBox[{"Sqrt", "[", "hh", "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<Epstein\>\"", 
      ",", "\"\<xi0 = (4 pi/3) l^2 (rho cbar)(1 + pi a/8) with rho cbar = 2 \
alpha\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"xi0", "-", 
        RowBox[{"4", 
         RowBox[{"Pi", "/", "3"}], 
         RowBox[{"l", "^", "2"}], 
         RowBox[{"(", 
          RowBox[{"2", "al"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Pi", 
            RowBox[{"aa", "/", "8"}]}]}], ")"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<rotation\>\"", ",", "\"\<c0 = (2 pi/3) a (rho cbar) l^4\>\"",
       ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"c0", "-", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "3"}], "aa", 
         RowBox[{"(", 
          RowBox[{"2", "al"}], ")"}], 
         RowBox[{"l", "^", "4"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<T_th\>\"", 
      ",", "\"\<T_th = gamma0 [r_H]x (antisymmetric, lambda_a = -gamma0 \
z_c)\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Tth", "-", 
        RowBox[{"gamma0", 
         RowBox[{"hat", "[", "rH", "]"}]}]}], "]"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<coupling\>\"", 
      ",", "\"\<B = -xi0 [r_H]x and T_drag = c0 + xi0 z_c^2 diag(1,1,0)\>\"", 
      ",", 
      RowBox[{
       RowBox[{"zeroQ", "[", 
        RowBox[{"Bblk", "+", 
         RowBox[{"xi0", 
          RowBox[{"hat", "[", "rH", "]"}]}]}], "]"}], "&&", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"Rsp", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"4", ";;", "6"}], ",", 
            RowBox[{"7", ";;", "9"}]}], "]"}], "]"}], "-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c0", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "+", 
           RowBox[{"xi0", 
            RowBox[{"zc", "^", "2"}], 
            RowBox[{"DiagonalMatrix", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "0"}], "}"}], "]"}]}]}], ")"}]}], 
        "]"}]}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<Onsager\>\"", 
      ",", "\"\<6x6 resistance matrix is symmetric\>\"", ",", 
      RowBox[{"zeroQ", "[", 
       RowBox[{"Res6", "-", 
        RowBox[{"Transpose", "[", "Res6", "]"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"check", "[", 
     RowBox[{"\"\<shift rule\>\"", 
      ",", "\"\<all blocks follow from the sphere tensors at H by the rigid \
shift r_H\>\"", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"P", "=", 
           RowBox[{"ArrayFlatten", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{"hat", "[", "rH", "]"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "}"}]}], "}"}], 
            "]"}]}], ",", "thH", ",", "resH"}], "}"}], ",", 
        RowBox[{
         RowBox[{"thH", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"gamma0", 
             RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0", ",", 
              RowBox[{"{", 
               RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "]"}]}], ";", 
         RowBox[{"resH", "=", 
          RowBox[{"ArrayFlatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"xi0", 
                RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", "0"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"c0", 
                RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}]}], "}"}],
            "]"}]}], ";", 
         RowBox[{"zeroQ", "[", 
          RowBox[{"Rsp", "-", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "P", "]"}], ".", "thH"}], ",", 
             RowBox[{
              RowBox[{"Transpose", "[", "P", "]"}], ".", "resH", ".", "P"}], ",",
              "2"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], "}"}], 
  "]"}]}], "Input",ExpressionUUID->"9803a762-644e-4dd1-9c2f-c3f48844542a"],

